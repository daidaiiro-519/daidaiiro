{
  "order": [
    "core",
    "adapter"
  ],
  "layers": {
    "core": "src/core",
    "adapter": "src/adapter"
  },
  "rules": [
    {
      "rule": "依存の向きが、内から外へ出ていない",
      "source": {
        "record": "model"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "npx",
          "--yes",
          "dependency-cruiser@18.4.0",
          "--config",
          ".dependency-cruiser.json",
          "src"
        ]
      }
    }
  ]
}
