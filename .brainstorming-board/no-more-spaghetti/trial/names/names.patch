+/// Ruby の `"#{__dir__}/経路"` を、そのファイルからの相対経路へ直す。**`__dir__` は、
+/// そのファイルのディレクトリである** ── 埋め込みはそれ1つだけのときに限る（実測 ── rubocop）。
+fn ruby_dir_relative(raw: &str) -> Option<String> {
+    let body = raw.trim_matches('"');
+    let rest = body.strip_prefix("#{__dir__}/")?;
+    if rest.contains("#{") {
+        return None;
+    }
+    Some(format!("./{rest}"))
+}
