{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "案内の契約",
  "description": "スキーマ自身を実体として検証する。**案内は、値を書く単位ごとに持つ** ── 最上位の項目と、$defs の各形の項目である。入れ子の奥の葉は、親の案内が覆う。",
  "type": "object",
  "properties": {
    "properties": { "$ref": "#/$defs/item_set" },
    "$defs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "properties": { "$ref": "#/$defs/item_set" } }
      }
    }
  },
  "$defs": {
    "item_set": {
      "type": "object",
      "properties": { "$schema": true },
      "additionalProperties": { "$ref": "#/$defs/item" }
    },
    "item": {
      "type": "object",
      "required": ["description", "x-prompt"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "x-prompt": {
          "type": "object",
          "required": ["read", "write"],
          "additionalProperties": false,
          "properties": {
            "read": { "type": "string", "minLength": 1 },
            "write": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
