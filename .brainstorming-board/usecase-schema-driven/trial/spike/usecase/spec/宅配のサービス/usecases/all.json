              "op": "作成する"
            }
          ],
          "when": {
            "op": "確定する"
          },
          "then": {
            "fails": true,
            "check": "check.precondition"
          }
        }
      },
      {
        "id": "SC-01J7Q4N",
        "name": "明細が1件あれば、確定できる",
        "body": {
          "given": [
            {
              "op": "作成する"
            },
            {
              "op": "明細を足す"
            }
          ],
          "when": {
            "op": "確定する"
          },
          "then": {
            "fails": false,
            "check": "check.statusIs"
          }
        }
      }
    ],
    "body": {
      "subdomain": "SD-01J8C1A",
      "context": "BC-01J8B7C"
    }
  },
