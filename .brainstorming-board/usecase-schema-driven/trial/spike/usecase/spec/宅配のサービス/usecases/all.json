        "post": [
          "status == 確定済"
        ],
        "writes": [
          "出荷指示",
          "出荷明細"
        ]
      }
    ],
    "nodes": [
      {
        "id": "SC-01J7Q4M",
        "name": "明細が0件のとき、確定できない",
        "body": {
