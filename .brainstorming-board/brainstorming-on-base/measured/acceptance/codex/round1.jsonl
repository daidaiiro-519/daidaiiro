hy\": \"長いと強調した行が埋もれる。\",\n                      \"test\": \"60行くらいまでかを見る。\"\n                    }\n                  ]\n                }\n              },\n              \"description\": \"詳しい決まり\",\n              \"x-prompt\": {\n                \"read\": {\n                  \"means\": \"詳しい決まりである。\"\n                },\n                \"write\": [\n                  {\n                    \"id\": \"as-described\",\n                    \"rule\": \"説明のとおりに書く。\",\n                    \"why\": \"読み手と道具は説明のとおりに読む。\",\n                    \"test\": \"説明と合っているかを見る。\"\n                  }\n                ]\n              }\n            }\n          },\n          \"x-prompt\": {\n            \"read\": {\n              \"means\": \"答えである。\"\n            },\n            \"write\": [\n              {\n                \"id\": \"one-sentence-first\",\n                \"rule\": \"承認してほしいことを1文で text に書き、詳しい決まりを details に並べる。\",\n                \"why\": \"読み手は1文だけで判断できる。\",\n                \"test\": \"text が120字までかを見る。\"\n              }\n            ]\n          }\n        },\n        \"images\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"oneOf\": [\n              {\n                \"$ref\": \"#/$defs/figure\"\n              },\n              {\n                \"$ref\": \"#/$defs/screen\"\n              },\n              {\n                \"$ref\": \"#/$defs/code\"\n              },\n              {\n                \"$ref\": \"#/$defs/diff\"\n              },\n              {\n                \"$ref\": \"#/$defs/tree\"\n              },\n              {\n                \"$ref\": \"#/$defs/run\"\n              }\n            ]\n          },\n          \"description\": \"完成イメージ。在る種類だけがタブになる\",\n          \"x-prompt\": {\n            \"read\": {\n              \"means\": \"完成イメージ。在る種類だけがタブになるである。\"\n            },\n            \"write\": [\n              {\n                \"id\": \"always\",\n                \"rule\": \"答えの完成イメージを1つ以上置く。\"