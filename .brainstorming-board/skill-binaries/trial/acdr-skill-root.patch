+/// この Skill の置き場所。**呼ぶ側が渡したものを優先する。** 渡されなければ、実行ファイルの
+/// 1つ上（bin/ の親）を Skill のフォルダとする ── 置き場所は道具の契約が bin/ に固定するので、
+/// 配布しても変わらない。どちらにも references/ が無ければ、試した経路を示して停止する。
+fn references(given: &Given) -> Result<PathBuf, String> {
+    if given.has("skill_root") {
+        return Ok(PathBuf::from(given.one("skill_root", ".")).join("references"));
+    }
+    let exe = std::env::current_exe().map_err(|e| format!("実行ファイルの位置を取れない ── {e}"))?;
+    let tried = exe
+        .parent()
+        .and_then(std::path::Path::parent)
+        .map(|root| root.join("references"));
+    match tried {
+        Some(refs) if refs.is_dir() => Ok(refs),
+        Some(refs) => Err(format!(
+            "契約を読めない ── {} に references/ が無い。--skill_root で Skill の置き場所を渡す",
+            refs.display()
+        )),
+        None => Err("契約を読めない ── 実行ファイルの1つ上が無い。--skill_root で渡す".to_owned()),
+    }
 }
 
