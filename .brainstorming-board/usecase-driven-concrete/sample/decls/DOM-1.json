    "differentiator": true
   },
   {
    "id": "VAL-2",
    "name": "現金を扱わない支払い",
    "text": "店頭で現金を扱わずに支払える",
    "differentiator": false
   }
  ],
  "competitors": [
   {
    "id": "CMP-1",
    "name": "他チェーンのモバイルオーダー",
    "lacks": [
     "VAL-1"
    ]
   }
  ]
 },
 "success_criteria": [
