{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "value_object.schema.json",
 "x-generates": "decls/VO-<番号>.json",
 "title": "値オブジェクト",
 "description": "値で同一性が決まり、変わらないもの。成分ごとの不変条件と操作を持つ",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "id",
  "header",
  "components",
  "operations"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "kind": {
   "const": "value_object",
   "description": "宣言の種類",
   "x-prompt": {
    "read": "種類で読む欄が決まる",
    "write": "value_object と書く"
   }
  },
  "id": {
   "type": "string",
   "pattern": "^VO-[0-9]+$",
   "description": "宣言の ID",
   "x-prompt": {
    "read": "ほかの宣言はこの ID で指す",
    "write": "VO-番号 の形で書く。番号は増える一方にし、消した ID を再び使わない"
   },
   "x-view": {
    "hidden": true
   }
  },
  "header": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "description": "名前。用語集の語の ID",
     "x-prompt": {
      "read": "用語集の語として読む",
      "write": "用語集に語を足してから、その ID を書く。語を新しく作らない"
     },
     "allOf": [
      {
       "$ref": "common.schema.json#/$defs/term"
      }
     ],
     "x-ref": {
      "to": "glossary",
      "in": "terms",
      "meanings": "meanings",
      "meaning_key": "kind",
      "label": "word",
      "meaning": [
       "値オブジェクト"
      ]
     }
    },
    "context": {
     "type": "string",
     "pattern": "^BC-[0-9]+$",
     "description": "所属する区切られた文脈",
     "x-prompt": {
      "read": "この宣言が属する区切られた文脈",
      "write": "BC の ID を書く"
     },
     "x-ref": {
      "to": "context"
     }
    }
   },
   "required": [
    "name",
    "context"
   ],
   "description": "名前と、所属する区切られた文脈",
   "x-prompt": {
    "read": "名前は用語集の語、文脈は BC の ID である",
    "write": "名前は用語集の語の ID、文脈は BC の ID で書く"
   }
  },
  "components": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^CMP-[0-9]+$",
      "x-view": {
       "hidden": true
      }
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "description": "名前"
     },
     "kind": {
      "type": "string",
      "minLength": 1,
      "description": "種類"
     },
     "precision": {
      "type": "string",
      "minLength": 1,
      "description": "精度"
     },
     "unit": {
      "type": "string",
      "minLength": 1,
      "description": "単位"
     },
     "digits": {
      "type": "integer"
     },
     "values": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "description": "提供価値"
     },
     "invariants": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^INV-[0-9]+$",
         "x-view": {
          "hidden": true
         }
        },
        "condition": {
         "$ref": "common.schema.json#/$defs/condition",
         "description": "条件"
        }
       },
       "required": [
        "id",
        "condition"
       ],
       "x-test-spec": {
        "id": "decl",
        "checks": "作れない値を拒む",
        "level": "component"
       }
      },
      "description": "不変条件"
     }
    },
    "required": [
     "id",
     "name",
     "kind",
     "invariants"
    ]
   },
   "description": "成分",
   "x-prompt": {
    "read": "成分ごとの種類 ・ 精度 ・ 単位 ・ 不変条件",
    "write": "妥当性の検証は不変条件として値オブジェクト自身に書く。業務の決まりでない技術の制限（ファイルの名前の長さなど）は、ここではなくデータ要求か、書き込む側に書く。文字数は measure: length"
   }
  },
  "operations": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^OP-[0-9]+$",
      "x-view": {
       "hidden": true
      }
     },
     "name": {
      "type": "string",
      "pattern": "^TERM-[0-9]+$",
      "description": "名前"
     },
     "args": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "引数"
     },
     "result": {
      "type": "string",
      "description": "結果"
     },
     "accept_examples": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^OK-[0-9]+$",
         "x-view": {
          "hidden": true
         }
        },
        "self": {},
        "args": {
         "type": "array",
         "description": "引数"
        },
        "result": {
         "description": "結果"
        }
       },
       "required": [
        "id",
        "self",
        "args",
        "result"
       ],
       "x-test-spec": {
        "id": "parent",
        "checks": "操作の結果が例と同じ",
        "level": "component"
       }
      },
      "description": "受け付ける例"
     }
    },
    "required": [
     "id",
     "name",
     "args",
     "result",
     "accept_examples"
    ]
   },
   "description": "操作",
   "x-prompt": {
    "read": "値から値を求める操作",
    "write": "名前は用語集の語で書き、受け付ける例を1つ以上書く"
   }
  }
 }
}