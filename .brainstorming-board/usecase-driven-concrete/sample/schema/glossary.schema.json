{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "glossary.schema.json",
 "x-generates": "decls/GLO-<番号>.json",
 "title": "用語集",
 "description": "プロダクトに1つ。語ごとに意味の一覧と、使わない語を持つ。宣言の名前と条件は、ここの語を指す",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "id",
  "header",
  "terms"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "kind": {
   "const": "glossary",
   "description": "宣言の種類",
   "x-prompt": {
    "read": "種類で読む欄が決まる",
    "write": "glossary と書く"
   }
  },
  "id": {
   "type": "string",
   "pattern": "^GLO-[0-9]+$",
   "description": "宣言の ID",
   "x-prompt": {
    "read": "ほかの宣言はこの ID で指す",
    "write": "GLO-番号 の形で書く。番号は増える一方にし、消した ID を再び使わない"
   },
   "x-view": {
    "hidden": true
   }
  },
  "header": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "名前"
    }
   },
   "required": [
    "name"
   ],
   "description": "名前",
   "x-prompt": {
    "read": "用語集の名前",
    "write": "「用語集」と書く"
   }
  },
  "terms": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^TERM-[0-9]+$",
      "x-view": {
       "hidden": true
      }
     },
     "word": {
      "type": "string",
      "minLength": 1,
      "description": "語"
     },
     "meanings": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string",
         "pattern": "^M-[0-9]+$",
         "x-view": {
          "hidden": true
         }
        },
        "definition": {
         "type": "string",
         "minLength": 1,
         "description": "定義"
        },
        "kind": {
         "type": "string",
         "minLength": 1,
         "description": "種類"
        },
        "form": {
         "type": "string",
         "minLength": 1
        },
        "change": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "id",
        "definition",
        "kind"
       ]
      },
      "minItems": 1,
      "description": "意味"
     },
     "avoid": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "description": "使わない語"
     }
    },
    "required": [
     "id",
     "word",
     "meanings",
     "avoid"
    ]
   },
   "description": "語の一覧",
   "x-prompt": {
    "read": "語 → 意味の一覧 → 意味ごとの種類の順に読む",
    "write": "1つの語に意味が2つ以上あれば、意味を分けて書き、語の頭に文脈名を付けない。区切られた文脈は、どの意味を使うかを指す。意味の kind は、その語が宣言のどこで使われるか（集約 ・ 状態 ・ 状態の値 ・ 値オブジェクト ・ コマンド ・ 拒否の理由 ・ 情報の別名 ・ 動作 など）を書く。避けたい言い換えは avoid に並べる。語を新しく作らない ── 業務の人がふだん使う語を書く"
   }
  }
 }
}