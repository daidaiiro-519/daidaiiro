{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "application_operation.schema.json",
 "x-generates": "decls/APP-<番号>.json",
 "title": "アプリケーション層の操作",
 "description": "要求の側と設計の側をつなぐ唯一の宣言。どのユースケースを満たし、各手順で何を呼び、各拡張がどの拒否 ・ 失敗で起きるかを持つ",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "id",
  "header",
  "satisfies",
  "steps",
  "extensions",
  "preconditions",
  "guarantees"
 ],
 "properties": {
  "$schema": {
   "type": "string"
  },
  "kind": {
   "const": "application_operation",
   "description": "宣言の種類",
   "x-prompt": {
    "read": "種類で読む欄が決まる",
    "write": "application_operation と書く"
   }
  },
  "id": {
   "type": "string",
   "pattern": "^APP-[0-9]+$",
   "description": "宣言の ID",
   "x-prompt": {
    "read": "ほかの宣言はこの ID で指す",
    "write": "APP-番号 の形で書く。番号は増える一方にし、消した ID を再び使わない"
   }
  },
  "header": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "name": {
     "$ref": "common.schema.json#/$defs/term",
     "description": "名前。用語集の語の ID",
     "x-prompt": {
      "read": "用語集の語として読む",
      "write": "用語集に語を足してから、その ID を書く。語を新しく作らない"
     }
    },
    "context": {
     "type": "string",
     "pattern": "^BC-[0-9]+$",
     "description": "所属する区切られた文脈",
     "x-prompt": {
      "read": "この宣言が属する区切られた文脈",
      "write": "BC の ID を書く"
     }
    }
   },
   "required": [
    "name",
    "context"
   ],
   "description": "名前と、所属する区切られた文脈",
   "x-prompt": {
    "read": "名前は用語集の語、文脈は BC の ID である",
    "write": "名前は用語集の語の ID、文脈は BC の ID で書く"
   }
  },
  "satisfies": {
   "type": "array",
   "items": {
    "type": "string",
    "pattern": "^UC-[0-9]+$"
   },
   "minItems": 1,
   "description": "満たすユースケース",
   "x-prompt": {
    "read": "この操作が実現するユースケース",
    "write": "UC の ID を書く。ユースケースと一対一に固定しない"
   }
  },
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "step": {
      "$ref": "common.schema.json#/$defs/ref"
     },
     "calls": {
      "$ref": "common.schema.json#/$defs/ref"
     }
    },
    "required": [
     "step",
     "calls"
    ]
   },
   "description": "手順の対応",
   "x-prompt": {
    "read": "ユースケースのどの手順で何を呼ぶか",
    "write": "内部の状態変化の手順と、支援アクターとの相互作用の手順ごとに、呼ぶ集約のコマンド ・ ドメインサービスの操作 ・ 文脈の地図の操作を書く。トランザクションスクリプトとアクティブレコードでは書かない"
   }
  },
  "extensions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "extension": {
      "$ref": "common.schema.json#/$defs/ref"
     },
     "raised_by": {
      "$ref": "common.schema.json#/$defs/ids"
     }
    },
    "required": [
     "extension",
     "raised_by"
    ]
   },
   "description": "拡張の対応",
   "x-prompt": {
    "read": "どの拒否 ・ 失敗で、どの拡張が起きるか",
    "write": "業務ルールの拒否と支援アクターの失敗の拡張ごとに、起こす業務ルールか失敗の種類を raised_by に書く。別の道筋での成功と妥当性確認の失敗は書かない"
   }
  },
  "preconditions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "precondition": {
      "$ref": "common.schema.json#/$defs/ref"
     },
     "prevents": {
      "$ref": "common.schema.json#/$defs/ids"
     }
    },
    "required": [
     "precondition",
     "prevents"
    ]
   },
   "description": "事前条件の対応",
   "x-prompt": {
    "read": "どの事前条件が、どの拒否を防いでいるか",
    "write": "防いでいる業務ルールを prevents に書く。ここに書いた拒否は、拡張の欠けとして数えない"
   }
  },
  "guarantees": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "guarantee": {
      "$ref": "common.schema.json#/$defs/ref"
     },
     "established_by": {
      "$ref": "common.schema.json#/$defs/ids"
     }
    },
    "required": [
     "guarantee",
     "established_by"
    ]
   },
   "description": "成功時保証の対応",
   "x-prompt": {
    "read": "どの状態の変更が、どの成功時保証を成り立たせるか",
    "write": "保証の条件の語と同じ状態を変える状態の変更を書く"
   }
  }
 }
}