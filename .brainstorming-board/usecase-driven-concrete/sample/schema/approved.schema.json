{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "approved.schema.json",
 "x-generates": "spec/approved-record.json",
 "title": "承認した時点の記録",
 "description": "宣言の従属関係ごとに、承認した時点の参照先のハッシュ値を持つ。道具はいまのハッシュ値と比べ、違えば「確かめ直し」と出す。手で書かない ── 承認したときに道具が書く",
 "type": "object",
 "propertyNames": {
  "pattern": "^[A-Z]+-[0-9]+[A-Z0-9.:-]*→[A-Z]+-[0-9]+[A-Z0-9.-]*$"
 },
 "additionalProperties": {
  "type": "string",
  "pattern": "^[0-9a-f]{8}$"
 }
}