{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"テストの報告",
 "description":"テスト実装が出す、テスト条件ごとの結果。道具はこれを宣言から取り出したテスト条件と突き合わせる。",
 "type":"object","required":["schema","producer","spec_revision","results"],"additionalProperties":false,
 "properties":{
  "schema":{"const":"report.schema.json"},
  "producer":{"type":"string","description":"報告を出したテストの実行器"},
  "spec_revision":{"type":"string","description":"テストが前提にした宣言の版"},
  "results":{"type":"array","items":{
   "type":"object","required":["condition","hash","test","level","result"],"additionalProperties":false,
   "properties":{
    "condition":{"type":"string","pattern":"^[A-Z]+-[0-9]+(\\.[A-Z]+-?[0-9]*)+$","description":"テスト条件の ID（宣言ID.種類-連番）"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{8}$","description":"テストを書いたときのテスト条件のハッシュ値"},
    "test":{"type":"string","description":"テストの名前"},
    "level":{"enum":["component","component-integration","system"]},
    "result":{"enum":["pass","fail","skip"]},
    "reason":{"type":"string","description":"skip の理由"}},
   "if":{"properties":{"result":{"const":"skip"}}},"then":{"required":["reason"]}}}}}
