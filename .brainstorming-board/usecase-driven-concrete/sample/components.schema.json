{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "components.schema.json",
 "title": "見本のコンポーネント（19）",
 "description": "ユースケース駆動の見本が使うコンポーネントの入力の形。ACDR 0128 で schema-driven の page.schema.json に置き、ACDR 0132 で具体のこちらへ移した。#/$defs/expr ・ node ・ control は page.schema.json のものを指す（転写するときに解決する）",
 "oneOf": [{"$ref": "#/$defs/c-text"}, {"$ref": "#/$defs/c-strong"}, {"$ref": "#/$defs/c-sentence"}, {"$ref": "#/$defs/c-pill"}, {"$ref": "#/$defs/c-ref"}, {"$ref": "#/$defs/c-missing"}, {"$ref": "#/$defs/c-yes-no"}, {"$ref": "#/$defs/c-code"}, {"$ref": "#/$defs/c-note"}, {"$ref": "#/$defs/c-paragraph"}, {"$ref": "#/$defs/c-subheading"}, {"$ref": "#/$defs/c-kv"}, {"$ref": "#/$defs/c-table"}, {"$ref": "#/$defs/c-filter-table"}, {"$ref": "#/$defs/c-cards"}, {"$ref": "#/$defs/c-list"}, {"$ref": "#/$defs/c-fold"}, {"$ref": "#/$defs/c-steps"}, {"$ref": "#/$defs/c-json"}],
 "$defs": {
  "c-text": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "text"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "show": true, "each": true},
   "description": "地の文の文字", "x-prompt": {"read": "value を地の文の文字で出す。", "write": "強調も意味づけも要らない値に使う。"}},
  "c-strong": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "strong"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "show": true, "each": true},
   "description": "強調した文字", "x-prompt": {"read": "value を太字で出す。", "write": "表の先頭の列の名前など、読み手が目で探す値にだけ使う。"}},
  "c-sentence": {"type": "object", "additionalProperties": false, "required": ["component", "view", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "sentence"}, "view": {"type": "string", "minLength": 1, "description": "x-view を持つスキーマの場所（JSON Pointer）"}, "value": {"$ref": "page.schema.json#/$defs/expr"}, "show": true, "each": true},
   "description": "x-view の文の型で、値を文にする",
   "x-prompt": {"read": "value の値を、スキーマの view の場所にある x-view の文の型に当てて文にする。", "write": "条件や手順のように、構造を持つ値を文で読ませたいときに使う。view には、その値の形を定義しているスキーマの場所を JSON Pointer で書く（例：/$defs/condition）。"}},
  "c-pill": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "pill"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "tone": {"type": "string", "description": "tones の表の名前"}, "show": true, "each": true},
   "description": "札。分類や状態を短い語で出す",
   "x-prompt": {"read": "value を札で出す。tone があれば、ページテンプレートの tones の表で色の役割を決める。", "write": "分類 ・ 状態 ・ 種類のような、決まった値のどれかを出すときに使う。文には使わない。"}},
  "c-ref": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "ref"}, "value": {"$ref": "page.schema.json#/$defs/expr"}, "show": true, "each": true},
   "description": "ほかのインスタンスへのリンク",
   "x-prompt": {"read": "value の値（links の要素 ・ 指す先のインスタンス ・ id のどれか）を、指す先のページへのリンクで出す。名前は x-ref の label、無ければ id。指す先が無ければ「未作成」として出す。", "write": "ほかのインスタンスや項目を指す値に使う。links[…] で取った要素を渡すと、名前と指す先が正しく出る。"}},
  "c-missing": {"type": "object", "additionalProperties": false, "required": ["component", "text"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "missing"}, "text": {"type": "string", "minLength": 1}, "show": true, "each": true},
   "description": "注意を引く文字（食い違い ・ 欠け）",
   "x-prompt": {"read": "text を注意の色で出す。", "write": "show で食い違いの条件を書き、そのときだけ出す（例：導出値と宣言した値が違う）。いつも出す説明には使わない。"}},
  "c-yes-no": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "yes-no"}, "value": {"$ref": "page.schema.json#/$defs/expr"}, "show": true, "each": true},
   "description": "真偽を「はい」「いいえ」で出す",
   "x-prompt": {"read": "value が true なら「はい」、false なら「いいえ」を出す。", "write": "問いへの答えのような真偽の値に使う。"}},
  "c-code": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "code"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "show": true, "each": true},
   "description": "識別子 ・ パス ・ 式などを等幅で出す",
   "x-prompt": {"read": "value を等幅の文字で出す。", "write": "ID ・ パス ・ キーの名前など、綴りのまま読ませたい値に使う。"}},
  "c-note": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "note"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "show": true, "each": true},
   "description": "補足の小さな文字",
   "x-prompt": {"read": "value を補足の文字で出す。", "write": "主な値の横に添える補足に使う。主な内容には使わない。"}},
  "c-paragraph": {"type": "object", "additionalProperties": false, "required": ["component", "value"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "paragraph"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "show": true, "each": true},
   "description": "段落",
   "x-prompt": {"read": "value を1つの段落で出す。", "write": "説明文のような、まとまった文を出すときに使う。"}},
  "c-subheading": {"type": "object", "additionalProperties": false, "required": ["component", "text"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "subheading"}, "text": {"type": "string", "minLength": 1}, "show": true, "each": true},
   "description": "節の中の小見出し",
   "x-prompt": {"read": "text を節の中の小見出しで出す。", "write": "1つの節の中で、内容を2つ以上に分けたいときに使う。分けるものが大きければ、節を分ける。"}},
  "c-kv": {"type": "object", "additionalProperties": false, "required": ["component", "rows"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "kv"}, "show": true, "each": true,
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "value"],
     "properties": {"label": {"$ref": "page.schema.json#/$defs/node"}, "value": {"$ref": "page.schema.json#/$defs/node"}, "note": {"$ref": "page.schema.json#/$defs/node"}, "show": {"$ref": "page.schema.json#/$defs/expr"}}}}},
   "description": "項目と値の組の一覧（左に項目、右に値。境界線で分ける）",
   "x-prompt": {"read": "rows の1つ1つを、左に label、右に value（と note）の行で出す。show が空の行は出さない。", "write": "1つのものの属性を並べるときに使う（タイルやカードに並べない）。label には項目の名前を {\"text\": …} で、value には値を書く。"}},
  "c-table": {"type": "object", "additionalProperties": false, "required": ["component", "rows", "cols"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "table"}, "show": true, "each": true,
    "rows": {"$ref": "page.schema.json#/$defs/expr", "description": "行にする配列"},
    "cols": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["head", "value"],
     "properties": {"head": {"type": "string", "minLength": 1}, "value": {"$ref": "page.schema.json#/$defs/node"}}}},
    "empty": {"type": "string", "description": "行が0件のときに出す文"}},
   "description": "表。行の配列と列の定義から組む",
   "x-prompt": {"read": "rows の式の結果の要素ごとに1行を作り、cols の順に列を並べる。列の value は、その行の要素を今の位置として当てる（@ が行の要素）。0件なら empty を出す（無ければ表ごと出さない）。", "write": "同じ形のものが並ぶときに使う。rows には並べる配列を、cols には列ごとに見出しと値を書く。行の数が多く、種類で絞りたいなら filter-table を使う。"}},
  "c-filter-table": {"type": "object", "additionalProperties": false, "required": ["component", "rows", "cols", "filter"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "filter-table"}, "show": true, "each": true,
    "rows": {"$ref": "page.schema.json#/$defs/expr"},
    "cols": {"$ref": "#/$defs/c-table/properties/cols"},
    "filter": {"type": "object", "additionalProperties": false, "required": ["label", "key"],
     "properties": {"label": {"type": "string", "minLength": 1, "description": "絞るものの名前（例：種類）"},
      "key": {"$ref": "page.schema.json#/$defs/expr", "description": "行ごとに、絞り込みに使う値"},
      "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "keys"],
       "properties": {"name": {"type": "string"}, "keys": {"type": "array", "items": {"type": "string"}}}}},
      "unit": {"type": "string", "description": "件数の単位（例：語）"}}}},
   "description": "絞り込みのボタン（複数選べる）を持つ表",
   "x-prompt": {"read": "表の上に、filter.key の値ごとのボタンを並べる。ボタンは複数選べ、選んだ値の行だけを出す。groups があれば、ボタンをその名前でまとめる。", "write": "行が多く、読み手が種類ごとに見たい表に使う。key には行の種類を表す値の式を書く。ボタンが多いときは groups でまとめる。"}},
  "c-cards": {"type": "object", "additionalProperties": false, "required": ["component", "items", "title"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "cards"}, "show": true, "each": true,
    "items": {"$ref": "page.schema.json#/$defs/expr"}, "title": {"$ref": "page.schema.json#/$defs/node"}, "body": {"type": "array", "items": {"$ref": "page.schema.json#/$defs/node"}}},
   "description": "カードの並び。1件ごとに見出しと中身を持つ",
   "x-prompt": {"read": "items の要素ごとにカードを1枚出し、title を見出し、body を中身にする。カードは同じ高さにそろえる。", "write": "1件ごとに中身の形が違い、表の列にそろえられないものにだけ使う。表にできるものは table にする。"}},
  "c-list": {"type": "object", "additionalProperties": false, "required": ["component", "items", "name"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "list"}, "show": true, "each": true,
    "items": {"$ref": "page.schema.json#/$defs/expr"}, "name": {"$ref": "page.schema.json#/$defs/node"}, "text": {"$ref": "page.schema.json#/$defs/node"}, "extra": {"$ref": "page.schema.json#/$defs/node"}},
   "description": "名前と説明の並び",
   "x-prompt": {"read": "items の要素ごとに、name を太字、その後に text と extra を出す。", "write": "名前と短い説明の組を並べるときに使う。列が3つ以上になるなら table にする。"}},
  "c-fold": {"type": "object", "additionalProperties": false, "required": ["component", "summary", "body"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "fold"}, "show": true, "each": true,
    "summary": {"type": "string", "minLength": 1}, "body": {"type": "array", "items": {"$ref": "page.schema.json#/$defs/node"}}},
   "description": "開いて読む部分",
   "x-prompt": {"read": "summary の行だけを出し、押すと body を開く。", "write": "裏づけや詳しい内訳のように、判断に毎回は要らない内容に使う。結論や主な内容は畳まない。"}},
  "c-steps": {"type": "object", "additionalProperties": false, "required": ["component", "items", "text"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "steps"}, "show": true, "each": true,
    "items": {"$ref": "page.schema.json#/$defs/expr", "description": "手順の配列"},
    "no": {"$ref": "page.schema.json#/$defs/node"}, "actor": {"$ref": "page.schema.json#/$defs/node"}, "text": {"$ref": "page.schema.json#/$defs/node"}, "reply": {"$ref": "page.schema.json#/$defs/node"},
    "branches": {"type": "object", "additionalProperties": false, "required": ["items", "text"],
     "properties": {"items": {"$ref": "page.schema.json#/$defs/expr"}, "no": {"$ref": "page.schema.json#/$defs/node"}, "text": {"$ref": "page.schema.json#/$defs/node"},
      "steps": {"$ref": "page.schema.json#/$defs/expr"}, "end": {"$ref": "page.schema.json#/$defs/node"}}},
    "end": {"$ref": "page.schema.json#/$defs/node"}},
   "description": "番号つきの手順の流れ。手順ごとに分かれ道（branches）を持てる",
   "x-prompt": {"read": "items の要素ごとに、no ・ actor ・ text ・ reply で1つの手順を出す。branches があれば、その手順の下に分かれ道（番号 ・ 条件 ・ 中の手順 ・ 終わり方）を字下げして出す。最後に end を出す。", "write": "順に進む手順と、途中で分かれる道を持つもの（例：ユースケースのシナリオと拡張）に使う。分かれ道の中の手順は、branches.steps に、手順と同じ形の配列を取る式で書く。"}},
  "c-json": {"type": "object", "additionalProperties": false, "required": ["component"], "allOf": [{"$ref": "page.schema.json#/$defs/control"}],
   "properties": {"component": {"const": "json"}, "show": true, "each": true, "label": {"type": "string"}},
   "description": "このインスタンスの JSON を、畳んで出す",
   "x-prompt": {"read": "このページのインスタンスの JSON を整形して、畳んだ状態で出す。", "write": "ページの最後に置く。AI や書き手が正本の形を確かめるためのもので、読み手向けの内容には使わない。"}}
 }
}
