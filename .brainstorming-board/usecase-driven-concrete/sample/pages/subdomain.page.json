{
 "kind": "subdomain",
 "page": [
  {"head": {"badges": [" ", {"pill": {"val": "classification/category"}, "tone": {"map": "category", "on": "classification/category"}}], "lead": {"val": "header/description"}}},
  {"block": "カテゴリー", "body": [
   {"kv": [
    {"k": {"sch": "classification", "key": "x-derive/title"}, "v": {"pill": {"derive": "classification"}, "tone": {"map": "category", "of": {"derive": "classification"}}}},
    {"k": "カテゴリー（宣言）", "v": [
     {"pill": {"val": "classification/category"}, "tone": {"map": "category", "on": "classification/category"}},
     {"if": {"not": {"same": ["classification/category", {"derive": "classification"}]}}, "then": [" ", {"p": "missing", "s": {"text": "導いたカテゴリーと違う"}}]}]},
    {"k": "調達", "v": {"val": "classification/sourcing"}, "if": "classification/sourcing"}]},
   {"table": {"cols": ["問い（どのサブドメインでも同じ）", "このサブドメインの答え"], "rows": [
    {"each": {"questions": "classification"}, "rows": [{"cells": [{"val": "title"}, {"if": "answer", "then": {"p": "yes"}, "else": {"p": "no"}}]}]}]}}]},
  {"block": "業務ロジックの性質", "body": [
   {"kv": [{"k": {"sch": "business_logic", "key": "x-derive/title"}, "v": {"p": "b", "s": {"text": {"derive": "business_logic"}}}}]},
   {"table": {"cols": ["問い（どのサブドメインでも同じ）", "このサブドメインの答え"], "rows": [
    {"each": {"questions": "business_logic"}, "rows": [{"cells": [{"val": "title"}, {"if": "answer", "then": {"p": "yes"}, "else": {"p": "no"}}]}]}]}},
   {"if": "business_logic/rule_conditions", "then": [
    {"p": "sub", "s": {"text": {"sch": "business_logic/rule_conditions", "key": "title"}}},
    {"table": {"cols": ["根拠の条件"], "rows": [
     {"each": "business_logic/rule_conditions", "rows": [{"cells": [[{"t": "{.|name}"}, {"p": "ln-id", "s": {"id": {"val": "."}}}]]}]}]}}]}]},
  {"if": "serves_values", "then": {"block": "担う提供価値", "body": {"table": {"cols": ["提供価値", "説明"], "rows": [
   {"each": "%domain/vision/values", "where": {"in": ["id", "^/serves_values"]}, "rows": [
    {"cells": [{"p": "b", "s": {"text": {"val": "name"}}}, {"p": "txt", "s": {"text": {"val": "text"}}}]}]}]}}}},
  {"block": "束ねるユースケース", "body": {"table": {"cols": ["ユースケース", "目的レベル", "主アクター"], "empty": {"p": "p-txt", "s": {"text": "なし（外部のサービスで満たす）"}}, "rows": [
   {"each": "use_cases", "rows": [{"cells": [{"ref": "."}, {"pill": {"val": "./@ref/header/level"}}, {"val": "./@ref/header/primary_actor"}]}]}]}}},
  {"json": true}
 ]
}
