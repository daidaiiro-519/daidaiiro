{
 "kind": "glossary",
 "id": "GLO-1",
 "header": {
  "name": "用語集"
 },
 "terms": [
  {
   "id": "TERM-1",
   "word": "実体",
   "meanings": [
    {
     "id": "M-1",
     "definition": "スキーマに従う JSON のデータ1件。正本であり、1つのファイルに置く",
     "kind": "集約"
    }
   ],
   "avoid": [
    "インスタンス",
    "ドキュメント"
   ]
  },
  {
   "id": "TERM-2",
   "word": "スキーマ",
   "meanings": [
    {
     "id": "M-1",
     "definition": "実体の形と注釈を書いた JSON Schema",
     "kind": "値オブジェクト"
    }
   ],
   "avoid": []
  },
  {
   "id": "TERM-3",
   "word": "注釈",
   "meanings": [
    {
     "id": "M-1",
     "definition": "スキーマの欄に付ける、x- で始まるキー（x-ref ・ x-derive ・ x-view ・ x-prompt ・ x-generates）",
     "kind": "情報の別名"
    }
   ],
   "avoid": []
  },
  {
