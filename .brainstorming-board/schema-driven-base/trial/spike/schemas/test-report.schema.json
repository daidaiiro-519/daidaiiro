{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "テストの報告",
 "description": "テスト実装が出す報告。作り方は、技術スタックごとにコーディングの側が持つ",
 "type": "object",
 "required": ["results"],
 "properties": {
  "results": {"type": "array", "title": "結果",
   "items": {"type": "object", "required": ["id", "result"], "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+\\.[A-Z]+-[0-9]+$", "title": "テスト仕様の ID"},
     "result": {"enum": ["pass", "fail", "skip"], "title": "結果"}}}}
 }
}
