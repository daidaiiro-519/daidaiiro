{
  "order": [
    "core",
    "adapter"
  ],
  "layers": {
    "core": "server/internal/core",
    "adapter": "server/internal/adapter"
  },
  "rules": [
    {
      "rule": "整形されている",
      "source": {
        "meta": "pkg.go.dev/cmd/gofmt",
        "quote": "Gofmt formats Go programs."
      },
      "scope": "整形の差分のみ",
      "check": {
        "tool": [
          "gofmt",
          "-d",
          "."
        ],
        "target": "server"
      }
    },
    {
      "rule": "静的解析を通る",
      "source": {
        "meta": "go.dev/ref/mod",
        "quote": "go vet"
      },
      "scope": "既定の検査のみ",
      "check": {
        "tool": [
          "go",
          "vet",
          "./..."
        ],
        "target": "server"
      }
    },
    {
      "rule": "試験が通る",
      "source": {
        "meta": "pkg.go.dev/testing",
        "quote": "Package testing provides support for automated testing of Go packages."
      },
      "scope": "既定の実行のみ",
      "check": {
        "tool": [
          "go",
          "test",
          "./..."
        ],
        "target": "server"
      }
    }
  ]
}
