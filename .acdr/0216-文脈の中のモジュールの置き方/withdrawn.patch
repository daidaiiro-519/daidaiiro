 import os, re
 H = os.path.dirname(os.path.abspath(__file__))
-TEMPLATE = '<title>抽象概念の土台</title>\n<meta name="claude:viewport-fit-sides" content="cover">\n<style>\n/* タブで層 ・ 意味の境界 ・ パターン ・ 境界 ・ 単位 ・ 文脈 ・ 六角形 ・ 置き場所 ・ 育てている所を切り替える */\n:root{--bg:#eef2f0;--card:#fff;--ink:#111d1a;--sub:#5b6b66;--line:#d3dcd8;--accent:#0d5c55;--accent-bg:#d5e6e3;--code:#f3f6f4;--f:"Noto Sans JP","Hiragino Kaku Gothic ProN",system-ui,sans-serif}\n@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#111614;--card:#192120;--ink:#e3ebe8;--sub:#9aaba5;--line:#2f3b37;--accent:#7cc4b7;--accent-bg:#1e3330;--code:#151c1a;color-scheme:dark}}\n:root[data-theme="dark"]{--bg:#111614;--card:#192120;--ink:#e3ebe8;--sub:#9aaba5;--line:#2f3b37;--accent:#7cc4b7;--accent-bg:#1e3330;--code:#151c1a;color-scheme:dark}\n[hidden]{display:none!important}\nbody{background:var(--bg);color:var(--ink);font:15px/1.75 var(--f);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 56px}\nmain{max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:14px}\nh1{font-size:24px;margin:0} h2{font-size:18px;margin:0;color:var(--accent)} h3{font-size:15px;margin:8px 0 0} p{margin:0}\n.tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:2;padding-top:6px}\n.tabs button{flex:0 0 auto;font:inherit;font-size:14px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:4px 14px;cursor:pointer}\n.tabs button[aria-selected="true"]{background:var(--accent-bg);border-color:var(--accent);color:var(--accent);font-weight:700}\n.tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;min-width:0;display:flex;flex-direction:column;gap:12px}\n.ans{border-left:4px solid var(--accent);padding:8px 14px;font-weight:700;max-width:95ch}\n.read{font-size:14px;color:var(--sub);max-width:100ch}\n.fig,.tw{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-size:13.5px} th,td{border-bottom:1px solid var(--line);padding:7px 8px;text-align:left;vertical-align:top} th{font-size:12px;color:var(--sub);font-weight:500;white-space:nowrap}\ndetails{border-top:1px solid var(--line);padding-top:8px} summary{cursor:pointer;color:var(--accent);font-size:14px} details[open] summary{margin-bottom:8px}\n.lead{font-size:16px;font-weight:700}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:8px}\n.card{background:var(--accent-bg);border-radius:8px;padding:8px 12px;display:flex;flex-direction:column;gap:2px;min-width:0} .card b{color:var(--accent);font-size:14px} .card span{font-size:13px}\n.chips{display:flex;flex-wrap:wrap;gap:6px} .chips span{background:var(--code);border:1px solid var(--line);border-radius:999px;padding:2px 12px;font-size:13px}\nol.steps,ul.steps{margin:0;padding-left:1.4em;font-size:14px}\n.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}@media (max-width:760px){.two{grid-template-columns:1fr}}\n.box{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;min-width:0}.box b{color:var(--accent)}\n.link{font-size:14px} .link a{color:var(--accent)}\n</style>\n<main>\n<h1>抽象概念の土台</h1>\n<nav class="tabs" role="tablist" aria-label="内容"><button type="button" role="tab" id="t-overview" aria-controls="p-overview" aria-selected="true">全体像</button><button type="button" role="tab" id="t-layers" aria-controls="p-layers" aria-selected="false">3つの層</button><button type="button" role="tab" id="t-first" aria-controls="p-first" aria-selected="false">意味の境界を先に</button><button type="button" role="tab" id="t-patterns" aria-controls="p-patterns" aria-selected="false">パターン</button><button type="button" role="tab" id="t-boundaries" aria-controls="p-boundaries" aria-selected="false">13の境界</button><button type="button" role="tab" id="t-usecases" aria-controls="p-usecases" aria-selected="false">ユースケース</button><button type="button" role="tab" id="t-contexts" aria-controls="p-contexts" aria-selected="false">文脈</button><button type="button" role="tab" id="t-hexagonal" aria-controls="p-hexagonal" aria-selected="false">ヘキサゴナル</button><button type="button" role="tab" id="t-layout" aria-controls="p-layout" aria-selected="false">ディレクトリ</button><button type="button" role="tab" id="t-growing" aria-controls="p-growing" aria-selected="false">育てている所</button></nav>\n<section role="tabpanel" id="p-overview" aria-labelledby="t-overview"><h2>全体像</h2><p class="lead">事業を設計 ・ 実装するための抽象概念。基盤自身にも、基盤で作るものにも使う。3つの層を分けて持ち、どの形を選んでも13の境界を守る。</p><div class="fig">{{FIG:layers}}</div><div class="cards"><div class="card"><b>層1 業務領域</b><span>事業領域を分解して見つける。線は「分解」</span></div><div class="card"><b>層2 目的レベル</b><span>ユースケースの高さ。線は「呼び出し」</span></div><div class="card"><b>層3 区切られた文脈</b><span>意味の境界として設計する。線は「連係」</span></div></div><p class="read">目的は、あとから「この文脈で分けたのは間違いだった」と作り直さないこと。そのために、意味の境界を先に広く引き、中身はユースケースから後で育てる。</p><p class="link">Semantic Agent Schema に適用した結果（業務領域 ・ 文脈 ・ ドメインモデル ・ ER ・ スキーマ構成 ・ ディレクトリ）は <a href="../design/index.html">docs/design/</a> にまとめる。この頁はどの事業にも使う概念だけを持つ。</p></section><section role="tabpanel" id="p-layers" aria-labelledby="t-layers" hidden><h2>3つの層</h2><p class="lead">業務領域は見つけるもの、文脈は設計するもの。対応は設計判断で、中に入る関係でも1対1でもない。</p><div class="two"><div class="box"><b>事業領域 → 業務領域（問題の側）</b><span>作るプロダクト全体が事業領域。それを事業活動の単位に分解して、業務領域を見つける。区分（中核 ・ 補完 ・ 一般）は業務領域の属性で、変わりうる</span></div><div class="box"><b>区切られた文脈（解決の側）</b><span>1つのモデルと言葉が同じ意味で通じる範囲を、設計で引く。業務領域を単位に引き、1つの文脈が複数の業務領域を受け持ってもよい。事業領域そのものを1つの文脈とみなさない</span></div></div><div class="fig">{{FIG:problem-solution}}</div><div class="cards"><div class="card"><b>下へ：どのように？</b><span>目的を手順へ分ける</span></div><div class="card"><b>上へ：なぜ？</b><span>手順をまとめて1つ上の目的へ</span></div><div class="card"><b>外へ：設計の範囲</b><span>一番外側に要約を書く（別の軸）</span></div></div><details><summary>詳しい表</summary><div class="tw"><table><thead><tr><th>層</th><th>何を表すか</th><th>線の意味</th><th>決め方</th></tr></thead><tbody><tr><td>層1\u3000業務領域</td><td>事業活動を細かく分けたもの。何をするかを表す。見つける（問題の側）</td><td>分解：事業活動を細かく分ける</td><td>ユースケースの3条件（同じアクター ・ 同じ外部システム ・ 密接なデータ）でまとまるまで分ける。補完 ・ 一般は分けても区分が変わらなければ止め、中核はできる限り正確に区切る</td></tr><tr><td>層2\u3000目的レベル</td><td>主体の目的の高さ。要約 ・ ユーザー目的 ・ サブ機能</td><td>呼び出し：なぜ？で上、どのように？で下</td><td>目的レベルと設計の範囲は別の軸として持つ</td></tr><tr><td>層3\u3000区切られた文脈</td><td>1つのモデルと言葉が通じる範囲。設計する（解決の側）</td><td>連係：上流 ・ 下流と、その方法</td><td>言葉の一貫と、同じデータを扱うユースケースの集まりで線を引く</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-first" aria-labelledby="t-first" hidden><h2>意味の境界を先に、中身はあとで</h2><p class="lead">区切られた文脈（意味の境界）と公開する契約は、部品を探す前に先に引く。中身（集約 ・ 値 ・ 共通のルール）は、ユースケースと実際の重複から後で育てる。</p><div class="two"><div class="box"><b>先に引く：意味の境界と公開する契約</b><span>あとで変えると、パッケージの分割 ・ データの分離 ・ 依存の付け替え ・ 相手との取り決めが必要になり、高くつく</span><span>ただし広く引く。業務知識が乏しいほど広くし、知識が増えてから小さな文脈を切り出す</span><span>「広く」は「事業全体で1つ」ではない。範囲は、用語集で同じ語が同じ意味で通じるかで決める</span></div><div class="box"><b>後で育てる：集約 ・ 値 ・ 共通のルール</b><span>初めに描いた中身は外れやすい。ユースケースを書き、実際に重複したルールを見てから引き上げる</span><span>引き上げるかは「同じ理由で一緒に変わるか」で決める。見た目が同じでも変わる理由が違えば、まとめない</span></div></div><h3>意味の境界が無いと起きること</h3><p class="read">同じ語が2つの意味で使われていると、その2つが1つの部品に混ざる。たとえば「記録」という語が、ある所では「1件ごとに置き換える値」、別の所では「消さずに積み上げる出来事」を指すとき、境界を引く前に部品を探すと、その記録を値オブジェクトにするか業務イベントにするかが決まらない。先に、語の意味が1つに通じる範囲を引いてから、その中で部品を探す。</p><details><summary>出どころ</summary><div class="tw"><table><thead><tr><th>何を支えるか</th><th>もとにしたこと</th><th>出どころ</th></tr></thead><tbody><tr><td>広く引き、後で切り出す</td><td>業務知識が乏しいほど初期境界を広くし、十分な知識を得てから段階的に小さなコンテキストやサービスを抽出する</td><td>『ドメイン駆動設計をはじめよう』第11章</td></tr><tr><td>境界は先、中身は後</td><td>境界はトップダウンで先に広く、中身はボトムアップで後から。引き上げは同じ理由で一緒に変わるかで判断する</td><td>2026-10-29 の利用者との合意</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-patterns" aria-labelledby="t-patterns" hidden><h2>パターン</h2><p class="lead">層ごとに選ぶ。文脈は広く引くことから始める（意味の境界を先に）。</p><div class="fig">{{FIG:patterns}}</div><details><summary>詳しい表</summary><div class="tw"><table><thead><tr><th>層</th><th>パターン</th><th>選ぶとき</th></tr></thead><tbody><tr><td>層1</td><td>細分化</td><td>事業活動を、3条件でまとまるまで分ける。中核はできる限り正確に</td></tr><tr><td>層2</td><td>要約 → ユーザー目的 → サブ機能</td><td>サブ機能は、読みやすくするときか、ほかから何度も使うときだけ書く</td></tr><tr><td>層2</td><td>なぜ？で上げる</td><td>手順をまとめて1つ上の目的にする（目的レベルの軸）</td></tr><tr><td>層2</td><td>一番外側に要約を書く</td><td>設計の範囲の軸。主体が外にいる一番外側の範囲で、いつも書くことを勧める</td></tr><tr><td>層3</td><td>広い1つの文脈（中を業務領域の論理的な境界で分ける）</td><td>業務の理解が浅い ・ 変更が多い ・ 小さいチーム。範囲は同じ語が同じ意味で通じる所までで、事業全体ではない</td></tr><tr><td>層3</td><td>部分木を文脈として切り出す（論理 → 物理）</td><td>業務知識が増えて安定し、言葉 ・ チーム ・ ライフサイクルが分かれたとき</td></tr><tr><td>層3</td><td>1つの業務領域に複数のモデル</td><td>課題ごとにモデルが違うとき。モデルごとに別の文脈に置く</td></tr><tr><td>層3</td><td>連係を選ぶ：共用サービス（公開された言葉を出す）・ モデル変換装置 ・ 従属 ・ 良きパートナー</td><td>文脈どうしをつなぐとき。どれを選んだかを明示する</td></tr><tr><td>層3</td><td>互いに独立（重複して実装する）</td><td>一般 ・ 補完の業務領域だけ。中核には使えない</td></tr><tr><td>層3</td><td>モデルの共有</td><td>例外。1つのチームが複数の文脈を持つとき、境界を明確にする手段として使う</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-boundaries" aria-labelledby="t-boundaries" hidden><h2>13の境界</h2><p class="lead">パターンは選ぶもの、境界は守るもの。どの境界も、防ぐ失敗を1つ持つ。</p><div class="fig">{{FIG:boundaries}}</div><details><summary>防ぐ失敗と出どころ</summary><div class="tw"><table><thead><tr><th>#</th><th>境界</th><th>防ぐ失敗</th><th>出どころ</th></tr></thead><tbody><tr><td>1</td><td>業務領域は事業活動に届くもので、まとまりはユースケースの3条件で決める。都合で入れない</td><td>業務領域の中身が目的と関係なく増え、あとで業務領域を分け直すことになる</td><td>ddd-advisor ・ あなたの「分解」</td></tr><tr><td>2</td><td>呼び出しの親子には「なぜ？」で届く目的だけを入れる。サブ機能は、複数から使われるか呼び出し側が読みにくくなるときに切り出し、親を1つに決めない。ユーザー目的から別のユーザー目的を呼んでもよい</td><td>どの目的のための手順かを辿れなくなり、サブ機能が乱立する</td><td>usecase-advisor</td></tr><tr><td>3</td><td>目的レベル ・ 設計の範囲 ・ 業務領域は別々の分類として持つ。区分（中核 ・ 補完 ・ 一般）でディレクトリの置き場所を決めない（区分は実装方法と連係の選び方を決める）</td><td>1つの分類から他を決めつけ、置き場所や実装を誤る。区分が変わるたびに組み替える</td><td>usecase-advisor ・ ddd-advisor</td></tr><tr><td>4</td><td>どのユースケースにもレベル欄とスコープ欄を持たせる</td><td>高さの違うユースケースを、印なしで同じ並びに置いてしまう</td><td>usecase-advisor</td></tr><tr><td>5</td><td>低すぎる目的はユースケースにせず、呼ぶ側の手順に含める</td><td>細かすぎるユースケースが増え、追跡とテストの手間が増える</td><td>usecase-advisor</td></tr><tr><td>6</td><td>ユースケースを1つずつクラスやフォルダに対応づけない</td><td>ユースケースを足すたびに、コードの構造を組み替えることになる</td><td>usecase-advisor</td></tr><tr><td>7</td><td>同じデータを扱うユースケースの集まりを、文脈の線で割らない</td><td>同じデータを扱う処理が2つの文脈に分かれ、一貫性が壊れる</td><td>ddd-advisor</td></tr><tr><td>8</td><td>1つの文脈に、競合するモデルを入れない</td><td>1つの文脈の中で言葉の意味が割れる</td><td>ddd-advisor</td></tr><tr><td>9</td><td>文脈どうしは連係方法を明示して選ぶ。中核を含む下流は従属しない</td><td>つなぎ方が暗黙になり、上流の変更で中核が壊れる</td><td>ddd-advisor</td></tr><tr><td>10</td><td>1つの文脈は1つのチームだけが持つ（AI のセッションをチームとみなすかは事業ごとに決める）</td><td>1つの文脈を複数で直し、変更がぶつかる</td><td>ddd-advisor</td></tr><tr><td>11</td><td>1つの集約を2つの文脈に分けない</td><td>1つの集約の不変条件を2か所で守ることになり、破れる</td><td>ddd-advisor</td></tr><tr><td>12</td><td>集約の状態は、集約の中の業務ロジックだけが変える。外には参照だけ</td><td>外から状態が変えられ、不変条件が守れない</td><td>ddd-advisor</td></tr><tr><td>13</td><td>1つのトランザクションで変える集約は1つ</td><td>1回の変更で複数の集約を書き、一部だけ失敗したときに整合が崩れる</td><td>ddd-advisor</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-usecases" aria-labelledby="t-usecases" hidden><h2>ユースケース</h2><p class="lead">単位はユーザー目的。コマンドはそれを呼ぶ入口で、ユースケースではない。</p><div class="fig">{{FIG:usecase-units}}</div></section><section role="tabpanel" id="p-contexts" aria-labelledby="t-contexts" hidden><h2>文脈</h2><p class="lead">型は4つ。業務知識が乏しいうちは型1から始め、言葉が分かれた所で切り出す。どの型でも、事業領域そのものを1つの文脈とみなさない。</p><div class="fig">{{FIG:context-types}}</div><details><summary>型ごとのディレクトリ</summary><div class="tw"><table><thead><tr><th>型</th><th>選ぶとき</th><th>ディレクトリ</th></tr></thead><tbody><tr><td>型1\u3000広い1つの文脈</td><td>理解が浅い ・ 変更が多い ・ 小さいチーム ・ 言葉を共有している</td><td>文脈の根の下を、業務領域の論理的な境界で分ける</td></tr><tr><td>型2\u30001対1</td><td>業務領域ごとに言葉や変わる速さが違う ・ チームが分かれている</td><td>contexts/&lt;業務領域&gt;/ がそれぞれ六角形と外へ出す言葉を持つ</td></tr><tr><td>型3\u3000まとめて分ける</td><td>言葉を共有する業務領域とそうでないものがはっきりしている</td><td>contexts/&lt;束ねた文脈&gt;/ の中に業務領域</td></tr><tr><td>型4\u30001つの業務領域を複数の文脈で扱う</td><td>課題ごとにモデルが違うとき。割らないのは、同じデータのユースケースの集まりと集約</td><td>同じ業務領域が、モデルごとに別の文脈に入る</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-hexagonal" aria-labelledby="t-hexagonal" hidden><h2>ヘキサゴナル</h2><p class="lead">コアは domain と application。ポートは、その会話を受け持つ業務領域の application が持つ。</p><div class="cards"><div class="card"><b>ユースケース</b><span>目的を果たす手順と判断（application の use_cases）</span></div><div class="card"><b>ドメイン</b><span>値を受け取り値を返す（domain）</span></div><div class="card"><b>ポート</b><span>外に依頼する1回の約束。会話の目的で決める（application の ports）</span></div><div class="card"><b>アダプター</b><span>その1回を技術で実現する（outbound）</span></div></div><div class="fig">{{FIG:hexagon}}</div><p class="read">どの業務領域がどのポートを持つかは、事業ごとに決める（Semantic Agent Schema では docs/design/）。</p></section><section role="tabpanel" id="p-layout" aria-labelledby="t-layout" hidden><h2>ディレクトリ</h2><p class="lead">1つの文脈の中の形。文脈の根の下に、業務領域ごとの domain と application、外側に inbound と outbound。</p><div class="fig">{{FIG:directories}}</div><details><summary>置き方の決まり</summary><ul class="steps"><li>文脈の根：文脈が1つならリポジトリの根、複数なら contexts/&lt;文脈&gt;/</li><li>文脈の根の下に core/&lt;業務領域&gt;/{domain, application}。domain は集約 ・ 値 ・ ドメインサービスでポートを知らない。application は use_cases と ports</li><li>ポートは、その会話を受け持つ業務領域の application に置く。共有の置き場は作らない</li><li>ユースケースは1つにつき1ファイルにしない（境界6）。目的レベルでフォルダを分けない（境界3）。区分でも分けない</li><li>外側は inbound（入口）と outbound（外の技術）。入口を足すときは inbound に足す</li></ul></details><p class="read">言語やビルドのツールに合わせた置き方（crate の分け方など）は、事業ごとの具体に書く。</p></section><section role="tabpanel" id="p-growing" aria-labelledby="t-growing" hidden><h2>育てている所</h2><p class="lead">具体に適用して分かったことを、ここへ戻して育てる。まだ決まっていない概念の問いと、決める場所。</p><div class="tw"><table><thead><tr><th>問い</th><th>いまの見立て</th><th>決める場所</th></tr></thead><tbody><tr><td>見つけたもののインスタンスは何種類か</td><td>業務領域 ・ 区切られた文脈 ・ 集約 ・ 値オブジェクト ・ 業務サービスの5種類</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>コマンドと業務イベントをどこに持つか</td><td>集約の中に持つ</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>外部システムとの連係をどこに持つか</td><td>部品ではなく、文脈と文脈の関係として持つ（境界9 に1文を足す候補）</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>同じ語が同じ意味かを、どう確かめるか</td><td>用語集で語ごとに意味を書き、意味が分かれる所を境界の候補にする</td><td>ガイドの Q3（業務領域と区切られた文脈）</td></tr><tr><td>この土台とガイドの分け方</td><td>概念はこの土台、手順はガイド、適用した結果は docs/design/</td><td>ガイドの Q8（土台とガイドの分け方と往復）</td></tr></tbody></table></div><p class="link">ガイドのボード：<a href="https://claude.ai/artifact/746VYbbvem7DwcRK5yYgzK">ユースケースからドメインモデリングへ</a></p></section>\n</main>\n<script>\n(function(){\n  var bs=[].slice.call(document.querySelectorAll(\'.tabs button\'));\n  function show(k){bs.forEach(function(b){var on=b.id===\'t-\'+k;b.setAttribute(\'aria-selected\',on?\'true\':\'false\');document.getElementById(b.getAttribute(\'aria-controls\')).hidden=!on;});\n    try{localStorage.setItem(\'tab\',k)}catch(e){}}\n  bs.forEach(function(b){b.addEventListener(\'click\',function(){show(b.id.slice(2));window.scrollTo({top:0})})});\n  var h=(location.hash||\'\').slice(1); var s=null; try{s=localStorage.getItem(\'tab\')}catch(e){}\n  var k=document.getElementById(\'t-\'+h)?h:(s&&document.getElementById(\'t-\'+s)?s:null); if(k) show(k);\n})();\n</script>\n'
+TEMPLATE = '<title>抽象概念の土台</title>\n<meta name="claude:viewport-fit-sides" content="cover">\n<style>\n/* タブで層 ・ 意味の境界 ・ パターン ・ 境界 ・ 単位 ・ 文脈 ・ 六角形 ・ 置き場所 ・ 育てている所を切り替える */\n:root{--bg:#eef2f0;--card:#fff;--ink:#111d1a;--sub:#5b6b66;--line:#d3dcd8;--accent:#0d5c55;--accent-bg:#d5e6e3;--code:#f3f6f4;--f:"Noto Sans JP","Hiragino Kaku Gothic ProN",system-ui,sans-serif}\n@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#111614;--card:#192120;--ink:#e3ebe8;--sub:#9aaba5;--line:#2f3b37;--accent:#7cc4b7;--accent-bg:#1e3330;--code:#151c1a;color-scheme:dark}}\n:root[data-theme="dark"]{--bg:#111614;--card:#192120;--ink:#e3ebe8;--sub:#9aaba5;--line:#2f3b37;--accent:#7cc4b7;--accent-bg:#1e3330;--code:#151c1a;color-scheme:dark}\n[hidden]{display:none!important}\nbody{background:var(--bg);color:var(--ink);font:15px/1.75 var(--f);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 56px}\nmain{max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:14px}\nh1{font-size:24px;margin:0} h2{font-size:18px;margin:0;color:var(--accent)} h3{font-size:15px;margin:8px 0 0} p{margin:0}\n.tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:2;padding-top:6px}\n.tabs button{flex:0 0 auto;font:inherit;font-size:14px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:4px 14px;cursor:pointer}\n.tabs button[aria-selected="true"]{background:var(--accent-bg);border-color:var(--accent);color:var(--accent);font-weight:700}\n.tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}\nsection{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;min-width:0;display:flex;flex-direction:column;gap:12px}\n.ans{border-left:4px solid var(--accent);padding:8px 14px;font-weight:700;max-width:95ch}\n.read{font-size:14px;color:var(--sub);max-width:100ch}\n.fig,.tw{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;font-size:13.5px} th,td{border-bottom:1px solid var(--line);padding:7px 8px;text-align:left;vertical-align:top} th{font-size:12px;color:var(--sub);font-weight:500;white-space:nowrap}\ndetails{border-top:1px solid var(--line);padding-top:8px} summary{cursor:pointer;color:var(--accent);font-size:14px} details[open] summary{margin-bottom:8px}\n.lead{font-size:16px;font-weight:700}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:8px}\n.card{background:var(--accent-bg);border-radius:8px;padding:8px 12px;display:flex;flex-direction:column;gap:2px;min-width:0} .card b{color:var(--accent);font-size:14px} .card span{font-size:13px}\n.chips{display:flex;flex-wrap:wrap;gap:6px} .chips span{background:var(--code);border:1px solid var(--line);border-radius:999px;padding:2px 12px;font-size:13px}\nol.steps,ul.steps{margin:0;padding-left:1.4em;font-size:14px}\n.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}@media (max-width:760px){.two{grid-template-columns:1fr}}\n.box{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;min-width:0}.box b{color:var(--accent)}\n.link{font-size:14px} .link a{color:var(--accent)}\n</style>\n<main>\n<h1>抽象概念の土台</h1>\n<nav class="tabs" role="tablist" aria-label="内容"><button type="button" role="tab" id="t-overview" aria-controls="p-overview" aria-selected="true">全体像</button><button type="button" role="tab" id="t-layers" aria-controls="p-layers" aria-selected="false">3つの層</button><button type="button" role="tab" id="t-first" aria-controls="p-first" aria-selected="false">意味の境界を先に</button><button type="button" role="tab" id="t-patterns" aria-controls="p-patterns" aria-selected="false">パターン</button><button type="button" role="tab" id="t-boundaries" aria-controls="p-boundaries" aria-selected="false">13の境界</button><button type="button" role="tab" id="t-usecases" aria-controls="p-usecases" aria-selected="false">ユースケース</button><button type="button" role="tab" id="t-contexts" aria-controls="p-contexts" aria-selected="false">文脈</button><button type="button" role="tab" id="t-hexagonal" aria-controls="p-hexagonal" aria-selected="false">ヘキサゴナル</button><button type="button" role="tab" id="t-layout" aria-controls="p-layout" aria-selected="false">ディレクトリ</button><button type="button" role="tab" id="t-growing" aria-controls="p-growing" aria-selected="false">育てている所</button></nav>\n<section role="tabpanel" id="p-overview" aria-labelledby="t-overview"><h2>全体像</h2><p class="lead">事業を設計 ・ 実装するための抽象概念。基盤自身にも、基盤で作るものにも使う。3つの層を分けて持ち、どの形を選んでも13の境界を守る。</p><div class="fig">{{FIG:layers}}</div><div class="cards"><div class="card"><b>層1 業務領域</b><span>事業領域を分解して見つける。線は「分解」</span></div><div class="card"><b>層2 目的レベル</b><span>ユースケースの高さ。線は「呼び出し」</span></div><div class="card"><b>層3 区切られた文脈</b><span>意味の境界として設計する。線は「連係」</span></div></div><p class="read">目的は、あとから「この文脈で分けたのは間違いだった」と作り直さないこと。そのために、意味の境界を先に広く引き、中身はユースケースから後で育てる。</p><p class="link">Semantic Agent Schema に適用した結果（業務領域 ・ 文脈 ・ ドメインモデル ・ ER ・ スキーマ構成 ・ ディレクトリ）は <a href="../design/index.html">docs/design/</a> にまとめる。この頁はどの事業にも使う概念だけを持つ。</p></section><section role="tabpanel" id="p-layers" aria-labelledby="t-layers" hidden><h2>3つの層</h2><p class="lead">業務領域は見つけるもの、文脈は設計するもの。対応は設計判断で、中に入る関係でも1対1でもない。</p><div class="two"><div class="box"><b>事業領域 → 業務領域（問題の側）</b><span>作るプロダクト全体が事業領域。それを事業活動の単位に分解して、業務領域を見つける。区分（中核 ・ 補完 ・ 一般）は業務領域の属性で、変わりうる</span></div><div class="box"><b>区切られた文脈（解決の側）</b><span>1つのモデルと言葉が同じ意味で通じる範囲を、設計で引く。業務領域を手がかりに引く。1つの文脈が複数の業務領域を受け持つことも、1つの業務領域を複数の文脈で扱うこともある。事業領域そのものを1つの文脈とみなさない</span></div></div><div class="fig">{{FIG:problem-solution}}</div><div class="cards"><div class="card"><b>下へ：どのように？</b><span>目的を手順へ分ける</span></div><div class="card"><b>上へ：なぜ？</b><span>手順をまとめて1つ上の目的へ</span></div><div class="card"><b>外へ：設計の範囲</b><span>一番外側に要約を書く（別の軸）</span></div></div><details><summary>詳しい表</summary><div class="tw"><table><thead><tr><th>層</th><th>何を表すか</th><th>線の意味</th><th>決め方</th></tr></thead><tbody><tr><td>層1\u3000業務領域</td><td>事業活動を細かく分けたもの。何をするかを表す。見つける（問題の側）</td><td>分解：事業活動を細かく分ける</td><td>ユースケースの3条件（同じアクター ・ 同じ外部システム ・ 密接なデータ）でまとまるまで分ける。補完 ・ 一般は分けても区分が変わらなければ止め、中核はできる限り正確に区切る</td></tr><tr><td>層2\u3000目的レベル</td><td>主体の目的の高さ。要約 ・ ユーザー目的 ・ サブ機能</td><td>呼び出し：なぜ？で上、どのように？で下</td><td>目的レベルと設計の範囲は別の軸として持つ</td></tr><tr><td>層3\u3000区切られた文脈</td><td>1つのモデルと言葉が通じる範囲。設計する（解決の側）</td><td>連係：上流 ・ 下流と、その方法</td><td>言葉の一貫と、同じデータを扱うユースケースの集まりで線を引く</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-first" aria-labelledby="t-first" hidden><h2>意味の境界を先に、中身はあとで</h2><p class="lead">区切られた文脈（意味の境界）と公開する契約は、部品を探す前に先に引く。中身（集約 ・ 値 ・ 共通のルール）は、ユースケースと実際の重複から後で育てる。</p><div class="two"><div class="box"><b>先に引く：意味の境界と公開する契約</b><span>あとで変えると、パッケージの分割 ・ データの分離 ・ 依存の付け替え ・ 相手との取り決めが必要になり、高くつく</span><span>ただし広く引く。業務知識が乏しいほど広くし、知識が増えてから小さな文脈を切り出す</span><span>「広く」は「事業全体で1つ」ではない。範囲は、用語集で同じ語が同じ意味で通じるかで決める</span></div><div class="box"><b>後で育てる：集約 ・ 値 ・ 共通のルール</b><span>初めに描いた中身は外れやすい。ユースケースを書き、実際に重複したルールを見てから引き上げる</span><span>引き上げるかは「同じ理由で一緒に変わるか」で決める。見た目が同じでも変わる理由が違えば、まとめない</span></div></div><h3>意味の境界が無いと起きること</h3><p class="read">同じ語が2つの意味で使われていると、その2つが1つの部品に混ざる。たとえば「記録」という語が、ある所では「1件ごとに置き換える値」、別の所では「消さずに積み上げる出来事」を指すとき、境界を引く前に部品を探すと、その記録を値オブジェクトにするか業務イベントにするかが決まらない。先に、語の意味が1つに通じる範囲を引いてから、その中で部品を探す。</p><details><summary>出どころ</summary><div class="tw"><table><thead><tr><th>何を支えるか</th><th>もとにしたこと</th><th>出どころ</th></tr></thead><tbody><tr><td>広く引き、後で切り出す</td><td>業務知識が乏しいほど初期境界を広くし、十分な知識を得てから段階的に小さなコンテキストやサービスを抽出する</td><td>『ドメイン駆動設計をはじめよう』第11章</td></tr><tr><td>境界は先、中身は後</td><td>境界はトップダウンで先に広く、中身はボトムアップで後から。引き上げは同じ理由で一緒に変わるかで判断する</td><td>2026-10-29 の利用者との合意</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-patterns" aria-labelledby="t-patterns" hidden><h2>パターン</h2><p class="lead">層ごとに選ぶ。文脈は広く引くことから始める（意味の境界を先に）。</p><div class="fig">{{FIG:patterns}}</div><details><summary>詳しい表</summary><div class="tw"><table><thead><tr><th>層</th><th>パターン</th><th>選ぶとき</th></tr></thead><tbody><tr><td>層1</td><td>細分化</td><td>事業活動を、3条件でまとまるまで分ける。中核はできる限り正確に</td></tr><tr><td>層2</td><td>要約 → ユーザー目的 → サブ機能</td><td>サブ機能は、読みやすくするときか、ほかから何度も使うときだけ書く</td></tr><tr><td>層2</td><td>なぜ？で上げる</td><td>手順をまとめて1つ上の目的にする（目的レベルの軸）</td></tr><tr><td>層2</td><td>一番外側に要約を書く</td><td>設計の範囲の軸。主体が外にいる一番外側の範囲で、いつも書くことを勧める</td></tr><tr><td>層3</td><td>広い1つの文脈（中を業務領域の論理的な境界で分ける）</td><td>業務の理解が浅い ・ 変更が多い ・ 小さいチーム。範囲は同じ語が同じ意味で通じる所までで、事業全体ではない</td></tr><tr><td>層3</td><td>部分木を文脈として切り出す（論理 → 物理）</td><td>業務知識が増えて安定し、言葉 ・ チーム ・ ライフサイクルが分かれたとき</td></tr><tr><td>層3</td><td>1つの業務領域に複数のモデル</td><td>課題ごとにモデルが違うとき。モデルごとに別の文脈に置く</td></tr><tr><td>層3</td><td>連係を選ぶ：共用サービス（公開された言葉を出す）・ モデル変換装置 ・ 従属 ・ 良きパートナー</td><td>文脈どうしをつなぐとき。どれを選んだかを明示する</td></tr><tr><td>層3</td><td>互いに独立（重複して実装する）</td><td>一般 ・ 補完の業務領域だけ。中核には使えない</td></tr><tr><td>層3</td><td>モデルの共有</td><td>例外。1つのチームが複数の文脈を持つとき、境界を明確にする手段として使う</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-boundaries" aria-labelledby="t-boundaries" hidden><h2>13の境界</h2><p class="lead">パターンは選ぶもの、境界は守るもの。どの境界も、防ぐ失敗を1つ持つ。</p><div class="fig">{{FIG:boundaries}}</div><details><summary>防ぐ失敗と出どころ</summary><div class="tw"><table><thead><tr><th>#</th><th>境界</th><th>防ぐ失敗</th><th>出どころ</th></tr></thead><tbody><tr><td>1</td><td>業務領域は事業活動に届くもので、まとまりはユースケースの3条件で決める。都合で入れない</td><td>業務領域の中身が目的と関係なく増え、あとで業務領域を分け直すことになる</td><td>ddd-advisor ・ あなたの「分解」</td></tr><tr><td>2</td><td>呼び出しの親子には「なぜ？」で届く目的だけを入れる。サブ機能は、複数から使われるか呼び出し側が読みにくくなるときに切り出し、親を1つに決めない。ユーザー目的から別のユーザー目的を呼んでもよい</td><td>どの目的のための手順かを辿れなくなり、サブ機能が乱立する</td><td>usecase-advisor</td></tr><tr><td>3</td><td>目的レベル ・ 設計の範囲 ・ 業務領域は別々の分類として持つ。区分（中核 ・ 補完 ・ 一般）でディレクトリの置き場所を決めない（区分は実装方法と連係の選び方を決める）</td><td>1つの分類から他を決めつけ、置き場所や実装を誤る。区分が変わるたびに組み替える</td><td>usecase-advisor ・ ddd-advisor</td></tr><tr><td>4</td><td>どのユースケースにもレベル欄とスコープ欄を持たせる</td><td>高さの違うユースケースを、印なしで同じ並びに置いてしまう</td><td>usecase-advisor</td></tr><tr><td>5</td><td>低すぎる目的はユースケースにせず、呼ぶ側の手順に含める</td><td>細かすぎるユースケースが増え、追跡とテストの手間が増える</td><td>usecase-advisor</td></tr><tr><td>6</td><td>ユースケースを1つずつクラスやフォルダに対応づけない</td><td>ユースケースを足すたびに、コードの構造を組み替えることになる</td><td>usecase-advisor</td></tr><tr><td>7</td><td>同じデータを扱うユースケースの集まりを、文脈の線で割らない</td><td>同じデータを扱う処理が2つの文脈に分かれ、一貫性が壊れる</td><td>ddd-advisor</td></tr><tr><td>8</td><td>1つの文脈に、競合するモデルを入れない</td><td>1つの文脈の中で言葉の意味が割れる</td><td>ddd-advisor</td></tr><tr><td>9</td><td>文脈どうしは連係方法を明示して選ぶ。中核を含む下流は従属しない</td><td>つなぎ方が暗黙になり、上流の変更で中核が壊れる</td><td>ddd-advisor</td></tr><tr><td>10</td><td>1つの文脈は1つのチームだけが持つ（AI のセッションをチームとみなすかは事業ごとに決める）</td><td>1つの文脈を複数で直し、変更がぶつかる</td><td>ddd-advisor</td></tr><tr><td>11</td><td>1つの集約を2つの文脈に分けない</td><td>1つの集約の不変条件を2か所で守ることになり、破れる</td><td>ddd-advisor</td></tr><tr><td>12</td><td>集約の状態は、集約の中の業務ロジックだけが変える。外には参照だけ</td><td>外から状態が変えられ、不変条件が守れない</td><td>ddd-advisor</td></tr><tr><td>13</td><td>1つのトランザクションで変える集約は1つ</td><td>1回の変更で複数の集約を書き、一部だけ失敗したときに整合が崩れる</td><td>ddd-advisor</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-usecases" aria-labelledby="t-usecases" hidden><h2>ユースケース</h2><p class="lead">単位はユーザー目的。コマンドはそれを呼ぶ入口で、ユースケースではない。</p><div class="fig">{{FIG:usecase-units}}</div></section><section role="tabpanel" id="p-contexts" aria-labelledby="t-contexts" hidden><h2>文脈</h2><p class="lead">型は4つ。業務知識が乏しいうちは型1から始め、言葉が分かれた所で切り出す。どの型でも、事業領域そのものを1つの文脈とみなさない。</p><div class="fig">{{FIG:context-types}}</div><details><summary>型ごとのディレクトリ</summary><div class="tw"><table><thead><tr><th>型</th><th>選ぶとき</th><th>ディレクトリ</th></tr></thead><tbody><tr><td>型1\u3000広い1つの文脈</td><td>理解が浅い ・ 変更が多い ・ 小さいチーム ・ 言葉を共有している</td><td>文脈の根の下を、業務領域の論理的な境界で分ける</td></tr><tr><td>型2\u30001対1</td><td>業務領域ごとに言葉や変わる速さが違う ・ チームが分かれている</td><td>contexts/&lt;業務領域&gt;/ がそれぞれ六角形と外へ出す言葉を持つ</td></tr><tr><td>型3\u3000まとめて分ける</td><td>言葉を共有する業務領域とそうでないものがはっきりしている</td><td>contexts/&lt;束ねた文脈&gt;/ の中に業務領域</td></tr><tr><td>型4\u30001つの業務領域を複数の文脈で扱う</td><td>課題ごとにモデルが違うとき。割らないのは、同じデータのユースケースの集まりと集約</td><td>同じ業務領域が、モデルごとに別の文脈に入る</td></tr></tbody></table></div></details></section><section role="tabpanel" id="p-hexagonal" aria-labelledby="t-hexagonal" hidden><h2>ヘキサゴナル</h2><p class="lead">コアは domain と application。ポートは、それを使うユースケースを持つモジュールの application に置く。</p><div class="cards"><div class="card"><b>ユースケース</b><span>目的を果たす手順と判断（application の use_cases）</span></div><div class="card"><b>ドメイン</b><span>値を受け取り値を返す（domain）</span></div><div class="card"><b>ポート</b><span>外に依頼する1回の約束。会話の目的で決める（application の ports）</span></div><div class="card"><b>アダプター</b><span>その1回を技術で実現する（outbound）</span></div></div><div class="fig">{{FIG:hexagon}}</div><p class="read">どのモジュールがどのポートを持つかは、事業ごとに決める（Semantic Agent Schema では docs/design/）。業務領域は事業として何をするかで決まり、外の仕組みとの会話のような技術の役割では決めない。</p></section><section role="tabpanel" id="p-layout" aria-labelledby="t-layout" hidden><h2>ディレクトリ</h2><p class="lead">文脈の中のモジュール：この文脈が受け持つ業務領域（の部分）ごとに分け、外側は adapters/ にまとめる。</p><div class="fig">{{FIG:directories}}</div><details><summary>置き方の決まり</summary><ul class="steps"><li>文脈の根：文脈が1つならリポジトリの根、複数なら contexts/&lt;文脈&gt;/</li><li>文脈の根の下に &lt;業務領域&gt;/ のモジュールと adapters/{inbound, outbound}/ を置く。core/ という名前は区分の「中核」と紛れるので使わない</li><li>モジュールは業務領域そのものではなく、この文脈が受け持つ部分。同じ業務領域の名前が、別の文脈に別のモデルで現れることがある（型4）</li><li>中の形は実装の方法で選ぶ。ドメインモデルなら domain（集約 ・ 値 ・ ドメインサービス。ポートを知らない）と application（use_cases と ports）、トランザクションスクリプトとアクティブレコードなら application とデータアクセス。区分では決めない</li><li>ポートは六角形の内側に置く。この土台では、それを使うユースケースを持つモジュールの application に置く。判断基準は「業務ロジック層が定義する」と書くが、依頼する約束を手順（use_cases）の近くに置くために application にする。共有の置き場は作らない</li><li>ユースケースは1つにつき1ファイルにしない（境界6）。目的レベルでフォルダを分けない（境界3）。区分でも分けない</li><li>外側は adapters/ の inbound（入口）と outbound（ポートの実装と外の仕組みへのアダプター。従属か変換かを明示する）。文脈ごとに1組。入口を足すときは inbound に足す</li></ul></details><p class="read">言語やビルドのツールに合わせた置き方（crate の分け方など）は、事業ごとの具体に書く。</p></section><section role="tabpanel" id="p-growing" aria-labelledby="t-growing" hidden><h2>育てている所</h2><p class="lead">具体に適用して分かったことを、ここへ戻して育てる。まだ決まっていない概念の問いと、決める場所。</p><div class="tw"><table><thead><tr><th>問い</th><th>いまの見立て</th><th>決める場所</th></tr></thead><tbody><tr><td>見つけたもののインスタンスは何種類か</td><td>業務領域 ・ 区切られた文脈 ・ 集約 ・ 値オブジェクト ・ 業務サービスの5種類</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>コマンドと業務イベントをどこに持つか</td><td>集約の中に持つ</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>外部システムとの連係をどこに持つか</td><td>部品ではなく、文脈と文脈の関係として持つ（境界9 に1文を足す候補）</td><td>ガイドの Q4（見つかるものから部品へ）</td></tr><tr><td>同じ語が同じ意味かを、どう確かめるか</td><td>用語集で語ごとに意味を書き、意味が分かれる所を境界の候補にする</td><td>ガイドの Q3（業務領域と区切られた文脈）</td></tr><tr><td>この土台とガイドの分け方</td><td>概念はこの土台、手順はガイド、適用した結果は docs/design/</td><td>ガイドの Q8（土台とガイドの分け方と往復）</td></tr></tbody></table></div><p class="link">ガイドのボード：<a href="https://claude.ai/artifact/746VYbbvem7DwcRK5yYgzK">ユースケースからドメインモデリングへ</a></p></section>\n</main>\n<script>\n(function(){\n  var bs=[].slice.call(document.querySelectorAll(\'.tabs button\'));\n  function show(k){bs.forEach(function(b){var on=b.id===\'t-\'+k;b.setAttribute(\'aria-selected\',on?\'true\':\'false\');document.getElementById(b.getAttribute(\'aria-controls\')).hidden=!on;});\n    try{localStorage.setItem(\'tab\',k)}catch(e){}}\n  bs.forEach(function(b){b.addEventListener(\'click\',function(){show(b.id.slice(2));window.scrollTo({top:0})})});\n  var h=(location.hash||\'\').slice(1); var s=null; try{s=localStorage.getItem(\'tab\')}catch(e){}\n  var k=document.getElementById(\'t-\'+h)?h:(s&&document.getElementById(\'t-\'+s)?s:null); if(k) show(k);\n})();\n</script>\n'
 
 def fig(m):
     return open(os.path.join(H, m.group(1) + '.svg')).read()
