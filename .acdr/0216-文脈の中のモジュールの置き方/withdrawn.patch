66" stroke-width="1.5" marker-end="url(#dsvg-7585eca0-arrow-5B6B66)"/><path class="flow" d="M630,332 V368" fill="none" stroke="#5B6B66" stroke-width="1.5" marker-end="url(#dsvg-7585eca0-arrow-5B6B66)"/></svg></div></section><section role="tabpanel" id="p-schemas" aria-labelledby="t-schemas" hidden><h2>スキーマの構成</h2><p class="where"><span class="st wait">案</span><span>どこで決めるか：<a href="https://claude.ai/artifact/MmnqRQksebjiHYS3Cikubc" target="_blank" rel="noopener">基盤が用意するスキーマ</a> の承認。そのあと ACDR で schemas/v1 とコードへ</span></p><p class="read">公開する契約は「任せる先の入出力」「コミットするファイル」「CLI の出力」「Concrete を書く型」の4種類だけにする。schemas/v1 は8つから7つにする。</p><div class="tw"><table><thead><tr><th>いまの schemas/v1（実物）</th><th>案での扱い</th></tr></thead><tbody><tr><td><code>call.schema.json</code></td><td>消す（渡す形は本体の input-judging ・ input-working へ）</td></tr><tr><td><code>change-summary.schema.json</code></td><td>コミットするファイル（range など4つをここへ）</td></tr><tr><td><code>change.schema.json</code></td><td>CLI の出力（record ・ history が出す変更の記録の形と定め直す）</td></tr><tr><td><code>dialect.schema.json</code></td><td>Concrete を書く型（検査のため）</td></tr><tr><td><code>glossary.schema.json</code></td><td>コミットするファイル</td></tr><tr><td><code>judgment.schema.json</code></td><td>コミットするファイル（意図の判定の枝を外す）</td></tr><tr><td><code>semantic-abstract-schema.json</code></td><td>Concrete を書く型 ・ 任せる先の入出力（input-judging ・ input-working を足す）</td></tr><tr><td><code>vocab-meta.schema.json</code></td><td>Concrete を書く型（検査のため）</td></tr></tbody></table></div><div class="fig"><svg viewBox="0 0 980 608" width="100%" style="min-width:800px;max-width:980px;display:block;margin:0 auto" role="img" aria-label="schemas/v1 のいまと案の対比" class="dsvg"><style data-dsvg="dark">.dsvg .canvas{fill:var(--dsvg-area-fill,#FFFFFF)}.dsvg .area{fill:var(--dsvg-area-fill,#FFFFFF);stroke:var(--dsvg-line,#7C8C86)}.dsvg .title{fill:var(--dsvg-ink,#111D1A);font-size:13px;font-weight:700}.dsvg .box.focus{fill:var(--dsvg-accent-bg,#D5E6E3);stroke:var(--dsvg-accent,#0D5C55)}.dsvg .label.focus{fill:var(