{
  "$schema": "../.claude/skills/no-more-spaghetti/references/rules.schema.json",
  "order": [
    "skills",
    "board",
    "docs"
  ],
  "layers": {
    "skills": ".claude/skills",
    "board": ".brainstorming-board",
    "docs": "docs"
  },
  "rules": [
    {
      "rule": "配線表が、形の契約を満たす",
      "source": {
        "record": "skill-router/references/skill-wiring.schema.json"
      },
      "scope": "この配線表が、そのスキーマへ適合すること",
      "check": {
        "tool": [
          "python3",
          "-m",
          "jsonschema",
          "-i",
          "skill-wiring.json",
          ".claude/skills/skill-router/references/skill-wiring.schema.json"
        ]
      }
    },
    {
      "rule": "ブレストボードの入力が、契約を満たす",
      "source": {
        "record": "brainstorming-board/SKILL.md"
      },
      "scope": "no-more-spaghetti のブレストボードに限る",
      "check": {
        "tool": [
          "python3",
          ".claude/skills/brainstorming-board/scripts/cli.py",
          "validate",
          ".brainstorming-board/no-more-spaghetti"
        ]
      }
    },
    {
      "rule": "ブレストボードの生成が冪等である",
      "source": {
        "record": "brainstorming-board/SKILL.md"
      },
      "scope": "no-more-spaghetti のブレストボードに限る",
      "check": {
        "tool": [
          "python3",
          ".claude/skills/brainstorming-board/scripts/cli.py",
          "render",
          ".brainstorming-board/no-more-spaghetti",
          "--check",
          "1"
        ]
      }
    },
    {
      "rule": "すべての実装が、構文として妥当である",
      "source": {
        "meta": "Python 3.14 documentation, compileall",
        "quote": "Return a true value if all the files compiled successfully, and a false value otherwise.",
        "fetched": {
          "url": "https://docs.python.org/3/library/compileall.html",
          "date": "2026-09-24",
          "sha256": "4d63a78c7de74a90fb96ec2555eb9f049a1614cceb5ef6e7e081c0a8eee35f62",
          "line": 398
        }
      },
      "scope": "構文の検査のみ ── 実行時の誤りは対象にしない",
      "check": {
        "tool": [
          "python3",
          "-m",
          "compileall",
          "-q",
          "-x",
          "(__pycache__|/trial/)",
          ".claude/skills"
        ]
      }
    }
  ]
}
