{
  "$schema": "../../.claude/skills/coding-skills/references/rules.schema.json",
  "order": [
    "lib",
    "declaration",
    "entry"
  ],
  "layers": {
    "lib": ".claude/skills/design-svg/scripts/lib",
    "declaration": ".claude/skills/design-svg/scripts/tools.py",
    "entry": ".claude/skills/design-svg/scripts/cli.py"
  },
  "rules": [
    {
      "rule": "層の場所と依存の向きが、契約を満たす",
      "source": {
        "record": "skills-creator/references/tool-contract.md"
      },
      "scope": "入口 ・ 宣言 ・ 部品の置き場所と、部品が入口を持たないこと",
      "check": {
        "tool": [
          "python3",
          "../skills-creator/scripts/cli.py",
          "check",
          "."
        ],
        "target": ".claude/skills/design-svg"
      }
    },
    {
      "rule": "事例が通る",
      "source": {
        "meta": "docs.pytest.org",
        "quote": "pytest"
      },
      "scope": "この成果物の試験のみ ── まとめて実行する（各ファイルは単体で実行できない）",
      "check": {
        "tool": [
          "pytest",
          "-q",
          "scripts/tests"
        ],
        "target": ".claude/skills/design-svg"
      }
    },
    {
      "rule": "生の数値が残っていない",
      "source": {
        "record": "design-svg/SKILL.md"
      },
      "scope": "設計上の選択はトークンから、量はデータから出すこと",
      "check": {
        "tool": [
          "python3",
          "scripts/cli.py",
          "lint"
        ],
        "target": ".claude/skills/design-svg"
      }
    },
    {
      "rule": "人が読む文書が、10の判定を通る",
      "source": {
        "record": "doc-writing-skills/SKILL.md"
      },
      "scope": "この成果物の SKILL.md のみ",
      "check": {
        "tool": [
          "python3",
          "../doc-writing-skills/scripts/cli.py",
          "check",
          "SKILL.md"
        ],
        "target": ".claude/skills/design-svg"
      }
    }
  ]
}
