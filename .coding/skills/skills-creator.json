{
  "$schema": "../../.claude/skills/coding-skills/references/rules.schema.json",
  "order": [
    "lib",
    "declaration",
    "entry"
  ],
  "layers": {
    "lib": ".claude/skills/skills-creator/scripts/lib",
    "declaration": ".claude/skills/skills-creator/scripts/tools.py",
    "entry": ".claude/skills/skills-creator/scripts/cli.py"
  },
  "rules": [
    {
      "rule": "層の場所と依存の向きが、契約を満たす",
      "source": {
        "record": "skills-creator/references/tool-contract.md"
      },
      "scope": "入口 ・ 宣言 ・ 部品の置き場所と、部品が入口を持たないこと",
      "check": {
        "tool": [
          "python3",
          "../skills-creator/scripts/cli.py",
          "check",
          "."
        ],
        "target": ".claude/skills/skills-creator"
      }
    },
    {
      "rule": "人が読む文書が、10の判定を通る",
      "source": {
        "record": "doc-writing-skills/SKILL.md"
      },
      "scope": "この成果物の SKILL.md のみ",
      "check": {
        "tool": [
          "python3",
          "../doc-writing-skills/scripts/cli.py",
          "check",
          "SKILL.md"
        ],
        "target": ".claude/skills/skills-creator"
      }
    },
    {
      "rule": "節の検査が、雛形との差を検出する",
      "source": {
        "record": "skills-creator/references/tool-contract.md"
      },
      "scope": "この成果物の試験のみ",
      "check": {
        "tool": [
          "python3",
          "scripts/tests/test_sections.py"
        ],
        "target": ".claude/skills/skills-creator"
      }
    }
  ]
}
