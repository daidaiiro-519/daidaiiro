{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:base:operation-result:v1",
 "title": "sas が返す結果",
 "description": "sas のコマンドが標準出力へ返す JSON の1行。kind で、検証の結果（validation）・ 作成と更新の結果（change）・ 始められなかった ・ 書かなかった理由（error）を分ける。$defs はステップごとに足す",
 "type": "object",
 "required": [
  "$schema",
  "kind"
 ],
 "properties": {
  "$schema": {
   "const": "urn:semantic-agent-schema:base:operation-result:v1"
  },
  "kind": {
   "enum": [
    "validation",
    "change",
    "error"
   ]
  }
 },
 "oneOf": [
  {
   "$ref": "#/$defs/validation"
  },
  {
   "$ref": "#/$defs/change"
  },
  {
   "$ref": "#/$defs/error"
  }
 ],
 "$defs": {
  "verdict": {
   "enum": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "description": "rule の結果の5つの値。unverified は人が決めるもの、unsupported は判定する手続きか相手がまだ無いもの"
  },
  "counts": {
   "type": "object",
   "description": "5つの値ごとの件数",
   "required": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "additionalProperties": false,
   "properties": {
    "verified": {
     "type": "integer",
     "minimum": 0
    },
    "violated": {
     "type": "integer",
     "minimum": 0
    },
    "unverified": {
     "type": "integer",
     "minimum": 0
    },
    "error": {
     "type": "integer",
     "minimum": 0
    },
    "unsupported": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "fingerprint": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "description": "対象の中身（バイト列）の SHA-256"
  },
  "rule-result": {
   "type": "object",
   "required": [
    "rule",
    "pointer",
    "by",
    "result",
    "reason"
   ],
   "additionalProperties": false,
   "properties": {
    "rule": {
     "type": "string",
     "minLength": 1,
     "description": "rule の id。JSON Schema の形の検査は json-schema、参照の先は relationship-target"
    },
    "pointer": {
     "type": "string",
     "description": "対象の中の当たる所（JSON Pointer）"
    },
    "by": {
     "enum": [
      "machine",
      "ai",
      "human"
     ]
    },
    "result": {
     "$ref": "#/$defs/verdict"
    },
    "reason": {
     "type": "string",
     "minLength": 1
    }
   },
   "if": {
    "properties": {
     "by": {
      "const": "human"
     }
    }
   },
   "then": {
    "properties": {
     "result": {
      "const": "unverified"
     }
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "path",
    "kind",
    "schema",
    "fingerprint",
    "operation",
    "results",
    "counts"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "type": "string",
     "description": "リポジトリの根からの経路"
    },
    "kind": {
     "enum": [
      "concrete",
      "instance"
     ]
    },
    "schema": {
     "type": "string",
     "description": "従う schema の $id（Concrete なら Abstract の版）"
    },
    "fingerprint": {
     "$ref": "#/$defs/fingerprint"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "この対象の検証を記録した操作の ID"
    },
    "results": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/rule-result"
     },
     "minItems": 1
    },
    "counts": {
     "$ref": "#/$defs/counts"
    }
   }
  },
  "validation": {
   "type": "object",
   "required": [
    "kind",
    "session",
    "operations",
    "targets",
    "counts"
   ],
   "properties": {
    "kind": {
     "const": "validation"
    },
    "session": {
     "type": "string",
     "pattern": "^s-[0-9]{4,}$",
     "description": "呼び出し元のセッションの ID"
    },
    "operations": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^o-[0-9]{4,}$"
     }
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/target"
     }
    },
    "counts": {
     "$ref": "#/$defs/counts"
    }
   }
  },
  "field-change": {
   "type": "object",
   "description": "変わった欄1つ。add は before を、remove は after を持たない。値が null のときは null を持つ",
   "required": [
    "pointer",
    "change"
   ],
   "additionalProperties": false,
   "properties": {
    "pointer": {
     "type": "string",
     "description": "変わった欄（JSON Pointer）"
    },
    "change": {
     "enum": [
      "add",
      "remove",
      "replace"
     ]
    },
    "before": {
     "description": "前の値"
    },
    "after": {
     "description": "後の値"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "change": {
        "const": "add"
       }
      }
     },
     "then": {
      "required": [
       "after"
      ],
      "not": {
       "required": [
        "before"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "remove"
       }
      }
     },
     "then": {
      "required": [
       "before"
      ],
      "not": {
       "required": [
        "after"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "replace"
       }
      }
     },
     "then": {
      "required": [
       "before",
       "after"
      ]
     }
    }
   ]
  },
  "side": {
   "type": "object",
   "required": [
    "fingerprint"
   ],
   "additionalProperties": false,
   "properties": {
    "fingerprint": {
     "$ref": "#/$defs/fingerprint"
    }
   }
  },
  "diff": {
   "type": "object",
   "description": "前後の中身から JSON Pointer ごとに求めた差分（Git の行の差分は使わない）。作成では before が無い",
   "required": [
    "source",
    "after",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "const": "sas",
     "description": "SAS を通った変更（SAS を通らない変更の取り込みはステップ3 で outside を足す）"
    },
    "before": {
     "$ref": "#/$defs/side"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    }
   }
  },
  "change": {
   "type": "object",
   "required": [
    "kind",
    "session",
    "operation",
    "result",
    "replayed",
    "target",
    "diff",
    "stale_rules",
    "violated_instances"
   ],
   "properties": {
    "kind": {
     "const": "change"
    },
    "session": {
     "type": "string",
     "pattern": "^s-[0-9]{4,}$",
     "description": "呼び出し元のセッションの ID"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "作成か更新の操作の ID"
    },
    "result": {
     "enum": [
      "created",
      "updated"
     ]
    },
    "replayed": {
     "type": "boolean",
     "description": "同じ request_id の操作がすでにあり、書かずにそれを返したか。true のときの stale_rules と violated_instances は空（記録にあるのは差分だけ）"
    },
    "target": {
     "type": "object",
     "required": [
      "kind",
      "path",
      "concrete"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "concrete",
        "instance"
       ]
      },
      "path": {
       "type": "string",
       "description": "リポジトリの根からの経路"
      },
      "concrete": {
       "type": "string",
       "description": "従う Concrete の $id（Concrete なら Abstract の版）"
      }
     }
    },
    "diff": {
     "$ref": "#/$defs/diff"
    },
    "stale_rules": {
     "type": "array",
     "description": "前の検証の判定のうち、読む所がこの変更で変わったもの。もう効かない",
     "items": {
      "type": "object",
      "required": [
       "rule",
       "pointer",
       "operation"
      ],
      "additionalProperties": false,
      "properties": {
       "rule": {
        "type": "string",
        "minLength": 1
       },
       "pointer": {
        "type": "string"
       },
       "operation": {
        "type": "string",
        "pattern": "^o-[0-9]{4,}$",
        "description": "その判定を記録した検証の操作の ID"
       }
      }
     }
    },
    "violated_instances": {
     "type": "array",
     "description": "Concrete の更新で、新しい形に従わなくなったインスタンス。呼ぶ側がそれぞれに UC2 を呼ぶ",
     "items": {
      "type": "object",
      "required": [
       "path",
       "results"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "results": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/rule-result"
        },
        "minItems": 1
       }
      }
     }
    }
   }
  },
  "error": {
   "type": "object",
   "required": [
    "kind",
    "code",
    "message"
   ],
   "properties": {
    "kind": {
     "const": "error"
    },
    "code": {
     "enum": [
      "usage",
      "schema_not_listed",
      "unknown_schema",
      "no_schema",
      "not_found",
      "not_json",
      "exists",
      "invalid_input",
      "request_reused",
      "store",
      "checker",
      "log",
      "invalid_value",
      "conflict",
      "patch_failed",
      "id_changed",
      "human_field",
      "derived_mismatch",
      "published_changed"
     ],
     "description": "決まった名前。schema_not_listed は、申告した Abstract の版が閉じた一覧に無く、取りに行かなかったこと。invalid_value から published_changed までの7つは書く手前で断った作成 ・ 更新で、操作として記録し、session と operation を返す"
    },
    "path": {
     "type": "string"
    },
    "message": {
     "type": "string",
     "minLength": 1
    },
    "session": {
     "type": "string",
     "pattern": "^s-[0-9]{4,}$",
     "description": "断った操作を記録したセッションの ID"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "断った操作の ID"
    },
    "interleaved": {
     "$ref": "#/$defs/interleaved",
     "description": "conflict のときだけ持つ。同じ request_id のやり直しで断りを返すときは、比べた指紋を記録していないので持たない"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "code": {
        "enum": [
         "invalid_value",
         "conflict",
         "patch_failed",
         "id_changed",
         "human_field",
         "derived_mismatch",
         "published_changed"
        ]
       }
      }
     },
     "then": {
      "required": [
       "session",
       "operation"
      ]
     },
     "else": {
      "not": {
       "anyOf": [
        {
         "required": [
          "session"
         ]
        },
        {
         "required": [
          "operation"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "not": {
       "properties": {
        "code": {
         "const": "conflict"
        }
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "interleaved"
       ]
      }
     }
    }
   ]
  },
  "written-operation": {
   "type": "object",
   "description": "記録にある、対象を書いた操作1件（作成か更新で、断っていないもの）",
   "required": [
    "operation",
    "session",
    "kind",
    "at",
    "after",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "操作の ID"
    },
    "session": {
     "type": "string",
     "pattern": "^s-[0-9]{4,}$",
     "description": "その操作をしたセッションの ID"
    },
    "kind": {
     "enum": [
      "create",
      "update"
     ]
    },
    "intent": {
     "type": "string",
     "minLength": 1,
     "description": "呼ぶ側が渡した意図（なぜその操作をしたか）。渡されなかったときは無い"
    },
    "at": {
     "type": "string",
     "description": "記録した日時（UTC の RFC 3339）"
    },
    "before": {
     "$ref": "#/$defs/side",
     "description": "事前の指紋。作成では無い"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    }
   }
  },
  "interleaved": {
   "type": "object",
   "description": "指紋が違って断ったときの、間に入った変更。呼ぶ側は、意図と変わった欄を読んでから直し方を決め直す",
   "required": [
    "expected",
    "current",
    "untracked",
    "operations"
   ],
   "additionalProperties": false,
   "properties": {
    "expected": {
     "$ref": "#/$defs/fingerprint",
     "description": "比べた指紋（--if-match か、SAS が最後に書いた事後の指紋）"
    },
    "current": {
     "$ref": "#/$defs/fingerprint",
     "description": "いまの中身の指紋"
    },
    "untracked": {
     "type": "boolean",
     "description": "true なら、いまの中身は記録した操作の事後のどれでもない（SAS を通らない変更があった。取り込みはステップ3 の --adopt）"
    },
    "operations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/written-operation"
     },
     "description": "比べた指紋のあとに記録された、対象を書いた操作（古い順）。事前と事後の指紋をたどって組む"
    },
    "last_recorded": {
     "type": "object",
     "description": "最後に記録した、対象を書いた操作",
     "required": [
      "operation",
      "session",
      "at",
      "after"
     ],
     "additionalProperties": false,
     "properties": {
      "operation": {
       "type": "string",
       "pattern": "^o-[0-9]{4,}$"
      },
      "session": {
       "type": "string",
       "pattern": "^s-[0-9]{4,}$"
      },
      "at": {
       "type": "string"
      },
      "after": {
       "$ref": "#/$defs/side"
      }
     }
    }
   }
  }
 }
}
