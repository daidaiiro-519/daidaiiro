<style>
:root{--bg:#f6f7f5;--card:#fff;--fg:#1b201e;--soft:#5d6763;--line:#d9ddd9;--accent:#1d6b57;--accent-bg:#e2f1ec;--warn:#9a4d1c;--warn-bg:#f8e9dd;--mid:#4a5a8a;--mid-bg:#e6e9f4}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151917;--card:#1d2321;--fg:#e4e9e6;--soft:#a3ada8;--line:#343c39;--accent:#79c7b0;--accent-bg:#1b2f29;--warn:#f0aa7c;--warn-bg:#33251b;--mid:#aab6e6;--mid-bg:#232a40;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#151917;--card:#1d2321;--fg:#e4e9e6;--soft:#a3ada8;--line:#343c39;--accent:#79c7b0;--accent-bg:#1b2f29;--warn:#f0aa7c;--warn-bg:#33251b;--mid:#aab6e6;--mid-bg:#232a40;color-scheme:dark}
body{background:var(--bg);color:var(--fg);font:15px/1.75 "Noto Sans JP",system-ui,sans-serif;margin:0;padding-inline:16px;padding-block:24px 56px}
main{max-width:860px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr);gap:26px}
h1{font-size:1.5rem;margin:0;text-wrap:balance} h2{font-size:1.1rem;margin:0 0 10px;text-wrap:balance} h3{font-size:.98rem;margin:8px 0 0}
.nb{display:inline-block} p{margin:0} .soft{color:var(--soft)}
code{font-size:.86em;background:var(--accent-bg);padding:1px 5px;border-radius:4px;overflow-wrap:break-word}
blockquote{margin:0;padding:6px 12px;border-left:3px solid var(--line);color:var(--soft)}
section{min-width:0;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;display:grid;gap:10px}
section.rule{border:2px solid var(--accent)} section.ng{border:2px solid var(--warn)}
ol,ul{margin:0;padding-left:1.3em}
.n{display:inline-block;width:1.6em;height:1.6em;border-radius:50%;background:var(--accent);color:var(--card);text-align:center;font-size:.85rem;line-height:1.6em;margin-right:6px}
section.ng .n{background:var(--warn)}
.fig{overflow-x:auto} .fig svg{display:block;max-width:560px;width:100%;margin:0 auto}
.cap{font-size:.85rem;color:var(--soft);text-align:center}
table{border-collapse:collapse;width:100%;font-size:.9rem} th,td{border-bottom:1px solid var(--line);padding:6px 8px;text-align:left;vertical-align:top} th{color:var(--soft);font-size:.8rem}
.wrap{overflow-x:auto} td code{overflow-wrap:break-word} td:first-child{min-width:6em}
.tr{font-size:.8rem;color:var(--soft)}
.k{display:inline-block;font-size:.8rem;font-weight:700;padding:0 8px;border-radius:999px;white-space:nowrap}
.core{background:var(--accent-bg);color:var(--accent)} .sup{background:var(--mid-bg);color:var(--mid)} .gen{background:var(--warn-bg);color:var(--warn)}
.ucs{display:grid;grid-template-columns:minmax(0,1fr);gap:12px}
.uc{border:1px solid var(--line);border-radius:8px;padding:10px 12px;display:grid;gap:4px;min-width:0;align-content:start}
.uc h3{margin:0;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.uc dl{margin:0;display:grid;grid-template-columns:5.6em minmax(0,1fr);gap:4px 10px;font-size:.9rem}
.uc dt{color:var(--soft);font-size:.8rem;padding-top:2px} .uc dd{margin:0}
.uc.core-uc{border-color:var(--accent)}
@media (max-width:560px){.uc dl{grid-template-columns:minmax(0,1fr)} .uc dt{padding-top:6px}
table.stack tr{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);border-bottom:1px solid var(--line)} table.stack td,table.stack th{border:0;display:block} table.stack td:first-child,table.stack th:first-child{grid-column:1/-1;font-weight:700;padding-bottom:0} table.stack td.tr{grid-column:1/-1;padding-top:0} table.stack th:first-child{display:none}}
.m{color:var(--mid);font-weight:700} .s{color:var(--accent);font-weight:700} .p{color:var(--warn);font-weight:700}
.steps td:first-child{min-width:2.4em;white-space:nowrap}
.id{display:inline-block;font-size:.78rem;font-weight:700;color:var(--accent);background:var(--accent-bg);border-radius:4px;padding:0 6px;margin-right:6px}
</style>