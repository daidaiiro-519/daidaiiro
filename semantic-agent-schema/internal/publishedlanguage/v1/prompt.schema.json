{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:prompt:v1",
  "title": "prompt",
  "description": "semantic <ユースケース> でコマンドが Concrete の x-prompt から組んで AI に返すもの。JSON ドキュメントの内容は貼らず、path で渡す。AI は steps の x-prompt に従って response を生成し、next を実行する。",
  "type": "object",
  "required": [
    "response",
    "next"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "description": "対象の JSON ドキュメントの path（作成 ・ 更新 ・ 判定）",
      "type": "string"
    },
    "hash": {
      "description": "判定の prompt で、判定する JSON ドキュメントの内容のハッシュ。judgments の JSON にそのまま写す",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "response": {
      "description": "response の形。AI が作って渡すものが従うスキーマで、$ref に $id を持つ（作成は Concrete、更新は JSON Patch のスキーマ、判定は judgment-response のスキーマ、検索は search-response のスキーマ）",
      "type": "object",
      "required": [
        "$ref"
      ],
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next": {
      "description": "response を渡すコマンド行。AI が埋める部分だけを <…> で空けておく",
      "type": "string",
      "minLength": 1
    },
    "question": {
      "description": "検索の問い",
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "description": "検索の範囲。各 JSON ドキュメントの path と内容のハッシュ。中身は貼らない",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "description": "1つのサブスキーマの、AI が読む部分。位置は、作成では Concrete の中の keyword location（URI の fragment の JSON Pointer）、更新ではインスタンスの中の instance location。判定では rule と instance location の組を1つ持つ",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywordLocation": {
          "type": "string",
          "pattern": "^#(/([^~/]|~[01])*)*$"
        },
        "instanceLocation": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "x-prompt": {
          "$ref": "urn:semantic-agent-schema:vocabulary:v1#/$defs/x-prompt"
        },
        "rule": {
          "description": "判定の step で、判定する rule の id（x-prompt の rules の1件）",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "keywordLocation"
          ]
        },
        {
          "required": [
            "instanceLocation"
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "description": "作成 ・ 更新 ・ 判定：1つの JSON ドキュメントの steps",
      "required": [
        "path",
        "steps"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "documents"
            ]
          },
          {
            "required": [
              "question"
            ]
          }
        ]
      }
    },
    {
      "description": "検索：範囲の documents と問い",
      "required": [
        "documents",
        "question"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "steps"
            ]
          }
        ]
      }
    }
  ]
}
