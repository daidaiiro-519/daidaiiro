{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:prompt:v1",
  "title": "prompt",
  "description": "semantic <ユースケース> でコマンドが Concrete の x-prompt から組んで AI に返すもの。JSON ドキュメントの内容は貼らず、path で渡す。作成は steps のサブスキーマごとの x-prompt に従って JSON ドキュメントを生成する。更新と判定は、steps の instanceLocation と、keywordLocation で subschemas から引く x-prompt に従う。response の形の JSON Schema に従う response を作り、next を実行する。",
  "type": "object",
  "required": [
    "response",
    "next"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "description": "対象の JSON ドキュメントの path（作成 ・ 更新 ・ 判定）",
      "type": "string"
    },
    "instruction": {
      "description": "判定の prompt で、AI がすること。JSON ドキュメントの内容は貼らないので、path のファイルを読んで判定する",
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "description": "判定の prompt で、判定する JSON ドキュメントの内容のハッシュ。judgments の JSON にそのまま写す",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "response": {
      "description": "response の形。AI が作って渡すものが従う JSON Schema の中身（作成は Concrete、更新は JSON Patch のスキーマ、判定は judgment-response のスキーマ、検索は search-response のスキーマ）",
      "type": "object"
    },
    "next": {
      "description": "response を渡すコマンド行。AI が埋める部分だけを <…> で空けておく",
      "type": "string",
      "minLength": 1
    },
    "question": {
      "description": "検索の問い",
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "description": "検索の範囲。各 JSON ドキュメントの path と内容のハッシュ。中身は貼らない",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "subschemas": {
      "description": "更新と判定で、steps が keywordLocation で指すサブスキーマ。x-prompt は、ここにサブスキーマごとに1回だけ置く",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "keywordLocation"
        ],
        "additionalProperties": false,
        "properties": {
          "keywordLocation": {
            "type": "string",
            "pattern": "^#(/([^~/]|~[01])*)*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "x-prompt": {
            "$ref": "urn:semantic-agent-schema:vocabulary:v1#/$defs/x-prompt"
          }
        }
      }
    },
    "violations": {
      "description": "更新で、直す対象の violated の judgment（いまの内容の、直前の検証のもの）",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "instanceLocation",
          "verdict",
          "by",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string"
          },
          "instanceLocation": {
            "type": "string",
            "pattern": "^(/([^~/]|~[01])*)*$"
          },
          "verdict": {
            "const": "violated"
          },
          "by": {
            "enum": [
              "machine",
              "ai"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "description": "作成：1つのサブスキーマの keywordLocation ・ title ・ description ・ x-prompt。更新：instanceLocation と、subschemas を指す keywordLocation。判定：それに加えて、判定する rule の id（rule と instance location の組1つ）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywordLocation": {
          "type": "string",
          "pattern": "^#(/([^~/]|~[01])*)*$"
        },
        "instanceLocation": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "x-prompt": {
          "$ref": "urn:semantic-agent-schema:vocabulary:v1#/$defs/x-prompt"
        },
        "rule": {
          "description": "判定の step で、判定する rule の id（x-prompt の rules の1件）",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "keywordLocation"
          ],
          "not": {
            "required": [
              "instanceLocation"
            ]
          }
        },
        {
          "required": [
            "instanceLocation",
            "keywordLocation"
          ],
          "properties": {
            "title": false,
            "description": false,
            "x-prompt": false
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "description": "作成 ・ 更新 ・ 判定：1つの JSON ドキュメントの steps",
      "required": [
        "path",
        "steps"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "documents"
            ]
          },
          {
            "required": [
              "question"
            ]
          }
        ]
      }
    },
    {
      "description": "検索：範囲の documents と問い",
      "required": [
        "documents",
        "question"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "steps"
            ]
          }
        ]
      }
    }
  ]
}
