{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:prompt:v1",
  "title": "prompt",
  "description": "--semantic でコマンドが Concrete の x-prompt から組んで AI に返すもの。JSON ドキュメントの内容は貼らず、path で渡す。AI は steps の x-prompt に従って response を生成し、next を実行する。",
  "type": "object",
  "required": [
    "path",
    "steps",
    "response",
    "next"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "description": "対象の JSON ドキュメントの path",
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "response": {
      "description": "response の形。AI が作って渡すものが従うスキーマで、$ref に $id を持つ（作成は Concrete、更新は JSON Patch のスキーマ）",
      "type": "object",
      "required": [
        "$ref"
      ],
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "next": {
      "description": "response を渡すコマンド行。AI が埋める部分だけを <…> で空けておく",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "step": {
      "description": "1つのサブスキーマの、AI が読む部分。位置は、作成では Concrete の中の keyword location（URI の fragment の JSON Pointer）、更新ではインスタンスの中の instance location",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywordLocation": {
          "type": "string",
          "pattern": "^#(/([^~/]|~[01])*)*$"
        },
        "instanceLocation": {
          "type": "string",
          "pattern": "^(/([^~/]|~[01])*)*$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "x-prompt": {
          "$ref": "urn:semantic-agent-schema:vocabulary:v1#/$defs/x-prompt"
        }
      },
      "oneOf": [
        {
          "required": [
            "keywordLocation"
          ]
        },
        {
          "required": [
            "instanceLocation"
          ]
        }
      ]
    }
  }
}
