{
  "$schema": "urn:semantic-agent-schema:dialect:v1",
  "$id": "urn:semantic-agent-schema:abstract:v1",
  "title": "Abstract",
  "description": "Semantic Agent Schema のメタスキーマ。Concrete のルートスキーマに適用する。Concrete は $schema にこの $id を書き、インスタンスに $schema を必須にして、その const に自分の $id を書く。",
  "x-prompt": {
    "meaning": "Concrete。Abstract の拡張項目を継承し、用途ごとに拡張したスキーマ",
    "when": "Concrete を作成 ・ 更新 ・ 検証するとき",
    "rules": []
  },
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "urn:semantic-agent-schema:vocabulary:v1": true
  },
  "$defs": {
    "subschema": {
      "$dynamicAnchor": "meta",
      "$ref": "urn:semantic-agent-schema:dialect:v1",
      "allOf": [
        {
          "$ref": "#/$defs/keywords"
        }
      ]
    },
    "keywords": {
      "description": "Concrete のどのサブスキーマにも当てる決まり。$ref は書かない（Concrete は1つのファイルで閉じる）。format は、機械的な検証で確かめられる名前だけを書く。x-prompt と x-decided-by は、ルートと、properties ・ items でたどるサブスキーマにだけ書く（ほかの中の rule は、当たるインスタンスの位置が値によって変わり、決定論的に決まらない）",
      "properties": {
        "$ref": false,
        "format": {
          "enum": [
            "date",
            "date-time",
            "duration",
            "email",
            "hostname",
            "ipv4",
            "ipv6",
            "iri",
            "iri-reference",
            "json-pointer",
            "period",
            "regex",
            "relative-json-pointer",
            "semver",
            "time",
            "uri",
            "uri-reference",
            "uri-template",
            "uuid"
          ]
        },
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "prefixItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "not": {
          "$ref": "#/$defs/noPrompt"
        },
        "if": {
          "$ref": "#/$defs/noPrompt"
        },
        "then": {
          "$ref": "#/$defs/noPrompt"
        },
        "else": {
          "$ref": "#/$defs/noPrompt"
        },
        "additionalProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "patternProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "dependentSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "propertyNames": {
          "$ref": "#/$defs/noPrompt"
        },
        "contains": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "contentSchema": {
          "$ref": "#/$defs/noPrompt"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        }
      }
    },
    "noPrompt": {
      "description": "x-prompt と x-decided-by を書いてはいけないサブスキーマ。その下のサブスキーマも、すべて同じ",
      "properties": {
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "prefixItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "not": {
          "$ref": "#/$defs/noPrompt"
        },
        "if": {
          "$ref": "#/$defs/noPrompt"
        },
        "then": {
          "$ref": "#/$defs/noPrompt"
        },
        "else": {
          "$ref": "#/$defs/noPrompt"
        },
        "additionalProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "patternProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "dependentSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "propertyNames": {
          "$ref": "#/$defs/noPrompt"
        },
        "contains": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "contentSchema": {
          "$ref": "#/$defs/noPrompt"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "x-prompt": false,
        "x-decided-by": false,
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "items": {
          "$ref": "#/$defs/noPrompt"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "$ref": "urn:semantic-agent-schema:vocabulary:v1"
    },
    {
      "$ref": "#/$defs/keywords"
    }
  ],
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "required",
    "properties"
  ],
  "properties": {
    "$schema": {
      "const": "urn:semantic-agent-schema:abstract:v1"
    },
    "$id": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "contains": {
        "const": "$schema"
      }
    },
    "properties": {
      "required": [
        "$schema"
      ],
      "properties": {
        "$schema": {
          "type": "object",
          "required": [
            "const"
          ],
          "properties": {
            "const": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
