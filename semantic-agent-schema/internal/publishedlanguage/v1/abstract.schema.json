{
  "$schema": "urn:semantic-agent-schema:dialect:v1",
  "$id": "urn:semantic-agent-schema:abstract:v1",
  "title": "Abstract",
  "description": "Semantic Agent Schema のメタスキーマ。Concrete のルートスキーマに適用する。Concrete は $schema にこの $id を書き、インスタンスに $schema を必須にして、その const に自分の $id を書く。$defs/keywords の properties.x-prompt は Concrete に書く x-prompt の値に当たり、その中の x-prompt はそれを判定する rule。",
  "x-prompt": {
    "meaning": "Concrete。Abstract の拡張項目を継承し、用途ごとに拡張したスキーマ",
    "when": "Concrete を作成 ・ 更新 ・ 検証するとき",
    "rules": []
  },
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "urn:semantic-agent-schema:vocabulary:v1": true
  },
  "$defs": {
    "subschema": {
      "$dynamicAnchor": "meta",
      "$ref": "urn:semantic-agent-schema:dialect:v1",
      "allOf": [
        {
          "$ref": "#/$defs/keywords"
        }
      ]
    },
    "keywords": {
      "description": "Concrete のどのサブスキーマにも当てる決まり。$ref は書かない（Concrete は1つのファイルで閉じる）。format は、機械的な検証で確かめられる名前だけを書く。x-prompt と x-decided-by は、ルートと、properties ・ items でたどるサブスキーマにだけ書く（ほかの中の rule は、当たるインスタンスの位置が値によって変わり、決定論的に決まらない）",
      "properties": {
        "$ref": false,
        "format": {
          "enum": [
            "date",
            "date-time",
            "duration",
            "email",
            "hostname",
            "ipv4",
            "ipv6",
            "iri",
            "iri-reference",
            "json-pointer",
            "period",
            "regex",
            "relative-json-pointer",
            "semver",
            "time",
            "uri",
            "uri-reference",
            "uri-template",
            "uuid"
          ]
        },
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "prefixItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "not": {
          "$ref": "#/$defs/noPrompt"
        },
        "if": {
          "$ref": "#/$defs/noPrompt"
        },
        "then": {
          "$ref": "#/$defs/noPrompt"
        },
        "else": {
          "$ref": "#/$defs/noPrompt"
        },
        "additionalProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "patternProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "dependentSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "propertyNames": {
          "$ref": "#/$defs/noPrompt"
        },
        "contains": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "contentSchema": {
          "$ref": "#/$defs/noPrompt"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "x-prompt": {
          "properties": {
            "meaning": {
              "x-prompt": {
                "meaning": "Concrete に書く x-prompt の meaning の欄。その値が業務で何を表すか",
                "when": "Concrete を書いて、サブスキーマの値の意味を決めるとき",
                "rules": [
                  {
                    "id": "meaning-domain",
                    "rule": "x-prompt の meaning は、その値が業務で何を表すかを書く",
                    "why": "生成するときも判定するときも、値の意味を同じに読むため",
                    "check": "この meaning は、その値が業務で何を表すかを書いているか",
                    "related_fields": [],
                    "bad": [
                      {
                        "value": "題名"
                      }
                    ],
                    "good": [
                      {
                        "value": "会議の記録を一覧で見分けるための、結論を表す短い名前"
                      }
                    ]
                  }
                ]
              }
            },
            "when": {
              "x-prompt": {
                "meaning": "Concrete に書く x-prompt の when の欄。その値を書く場面",
                "when": "Concrete を書いて、値を書く場面を決めるとき",
                "rules": [
                  {
                    "id": "when-situation",
                    "rule": "x-prompt の when は、その値を書く場面を書く。何をするときかは必ず書き、誰がは分かるときだけ書く",
                    "why": "生成の prompt で、AI がいつ何のために書くかを取り違えないため",
                    "check": "この when は、何をするときかを示しているか（誰がは、分かるときだけでよい）",
                    "related_fields": [],
                    "bad": [
                      {
                        "value": "必要なとき"
                      }
                    ],
                    "good": [
                      {
                        "value": "会議が終わり、決めたことを記録するとき"
                      }
                    ]
                  }
                ]
              }
            },
            "rules": {
              "items": {
                "x-prompt": {
                  "meaning": "Concrete に書く x-prompt の rules の1件。その値の決まり",
                  "when": "Concrete を書いて、値の決まりを書くとき",
                  "rules": [
                    {
                      "id": "schema-first",
                      "rule": "JSON Schema で書ける決まりを、x-prompt の rule に書かない。JSON Schema で書けない、ほかの値との比較（終わりの日が始まりの日より後か など）は rule に置く",
                      "why": "機械的に検証できるものは機械的な検証にし、rule は意味でしか決められないことだけにするため",
                      "check": "この rule は、type ・ enum ・ pattern ・ minLength ・ maxLength ・ minimum ・ maximum ・ format などで書けない決まりか。rule-judgeable とは別に判定する",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "rule": "20 文字以内で書く"
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "rule": "会議の結論が一読で分かる題名にする"
                          }
                        }
                      ]
                    },
                    {
                      "id": "rule-judgeable",
                      "rule": "rule は、値と related_fields の値だけを見て、満たすか満たさないかを決められる文にする",
                      "why": "判定の verdict を、AI がぶれずに出せるようにするため",
                      "check": "この rule は、値と related_fields の値だけで、満たす ・ 満たさないに決められるか。schema-first とは別に判定する",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "rule": "よい題名にする"
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "rule": "題名に、会議で決めたことの主語と動詞を含める"
                          }
                        }
                      ]
                    },
                    {
                      "id": "check-question",
                      "rule": "check は、rule を「はい ・ いいえ」で答える問いにする",
                      "why": "判定の prompt にそのまま入る問いなので、答えの形を一つにするため",
                      "check": "この rule の check は、rule に対応する、はい ・ いいえで答える問いか",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "check": "題名について"
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "check": "題名に、決めたことの主語と動詞が含まれているか"
                          }
                        }
                      ]
                    },
                    {
                      "id": "why-purpose",
                      "rule": "why は、rule を守る目的を書き、rule の言い換えにしない",
                      "why": "判定に迷ったとき、AI が目的から決められるようにするため",
                      "check": "この rule の why は、rule と違うこと（守る目的）を述べているか",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "rule": "題名に主語と動詞を含める",
                            "why": "主語と動詞を含めるため"
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "rule": "題名に主語と動詞を含める",
                            "why": "一覧で開かずに中身が分かるようにするため"
                          }
                        }
                      ]
                    },
                    {
                      "id": "examples-match",
                      "rule": "bad の値は rule に違反し、good の値は rule を満たすようにする",
                      "why": "例が rule と食い違うと、生成も判定も例に引きずられるため",
                      "check": "この rule でも、bad の値が rule に違反し、good の値が rule を満たしているか",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "rule": "題名に主語と動詞を含める",
                            "bad": [
                              {
                                "value": "Go で作り直すことを決めた"
                              }
                            ]
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "rule": "題名に主語と動詞を含める",
                            "bad": [
                              {
                                "value": "定例"
                              }
                            ],
                            "good": [
                              {
                                "value": "Go で作り直すことを決めた"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "related-fields-exact",
                      "rule": "related_fields には、rule が読むほかの値の位置を過不足なく書く。位置は、インスタンスの JSON Pointer（例 /start）で書く。Concrete の位置（/properties/start）ではない",
                      "why": "変更点で判定し直す rule を、漏れなく、多すぎずに選ぶため",
                      "check": "rule の文が読むほかの値の位置が、related_fields に過不足なく、インスタンスの JSON Pointer（/properties/start のような Concrete の位置でなく /start）で入っているか",
                      "related_fields": [],
                      "bad": [
                        {
                          "value": {
                            "rule": "終わりの日は始まりの日より後にする",
                            "related_fields": []
                          }
                        }
                      ],
                      "good": [
                        {
                          "value": {
                            "rule": "終わりの日は始まりの日より後にする",
                            "related_fields": [
                              "/start"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "noPrompt": {
      "description": "x-prompt と x-decided-by を書いてはいけないサブスキーマ。その下のサブスキーマも、すべて同じ",
      "properties": {
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "prefixItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "not": {
          "$ref": "#/$defs/noPrompt"
        },
        "if": {
          "$ref": "#/$defs/noPrompt"
        },
        "then": {
          "$ref": "#/$defs/noPrompt"
        },
        "else": {
          "$ref": "#/$defs/noPrompt"
        },
        "additionalProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "patternProperties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "dependentSchemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "propertyNames": {
          "$ref": "#/$defs/noPrompt"
        },
        "contains": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedItems": {
          "$ref": "#/$defs/noPrompt"
        },
        "unevaluatedProperties": {
          "$ref": "#/$defs/noPrompt"
        },
        "contentSchema": {
          "$ref": "#/$defs/noPrompt"
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "x-prompt": false,
        "x-decided-by": false,
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/noPrompt"
          }
        },
        "items": {
          "$ref": "#/$defs/noPrompt"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "$ref": "urn:semantic-agent-schema:vocabulary:v1"
    },
    {
      "$ref": "#/$defs/keywords"
    }
  ],
  "type": "object",
  "required": [
    "$schema",
    "$id",
    "required",
    "properties"
  ],
  "properties": {
    "$schema": {
      "const": "urn:semantic-agent-schema:abstract:v1"
    },
    "$id": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "contains": {
        "const": "$schema"
      }
    },
    "properties": {
      "required": [
        "$schema"
      ],
      "properties": {
        "$schema": {
          "type": "object",
          "required": [
            "const"
          ],
          "properties": {
            "const": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
