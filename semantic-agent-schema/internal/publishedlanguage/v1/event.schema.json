{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:event:v1",
  "title": "ログイベント",
  "description": "コマンドが返す JSON の1行。読むのは AI。event は、ユースケースで起きたことの過去形",
  "oneOf": [
    {
      "$ref": "#/$defs/generation_requested"
    },
    {
      "$ref": "#/$defs/update_requested"
    },
    {
      "$ref": "#/$defs/created"
    },
    {
      "$ref": "#/$defs/updated"
    },
    {
      "$ref": "#/$defs/validated"
    },
    {
      "$ref": "#/$defs/judgment_requested"
    },
    {
      "$ref": "#/$defs/judged"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "$defs": {
    "pointer": {
      "description": "JSON Pointer（RFC 6901）",
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "hash": {
      "description": "内容のバイト列から決まる値",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generation_requested": {
      "description": "作成の prompt を返した",
      "type": "object",
      "required": [
        "event",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "generation_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        }
      }
    },
    "update_requested": {
      "description": "更新の prompt を返した",
      "type": "object",
      "required": [
        "event",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "update_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        }
      }
    },
    "created": {
      "description": "作成で JSON ドキュメントを書いた",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "created"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "description": "書いた後の内容のハッシュ",
          "$ref": "#/$defs/hash"
        },
        "next": {
          "description": "書いたあとの次のアクション：意味的な検証の依頼。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "updated": {
      "description": "更新で JSON ドキュメントを書いた",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "updated"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "description": "書いた後の内容のハッシュ",
          "$ref": "#/$defs/hash"
        },
        "next": {
          "description": "書いたあとの次のアクション：意味的な検証の依頼。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validated": {
      "description": "検証した。JSON ドキュメント1つの結果",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "counts",
        "judgments"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "validated"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/judgment"
          }
        },
        "instruction": {
          "description": "violated の judgment があるときの、AI への直し方の文",
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "violated の judgment があるときの、次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "counts": {
            "properties": {
              "violated": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "instruction",
          "next"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "instruction"
              ]
            },
            {
              "required": [
                "next"
              ]
            }
          ]
        }
      }
    },
    "judgment_requested": {
      "description": "判定の prompt を返した。counts は、機械的な検証の judgment と、変更点でない instance location から引き継いだ AI の judgment の件数。変更点が無ければ prompt の steps は空",
      "type": "object",
      "required": [
        "event",
        "prompt",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "judgment_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "judged": {
      "description": "判定の response を検証し、judgment と JSON ドキュメントを操作の記録に追記した。JSON ドキュメント1つの結果",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "counts",
        "judgments"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "judged"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/judgment"
          }
        },
        "instruction": {
          "description": "violated の judgment があるときの、AI への直し方の文",
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "violated の judgment があるときの、次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "counts": {
            "properties": {
              "violated": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "instruction",
          "next"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "instruction"
              ]
            },
            {
              "required": [
                "next"
              ]
            }
          ]
        }
      }
    },
    "judgment": {
      "description": "1つの rule と1つの instance location の組の結果",
      "type": "object",
      "required": [
        "rule",
        "instanceLocation",
        "verdict",
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "instanceLocation": {
          "$ref": "#/$defs/pointer"
        },
        "verdict": {
          "enum": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ]
        },
        "by": {
          "enum": [
            "machine",
            "ai"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "rejected": {
      "description": "違反を伝えるログイベント。理由は code。AI は instruction に従い、next を実行する",
      "type": "object",
      "required": [
        "event",
        "code",
        "message",
        "instruction",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "rejected"
        },
        "code": {
          "enum": [
            "arguments_invalid",
            "schema_not_found",
            "schema_duplicate",
            "schema_violation",
            "invalid_json",
            "path_outside",
            "file_not_found",
            "log_unavailable",
            "log_locked",
            "convention_violation",
            "decided_by_human",
            "file_exists",
            "hash_mismatch",
            "range_required",
            "range_violation",
            "patch_not_applicable",
            "response_mismatch"
          ]
        },
        "instanceLocation": {
          "$ref": "#/$defs/pointer"
        },
        "absoluteKeywordLocation": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string"
        }
      }
    }
  }
}
