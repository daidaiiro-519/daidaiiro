{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:event:v1",
  "title": "ログイベント",
  "description": "コマンドが返す JSON の1行。読むのは AI。event は、ユースケースで起きたことの過去形",
  "oneOf": [
    {
      "$ref": "#/$defs/generation_requested"
    },
    {
      "$ref": "#/$defs/update_requested"
    },
    {
      "$ref": "#/$defs/created"
    },
    {
      "$ref": "#/$defs/updated"
    },
    {
      "$ref": "#/$defs/validated"
    },
    {
      "$ref": "#/$defs/judgment_requested"
    },
    {
      "$ref": "#/$defs/judged"
    },
    {
      "$ref": "#/$defs/rendered"
    },
    {
      "$ref": "#/$defs/search_requested"
    },
    {
      "$ref": "#/$defs/found"
    },
    {
      "$ref": "#/$defs/listed"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "$defs": {
    "pointer": {
      "description": "JSON Pointer（RFC 6901）",
      "type": "string",
      "pattern": "^(/([^~/]|~[01])*)*$"
    },
    "hash": {
      "description": "内容のバイト列から決まる値",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generation_requested": {
      "description": "作成の prompt を返した",
      "type": "object",
      "required": [
        "event",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "generation_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        }
      }
    },
    "update_requested": {
      "description": "更新の prompt を返した",
      "type": "object",
      "required": [
        "event",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "update_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        }
      }
    },
    "created": {
      "description": "作成で JSON ドキュメントを書いた",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "created"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "description": "書いた後の内容のハッシュ",
          "$ref": "#/$defs/hash"
        },
        "next": {
          "description": "書いたあとの次のアクション：意味的な検証の依頼。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "updated": {
      "description": "更新で JSON ドキュメントを書いた",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "updated"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "description": "書いた後の内容のハッシュ",
          "$ref": "#/$defs/hash"
        },
        "next": {
          "description": "書いたあとの次のアクション：意味的な検証の依頼。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validated": {
      "description": "検証した。JSON ドキュメント1つの結果",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "counts",
        "judgments"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "validated"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/judgment"
          }
        },
        "instruction": {
          "description": "violated の judgment があるときの、AI への直し方の文",
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "violated の judgment があるときの、次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "counts": {
            "properties": {
              "violated": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "instruction",
          "next"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "instruction"
              ]
            },
            {
              "required": [
                "next"
              ]
            }
          ]
        }
      }
    },
    "judgment_requested": {
      "description": "判定の prompt を返した。counts は、機械的な検証の judgment と、変更点でない instance location から引き継いだ AI の judgment の件数。変更点が無ければ prompt の steps は空",
      "type": "object",
      "required": [
        "event",
        "prompt",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "judgment_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "judged": {
      "description": "判定の response を検証し、judgment と JSON ドキュメントを操作の記録に追記した。JSON ドキュメント1つの結果",
      "type": "object",
      "required": [
        "event",
        "id",
        "path",
        "schemaId",
        "contentHash",
        "counts",
        "judgments"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "judged"
        },
        "id": {
          "description": "操作の ID",
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "schemaId": {
          "description": "従う Concrete（Concrete なら Abstract）の $id",
          "type": "string"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "counts": {
          "description": "verdict ごとの judgment の件数。満たしたとするのは verified だけ",
          "type": "object",
          "required": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ],
          "additionalProperties": false,
          "properties": {
            "verified": {
              "type": "integer",
              "minimum": 0
            },
            "violated": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "not-judged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/judgment"
          }
        },
        "instruction": {
          "description": "violated の judgment があるときの、AI への直し方の文",
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "violated の judgment があるときの、次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "counts": {
            "properties": {
              "violated": {
                "minimum": 1
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "instruction",
          "next"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "instruction"
              ]
            },
            {
              "required": [
                "next"
              ]
            }
          ]
        }
      }
    },
    "judgment": {
      "description": "1つの rule と1つの instance location の組の結果",
      "type": "object",
      "required": [
        "rule",
        "instanceLocation",
        "verdict",
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "type": "string"
        },
        "instanceLocation": {
          "$ref": "#/$defs/pointer"
        },
        "verdict": {
          "enum": [
            "verified",
            "violated",
            "unverified",
            "not-judged"
          ]
        },
        "by": {
          "enum": [
            "machine",
            "ai"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "rendered": {
      "description": "インスタンスを HTML にして書き出した。インスタンス1つにつき1つ",
      "type": "object",
      "required": [
        "event",
        "path",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "rendered"
        },
        "path": {
          "description": "インスタンスの path",
          "type": "string"
        },
        "out": {
          "description": "書き出した HTML の path",
          "type": "string"
        }
      }
    },
    "search_requested": {
      "description": "問いで探す prompt を返した",
      "type": "object",
      "required": [
        "event",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "search_requested"
        },
        "prompt": {
          "$ref": "urn:semantic-agent-schema:prompt:v1"
        }
      }
    },
    "found": {
      "description": "範囲の中だけを探し、条件か matches で見つけた instance location を返した",
      "type": "object",
      "required": [
        "event",
        "range",
        "matches"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "found"
        },
        "range": {
          "description": "探した範囲の path",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "hash",
              "instanceLocation"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "hash": {
                "$ref": "#/$defs/hash"
              },
              "instanceLocation": {
                "$ref": "#/$defs/pointer"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "listed": {
      "description": "操作の記録の1件を返した。--operation で1件を指したときは、書く操作なら changes、検証なら judgments も持つ",
      "type": "object",
      "required": [
        "event",
        "command",
        "id",
        "path",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "listed"
        },
        "command": {
          "description": "操作のコマンド。--operation <command>:<id> の command",
          "enum": [
            "create",
            "update",
            "validate"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "at": {
          "description": "操作の時刻（UTC、RFC 3339）",
          "type": "string"
        },
        "schemaId": {
          "type": "string"
        },
        "beforeHash": {
          "$ref": "#/$defs/hash"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "validation": {
          "description": "検証の記録の種類",
          "enum": [
            "validated",
            "judged"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "instanceLocation",
              "op"
            ],
            "additionalProperties": false,
            "properties": {
              "instanceLocation": {
                "$ref": "#/$defs/pointer"
              },
              "op": {
                "enum": [
                  "add",
                  "remove",
                  "replace"
                ]
              },
              "before": {
                "description": "前の値（JSON の文字列）",
                "type": "string"
              },
              "after": {
                "description": "後の値（JSON の文字列）",
                "type": "string"
              }
            }
          }
        },
        "judgments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/judgment"
          }
        }
      }
    },
    "rejected": {
      "description": "違反を伝えるログイベント。理由は code。AI は instruction に従い、next を実行する",
      "type": "object",
      "required": [
        "event",
        "code",
        "message",
        "instruction",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "rejected"
        },
        "code": {
          "enum": [
            "arguments_invalid",
            "schema_not_found",
            "schema_duplicate",
            "schema_violation",
            "invalid_json",
            "path_outside",
            "file_not_found",
            "not_in_git",
            "log_unavailable",
            "log_locked",
            "convention_violation",
            "decided_by_human",
            "file_exists",
            "hash_mismatch",
            "range_required",
            "range_violation",
            "patch_not_applicable",
            "response_mismatch",
            "operation_not_found",
            "template_missing",
            "template_invalid",
            "out_overlap",
            "template_reference_missing"
          ]
        },
        "instanceLocation": {
          "$ref": "#/$defs/pointer"
        },
        "absoluteKeywordLocation": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "description": "次に実行するコマンド行。AI が埋める部分だけを <…> で空けておく",
          "type": "string"
        },
        "line": {
          "description": "テンプレートの違反で、テンプレートのファイルの中の行",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
