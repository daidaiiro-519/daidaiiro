{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:arguments:v1",
  "title": "引数",
  "description": "コマンドごとの引数の JSON の形。pflag で読んだ引数をこの形にして検証する。semantic <ユースケース> は意味的な操作（prompt を返す）、semantic の無い <ユースケース> は機械的な操作（AI が作ったものを受け取って検証する）。",
  "type": "object",
  "required": [
    "command"
  ],
  "properties": {
    "semantic": {
      "description": "semantic <ユースケース> のとき true",
      "const": true
    },
    "command": {
      "enum": [
        "create",
        "update",
        "validate",
        "search",
        "render",
        "log"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "semantic"
        ],
        "properties": {
          "command": {
            "const": "create"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/semantic-create"
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "semantic"
          ]
        },
        "properties": {
          "command": {
            "const": "create"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/create"
      }
    },
    {
      "if": {
        "required": [
          "semantic"
        ],
        "properties": {
          "command": {
            "const": "update"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/semantic-update"
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "semantic"
          ]
        },
        "properties": {
          "command": {
            "const": "update"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/update"
      }
    },
    {
      "if": {
        "required": [
          "semantic"
        ],
        "properties": {
          "command": {
            "const": "validate"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/semantic-validate"
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "semantic"
          ]
        },
        "properties": {
          "command": {
            "const": "validate"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/validate"
      }
    },
    {
      "if": {
        "required": [
          "semantic"
        ],
        "properties": {
          "command": {
            "const": "search"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/semantic-search"
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "semantic"
          ]
        },
        "properties": {
          "command": {
            "const": "search"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/search"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "render"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/render"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "log"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/log"
      }
    }
  ],
  "$defs": {
    "path": {
      "description": "working tree の top-level directory からの相対のパス。絶対パス ・ 空の要素 ・ . と .. の要素を持たない。",
      "type": "string",
      "pattern": "^([^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+)(/([^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+))*$"
    },
    "semantic-create": {
      "description": "semantic create <path> --schemas <ディレクトリ> --schema <$id>。作成の prompt を依頼する",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "semantic",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "schema": {
          "description": "作る JSON ドキュメントが従う Concrete の $id",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "create": {
      "description": "create <path> --schemas <ディレクトリ> --json <JSON | ->。AI が作った JSON ドキュメントを受け取って作る",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "json"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "json": {
          "description": "JSON ドキュメントの文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic-update": {
      "description": "semantic update <path> --schemas <ディレクトリ> [--range <path>]。更新の prompt を依頼する",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "semantic"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "range": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "update": {
      "description": "update <path> --schemas <ディレクトリ> --patch <JSON | ->。Concrete を更新するときは --range <path>（繰り返せる）。AI が作った JSON Patch を受け取って書き換える",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "patch"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "patch": {
          "description": "JSON Patch の文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "semantic-validate": {
      "description": "semantic validate <path> --schemas <ディレクトリ> [--all]。判定の prompt を依頼する。--all が無ければ変更点に当たる rule だけ",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "semantic"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "all": {
          "description": "すべての rule とすべての instance location を判定する",
          "const": true
        }
      }
    },
    "validate": {
      "description": "validate <path>... --schemas <ディレクトリ>。機械的な検証。validate <path> --schemas <ディレクトリ> --judgments <JSON | -> [--all] は、AI が判定した judgments を受け取って記録する",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "judgments": {
          "description": "判定の response の文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        },
        "all": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "judgments"
            ]
          },
          "then": {
            "properties": {
              "paths": {
                "maxItems": 1
              }
            }
          },
          "else": {
            "description": "--all は semantic validate か --judgments と一緒に渡す",
            "not": {
              "required": [
                "all"
              ]
            }
          }
        }
      ]
    },
    "log": {
      "description": "log [<path>...] [--limit <数>]。操作の記録を新しい順に返す。log --operation <command>:<id> は、その1件を change か judgment と一緒に返す",
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "limit": {
          "description": "返す件数の上限",
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "description": "<command>:<id>。ビュー operations の command と id の組",
          "type": "string",
          "pattern": "^(create|update|validate):[1-9][0-9]*$"
        }
      },
      "if": {
        "required": [
          "operation"
        ]
      },
      "then": {
        "description": "1件を指すときは、path と --limit を渡さない",
        "properties": {
          "paths": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "limit"
          ]
        }
      }
    },
    "semantic-search": {
      "description": "semantic search <path>... --question <問い>。問いで探す prompt を依頼する",
      "type": "object",
      "required": [
        "semantic",
        "command",
        "paths",
        "question"
      ],
      "additionalProperties": false,
      "properties": {
        "semantic": true,
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "search": {
      "description": "search <path>... --where <JSON Pointer>=<JSON>（繰り返せる。すべてを満たすもの）、または search <path>... --matches <JSON | ->（AI が問いで探した matches を受け取る）",
      "type": "object",
      "required": [
        "command",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "pointer",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^(/([^~/]|~[01])*)*$",
                "description": "条件の instance location"
              },
              "value": {
                "description": "条件の値（JSON）"
              }
            }
          }
        },
        "matches": {
          "description": "matches の文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "where"
          ]
        },
        {
          "required": [
            "matches"
          ]
        }
      ]
    },
    "render": {
      "description": "render <path>... --schemas <ディレクトリ> --design-system <path> --out <ディレクトリ>。インスタンスをデザインシステムで HTML にする",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas",
        "designSystem",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "designSystem": {
          "$ref": "#/$defs/path"
        },
        "out": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
