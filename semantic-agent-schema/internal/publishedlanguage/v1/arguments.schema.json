{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-agent-schema:arguments:v1",
  "title": "引数",
  "description": "コマンドごとの引数の JSON の形。pflag で読んだ引数をこの形にして検証する。",
  "type": "object",
  "required": [
    "command"
  ],
  "properties": {
    "command": {
      "enum": [
        "create",
        "update",
        "validate"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "create"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/create"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "update"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/update"
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "validate"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/validate"
      }
    }
  ],
  "$defs": {
    "path": {
      "description": "working tree の top-level directory からの相対のパス。絶対パス ・ 空の要素 ・ . と .. の要素を持たない。",
      "type": "string",
      "pattern": "^([^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+)(/([^/.][^/]*|\\.[^/.][^/]*|\\.\\.[^/]+))*$"
    },
    "validate": {
      "description": "validate <path>... --schemas <ディレクトリ> [--human]。検証",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "human": {
          "type": "boolean"
        }
      }
    },
    "create": {
      "description": "create <path> --schemas <ディレクトリ>、次のどちらか：--semantic --schema-id <$id> ／ --value <JSON | ->。[--human]。作成",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "human": {
          "type": "boolean"
        },
        "semantic": {
          "const": true
        },
        "schemaId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "JSON ドキュメントの文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "required": [
          "semantic"
        ]
      },
      "then": {
        "description": "作成の procedure を依頼する：--schema-id が要り、--value は渡さない",
        "required": [
          "schemaId"
        ],
        "not": {
          "required": [
            "value"
          ]
        }
      },
      "else": {
        "description": "JSON ドキュメントを直接渡す：--value が要り、--schema-id は渡さない",
        "required": [
          "value"
        ],
        "not": {
          "required": [
            "schemaId"
          ]
        }
      }
    },
    "hash": {
      "description": "内容のバイト列から決まる値",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "update": {
      "description": "update <path> --schemas <ディレクトリ>、次のどちらか：--semantic ／ --patch <JSON | -> --if-match <ハッシュ>。Concrete を更新するときは --range <path>（繰り返せる）。[--human]。更新",
      "type": "object",
      "required": [
        "command",
        "paths",
        "schemas"
      ],
      "additionalProperties": false,
      "properties": {
        "command": true,
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "human": {
          "type": "boolean"
        },
        "semantic": {
          "const": true
        },
        "patch": {
          "description": "JSON Patch の文字列。- なら標準入力から読む",
          "type": "string",
          "minLength": 1
        },
        "ifMatch": {
          "$ref": "#/$defs/hash"
        },
        "range": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      },
      "if": {
        "required": [
          "semantic"
        ]
      },
      "then": {
        "description": "更新の procedure を依頼する：--patch と --if-match は渡さない",
        "not": {
          "anyOf": [
            {
              "required": [
                "patch"
              ]
            },
            {
              "required": [
                "ifMatch"
              ]
            }
          ]
        }
      },
      "else": {
        "description": "JSON Patch を直接渡す：--patch と --if-match が要る",
        "required": [
          "patch",
          "ifMatch"
        ]
      }
    }
  }
}
