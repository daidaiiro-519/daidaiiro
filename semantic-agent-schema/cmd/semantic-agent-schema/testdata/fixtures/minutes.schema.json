{
  "$schema": "urn:semantic-agent-schema:abstract:v1",
  "$id": "urn:example:minutes:v1",
  "title": "議事録",
  "x-view": "minutes",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:example:minutes:v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
