{
  "title": "Concrete を更新するときは --range が要り、範囲のインスタンスがこの Concrete に従っていないか新しい Concrete に違反すると rejected を返し、満たせば書き換える",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    },
    "other.json": {
      "$schema": "urn:example:order:v1",
      "items": []
    }
  },
  "steps": [
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "range_required",
          "/next": "semantic-agent-schema update schemas/memo.json --schemas schemas --patch '<同じ JSON Patch>' --range <この Concrete に従うインスタンスの path>"
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"add\", \"path\": \"/required/-\", \"value\": \"owner\"}]",
        "--range",
        "memo.json"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "range_violation",
          "/instanceLocation": "",
          "/absoluteKeywordLocation": "urn:example:memo:v1#/required",
          "/next": "semantic-agent-schema semantic update memo.json --schemas schemas"
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]",
        "--range",
        "other.json"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "range_violation",
          "/instanceLocation": "/$schema",
          "/next": "semantic-agent-schema semantic update other.json --schemas schemas"
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]",
        "--range",
        "memo.json"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "updated",
          "/schemaId": "urn:semantic-agent-schema:abstract:v1",
          "/path": "schemas/memo.json"
        }
      ]
    }
  ]
}
