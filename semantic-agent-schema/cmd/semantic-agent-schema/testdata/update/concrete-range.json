{
  "title": "Concrete を更新するときは --range が要り、範囲のインスタンスがこの Concrete に従っていないか新しい Concrete に違反すると error を返し、満たせば書き換える",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    },
    "other.json": {
      "$schema": "urn:example:order:v1",
      "items": []
    }
  },
  "steps": [
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]",
        "--if-match",
        "{sha256 schemas/memo.json}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "range_required",
          "/next": {
            "$format": "semantic-agent-schema update schemas/memo.json --schemas schemas --patch '<同じ JSON Patch>' --if-match {sha256 schemas/memo.json} --range <この Concrete に従うインスタンスの path>"
          }
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"add\", \"path\": \"/required/-\", \"value\": \"owner\"}]",
        "--if-match",
        "{sha256 schemas/memo.json}",
        "--range",
        "memo.json"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "range_violation",
          "/instanceLocation": "",
          "/absoluteKeywordLocation": "urn:example:memo:v1#/required",
          "/next": "semantic-agent-schema update memo.json --schemas schemas --semantic"
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]",
        "--if-match",
        "{sha256 schemas/memo.json}",
        "--range",
        "other.json"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "range_violation",
          "/instanceLocation": "/$schema",
          "/next": "semantic-agent-schema update other.json --schemas schemas --semantic"
        }
      ]
    },
    {
      "args": [
        "update",
        "schemas/memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/description\", \"value\": \"会議の記録\"}]",
        "--if-match",
        "{sha256 schemas/memo.json}",
        "--range",
        "memo.json"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "change",
          "/schemaId": "urn:semantic-agent-schema:abstract:v1",
          "/path": "schemas/memo.json"
        }
      ]
    }
  ]
}
