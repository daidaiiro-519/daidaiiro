{
  "title": "更新の prompt を依頼し、prompt に従って作った JSON Patch を 渡すと、2文字の字下げと末尾の改行にそろえて書き換え、 change を返す",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    }
  },
  "steps": [
    {
      "args": [
        "semantic",
        "update",
        "memo.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "update_requested",
          "/prompt/path": "memo.json",
          "/prompt/next": "semantic-agent-schema update memo.json --schemas schemas --patch '<response の形に従う JSON Patch>'",
          "/prompt/response/$id": "urn:semantic-agent-schema:patch:v1",
          "/prompt/steps": [
            {
              "instanceLocation": "",
              "keywordLocation": "#"
            },
            {
              "instanceLocation": "/title",
              "keywordLocation": "#/properties/title"
            }
          ],
          "/prompt/subschemas": [
            {
              "keywordLocation": "#",
              "title": "メモ",
              "description": "会議のメモ"
            },
            {
              "keywordLocation": "#/properties/title",
              "title": "題名",
              "x-prompt": {
                "meaning": "メモの題名",
                "when": "メモを書くとき",
                "rules": [
                  {
                    "id": "title-short",
                    "rule": "20 文字以内で書く",
                    "why": "一覧で読める長さにする",
                    "check": "20 文字以内か",
                    "related_fields": [],
                    "bad": [],
                    "good": [
                      {
                        "value": "定例会議"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/title\", \"value\": \"週次会議\"}]"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "updated",
          "/id": 1,
          "/path": "memo.json",
          "/schemaId": "urn:example:memo:v1",
          "/contentHash": {
            "$sha256": "memo.json"
          },
          "/next": "semantic-agent-schema semantic validate memo.json --schemas schemas"
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"週次会議\"\n}\n"
      }
    },
    {
      "args": [
        "validate",
        "memo.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/counts/violated": 0
        }
      ]
    }
  ]
}
