{
  "title": "Git のリポジトリの外では、working tree が決まらないので rejected（not_in_git）を返し、ファイルを変えない",
  "git": false,
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    }
  },
  "steps": [
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/title\", \"value\": \"週次会議\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "not_in_git"
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"定例会議\"\n}"
      }
    }
  ]
}
