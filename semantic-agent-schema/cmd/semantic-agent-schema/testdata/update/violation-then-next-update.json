{
  "title": "検証の violated の judgment が返す next の update に、JSON Patch を入れて実行すると、そのまま通って直る",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": ""
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "memo.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "validated",
          "/counts/violated": 1,
          "/judgments/0/instanceLocation": "/title",
          "/next": "semantic-agent-schema update memo.json --schemas schemas --patch '<violated の instance location を直す JSON Patch>'"
        }
      ]
    },
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/title\", \"value\": \"週次会議\"}]"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "updated"
        }
      ]
    },
    {
      "args": [
        "validate",
        "memo.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/counts/violated": 0
        }
      ]
    }
  ]
}
