{
  "title": "JSON Patch が形に違反するか、JSON として読めないか、いまの内容に適用できないと rejected を返し、ファイルを変えない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    }
  },
  "steps": [
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/title\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/0",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:patch:v1#/items/allOf/0/then/required",
          "/next": "semantic-agent-schema update memo.json --schemas schemas --patch '<違反を直した JSON Patch>'",
          "/instruction": {
            "$prefix": "渡した --patch の JSON の \"/0\" を"
          }
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"定例会議\"\n}"
      }
    },
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"remove\", \"path\": \"/nothing\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "patch_not_applicable",
          "/instanceLocation": "/nothing",
          "/next": "semantic-agent-schema semantic update memo.json --schemas schemas"
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"定例会議\"\n}"
      }
    },
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "invalid_json"
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"定例会議\"\n}"
      }
    }
  ]
}
