{
  "title": "x-decided-by: human の値を変える（消すを含む）JSON Patch は error を返し、ファイルを変えない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "t",
      "status": "draft"
    }
  },
  "steps": [
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/status\", \"value\": \"approved\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "decided_by_human",
          "/instanceLocation": "/status",
          "/next": "semantic-agent-schema update memo.json --schemas schemas --patch '</status を変えない JSON Patch>'"
        }
      ]
    },
    {
      "args": [
        "update",
        "memo.json",
        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"remove\", \"path\": \"/status\"}]"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "decided_by_human",
          "/instanceLocation": "/status"
        }
      ]
    }
  ]
}
