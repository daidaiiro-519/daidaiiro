{
  "title": "デザイントークンは Design Tokens Format Module の形で検証し、別名を解いた値を .Tokens で渡す。型の違反（自分の $type でも、グループから受け継いだ $type でも）は schema_violation、別名の先が無い ・ 輪 ・ 型が違うのは token_alias_invalid、テンプレートが無いトークンを引くと template_reference_missing で、1つも書き出さない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    },
    "design/good.json": {
      "templateLanguage": {
        "name": "html/template",
        "version": "go1.27"
      },
      "templates": {
        "memo": "templates/page.html"
      },
      "tokens": {
        "color": {
          "$type": "color",
          "base": {
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.8,
                0,
                0
              ],
              "hex": "#cc0000"
            },
            "$description": "ブランドの赤"
          },
          "accent": {
            "$value": "{color.base}"
          }
        },
        "space": {
          "$type": "dimension",
          "small": {
            "$value": {
              "value": 4,
              "unit": "px"
            }
          },
          "medium": {
            "$value": {
              "value": 0.5,
              "unit": "rem"
            }
          }
        },
        "font": {
          "weight": {
            "strong": {
              "$type": "fontWeight",
              "$value": 700
            }
          },
          "family": {
            "body": {
              "$type": "fontFamily",
              "$value": [
                "Helvetica",
                "sans-serif"
              ]
            }
          }
        },
        "motion": {
          "quick": {
            "$type": "duration",
            "$value": {
              "value": 100,
              "unit": "ms"
            }
          },
          "ease": {
            "$type": "cubicBezier",
            "$value": [
              0.5,
              0,
              1,
              1
            ]
          }
        },
        "ratio": {
          "$type": "number",
          "$value": 1.5
        }
      }
    },
