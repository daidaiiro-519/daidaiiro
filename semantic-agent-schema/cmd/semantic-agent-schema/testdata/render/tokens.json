  "raw": {
    "design/templates/page.html": "<h1 style=\"font-weight: {{.Tokens.font.weight.strong.css}}\" data-space=\"{{.Tokens.space.medium.css}}\" data-color=\"{{.Tokens.color.accent.css}}\">{{.Value.title}}</h1>",
    "design/templates/unknown.html": "<p data-x=\"{{.Tokens.space.huge.value}}\">{{.Value.title}}</p>"
  },
  "steps": [
    {
      "args": [
        "render",
        "memo.json",
        "--schemas",
        "schemas",
        "--design-system",
        "design/badweight.json",
        "--out",
        "site"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/tokens/font/weight/strong/$value",
          "/next": "semantic-agent-schema render memo.json --schemas schemas --design-system design/badweight.json --out site"
        },
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/tokens/font/weight/strong/$value",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:design-tokens:v1#/$defs/fontWeight/anyOf/1/enum"
        }
      ],
      "files": {
        "site/memo.html": null
      }
    },
    {
      "args": [
        "render",
        "memo.json",
        "--schemas",
        "schemas",
        "--design-system",
        "design/badunit.json",
        "--out",
        "site"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/tokens/space/medium/$value/unit",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:design-tokens:v1#/$defs/dimension/properties/unit/enum"
        }
      ],
      "files": {
        "site/memo.html": null
      }
    },
    {
      "args": [
        "render",
        "memo.json",
        "--schemas",
