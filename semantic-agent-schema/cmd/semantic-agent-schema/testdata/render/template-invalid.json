{
  "title": "テンプレートの記法の誤りは template_invalid を返し、1つも書き出さない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    },
    "design/c.json": {
      "templateLanguage": {
        "name": "html/template",
        "version": "go1.27"
      },
      "templates": {
        "memo": "templates/c-memo.html"
      },
      "tokens": {
        "heading": "title"
      }
    }
  },
  "steps": [
    {
      "args": [
        "render",
        "memo.json",
        "--schemas",
        "schemas",
        "--design-system",
        "design/c.json",
        "--out",
        "site"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "template_invalid",
          "/line": 1
        }
      ],
      "files": {
        "site/memo.html": null
      }
    }
  ],
  "raw": {
    "design/templates/c-memo.html": "<p>{{.Value.title</p>"
  }
}
