{
  "title": "範囲のインスタンスの1つでも Concrete に違反すると rejected を返し、1つも書き出さない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    },
    "design/system.json": {
      "templateLanguage": {
        "name": "html/template",
        "version": "go1.27"
      },
      "templates": {
        "memo": "templates/system-memo.html"
      },
      "tokens": {
        "heading": "title"
      }
    },
    "memo.json": {
      "$schema": "urn:example:memo:v1",
      "title": "定例会議"
    },
    "bad.json": {
      "$schema": "urn:example:memo:v1",
      "title": ""
    }
  },
  "steps": [
    {
      "args": [
        "render",
        "memo.json",
        "bad.json",
        "--schemas",
        "schemas",
        "--design-system",
        "design/system.json",
        "--out",
        "site"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/title"
        }
      ],
      "files": {
        "site/memo.html": null,
        "site/bad.html": null
      }
    }
  ],
  "raw": {
    "design/templates/system-memo.html": "<h1 class=\"{{.Tokens.heading}}\">{{.Value.title}}</h1>"
  }
}
