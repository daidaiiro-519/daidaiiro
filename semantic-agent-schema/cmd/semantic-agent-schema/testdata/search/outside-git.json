{
  "title": "Git のリポジトリの外では、working tree が決まらないので rejected（not_in_git）を返す。next は同じコマンド",
  "git": false,
  "files": {
    "a.json": {
      "title": "t"
    }
  },
  "steps": [
    {
      "args": [
        "search",
        "a.json",
        "--where",
        "/title=\"t\""
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "not_in_git",
          "/next": "semantic-agent-schema search a.json --where <同じ条件>"
        }
      ]
    }
  ]
}
