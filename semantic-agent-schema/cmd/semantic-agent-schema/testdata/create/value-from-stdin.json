        "--schemas",
        "schemas",
        "--value",
        "-"
      ],
      "stdin": "{\"$schema\": \"urn:example:memo:v1\", \"title\": \"定例会議\"}",
      "exit": 0,
      "events": [
        {
          "/event": "change",
          "/path": "notes/memo.json",
          "/contentHash": {
            "$sha256": "notes/memo.json"
