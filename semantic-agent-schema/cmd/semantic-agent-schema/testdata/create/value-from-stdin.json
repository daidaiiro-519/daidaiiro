{
  "title": "JSON ドキュメントを先に持っているときは、procedure を依頼せず標準入力から直接渡して作る",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    }
  },
  "steps": [
    {
      "args": [
        "create",
