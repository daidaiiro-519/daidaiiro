{
  "title": "渡した JSON ドキュメントが JSON として読めないと invalid_json の rejected を返す",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    }
  },
  "steps": [
    {
      "args": [
        "create",
        "memo.json",
        "--schemas",
        "schemas",
        "--json",
        "{\"title\": "
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "invalid_json",
          "/next": "semantic-agent-schema create memo.json --schemas schemas --json '<直した JSON ドキュメント>'"
        }
      ],
      "files": {
        "memo.json": null
      }
    }
  ]
}
