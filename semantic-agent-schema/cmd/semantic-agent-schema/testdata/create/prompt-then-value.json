{
  "title": "作成の prompt を依頼し、prompt に従って作った JSON ドキュメントを渡すと、2文字の字下げと末尾の改行にそろえて path に作り、 change を返す",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    }
  },
  "steps": [
    {
      "args": [
        "semantic",
        "create",
        "memo.json",
        "--schemas",
        "schemas",
        "--schema",
        "urn:example:memo:v1"
      ],
      "exit": 0,
      "events": [
        {
          "/prompt/path": "memo.json",
          "/prompt/response": {
            "$ref": "urn:example:memo:v1"
          },
          "/prompt/steps": [
            {
              "keywordLocation": "#",
              "title": "メモ",
              "description": "会議のメモ"
            },
            {
              "keywordLocation": "#/properties/title",
              "title": "題名",
              "x-prompt": {
                "meaning": "メモの題名",
                "when": "メモを書くとき",
                "rules": [
                  {
                    "id": "title-short",
                    "rule": "20 文字以内で書く",
                    "why": "一覧で読める長さにする",
                    "check": "20 文字以内か",
                    "related_fields": [],
                    "bad": [],
                    "good": [
                      {
                        "value": "定例会議"
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "/prompt/next": "semantic-agent-schema create memo.json --schemas schemas --json '<response の形に従う JSON ドキュメント>'",
          "/event": "generation_requested"
        }
      ],
      "files": {
        "memo.json": null
      }
    },
    {
      "args": [
        "create",
        "memo.json",
        "--schemas",
        "schemas",
        "--json",
        "{\"$schema\": \"urn:example:memo:v1\", \"title\": \"定例会議\"}"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "created",
          "/id": 1,
          "/path": "memo.json",
          "/schemaId": "urn:example:memo:v1",
          "/contentHash": {
            "$sha256": "memo.json"
          },
          "/next": "semantic-agent-schema semantic validate memo.json --schemas schemas"
        }
      ],
      "files": {
        "memo.json": "{\n  \"$schema\": \"urn:example:memo:v1\",\n  \"title\": \"定例会議\"\n}\n"
      }
    },
    {
      "args": [
        "validate",
        "memo.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/counts/violated": 0
        }
      ]
    }
  ]
}
