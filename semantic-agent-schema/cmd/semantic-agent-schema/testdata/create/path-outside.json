{
  "title": "path のディレクトリのシンボリックリンクの先が working tree の外なら rejected を返し、外に書かない",
  "files": {
    "schemas/memo.json": {
      "$fixture": "memo.schema.json"
    }
  },
  "outside": {
    "elsewhere/keep.json": {}
  },
  "links": {
    "out": "../elsewhere"
  },
  "steps": [
    {
      "args": [
        "create",
        "out/memo.json",
        "--schemas",
        "schemas",
        "--value",
        "{\"$schema\": \"urn:example:memo:v1\", \"title\": \"定例会議\"}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "path_outside",
          "/next": "semantic-agent-schema create <working tree の中の path> --schemas schemas --value '<JSON ドキュメント>'"
        }
      ]
    }
  ]
}
