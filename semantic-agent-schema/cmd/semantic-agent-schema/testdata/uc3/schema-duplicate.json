{
  "title": "同じ $id の Concrete が schemas に2つある：error",
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    },
    "schemas/copy.json": {
      "$fixture": "order.schema.json"
    },
    "order.json": {
      "$schema": "urn:example:order:v1",
      "items": [
        {
          "price": 110
        }
      ]
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "order.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "schema_duplicate"
        }
      ]
    }
  ]
}
