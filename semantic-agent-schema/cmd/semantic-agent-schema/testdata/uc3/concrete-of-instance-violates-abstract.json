{
  "title": "インスタンスの Concrete が Abstract に違反すると、Concrete のファイルの path を持つ schema_violation の error を返す",
  "files": {
    "schemas/a.json": {
      "$schema": "urn:semantic-agent-schema:abstract:v1",
      "$id": "urn:example:a:v1",
      "required": [
        "$schema"
      ],
      "properties": {
        "$schema": {
          "const": "urn:example:a:v1"
        },
        "name": {
          "type": "string",
          "x-view": "name"
        }
      }
    },
    "a.json": {
      "$schema": "urn:example:a:v1",
      "name": "x"
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "a.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "schema_violation",
          "/instanceLocation": "/properties/name/x-view",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:dialect:v1#/properties/x-view",
          "/instruction": {
            "$prefix": "schemas/a.json の /properties/name/x-view を urn:semantic-agent-schema:dialect:v1#/properties/x-view に合うように直す"
          }
        }
      ]
    }
  ]
}
