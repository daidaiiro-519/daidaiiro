{
  "title": "範囲の path のファイルが無い：error。next は作成の procedure の依頼",
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "missing.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "error",
          "/code": "file_not_found",
          "/next": "semantic-agent-schema create missing.json --schemas schemas --semantic --schema-id <Concrete の $id>"
        }
      ]
    }
  ]
}
