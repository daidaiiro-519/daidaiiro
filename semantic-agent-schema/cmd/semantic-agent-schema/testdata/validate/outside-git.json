{
  "title": "Git のリポジトリの外：操作の記録に追記できないので rejected",
  "git": false,
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    },
    "order.json": {
      "$schema": "urn:example:order:v1",
      "items": [
        {
          "price": 110
        }
      ]
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "order.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "log_unavailable"
        }
      ]
    }
  ]
}
