{
  "title": "JSON として読めない JSON ドキュメントは invalid_json の rejected を返す",
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    }
  },
  "raw": {
    "broken.json": "{\"$schema\": "
  },
  "steps": [
    {
      "args": [
        "validate",
        "broken.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "invalid_json",
          "/next": "semantic-agent-schema validate broken.json --schemas schemas"
        }
      ]
    }
  ]
}
