{
  "title": "範囲の JSON ドキュメントが Concrete を満たすと、violated が0件の counts を返し、まだ判定していない rule と instance location の組を not-judged として数えて semantic validate の next を返す。検証するたびに操作の ID が付く",
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    },
    "order.json": {
      "$schema": "urn:example:order:v1",
      "items": [
        {
          "price": 110
        }
      ]
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "order.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/id": 1,
          "/path": "order.json",
          "/schemaId": "urn:example:order:v1",
          "/contentHash": {
            "$sha256": "order.json"
          },
          "/judgments": [
            {
              "rule": "price-tax",
              "instanceLocation": "/items/0/price",
              "verdict": "not-judged",
              "by": "ai",
              "reason": "意味的な検証で、まだ判定していない"
            }
          ],
          "/counts/verified": 0,
          "/counts/violated": 0,
          "/counts/unverified": 0,
          "/counts/not-judged": 1,
          "/next": "semantic-agent-schema semantic validate order.json --schemas schemas"
        }
      ]
    },
    {
      "args": [
        "validate",
        "order.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/id": 2,
          "/path": "order.json"
        }
      ]
    }
  ]
}
