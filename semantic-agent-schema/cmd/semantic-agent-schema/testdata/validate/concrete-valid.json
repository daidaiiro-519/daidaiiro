{
  "title": "Concrete を Abstract で検証し、作法を満たす",
  "files": {
    "schemas/order.json": {
      "$fixture": "order.schema.json"
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "schemas/order.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "validated",
          "/path": "schemas/order.json",
          "/schemaId": "urn:semantic-agent-schema:abstract:v1",
          "/counts/verified": 0,
          "/counts/violated": 0,
          "/counts/unverified": 0,
          "/next": "semantic-agent-schema semantic validate schemas/order.json --schemas schemas"
        }
      ]
    }
  ]
}
