        "--schemas",
        "schemas",
        "--patch",
        "[{\"op\": \"replace\", \"path\": \"/start\", \"value\": \"2026-02-15\"}]"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "updated",
          "/next": "semantic-agent-schema semantic validate plan.json --schemas schemas"
        }
      ]
    },
    {
