      "exit": 0,
      "events": [
        {
          "/event": "judgment_requested",
          "/prompt/steps": [
            {
              "instanceLocation": "/end",
              "keywordLocation": "#/properties/end",
              "rule": "end-after-start"
            },
            {
              "instanceLocation": "/title",
              "keywordLocation": "#/properties/title",
              "rule": "title-short"
            }
          ],
          "/prompt/subschemas": [
            {
              "keywordLocation": "#/properties/end",
              "title": "終わりの日",
              "x-prompt": {
                "meaning": "計画の終わりの日",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "end-after-start",
                    "rule": "終わりの日は始まりの日より後にする",
                    "why": "期間として読めるようにする",
                    "check": "/end が /start より後か",
                    "related_fields": [
                      "/start"
                    ],
                    "bad": [
                      {
                        "value": "2026-01-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ],
                    "good": [
                      {
                        "value": "2026-03-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "keywordLocation": "#/properties/title",
              "title": "題名",
              "x-prompt": {
                "meaning": "計画の題名",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "title-short",
                    "rule": "20 文字以内で書く",
                    "why": "一覧で読める長さにする",
                    "check": "20 文字以内か",
                    "related_fields": [],
                    "bad": [],
                    "good": [
                      {
                        "value": "春の計画"
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{\"hash\": \"{sha256 plan.json}\", \"judgments\": [{\"rule\": \"end-after-start\", \"instanceLocation\": \"/end\", \"verdict\": \"verified\", \"reason\": \"rule の check に照らした\"}, {\"rule\": \"title-short\", \"instanceLocation\": \"/title\", \"verdict\": \"verified\", \"reason\": \"rule の check に照らした\"}]}"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "judged",
          "/counts/verified": 2
        }
      ]
    },
    {
      "args": [
