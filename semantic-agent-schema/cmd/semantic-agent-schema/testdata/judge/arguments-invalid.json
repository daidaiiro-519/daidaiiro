{
  "title": "引数が意味的な検証の引数の形に違反すると rejected を返す（path が2つ ・ semantic validate に --judgments ・ --all だけ ・ 知らないフラグ）",
  "files": {
    "schemas/plan.json": {
      "$fixture": "plan.schema.json"
    },
    "plan.json": {
      "$schema": "urn:example:plan:v1",
      "title": "春の計画",
      "start": "2026-02-01",
      "end": "2026-03-01"
    }
  },
  "steps": [
    {
      "args": [
        "semantic",
        "validate",
        "plan.json",
        "plan.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "arguments_invalid",
          "/instanceLocation": "/paths",
          "/next": "semantic-agent-schema semantic validate <直した引数>"
        }
      ]
    },
    {
      "args": [
        "semantic",
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{\"hash\": \"{sha256 plan.json}\", \"judgments\": [{\"rule\": \"end-after-start\", \"instanceLocation\": \"/end\", \"verdict\": \"verified\", \"reason\": \"rule の check に照らした\"}, {\"rule\": \"title-short\", \"instanceLocation\": \"/title\", \"verdict\": \"verified\", \"reason\": \"rule の check に照らした\"}]}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "arguments_invalid"
        }
      ]
    },
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--all"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "arguments_invalid"
        }
      ]
    },
    {
      "args": [
        "semantic",
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--depth",
        "1"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "arguments_invalid"
        }
      ]
    }
  ]
}
