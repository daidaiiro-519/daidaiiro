{
  "title": "機械的な検証の違反があると、判定の prompt の counts に数え、judged の next は JSON Patch で直す update にする",
  "files": {
    "schemas/plan.json": {
      "$fixture": "plan.schema.json"
    },
    "plan.json": {
      "$schema": "urn:example:plan:v1",
      "title": "春の計画",
      "start": "2026-02-30",
      "end": "2026-03-01"
    }
  },
  "steps": [
    {
      "args": [
        "semantic",
        "validate",
        "plan.json",
        "--schemas",
        "schemas"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "judgment_requested",
          "/counts/violated": 1,
          "/prompt/steps": [
            {
              "instanceLocation": "/end",
              "title": "終わりの日",
              "x-prompt": {
                "meaning": "計画の終わりの日",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "end-after-start",
                    "rule": "終わりの日は始まりの日より後にする",
                    "why": "期間として読めるようにする",
                    "check": "/end が /start より後か",
                    "related_fields": [
                      "/start"
                    ],
                    "bad": [
                      {
                        "value": "2026-01-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ],
                    "good": [
                      {
                        "value": "2026-03-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ]
                  }
                ]
              },
              "rule": "end-after-start"
            },
            {
              "instanceLocation": "/title",
              "title": "題名",
              "x-prompt": {
                "meaning": "計画の題名",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "title-short",
                    "rule": "20 文字以内で書く",
                    "why": "一覧で読める長さにする",
                    "check": "20 文字以内か",
                    "related_fields": [],
                    "bad": [],
                    "good": [
                      {
                        "value": "春の計画"
                      }
                    ]
                  }
                ]
              },
              "rule": "title-short"
            }
          ]
        }
      ]
    },
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{\"hash\": \"{sha256 plan.json}\", \"judgments\": [{\"rule\": \"end-after-start\", \"instanceLocation\": \"/end\", \"verdict\": \"unverified\", \"reason\": \"rule の check に照らした\"}, {\"rule\": \"title-short\", \"instanceLocation\": \"/title\", \"verdict\": \"verified\", \"reason\": \"rule の check に照らした\"}]}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "judged",
          "/counts": {
            "verified": 1,
            "violated": 1,
            "unverified": 1,
            "not-judged": 0
          },
          "/judgments/0/by": "machine",
          "/next": "semantic-agent-schema update plan.json --schemas schemas --patch '<violated の instance location を直す JSON Patch>'"
        }
      ]
    }
  ]
}
