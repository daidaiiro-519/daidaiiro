{
  "title": "judgments が形に違反するか JSON として読めないと rejected を返し、操作の記録に追記しない",
  "files": {
    "schemas/plan.json": {
      "$fixture": "plan.schema.json"
    },
    "plan.json": {
      "$schema": "urn:example:plan:v1",
      "title": "春の計画",
      "start": "2026-02-01",
      "end": "2026-03-01"
    }
  },
  "steps": [
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{\"hash\": \"{sha256 plan.json}\", \"judgments\": [{\"rule\": \"title-short\", \"instanceLocation\": \"/title\", \"verdict\": \"ok\", \"reason\": \"r\"}]}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/instanceLocation": "/judgments/0/verdict",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:judgment-response:v1#/properties/judgments/items/properties/verdict/enum",
          "/next": "semantic-agent-schema validate plan.json --schemas schemas --judgments '<違反を直した judgments>'"
        }
      ]
    },
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{\"judgments\": []}"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "schema_violation",
          "/absoluteKeywordLocation": "urn:semantic-agent-schema:judgment-response:v1#/required"
        }
      ]
    },
    {
      "args": [
        "validate",
        "plan.json",
        "--schemas",
        "schemas",
        "--judgments",
        "{"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "invalid_json"
        }
      ]
    },
    {
      "args": [
        "semantic",
        "validate",
        "plan.json",
        "--schemas",
        "schemas"
      ],
      "exit": 0,
      "events": [
        {
          "/event": "judgment_requested",
          "/prompt/steps": [
            {
              "instanceLocation": "/end",
              "title": "終わりの日",
              "x-prompt": {
                "meaning": "計画の終わりの日",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "end-after-start",
                    "rule": "終わりの日は始まりの日より後にする",
                    "why": "期間として読めるようにする",
                    "check": "/end が /start より後か",
                    "related_fields": [
                      "/start"
                    ],
                    "bad": [
                      {
                        "value": "2026-01-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ],
                    "good": [
                      {
                        "value": "2026-03-01",
                        "related": {
                          "/start": "2026-02-01"
                        }
                      }
                    ]
                  }
                ]
              },
              "rule": "end-after-start"
            },
            {
              "instanceLocation": "/title",
              "title": "題名",
              "x-prompt": {
                "meaning": "計画の題名",
                "when": "計画を書くとき",
                "rules": [
                  {
                    "id": "title-short",
                    "rule": "20 文字以内で書く",
                    "why": "一覧で読める長さにする",
                    "check": "20 文字以内か",
                    "related_fields": [],
                    "bad": [],
                    "good": [
                      {
                        "value": "春の計画"
                      }
                    ]
                  }
                ]
              },
              "rule": "title-short"
            }
          ]
        }
      ]
    }
  ]
}
