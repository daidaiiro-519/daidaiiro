{
  "title": "Git のリポジトリの外では、working tree が決まらないので rejected を返す",
  "git": false,
  "files": {
    "a.json": {}
  },
  "steps": [
    {
      "args": [
        "log",
        "--limit",
        "3"
      ],
      "exit": 1,
      "events": [
        {
          "/event": "rejected",
          "/code": "not_in_git",
          "/next": "semantic-agent-schema log --limit 3"
        }
      ]
    }
  ]
}
