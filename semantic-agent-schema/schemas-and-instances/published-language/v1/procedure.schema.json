{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:published-language:procedure:v1",
 "title": "手順のプロンプト",
 "description": "SAS が Concrete の rule ・ 当たる所から組み、SAS が起動した子セッション（AI）に渡す手順。子セッションは steps を順に行い、answer の形の JSON だけを返す。意味の部分を含む操作では、子セッションに渡す前に CLI の標準出力へ同じものを1行ずつ出す（呼び出し元が、答えを待つ前に何を頼んだかを読めるように）。子セッションとのやりとりの途中は標準エラーに出る",
 "type": "object",
 "required": [
  "$schema",
  "kind",
  "operation_kind",
  "target",
  "steps",
  "answer",
  "constraints"
 ],
 "properties": {
  "$schema": {
   "const": "urn:semantic-agent-schema:published-language:procedure:v1"
  },
  "kind": {
   "const": "procedure"
  },
  "operation_kind": {
   "enum": [
    "validate",
    "write"
   ],
   "description": "validate は rule の判定、write は欄の値を書かせる"
  },
  "target": {
   "type": "object",
   "required": [
    "path",
    "concrete"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "concrete": {
     "type": "string"
    },
    "hash": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$",
     "description": "対象の中身のハッシュ（SHA-256）。作成には無い。SAS は答えを受けたときに対象が変わっていないかを比べる"
    }
   }
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "no",
     "action",
     "pointer",
     "rules"
    ],
    "properties": {
     "no": {
      "type": "integer",
      "minimum": 1
     },
     "action": {
      "enum": [
       "judge",
       "write"
      ]
     },
     "pointer": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "rules": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "current": {
      "description": "いまの値。判定ではいつもあり、書き込みでは更新のときだけある"
     },
     "read": {
      "type": "object",
      "description": "欄の読み方（x-prompt の read）"
     },
     "reads": {
      "type": "array",
      "description": "rule の reads が指す所。判定では値も入る。書き込みでは先に書く欄",
      "items": {
       "type": "object",
       "required": [
        "pointer"
       ],
       "properties": {
        "pointer": {
         "type": "string"
        },
        "value": true
       }
      }
     },
     "inner_rules": {
      "type": "array",
      "description": "欄の中（入れ子 ・ 配列の要素 ・ $ref の先）の rule と、その所の形（* は配列の要素か名前を選ばない欄）。書き込みのときだけ",
      "items": {
       "type": "object",
       "required": [
        "pointer",
        "rules"
       ],
       "properties": {
        "pointer": {
         "type": "string"
        },
        "rules": {
         "type": "array",
         "items": {
          "type": "object"
         }
        }
       }
      }
     },
     "optional": {
      "type": "boolean",
      "description": "書く元のスキーマが求めない欄。書かないなら答えから外してよい"
     }
    }
   }
  },
  "answer": {
   "type": "object"
  },
  "constraints": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "about": {
   "type": "object",
   "description": "書く文書（Concrete の title ・ description ・ read）。書き込みのときだけ",
   "properties": {
    "title": {
     "type": "string"
    },
    "description": {
     "type": "string"
    },
    "read": {
     "type": "object"
    }
   }
  },
  "brief": {
   "type": "string",
   "description": "何を書くかの依頼（--brief）。書き込みのときだけ"
  },
  "refs": {
   "type": "array",
   "description": "SAS が読んだ資料（--ref）。子セッションはファイルを開けないので中身を入れる",
   "items": {
    "type": "object",
    "required": [
     "path",
     "hash",
     "text"
    ],
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string"
     },
     "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "text": {
      "type": "string"
     }
    }
   }
  },
  "not_written": {
   "type": "array",
   "description": "子セッションに書かせない欄と、その理由",
   "items": {
    "type": "object",
    "required": [
     "pointer",
     "why"
    ],
    "properties": {
     "pointer": {
      "type": "string"
     },
     "why": {
      "type": "string"
     }
    }
   }
  },
  "rules": {
   "type": "array",
   "items": {
    "type": "object"
   },
   "description": "文書全体に当たる rule（書く元のスキーマの根の x-prompt の write）。書き込みのときだけ"
  }
 },
 "additionalProperties": false
}
