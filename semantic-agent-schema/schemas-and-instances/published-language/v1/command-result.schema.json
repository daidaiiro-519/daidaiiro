{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:published-language:command-result:v1",
 "title": "sas が返す結果",
 "description": "sas のコマンドが標準出力へ返す結果の JSON の1行。kind で、検証の結果（validation）・ 作成 ・ 更新 ・ 削除の結果（change）・ 描画の結果（render）・ sas init で登録したセッション（session）・ sas log の一覧の1行（operation）・ 検索の結果（search）・ 始められなかった ・ 書かなかった ・ 取り込まなかった理由（error）を分ける。意味の部分（--semantic）は、結果の行の代わりに手順（procedure.schema.json に従う行）を出す。SAS はエージェントを起動しない。sas log --operation は、記録にある1件を書いたとき ・ 検証したときと同じ change ・ validation の形で返す。$defs はステップごとに足す",
 "type": "object",
 "required": [
  "$schema",
  "kind"
 ],
 "properties": {
  "$schema": {
   "const": "urn:semantic-agent-schema:published-language:command-result:v1"
  },
  "kind": {
   "enum": [
    "validation",
    "change",
    "render",
    "session",
    "operation",
    "search",
    "error"
   ]
  }
 },
 "oneOf": [
  {
   "$ref": "#/$defs/validation"
  },
  {
   "$ref": "#/$defs/change"
  },
  {
   "$ref": "#/$defs/render"
  },
  {
   "$ref": "#/$defs/session-registered"
  },
  {
   "$ref": "#/$defs/operation"
  },
  {
   "$ref": "#/$defs/search"
  },
  {
   "$ref": "#/$defs/error"
  }
 ],
 "$defs": {
  "verdict": {
   "enum": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "description": "rule の結果の判定の5つの区分。unverified は判定したセッションが判定できないと答えたもの、unsupported は意味の判定を渡されていない（--answer の無い検証）もの"
  },
  "counts": {
   "type": "object",
   "description": "判定の5つの区分ごとの件数",
   "required": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "additionalProperties": false,
   "properties": {
    "verified": {
     "type": "integer",
     "minimum": 0
    },
    "violated": {
     "type": "integer",
     "minimum": 0
    },
    "unverified": {
     "type": "integer",
     "minimum": 0
    },
    "error": {
     "type": "integer",
     "minimum": 0
    },
    "unsupported": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "hash": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "description": "対象の中身（バイト列）の SHA-256"
  },
  "rule-result": {
   "type": "object",
   "required": [
    "rule",
    "pointer",
    "by",
    "result",
    "reason"
   ],
   "additionalProperties": false,
   "properties": {
    "rule": {
     "type": "string",
     "minLength": 1,
     "description": "rule の id。JSON Schema の形の検査は json-schema"
    },
    "pointer": {
     "type": "string",
     "description": "対象の中の当たる所（JSON Pointer）"
    },
    "by": {
     "enum": [
      "machine",
      "ai"
     ],
     "description": "machine は SAS が機械で判定したもの（形の検査 json-schema ・ Concrete の組み込みの検査 ・ デザインシステムの検査）、ai は打ったセッションが sas validate --answer で渡した判定"
    },
    "result": {
     "$ref": "#/$defs/verdict"
    },
    "reason": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "path",
    "kind",
    "schema",
    "hash",
    "operation",
    "results",
    "counts"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "type": "string",
     "description": "リポジトリの根からの経路"
    },
    "kind": {
     "enum": [
      "concrete",
      "instance",
      "design-system"
     ],
     "description": "design-system はデザインシステム（受け取りの型とテンプレートの書き方の契約に照らす。ステップ5）"
    },
    "schema": {
     "type": "string",
     "description": "従う schema の $id（Concrete なら Abstract の版、デザインシステムなら受け取りの型）"
    },
    "hash": {
     "$ref": "#/$defs/hash"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "この対象の検証を記録した操作の ID"
    },
    "results": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/rule-result"
     },
     "minItems": 1
    },
    "counts": {
     "$ref": "#/$defs/counts"
    },
    "unchanged_rules": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "入力が変わった rule だけを検証したとき、読んだ所が前の判定と同じで判定し直さなかった rule の id"
    }
   }
  },
  "validation": {
   "type": "object",
   "required": [
    "kind",
    "session",
    "operations",
    "targets",
    "counts",
    "unrecorded"
   ],
   "properties": {
    "kind": {
     "const": "validation"
    },
    "session": {
     "$ref": "#/$defs/session"
    },
    "operations": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^o-[0-9]{4,}$"
     }
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/target"
     }
    },
    "counts": {
     "$ref": "#/$defs/counts"
    },
    "stale_only": {
     "const": true,
     "description": "入力が変わった rule だけを検証した（--stale）。results には判定し直した rule だけが入る"
    },
    "unchanged_targets": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "入力が変わった rule が1つも無く、検証の操作を記録しなかった対象の経路"
    },
    "unrecorded": {
     "type": "array",
     "description": "SAS を通らない変更があった対象。記録の最後の事後と、いまの中身のハッシュが違う。いまの中身を検証した",
     "items": {
      "type": "object",
      "required": [
       "path",
       "last_operation",
       "expected",
       "actual"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "last_operation": {
        "type": "string",
        "pattern": "^o-[0-9]{4,}$",
        "description": "対象を最後に書いた操作の ID"
       },
       "expected": {
        "$ref": "#/$defs/hash",
        "description": "その操作の事後のハッシュ"
       },
       "actual": {
        "$ref": "#/$defs/hash",
        "description": "いまの中身のハッシュ"
       }
      }
     }
    },
    "hint": {
     "type": "string",
     "minLength": 1,
     "description": "SAS を通らない変更があったときの、取り込みの案内"
    },
    "at": {
     "type": "string",
     "title": "記録した日時",
     "description": "操作を記録した日時（UTC の RFC 3339）。sas log --operation で記録から読んだときだけ持つ"
    }
   }
  },
  "field-change": {
   "type": "object",
   "description": "変わった欄1つ。add は before を、remove は after を持たない。値が null のときは null を持つ。前の中身のコミットが無い取り込みでは replace で before を持たず、before_unavailable が true",
   "required": [
    "pointer",
    "change"
   ],
   "additionalProperties": false,
   "properties": {
    "pointer": {
     "type": "string",
     "description": "変わった欄（JSON Pointer）"
    },
    "change": {
     "enum": [
      "add",
      "remove",
      "replace"
     ]
    },
    "before": {
     "description": "前の値"
    },
    "after": {
     "description": "後の値"
    },
    "before_unavailable": {
     "const": true,
     "description": "前の値が取れなかった（SAS を通らない変更の取り込みで、記録の最後の事後と同じ中身のコミットが無い）"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "change": {
        "const": "add"
       }
      }
     },
     "then": {
      "required": [
       "after"
      ],
      "not": {
       "required": [
        "before"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "remove"
       }
      }
     },
     "then": {
      "required": [
       "before"
      ],
      "not": {
       "required": [
        "after"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "replace"
       }
      }
     },
     "then": {
      "required": [
       "after"
      ],
      "if": {
       "required": [
        "before_unavailable"
       ]
      },
      "then": {
       "not": {
        "required": [
         "before"
        ]
       }
      },
      "else": {
       "required": [
        "before"
       ]
      }
     }
    }
   ]
  },
  "side": {
   "type": "object",
   "required": [
    "hash"
   ],
   "additionalProperties": false,
   "properties": {
    "hash": {
     "$ref": "#/$defs/hash"
    },
    "commit": {
     "type": "string",
     "minLength": 1,
     "description": "欄ごとの前の値を取ったコミット（更新の取り込みだけ。Abstract の版とは別のもの）"
    }
   }
  },
  "diff": {
   "type": "object",
   "description": "前後の中身から JSON Pointer ごとに求めた差分（Git の行の差分は使わない）。作成では before が無い。更新の取り込みの前の値は、記録の最後の事後と同じ中身のコミットから取る。削除では after が無く、changes は消す前の根の欄ごとの remove",
   "required": [
    "source",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "enum": [
      "sas",
      "outside"
     ],
     "description": "sas は SAS が書いた変更、outside は SAS を通らない変更の取り込み（--adopt）"
    },
    "before": {
     "$ref": "#/$defs/side"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    },
    "before_unavailable": {
     "type": "boolean",
     "description": "更新の取り込みだけが持つ。true なら前の中身のコミットが無く、changes はいまの中身の根の欄ごとに前の値を持たない"
    }
   }
  },
  "change": {
   "type": "object",
   "required": [
    "kind",
    "session",
    "operation",
    "result",
    "replayed",
    "target",
    "diff",
    "stale_judgments",
    "violated_instances"
   ],
   "properties": {
    "kind": {
     "const": "change"
    },
    "session": {
     "$ref": "#/$defs/session"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "作成 ・ 更新 ・ 削除の操作の ID"
    },
    "result": {
     "enum": [
      "created",
      "updated",
      "adopted",
      "deleted"
     ],
     "description": "adopted は SAS を通らない変更を取り込んだ（ファイルは書いていない）。作成か更新かは diff の before の有無で分かる。deleted は消した（diff は消す前の状態で after を持たない）"
    },
    "replayed": {
     "type": "boolean",
     "description": "同じ request_id の操作がすでにあり、書かずにそれを返したか。true のときの stale_judgments と violated_instances は空（記録にあるのは差分だけ）。sas log --operation で記録から読んだときは false で、stale_judgments と violated_instances は空（記録にあるのは差分だけ）"
    },
    "target": {
     "type": "object",
     "required": [
      "kind",
      "path",
      "schema"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "concrete",
        "instance"
       ]
      },
      "path": {
       "type": "string",
       "description": "リポジトリの根からの経路"
      },
      "schema": {
       "type": "string",
       "description": "従う schema の $id（インスタンスなら Concrete、Concrete なら Abstract の版）"
      }
     }
    },
    "diff": {
     "$ref": "#/$defs/diff"
    },
    "stale_judgments": {
     "type": "array",
     "description": "前の検証の判定のうち、読む所がこの変更で変わったもの。もう効かない",
     "items": {
      "type": "object",
      "required": [
       "rule",
       "pointer",
       "operation"
      ],
      "additionalProperties": false,
      "properties": {
       "rule": {
        "type": "string",
        "minLength": 1
       },
       "pointer": {
        "type": "string"
       },
       "operation": {
        "type": "string",
        "pattern": "^o-[0-9]{4,}$",
        "description": "その判定を記録した検証の操作の ID"
       }
      }
     }
    },
    "violated_instances": {
     "type": "array",
     "description": "Concrete の更新で、新しい形に従わなくなったインスタンス。呼ぶ側がそれぞれに UC2 を呼ぶ",
     "items": {
      "type": "object",
      "required": [
       "path",
       "results"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "results": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/rule-result"
        },
        "minItems": 1
       }
      }
     }
    },
    "at": {
     "type": "string",
     "title": "記録した日時",
     "description": "操作を記録した日時（UTC の RFC 3339）。sas log --operation で記録から読んだときだけ持つ"
    },
    "reason": {
     "type": "string",
     "title": "理由",
     "description": "操作の理由（呼ぶ側が渡したときだけ）。sas log --operation で記録から読んだときだけ持つ"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "result": {
        "const": "deleted"
       }
      }
     },
     "then": {
      "properties": {
       "diff": {
        "required": [
         "before"
        ],
        "not": {
         "required": [
          "after"
         ]
        }
       }
      }
     },
     "else": {
      "properties": {
       "diff": {
        "required": [
         "after"
        ]
       }
      }
     }
    }
   ]
  },
  "error": {
   "type": "object",
   "required": [
    "kind",
    "code",
    "message"
   ],
   "properties": {
    "kind": {
     "const": "error"
    },
    "code": {
     "enum": [
      "usage",
      "schema_not_listed",
      "unknown_schema",
      "no_schema",
      "not_found",
      "not_json",
      "exists",
      "invalid_input",
      "request_reused",
      "store",
      "validator",
      "log",
      "invalid_value",
      "conflict",
      "patch_failed",
      "human_field",
      "published_changed",
      "recorded",
      "not_recorded",
      "nothing_to_adopt",
      "versions",
      "has_dependents",
      "missing_view_kinds",
      "template",
      "out",
      "invalid_design_system",
      "reads_cycle",
      "ref_too_large",
      "invalid_answer",
      "range_too_large"
     ],
     "description": "決まった名前。schema_not_listed は、申告した Abstract の版が閉じた一覧に無く、取りに行かなかったこと。invalid_value から published_changed までの5つは書く手前で断った作成 ・ 更新で、記録せず、理由と案内をその場で返す。recorded ・ not_recorded ・ nothing_to_adopt は取り込みの前提に合わない（作成の取り込みで記録がすでにある ・ 更新の取り込みで記録が無い ・ 外の変更が無い）こと、versions はコミット済みの版を読めなかったこと。has_dependents は止めた削除（Concrete に従うインスタンスがある）で、記録せず、blocked に理由になった文書を返す。reads_cycle ・ ref_too_large は意味で書く手順を組めなかったこと（rule の reads が読み合う ・ 資料が上限を超える）。invalid_answer は sas validate --answer の判定が答えの形か手順の step ・ rule ・ pointer に合わないことで、記録しない。--answer の判定のハッシュがいまの中身と違うときは conflict（interleaved を持たず、手順を取り直すコマンドを hint に返す）。not_found は sas log --operation の ID が記録に無いときも返す。range_too_large は sas search --semantic の範囲の中身の合計が上限を超えたこと（切り詰めずに断る）。sas search --answer の出どころが範囲の外か所が無いときは invalid_answer、ハッシュがいまの中身と違うときは conflict（interleaved を持たず、手順を取り直すコマンドを hint に返す）"
    },
    "path": {
     "type": "string"
    },
    "message": {
     "type": "string",
     "minLength": 1
    },
    "interleaved": {
     "$ref": "#/$defs/interleaved",
     "description": "conflict のときだけ持つ"
    },
    "hint": {
     "type": "string",
     "minLength": 1,
     "description": "次にすることの案内（SAS を通らない変更を取り込むコマンド、人が取り込むコマンド、手順を取り直すコマンド、判定の直し方）"
    },
    "blocked": {
     "type": "array",
     "minItems": 1,
     "description": "削除を止めた理由になった文書（と、片付けるコマンド）。has_dependents だけが持つ",
     "items": {
      "type": "object",
      "required": [
       "path",
       "code",
       "message",
       "hint"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "code": {
        "enum": [
         "follows"
        ],
        "description": "follows は Concrete に従うインスタンス"
       },
       "message": {
        "type": "string",
        "minLength": 1
       },
       "hint": {
        "type": "string",
        "minLength": 1,
        "description": "次に打つコマンド"
       }
      }
     }
    },
    "missing": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "デザインシステムに無かった x-view の種類（missing_view_kinds のとき。欠けたすべて）"
    }
   },
   "allOf": [
    {
     "if": {
      "not": {
       "properties": {
        "code": {
         "const": "conflict"
        }
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "interleaved"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "code": {
        "const": "has_dependents"
       }
      }
     },
     "then": {
      "required": [
       "blocked",
       "hint"
      ]
     },
     "else": {
      "not": {
       "required": [
        "blocked"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "code": {
        "const": "missing_view_kinds"
       }
      }
     },
     "then": {
      "required": [
       "missing"
      ]
     },
     "else": {
      "not": {
       "required": [
        "missing"
       ]
      }
     }
    }
   ]
  },
  "written-operation": {
   "type": "object",
   "description": "記録にある、対象を書いた操作1件（作成か更新で、断っていないもの）",
   "required": [
    "operation",
    "session",
    "kind",
    "source",
    "at",
    "after",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "操作の ID"
    },
    "session": {
     "$ref": "#/$defs/session"
    },
    "kind": {
     "enum": [
      "create",
      "update"
     ]
    },
    "source": {
     "enum": [
      "sas",
      "outside"
     ],
     "description": "outside は SAS を通らない変更を取り込んだ操作"
    },
    "reason": {
     "type": "string",
     "minLength": 1,
     "description": "呼ぶ側が渡した理由（なぜその操作をしたか）。渡されなかったときは無い"
    },
    "at": {
     "type": "string",
     "description": "記録した日時（UTC の RFC 3339）"
    },
    "before": {
     "$ref": "#/$defs/side",
     "description": "事前のハッシュ。作成では無い"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    }
   }
  },
  "interleaved": {
   "type": "object",
   "description": "ハッシュが違って断ったときの、間に入った変更。呼ぶ側は、理由と変わった欄を読んでから直し方を決め直す",
   "required": [
    "expected",
    "current",
    "unrecorded",
    "operations"
   ],
   "additionalProperties": false,
   "properties": {
    "expected": {
     "$ref": "#/$defs/hash",
     "description": "比べたハッシュ（--if-match か、SAS が最後に書いた事後のハッシュ）"
    },
    "current": {
     "$ref": "#/$defs/hash",
     "description": "いまの中身のハッシュ"
    },
    "unrecorded": {
     "type": "boolean",
     "description": "true なら、いまの中身は記録した操作の事後のどれでもない（SAS を通らない変更があった。--adopt で取り込む）"
    },
    "operations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/written-operation"
     },
     "description": "比べたハッシュのあとに記録された、対象を書いた操作（古い順）。事前と事後のハッシュをたどって組む"
    },
    "last_recorded": {
     "type": "object",
     "description": "最後に記録した、対象を書いた操作",
     "required": [
      "operation",
      "session",
      "at",
      "after"
     ],
     "additionalProperties": false,
     "properties": {
      "operation": {
       "type": "string",
       "pattern": "^o-[0-9]{4,}$"
      },
      "session": {
       "$ref": "#/$defs/session"
      },
      "at": {
       "type": "string"
      },
      "after": {
       "$ref": "#/$defs/side"
      }
     }
    }
   }
  },
  "session": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1,
   "description": "sas を打ったセッションの ID（--session ・ ツールの環境変数 ・ このフォルダで sas init が登録したセッションで決まる）。人なら null"
  },
  "render": {
   "type": "object",
   "required": [
    "kind",
    "design_system",
    "pages"
   ],
   "additionalProperties": false,
   "description": "描画の結果。ページは書き出す先に置き、記録しない。ページにはインスタンスの値とデザインだけが入る",
   "properties": {
    "$schema": true,
    "kind": {
     "const": "render"
    },
    "design_system": {
     "type": "object",
     "required": [
      "name",
      "version",
      "hash"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "hash": {
       "$ref": "#/$defs/hash"
      }
     }
    },
    "pages": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "target",
       "page_path",
       "views"
      ],
      "additionalProperties": false,
      "properties": {
       "target": {
        "type": "string",
        "description": "対象の経路"
       },
       "page_path": {
        "type": "string",
        "description": "書き出す先からのページの経路"
       },
       "views": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "使った x-view の種類"
       }
      }
     }
    }
   }
  },
  "session-registered": {
   "type": "object",
   "required": [
    "kind",
    "id",
    "tool",
    "folder",
    "via"
   ],
   "additionalProperties": false,
   "description": "sas init で、いまのセッションをこのフォルダの記録の相手として登録した結果。すでに記録にある ID なら、その行を書き換えずに返す",
   "properties": {
    "$schema": true,
    "kind": {
     "const": "session"
    },
    "id": {
     "type": "string",
     "minLength": 1,
     "description": "セッション ID（--session か環境変数の ID。どちらも無ければ SAS が決めたもの）"
    },
    "tool": {
     "type": "string",
     "minLength": 1,
     "description": "ツールの名前（分からなければ unknown）"
    },
    "folder": {
     "type": "string",
     "minLength": 1,
     "description": "初めて見たときに打ったフォルダ（Git の中なら作業ツリーの根、外なら作業フォルダ）"
    },
    "via": {
     "enum": [
      "env",
      "flag",
      "init"
     ],
     "description": "ID をどこから知ったか。init は sas init が登録したもの"
    }
   }
  },
  "operation": {
   "type": "object",
   "description": "sas log の一覧の1行。記録にある操作（変更と検証）1件の要約で、新しい順に1行ずつ出す。中身（変わった欄 ・ rule ごとの結果）は sas log --operation <ID> で読む。読む形は記録の表の形に依らない",
   "required": [
    "kind",
    "operation",
    "at",
    "op",
    "path",
    "session"
   ],
   "additionalProperties": false,
   "properties": {
    "$schema": true,
    "kind": {
     "const": "operation"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "title": "操作の ID",
     "description": "作成 ・ 更新 ・ 削除 ・ 検証の操作の ID"
    },
    "at": {
     "type": "string",
     "title": "記録した日時",
     "description": "操作を記録した日時（UTC の RFC 3339）"
    },
    "op": {
     "enum": [
      "create",
      "update",
      "delete",
      "validate"
     ],
     "title": "操作の種類",
     "description": "create ・ update ・ delete は書いた変更（取り込みを含む）、validate は検証"
    },
    "path": {
     "type": "string",
     "title": "対象の経路",
     "description": "リポジトリの根からの経路"
    },
    "session": {
     "type": [
      "object",
      "null"
     ],
     "title": "打ったセッション",
     "description": "操作を打ったセッション（sessions の行）。人なら null",
     "required": [
      "id",
      "tool",
      "folder"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1,
       "title": "セッション ID",
       "description": "--session ・ ツールの環境変数 ・ sas init で決まった ID"
      },
      "tool": {
       "type": "string",
       "minLength": 1,
       "title": "ツールの名前",
       "description": "claude-code など。分からなければ unknown"
      },
      "folder": {
       "type": "string",
       "minLength": 1,
       "title": "フォルダ",
       "description": "初めて見たときに打ったフォルダ（Git の中なら作業ツリーの根、外なら作業フォルダ）。--folder はこれと比べる"
      }
     }
    },
    "reason": {
     "type": "string",
     "title": "理由",
     "description": "変更の理由（呼ぶ側が渡したときだけ）"
    },
    "counts": {
     "$ref": "#/$defs/counts",
     "title": "判定の件数",
     "description": "検証のときだけ持つ。判定の5つの区分ごとの件数"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "op": {
        "const": "validate"
       }
      }
     },
     "then": {
      "required": [
       "counts"
      ],
      "not": {
       "required": [
        "reason"
       ]
      }
     },
     "else": {
      "not": {
       "required": [
        "counts"
       ]
      }
     }
    }
   ]
  },
  "search": {
   "type": "object",
   "description": "sas search の結果。探した範囲を必ず返し（範囲の外は探していない）、構造で絞ったときは matches を、意味で探した答えを --answer で渡したときは answer と、SAS が確かめた sources を持つ。検索は記録しない",
   "required": [
    "kind",
    "range"
   ],
   "additionalProperties": false,
   "properties": {
    "$schema": true,
    "kind": {
     "const": "search"
    },
    "range": {
     "type": "array",
     "title": "探した範囲",
     "description": "探した文書の経路と、そのときの中身のハッシュ（経路の順）",
     "items": {
      "type": "object",
      "required": [
       "path",
       "hash"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string",
        "title": "経路",
        "description": "リポジトリの根からの経路"
       },
       "hash": {
        "$ref": "#/$defs/hash",
        "title": "ハッシュ",
        "description": "探したときの中身のハッシュ"
       }
      }
     }
    },
    "matches": {
     "type": "array",
     "title": "一致",
     "description": "--where の条件のすべてに一致した文書の、条件の所と値",
     "items": {
      "type": "object",
      "required": [
       "path",
       "pointer",
       "value"
      ],
      "additionalProperties": false,
      "description": "一致した所1つ",
      "properties": {
       "path": {
        "type": "string",
        "title": "経路",
        "description": "値がある文書の経路（範囲の中）"
       },
       "pointer": {
        "type": "string",
        "title": "所",
        "description": "文書の中の所（JSON Pointer）"
       },
       "value": {
        "title": "値",
        "description": "その所のいまの値（SAS が文書から読んだもの）"
       }
      }
     }
    },
    "answer": {
     "type": "string",
     "minLength": 1,
     "title": "答え",
     "description": "打ったセッションが --answer で渡した、問いへの答えの文"
    },
    "sources": {
     "type": "array",
     "title": "出どころ",
     "description": "答えの根拠の所。SAS が、範囲の中か ・ ハッシュがいまの中身と同じか ・ 所があるかを確かめ、その所のいまの値を入れた",
     "items": {
      "type": "object",
      "required": [
       "path",
       "pointer",
       "value"
      ],
      "additionalProperties": false,
      "description": "出どころ1つ",
      "properties": {
       "path": {
        "type": "string",
        "title": "経路",
        "description": "値がある文書の経路（範囲の中）"
       },
       "pointer": {
        "type": "string",
        "title": "所",
        "description": "文書の中の所（JSON Pointer）"
       },
       "value": {
        "title": "値",
        "description": "その所のいまの値（SAS が文書から読んだもの）"
       }
      }
     }
    }
   },
   "oneOf": [
    {
     "required": [
      "matches"
     ],
     "not": {
      "anyOf": [
       {
        "required": [
         "answer"
        ]
       },
       {
        "required": [
         "sources"
        ]
       }
      ]
     }
    },
    {
     "required": [
      "answer",
      "sources"
     ],
     "not": {
      "required": [
       "matches"
      ]
     }
    }
   ]
  }
 }
}
