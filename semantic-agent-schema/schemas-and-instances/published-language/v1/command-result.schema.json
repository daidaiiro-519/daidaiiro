{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:published-language:command-result:v1",
 "title": "sas が返す結果",
 "description": "sas のコマンドが標準出力へ返す結果の JSON の1行。kind で、検証の結果（validation）・ 作成 ・ 更新 ・ 削除の結果（change）・ 描画の結果（render）・ 始められなかった ・ 書かなかった ・ 取り込まなかった理由（error）を分ける。意味の部分を含む操作は、結果の行の前に、子セッションに渡した手順（procedure.schema.json に従う行）を出す。$defs はステップごとに足す",
 "type": "object",
 "required": [
  "$schema",
  "kind"
 ],
 "properties": {
  "$schema": {
   "const": "urn:semantic-agent-schema:published-language:command-result:v1"
  },
  "kind": {
   "enum": [
    "validation",
    "change",
    "render",
    "error"
   ]
  }
 },
 "oneOf": [
  {
   "$ref": "#/$defs/validation"
  },
  {
   "$ref": "#/$defs/change"
  },
  {
   "$ref": "#/$defs/render"
  },
  {
   "$ref": "#/$defs/error"
  }
 ],
 "$defs": {
  "verdict": {
   "enum": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "description": "rule の結果の判定の5つの区分。unverified は人が決めるもの、unsupported は判定する手続きか相手がまだ無いもの"
  },
  "counts": {
   "type": "object",
   "description": "判定の5つの区分ごとの件数",
   "required": [
    "verified",
    "violated",
    "unverified",
    "error",
    "unsupported"
   ],
   "additionalProperties": false,
   "properties": {
    "verified": {
     "type": "integer",
     "minimum": 0
    },
    "violated": {
     "type": "integer",
     "minimum": 0
    },
    "unverified": {
     "type": "integer",
     "minimum": 0
    },
    "error": {
     "type": "integer",
     "minimum": 0
    },
    "unsupported": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "fingerprint": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$",
   "description": "対象の中身（バイト列）の SHA-256"
  },
  "rule-result": {
   "type": "object",
   "required": [
    "rule",
    "pointer",
    "by",
    "result",
    "reason"
   ],
   "additionalProperties": false,
   "properties": {
    "rule": {
     "type": "string",
     "minLength": 1,
     "description": "rule の id。JSON Schema の形の検査は json-schema"
    },
    "pointer": {
     "type": "string",
     "description": "対象の中の当たる所（JSON Pointer）"
    },
    "by": {
     "enum": [
      "machine",
      "ai"
     ],
     "description": "machine は形の検査（json-schema）と SAS の組み込みの検査、ai は検証用の子セッションの判定"
    },
    "result": {
     "$ref": "#/$defs/verdict"
    },
    "reason": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "target": {
   "type": "object",
   "required": [
    "path",
    "kind",
    "schema",
    "fingerprint",
    "operation",
    "results",
    "counts"
   ],
   "additionalProperties": false,
   "properties": {
    "path": {
     "type": "string",
     "description": "リポジトリの根からの経路"
    },
    "kind": {
     "enum": [
      "concrete",
      "instance",
      "design-system"
     ],
     "description": "design-system はデザインシステム（受け取りの型とテンプレートの書き方の契約に照らす。ステップ5）"
    },
    "schema": {
     "type": "string",
     "description": "従う schema の $id（Concrete なら Abstract の版、デザインシステムなら受け取りの型）"
    },
    "fingerprint": {
     "$ref": "#/$defs/fingerprint"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "この対象の検証を記録した操作の ID"
    },
    "results": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/rule-result"
     },
     "minItems": 1
    },
    "counts": {
     "$ref": "#/$defs/counts"
    },
    "unchanged_rules": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "入力が変わった rule だけを検証したとき、読んだ所が前の判定と同じで判定し直さなかった rule の id"
    }
   }
  },
  "validation": {
   "type": "object",
   "required": [
    "kind",
    "parent_session",
    "operations",
    "targets",
    "counts",
    "untracked"
   ],
   "properties": {
    "kind": {
     "const": "validation"
    },
    "parent_session": {
     "$ref": "#/$defs/parent-session"
    },
    "operations": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^o-[0-9]{4,}$"
     }
    },
    "targets": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/target"
     }
    },
    "counts": {
     "$ref": "#/$defs/counts"
    },
    "stale_only": {
     "const": true,
     "description": "入力が変わった rule だけを検証した（--stale）。results には判定し直した rule だけが入る"
    },
    "unchanged_targets": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "入力が変わった rule が1つも無く、検証の操作を記録しなかった対象の経路"
    },
    "untracked": {
     "type": "array",
     "description": "SAS を通らない変更があった対象。記録の最後の事後と、いまの中身の指紋が違う。いまの中身を検証した",
     "items": {
      "type": "object",
      "required": [
       "path",
       "last_operation",
       "expected",
       "actual"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "last_operation": {
        "type": "string",
        "pattern": "^o-[0-9]{4,}$",
        "description": "対象を最後に書いた操作の ID"
       },
       "expected": {
        "$ref": "#/$defs/fingerprint",
        "description": "その操作の事後の指紋"
       },
       "actual": {
        "$ref": "#/$defs/fingerprint",
        "description": "いまの中身の指紋"
       }
      }
     }
    },
    "hint": {
     "type": "string",
     "minLength": 1,
     "description": "SAS を通らない変更があったときの、取り込みの案内"
    },
    "child_session": {
     "type": "object",
     "required": [
      "id",
      "role",
      "continued",
      "started",
      "corrections",
      "restarts"
     ],
     "additionalProperties": false,
     "description": "rule を判定した検証用の子セッション（--agent のとき）",
     "properties": {
      "id": {
       "type": [
        "string",
        "null"
       ],
       "description": "判定した子セッションの ID（起動できなければ null）"
      },
      "role": {
       "const": "checker"
      },
      "continued": {
       "type": "boolean",
       "description": "--continue で続けた子か"
      },
      "started": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "この呼び出しで新しく起動した子セッションの ID"
      },
      "corrections": {
       "type": "integer",
       "minimum": 0,
       "description": "答えの形の誤りを直させた回数"
      },
      "restarts": {
       "type": "integer",
       "minimum": 0,
       "description": "時間切れで新しい子セッションにした回数"
      },
      "hint": {
       "type": "string",
       "description": "新しい子セッションを勧める案内"
      }
     }
    }
   }
  },
  "field-change": {
   "type": "object",
   "description": "変わった欄1つ。add は before を、remove は after を持たない。値が null のときは null を持つ。前の中身のコミットが無い取り込みでは replace で before を持たず、before_unavailable が true",
   "required": [
    "pointer",
    "change"
   ],
   "additionalProperties": false,
   "properties": {
    "pointer": {
     "type": "string",
     "description": "変わった欄（JSON Pointer）"
    },
    "change": {
     "enum": [
      "add",
      "remove",
      "replace"
     ]
    },
    "before": {
     "description": "前の値"
    },
    "after": {
     "description": "後の値"
    },
    "before_unavailable": {
     "const": true,
     "description": "前の値が取れなかった（SAS を通らない変更の取り込みで、記録の最後の事後と同じ中身のコミットが無い）"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "change": {
        "const": "add"
       }
      }
     },
     "then": {
      "required": [
       "after"
      ],
      "not": {
       "required": [
        "before"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "remove"
       }
      }
     },
     "then": {
      "required": [
       "before"
      ],
      "not": {
       "required": [
        "after"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "change": {
        "const": "replace"
       }
      }
     },
     "then": {
      "required": [
       "after"
      ],
      "if": {
       "required": [
        "before_unavailable"
       ]
      },
      "then": {
       "not": {
        "required": [
         "before"
        ]
       }
      },
      "else": {
       "required": [
        "before"
       ]
      }
     }
    }
   ]
  },
  "side": {
   "type": "object",
   "required": [
    "fingerprint"
   ],
   "additionalProperties": false,
   "properties": {
    "fingerprint": {
     "$ref": "#/$defs/fingerprint"
    },
    "commit": {
     "type": "string",
     "minLength": 1,
     "description": "欄ごとの前の値を取ったコミット（更新の取り込みだけ。Abstract の版とは別のもの）"
    }
   }
  },
  "diff": {
   "type": "object",
   "description": "前後の中身から JSON Pointer ごとに求めた差分（Git の行の差分は使わない）。作成では before が無い。更新の取り込みの前の値は、記録の最後の事後と同じ中身のコミットから取る。削除では after が無く、changes は消す前の根の欄ごとの remove",
   "required": [
    "source",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "source": {
     "enum": [
      "sas",
      "outside"
     ],
     "description": "sas は SAS が書いた変更、outside は SAS を通らない変更の取り込み（--adopt）"
    },
    "before": {
     "$ref": "#/$defs/side"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    },
    "before_unavailable": {
     "type": "boolean",
     "description": "更新の取り込みだけが持つ。true なら前の中身のコミットが無く、changes はいまの中身の根の欄ごとに前の値を持たない"
    }
   }
  },
  "change": {
   "type": "object",
   "required": [
    "kind",
    "parent_session",
    "operation",
    "result",
    "replayed",
    "target",
    "diff",
    "stale_rules",
    "violated_instances"
   ],
   "properties": {
    "kind": {
     "const": "change"
    },
    "parent_session": {
     "$ref": "#/$defs/parent-session"
    },
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "作成 ・ 更新 ・ 削除の操作の ID"
    },
    "result": {
     "enum": [
      "created",
      "updated",
      "adopted",
      "deleted"
     ],
     "description": "adopted は SAS を通らない変更を取り込んだ（ファイルは書いていない）。作成か更新かは diff の before の有無で分かる。deleted は消した（diff は消す前の状態で after を持たない）"
    },
    "replayed": {
     "type": "boolean",
     "description": "同じ request_id の操作がすでにあり、書かずにそれを返したか。true のときの stale_rules と violated_instances は空（記録にあるのは差分だけ）"
    },
    "target": {
     "type": "object",
     "required": [
      "kind",
      "path",
      "concrete"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "concrete",
        "instance"
       ]
      },
      "path": {
       "type": "string",
       "description": "リポジトリの根からの経路"
      },
      "concrete": {
       "type": "string",
       "description": "従う Concrete の $id（Concrete なら Abstract の版）"
      }
     }
    },
    "diff": {
     "$ref": "#/$defs/diff"
    },
    "stale_rules": {
     "type": "array",
     "description": "前の検証の判定のうち、読む所がこの変更で変わったもの。もう効かない",
     "items": {
      "type": "object",
      "required": [
       "rule",
       "pointer",
       "operation"
      ],
      "additionalProperties": false,
      "properties": {
       "rule": {
        "type": "string",
        "minLength": 1
       },
       "pointer": {
        "type": "string"
       },
       "operation": {
        "type": "string",
        "pattern": "^o-[0-9]{4,}$",
        "description": "その判定を記録した検証の操作の ID"
       }
      }
     }
    },
    "violated_instances": {
     "type": "array",
     "description": "Concrete の更新で、新しい形に従わなくなったインスタンス。呼ぶ側がそれぞれに UC2 を呼ぶ",
     "items": {
      "type": "object",
      "required": [
       "path",
       "results"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "results": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/rule-result"
        },
        "minItems": 1
       }
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "result": {
        "const": "deleted"
       }
      }
     },
     "then": {
      "properties": {
       "diff": {
        "required": [
         "before"
        ],
        "not": {
         "required": [
          "after"
         ]
        }
       }
      }
     },
     "else": {
      "properties": {
       "diff": {
        "required": [
         "after"
        ]
       }
      }
     }
    }
   ]
  },
  "error": {
   "type": "object",
   "required": [
    "kind",
    "code",
    "message"
   ],
   "properties": {
    "kind": {
     "const": "error"
    },
    "code": {
     "enum": [
      "usage",
      "schema_not_listed",
      "unknown_schema",
      "no_schema",
      "not_found",
      "not_json",
      "exists",
      "invalid_input",
      "request_reused",
      "store",
      "validator",
      "log",
      "invalid_value",
      "conflict",
      "patch_failed",
      "human_field",
      "published_changed",
      "recorded",
      "not_recorded",
      "nothing_to_adopt",
      "versions",
      "has_dependents",
      "missing_view_kinds",
      "template",
      "out",
      "invalid_design_system",
      "busy",
      "writer_as_checker",
      "launch_mismatch"
     ],
     "description": "決まった名前。schema_not_listed は、申告した Abstract の版が閉じた一覧に無く、取りに行かなかったこと。invalid_value から published_changed までの5つは書く手前で断った作成 ・ 更新で、記録せず、理由と案内をその場で返す。recorded ・ not_recorded ・ nothing_to_adopt は取り込みの前提に合わない（作成の取り込みで記録がすでにある ・ 更新の取り込みで記録が無い ・ 外の変更が無い）こと、versions はコミット済みの版を読めなかったこと。has_dependents は止めた削除（Concrete に従うインスタンスがある）で、記録せず、blocked に理由になった文書を返す。busy ・ writer_as_checker ・ launch_mismatch は検証用の子セッションを続けられないこと（同じ子セッションが処理中 ・ 書き込み用の子セッションを渡された ・ 子セッションを起動した接続の定義といまの定義の名前 ・ 版 ・ 中身の指紋のどれかが違う）で、記録しない"
    },
    "path": {
     "type": "string"
    },
    "message": {
     "type": "string",
     "minLength": 1
    },
    "interleaved": {
     "$ref": "#/$defs/interleaved",
     "description": "conflict のときだけ持つ"
    },
    "hint": {
     "type": "string",
     "minLength": 1,
     "description": "次にすることの案内（SAS を通らない変更を取り込むコマンド、人が取り込むコマンド）"
    },
    "blocked": {
     "type": "array",
     "minItems": 1,
     "description": "削除を止めた理由になった文書（と、片付けるコマンド）。has_dependents だけが持つ",
     "items": {
      "type": "object",
      "required": [
       "path",
       "code",
       "message",
       "hint"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "code": {
        "enum": [
         "follows"
        ],
        "description": "follows は Concrete に従うインスタンス"
       },
       "message": {
        "type": "string",
        "minLength": 1
       },
       "hint": {
        "type": "string",
        "minLength": 1,
        "description": "次に打つコマンド"
       }
      }
     }
    },
    "missing": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     },
     "description": "デザインシステムに無かった x-view の種類（missing_view_kinds のとき。欠けたすべて）"
    }
   },
   "allOf": [
    {
     "if": {
      "not": {
       "properties": {
        "code": {
         "const": "conflict"
        }
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "interleaved"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "code": {
        "const": "has_dependents"
       }
      }
     },
     "then": {
      "required": [
       "blocked",
       "hint"
      ]
     },
     "else": {
      "not": {
       "required": [
        "blocked"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "code": {
        "const": "missing_view_kinds"
       }
      }
     },
     "then": {
      "required": [
       "missing"
      ]
     },
     "else": {
      "not": {
       "required": [
        "missing"
       ]
      }
     }
    }
   ]
  },
  "written-operation": {
   "type": "object",
   "description": "記録にある、対象を書いた操作1件（作成か更新で、断っていないもの）",
   "required": [
    "operation",
    "parent_session",
    "kind",
    "source",
    "at",
    "after",
    "changes"
   ],
   "additionalProperties": false,
   "properties": {
    "operation": {
     "type": "string",
     "pattern": "^o-[0-9]{4,}$",
     "description": "操作の ID"
    },
    "parent_session": {
     "$ref": "#/$defs/parent-session"
    },
    "kind": {
     "enum": [
      "create",
      "update"
     ]
    },
    "source": {
     "enum": [
      "sas",
      "outside"
     ],
     "description": "outside は SAS を通らない変更を取り込んだ操作"
    },
    "intent": {
     "type": "string",
     "minLength": 1,
     "description": "呼ぶ側が渡した意図（なぜその操作をしたか）。渡されなかったときは無い"
    },
    "at": {
     "type": "string",
     "description": "記録した日時（UTC の RFC 3339）"
    },
    "before": {
     "$ref": "#/$defs/side",
     "description": "事前の指紋。作成では無い"
    },
    "after": {
     "$ref": "#/$defs/side"
    },
    "changes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/field-change"
     }
    }
   }
  },
  "interleaved": {
   "type": "object",
   "description": "指紋が違って断ったときの、間に入った変更。呼ぶ側は、意図と変わった欄を読んでから直し方を決め直す",
   "required": [
    "expected",
    "current",
    "untracked",
    "operations"
   ],
   "additionalProperties": false,
   "properties": {
    "expected": {
     "$ref": "#/$defs/fingerprint",
     "description": "比べた指紋（--if-match か、SAS が最後に書いた事後の指紋）"
    },
    "current": {
     "$ref": "#/$defs/fingerprint",
     "description": "いまの中身の指紋"
    },
    "untracked": {
     "type": "boolean",
     "description": "true なら、いまの中身は記録した操作の事後のどれでもない（SAS を通らない変更があった。--adopt で取り込む）"
    },
    "operations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/written-operation"
     },
     "description": "比べた指紋のあとに記録された、対象を書いた操作（古い順）。事前と事後の指紋をたどって組む"
    },
    "last_recorded": {
     "type": "object",
     "description": "最後に記録した、対象を書いた操作",
     "required": [
      "operation",
      "parent_session",
      "at",
      "after"
     ],
     "additionalProperties": false,
     "properties": {
      "operation": {
       "type": "string",
       "pattern": "^o-[0-9]{4,}$"
      },
      "parent_session": {
       "$ref": "#/$defs/parent-session"
      },
      "at": {
       "type": "string"
      },
      "after": {
       "$ref": "#/$defs/side"
      }
     }
    }
   }
  },
  "parent-session": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1,
   "description": "呼んだ親セッションの ID（ツールのセッション ID。--session か、ツールの環境変数で決まる）。人なら null"
  },
  "render": {
   "type": "object",
   "required": [
    "kind",
    "design_system",
    "pages"
   ],
   "additionalProperties": false,
   "description": "描画の結果。ページは書き出す先に置き、記録しない。ページにはインスタンスの値とデザインだけが入る",
   "properties": {
    "$schema": true,
    "kind": {
     "const": "render"
    },
    "design_system": {
     "type": "object",
     "required": [
      "name",
      "version",
      "fingerprint"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "fingerprint": {
       "$ref": "#/$defs/fingerprint"
      }
     }
    },
    "pages": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "target",
       "page_path",
       "views"
      ],
      "additionalProperties": false,
      "properties": {
       "target": {
        "type": "string",
        "description": "対象の経路"
       },
       "page_path": {
        "type": "string",
        "description": "書き出す先からのページの経路"
       },
       "views": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "description": "使った x-view の種類"
       }
      }
     }
    }
   }
  }
 }
}
