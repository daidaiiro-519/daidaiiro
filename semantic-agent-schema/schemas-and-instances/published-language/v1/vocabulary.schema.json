{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:published-language:vocabulary:v1",
 "$dynamicAnchor": "meta",
 "title": "Abstract の語彙",
 "description": "入れ子のどこでも書ける x- の3つのキーワード（x-prompt ・ x-decided-by ・ x-published）の形を決め、x- で始まるキーをこの3つと x-view（根だけ）に閉じるメタスキーマ。$dynamicAnchor meta により、方言を通して入れ子のすべてのサブスキーマに掛かる。x- で始まらないキーワードは禁じない。形の本体は Abstract の本体の $defs にあり、名前（$anchor）で指す。x- の読み方と rule は、その $defs の x-prompt にある",
 "type": [
  "object",
  "boolean"
 ],
 "properties": {
  "x-prompt": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#prompt"
  },
  "x-decided-by": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#decided"
  },
  "x-published": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#published"
  }
 },
 "propertyNames": {
  "anyOf": [
   {
    "not": {
     "pattern": "^x-"
    }
   },
   {
    "enum": [
     "x-prompt",
     "x-decided-by",
     "x-published",
     "x-view"
    ]
   }
  ]
 }
}
