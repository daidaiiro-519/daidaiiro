{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:published-language:vocabulary:v1",
 "$dynamicAnchor": "meta",
 "title": "Semantic Abstract Schema の語彙",
 "description": "入れ子のどこでも書ける x- の9つのキーワードの形だけを決めるメタスキーマ。$dynamicAnchor meta により、方言を通して入れ子のすべてのサブスキーマに掛かる。ほかのキーワードは禁じない。形の本体は Abstract の本体の $defs にあり、名前（$anchor）で指す",
 "type": [
  "object",
  "boolean"
 ],
 "properties": {
  "x-prompt": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#prompt"
  },
  "x-relationship": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#relationship"
  },
  "x-derived-from": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#derived"
  },
  "x-decided-by": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#decided"
  },
  "x-published": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#published"
  },
  "x-instance-path": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#instance-path"
  },
  "x-instance-label": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#instance-label"
  },
  "x-delegates": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#delegates"
  },
  "x-extensions": {
   "$ref": "urn:semantic-agent-schema:published-language:abstract:v1#extensions"
  }
 }
}
