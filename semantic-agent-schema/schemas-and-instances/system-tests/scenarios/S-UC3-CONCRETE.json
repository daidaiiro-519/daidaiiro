{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-CONCRETE",
 "name": "インスタンスの無い Concrete を消す",
 "title": "従うインスタンスが無い Concrete は消え、種類 concrete の削除として返る",
 "why": "使われなくなった型を残すと、検証の材料として読まれ続ける。",
 "traces": [
  "UC3:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "schemas/usecase.schema.json",
   "--reason",
   "ユースケースの型を使わなくなった",
   "--range"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "deleted"
  },
  {
   "of": "when",
   "pointer": "/target/kind",
   "equals": "concrete"
  },
  {
   "of": "when",
   "pointer": "/checked",
   "count": 0
  }
 ]
}
