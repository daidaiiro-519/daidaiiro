{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-SHAPE-ERROR",
 "name": "答えの形が直らない",
 "title": "同じ子セッションに2回直させても答えの形に合わなければ、該当の rule を error にする",
 "why": "形の合わない答えを判定として使わない。",
 "traces": [
  "SF1:拡張:答えの形が違う",
  "UC4:拡張:6a"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-bad.json",
   "agent/reply-2.json": "@fixtures/reply-bad.json",
   "agent/reply-3.json": "@fixtures/reply-bad.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/child_session/corrections",
   "equals": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/error",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/results",
   "contains": "答えが答えの形に合わない"
  }
 ]
}
