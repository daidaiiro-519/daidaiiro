{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC5-DS-NOT-FOUND",
 "name": "デザインシステムが無い",
 "title": "デザインシステムのファイルが無いと、何も書かずに断る",
 "why": "既定に頼らず、渡した物が無いことを返す。",
 "traces": [
  "UC5:拡張:2a"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "render",
   "usecases/u1.json",
   "--design-system",
   "design/ds.json",
   "--out",
   "site"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "not_found"
  },
  {
   "of": "when",
   "file": "site/usecases/u1.html",
   "exists": false
  }
 ]
}
