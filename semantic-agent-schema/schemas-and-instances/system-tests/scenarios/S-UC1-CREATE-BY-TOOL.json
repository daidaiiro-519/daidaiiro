{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-CREATE-BY-TOOL",
 "name": "ツールが既定の値で作る",
 "title": "名乗ったツールが、人の欄（x-decided-by: human）を default の値のまま書いて作ると、作れる",
 "why": "default のままでも断ると、ツールが人の欄を持つインスタンスを1つも作れない。",
 "traces": [
  "UC1:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "decisions/d2.json",
   "--concrete",
   "urn:semantic-agent-schema:sample:decision:v1",
   "--value",
   "{\"id\":\"D2\",\"summary\":\"差分は前後の中身から求める\",\"status\":\"draft\",\"risk\":\"low\",\"review\":\"by-one\"}",
   "--session",
   "agent-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "created"
  },
  {
   "of": "when",
   "pointer": "/parent_session",
   "equals": "agent-1"
  }
 ]
}
