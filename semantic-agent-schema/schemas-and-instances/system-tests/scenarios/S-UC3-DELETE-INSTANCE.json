{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-DELETE-INSTANCE",
 "name": "インスタンスを消す（参照の記載は残る）",
 "title": "U2 が calls で U1 を指していても、U1 を消すと U1 だけが消え、U2 は変わらない",
 "why": "参照はただの値で、SAS は参照を見分けない。消したファイルを指す記載は、Git の差分とレビューで見つけて直す。",
 "traces": [
  "UC3:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "usecases/u2.json": "@fixtures/u2-calls-u1.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "usecases/u1.json",
   "--reason",
   "U1 は U2 に統合した"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "--all"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "deleted"
  },
  {
   "of": "when",
   "pointer": "/target/path",
   "equals": "usecases/u1.json"
  },
  {
   "of": "when",
   "pointer": "/diff/after",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/diff/changes",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/2",
   "equals": {
    "pointer": "/goal",
    "change": "remove",
    "before": "検証の結果を受け取る"
   }
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/counts/violated",
   "equals": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets",
   "count": 2
  }
 ]
}
