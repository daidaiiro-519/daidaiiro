{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-DERIVED",
 "name": "導出値が古いまま",
 "title": "根の if ・ then ・ else で導く値と違う値で直そうとすると、書かずに invalid_value と期待した値を返す",
 "why": "導ける値を手で違えて書けると、同じ答えから別の結論が残る。導く決まりは JSON Schema の if ・ then ・ else で書く。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "decisions/d1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/risk\",\"value\":\"high\"}]",
   "--if-match",
   "sha256:da5cc215c456a669443fc2f07aa7b7817e7c1f39812490c6f6c1fec7a8ac743a",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/review"
  }
 ],
 "unchanged": [
  "decisions/d1.json"
 ]
}
