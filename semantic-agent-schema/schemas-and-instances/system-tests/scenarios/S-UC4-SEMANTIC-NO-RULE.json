{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SEMANTIC-NO-RULE",
 "name": "判定する rule が無い",
 "title": "意味の rule が無い対象に validate --semantic を打っても、判定する所が0件の手順を返し、記録しない。0件の手順にも空の判定を --answer で渡すと、機械の検証と一緒に記録する",
 "why": "同じコマンドで出力の形が手順と結果に分かれると、手順を待つ AI が結果の行を手順として読んで失敗する。",
 "traces": [
  "UC4:拡張:3a",
  "UC4:変形:意味の判定"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "decisions/d1.json",
   "--semantic",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "lines": 1
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/steps",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/command",
   "contains": "--answer"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/kind",
   "equals": "validation"
  },
  {
   "of": "after[0]",
   "pointer": "/operations/0",
   "equals": "o-0001"
  }
 ],
 "after": [
  {
   "args": [
    "validate",
    "decisions/d1.json",
    "--answer",
    "-",
    "--schemas",
    "schemas",
    "--human"
   ],
   "stdin": "{\"hash\": \"sha256:da5cc215c456a669443fc2f07aa7b7817e7c1f39812490c6f6c1fec7a8ac743a\", \"results\": []}"
  }
 ]
}
