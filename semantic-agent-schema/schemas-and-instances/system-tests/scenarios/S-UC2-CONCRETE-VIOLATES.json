{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-CONCRETE-VIOLATES",
 "name": "Concrete の更新で外れる",
 "title": "Concrete を直すと書き、新しい Concrete に従わなくなるインスタンスを violated_instances に返す",
 "why": "どのインスタンスが外れたかが返らないと、呼ぶ側はインスタンスを直す UC2 を呼べない。",
 "traces": [
  "UC2:拡張:Concrete の更新でインスタンスが violated になった"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "schemas/usecase.schema.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/properties/id/pattern\",\"value\":\"^UC[0-9]+$\"}]",
   "--if-match",
   "sha256:c17b5c2b549b7d2b92ccb5f9ec1d62073873977199fb997b8fe4eb72b18d3dc5"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "updated"
  },
  {
   "of": "when",
   "pointer": "/target/kind",
   "equals": "concrete"
  },
  {
   "of": "when",
   "pointer": "/violated_instances",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/violated_instances/0/path",
   "equals": "usecases/u1.json"
  },
  {
   "of": "when",
   "pointer": "/violated_instances/0/results/0/pointer",
   "equals": "/id"
  },
  {
   "of": "when",
   "pointer": "/violated_instances/0/results/0/result",
   "equals": "violated"
  }
 ]
}
