{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-CONTINUE",
 "name": "検証用の子セッションを続ける",
 "title": "--continue で記録にある検証用の子セッションを続けると、同じ子セッションの ID のまま送り、前の判定は渡さず、いまの中身だけを渡す",
 "why": "前の判定に引っぱられずに、いまの中身で判定させる。",
 "traces": [
  "SF1:変形:検証用の子セッションを続ける"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-ok.json",
   "agent/reply-2.json": "@fixtures/reply-again.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/r1.json",
     "--agent",
     "agent/test-agent.json"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json",
   "--continue",
   "child-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/child_session/id",
   "equals": "child-1"
  },
  {
   "of": "when",
   "pointer": "/child_session/continued",
   "equals": true
  },
  {
   "of": "when",
   "pointer": "/child_session/started",
   "equals": []
  },
  {
   "of": "when",
   "file": "agent/call-2.txt",
   "contains": "continue child-1"
  },
  {
   "of": "when",
   "file": "agent/prompt-2.txt",
   "lacks": "利用者が受け取る結果を書いている"
  },
  {
   "of": "when",
   "file": "agent/prompt-2.txt",
   "contains": "検証の結果を受け取る"
  },
  {
   "of": "when",
   "pointer": "/targets/0/results",
   "contains": "二度目の判定"
  }
 ]
}
