{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-UNTRACKED",
 "name": "SAS を通らない変更を知らせる",
 "title": "SAS が記録したあとにエディターで直されたファイルを検証すると、いまの中身を検証し、unrecorded と取り込みの案内を返す",
 "why": "記録に無い変更を黙って検証すると、誰が何のために直したかが分からないまま確かめ済みに見える。",
 "traces": [
  "UC4:変形:SAS を通らない変更を見つける"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:example:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"エディターで直した目的\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "usecases/u1.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/hash",
   "equals": "sha256:735cb22c5c532d6cb3301f4f221fc15ca3df176415b145f3a0c5a67919c1012d"
  },
  {
   "of": "when",
   "pointer": "/unrecorded",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/unrecorded/0/last_operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/unrecorded/0/actual",
   "equals": "sha256:735cb22c5c532d6cb3301f4f221fc15ca3df176415b145f3a0c5a67919c1012d"
  },
  {
   "of": "when",
   "pointer": "/hint",
   "contains": "sas update usecases/u1.json --adopt --reason"
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
