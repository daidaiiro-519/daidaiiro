{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SEMANTIC-ALL-RULES",
 "name": "すべての所を判定し直す",
 "title": "判定済みの対象でも、validate --semantic --all-rules は変わっていない所を含むすべての当たる所を所のまとまりにし、before には前の判定のときの値（変わっていない所は current と同じ）を、changes にはその所に関わった変更を入れる。判定を渡すコマンドにも --all-rules を付ける",
 "why": "rule の文ではなく判定する側の基準を変えたときは、変わった所だけでは前の判定が残る。",
 "traces": [
  "UC4:変形:意味の判定"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json",
   "answers/summary.json": "{\"hash\": \"sha256:cd024bdab47826bd4bbb3483df31b544cd88d9ca89879d18a0cc34616f4ddcaa\", \"results\": [{\"step\": 1, \"rule\": \"goal-is-outcome\", \"pointer\": \"/goal\", \"result\": \"verified\", \"reason\": \"結果を書いている\"}, {\"step\": 2, \"rule\": \"summary-matches\", \"pointer\": \"/summary\", \"result\": \"verified\", \"reason\": \"目的に食い違わない\"}]}"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/s1.json",
     "--answer",
     "answers/summary.json",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "args": [
     "update",
     "items/s1.json",
     "--if-match",
     "sha256:cd024bdab47826bd4bbb3483df31b544cd88d9ca89879d18a0cc34616f4ddcaa",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/summary\",\"value\":\"検証の結果を受け取るための約束\"}]",
     "--schemas",
     "schemas",
     "--human"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/s1.json",
   "--semantic",
   "--all-rules",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/steps",
   "count": 3
  },
  {
   "of": "when",
   "pointer": "/rules",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/command",
   "contains": "--all-rules --answer"
  },
  {
   "of": "when",
   "pointer": "/review/scope",
   "equals": "all-rules"
  },
  {
   "of": "when",
   "pointer": "/review/since",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/steps/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/steps/0/before",
   "equals": "検証の結果を受け取る"
  },
  {
   "of": "when",
   "pointer": "/steps/0/changes",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/steps/1/pointer",
   "equals": "/summary"
  },
  {
   "of": "when",
   "pointer": "/steps/1/before",
   "equals": "検証の結果を受け取るための決めごと"
  },
  {
   "of": "when",
   "pointer": "/steps/1/changes",
   "count": 1
  }
 ],
 "unchanged": [
  "items/s1.json"
 ]
}
