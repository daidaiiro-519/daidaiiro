   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\": \"replace\", \"path\": \"/goal\", \"value\": \"semantic-agent-schema で直した目的\"}]",
     "--reason",
     "目的を直す",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:example:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"検証の結果を受け取る\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
