{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-PUBLISHED",
 "name": "公開した欄を変える",
 "title": "x-published の欄の定義を、$id の版を上げずに変えようとすると、直さずに published_changed を返す",
 "why": "同じ版のまま定義が変わると、その版に従って書いたインスタンスと読む側が黙って食い違う。",
 "traces": [
  "UC2:最低保証",
  "約束:abstract:x-published"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "update",
   "schemas/decision.schema.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/properties/summary/type\",\"value\":\"array\"}]",
   "--if-match",
   "sha256:536389fc5b48231ddd1a1659d31e1ff5e768a7a220dee35731d6c8697853fa52"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "published_changed"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/properties/summary"
  }
 ],
 "unchanged": [
  "schemas/decision.schema.json"
 ]
}
