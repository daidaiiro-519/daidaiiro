{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-PUBLISHED-NESTED",
 "name": "入れ子の公開した欄を変える",
 "title": "配列の要素の中にある x-published の欄の定義を、$id の版を上げずに変えようとすると、直さずに published_changed と所を返す",
 "why": "同じ版のまま定義が変わると、その版に従って書いたインスタンスと読む側が黙って食い違う。",
 "traces": [
  "UC2:最低保証",
  "約束:abstract:x-published",
  "約束:dialect:nested"
 ],
 "given": {
  "files": {
   "schemas/checked-decision.schema.json": "@fixtures/checked-decision.schema.json"
  }
 },
 "when": {
  "args": [
   "update",
   "schemas/checked-decision.schema.json",
   "--patch",
   "[{\"op\":\"add\",\"path\":\"/properties/checks/items/properties/name/maxLength\",\"value\":40}]",
   "--schemas",
   "schemas",
   "--range"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "published_changed"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/properties/checks/items/properties/name"
  }
 ],
 "unchanged": [
  "schemas/checked-decision.schema.json"
 ]
}
