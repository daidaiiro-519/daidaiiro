{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SESSION-ENV",
 "name": "環境変数のセッション",
 "title": "環境変数からセッション ID が取れるツールでは、--session を付けずに打った最初の semantic-agent-schema で、そのセッションが sessions に1行入る（ツールの名前も残る）",
 "why": "使う側が登録の手順を覚えていなくても、記録は打った会話ごとにまとまる。",
 "traces": [
  "約束:command-result:session"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "schemas/usecase.schema.json",
     "--schemas",
     "schemas"
    ],
    "env": {
     "CLAUDE_CODE_SESSION_ID": "c-1"
    }
   }
  ]
 },
 "when": {
  "args": [
   "log"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/session/id",
   "equals": "c-1"
  },
  {
   "of": "when",
   "pointer": "/session/tool",
   "equals": "claude-code"
  }
 ]
}
