{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-REF-UNTRACKED",
 "name": "SAS を通らずに変わった参照元",
 "title": "参照元 U2 が SAS で書いたあと外で直されているとき、U1 を消そうとすると、U2 を取り込む案内と一緒に止まる",
 "why": "外で直した中身に記載を消した姿を書くと、外の変更の意図が記録に残らないまま上書きされる。",
 "traces": [
  "UC3:拡張:3a",
  "UC3:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "usecases/u2.json": "@fixtures/u2-calls-u1.json"
  },
  "steps": [
   {
    "args": [
     "update",
     "usecases/u2.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"記録を読んで直す\"}]"
    ]
   },
   {
    "write": {
     "path": "usecases/u2.json",
     "content": "{\n \"$schema\": \"urn:semantic-agent-schema:sample:usecase:v1\",\n \"id\": \"U2\",\n \"goal\": \"記録を読み、直す所を決める\",\n \"calls\": [\n  \"U1\"\n ]\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "delete",
   "usecases/u1.json",
   "--intent",
   "U1 は U2 に統合した"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "references_blocked"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/path",
   "equals": "usecases/u2.json"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/code",
   "equals": "conflict"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/hint",
   "equals": "外の変更を取り込む：sas update usecases/u2.json --adopt --intent \"…\""
  }
 ],
 "unchanged": [
  "usecases/u1.json",
  "usecases/u2.json"
 ]
}
