{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SEMANTIC-PROCEDURE",
 "name": "判定の手順を受け取る",
 "title": "validate --semantic は、機械の検証をしたうえで、意味の rule の判定の手順（レビューのまとまり：当たる所ごとの所のまとまりと文書全体のまとまり ・ rule の全文の一覧 ・ 対象のハッシュ ・ 判定を渡すコマンド ・ 判定を書いたときとは別の文脈で行うこと）を出し、記録しない。初めての対象では review.scope が first で、所のまとまりの before は null、changed と changes は空",
 "why": "判定するのは semantic-agent-schema を打ったセッション自身なので、SAS は何を判定するかだけを渡す。記録しないので、判定を渡す前の検証が記録に混ざらない。",
 "traces": [
  "UC4:変形:意味の判定",
  "約束:abstract:x-prompt",
  "約束:procedure"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--semantic"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "lines": 1
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/operation_kind",
   "equals": "validate"
  },
  {
   "of": "when",
   "pointer": "/target/hash",
   "equals": "sha256:fd220983cc989e528215fa39058a7881ea0df453630769e82d716b69db0ecd51"
  },
  {
   "of": "when",
   "pointer": "/steps/0/action",
   "equals": "review-place"
  },
  {
   "of": "when",
   "pointer": "/steps/0/before",
   "equals": null
  },
  {
   "of": "when",
   "pointer": "/steps/1/action",
   "equals": "review-document"
  },
  {
   "of": "when",
   "pointer": "/steps/1/changed",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/steps/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/steps/0/rules/0",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/rules/0/id",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/constraints",
   "contains": "書いたときとは別の文脈"
  },
  {
   "of": "when",
   "pointer": "/constraints",
   "contains": "キャッシュの有効時間のうちは同じものを続けて使い"
  },
  {
   "of": "when",
   "pointer": "/answer/format",
   "equals": "judgments"
  },
  {
   "of": "when",
   "pointer": "/command",
   "equals": "semantic-agent-schema validate items/r1.json --answer <判定の JSON のファイル | ->"
  },
  {
   "of": "after[0]",
   "pointer": "/operations/0",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/review/scope",
   "equals": "first"
  },
  {
   "of": "when",
   "pointer": "/review/since",
   "equals": null
  },
  {
   "of": "when",
   "pointer": "/steps/0/changes",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/steps/1/changes",
   "count": 0
  }
 ],
 "after": [
  {
   "args": [
    "validate",
    "items/r1.json"
   ]
  }
 ],
 "unchanged": [
  "items/r1.json"
 ]
}
