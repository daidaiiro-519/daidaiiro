{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-ABSTRACT-NAME",
 "name": "本体の名前を足した",
 "title": "Concrete が x-extensions で x- を足そうとすると、JSON Schema の検査（json-schema）が x- の閉じた一覧で断る",
 "why": "Concrete は x- を足さない（x- を増やさない方針）。意味の決まりを広げるときは x-prompt の rule に書く。",
 "traces": [
  "UC4:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/clash.schema.json": "@fixtures/clash.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "schemas/clash.schema.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/0/rule",
   "equals": "json-schema"
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/0/result",
   "equals": "violated"
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/0/reason",
   "contains": "x-extensions"
  }
 ]
}
