{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-PATCH-FAILED",
 "name": "差分を当てられない",
 "title": "JSON Patch の test が外れると、どの操作も当てずに patch_failed を返す",
 "why": "途中まで当てた結果を書くと、呼ぶ側が理由しない中身が残る。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"test\",\"path\":\"/goal\",\"value\":\"違う\"},{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
   "--if-match",
   "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "patch_failed"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/0"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
