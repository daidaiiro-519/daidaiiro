{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-SHAPE-RETRY",
 "name": "答えの形を直させる",
 "title": "答えが答えの形に合わないと、同じ子セッションに直させ、直った答えで判定する",
 "why": "1回の形の誤りで判定を捨てない。",
 "traces": [
  "SF1:拡張:答えの形が違う"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-bad.json",
   "agent/reply-2.json": "@fixtures/reply-ok.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/child_session/corrections",
   "equals": 1
  },
  {
   "of": "when",
   "file": "agent/call-2.txt",
   "contains": "continue child-1"
  },
  {
   "of": "when",
   "file": "agent/prompt-2.txt",
   "contains": "答えの形に合いませんでした"
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/verified",
   "equals": 2
  }
 ]
}
