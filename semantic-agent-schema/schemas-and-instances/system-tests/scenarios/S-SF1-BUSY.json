{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-BUSY",
 "name": "同じ子セッションが処理中",
 "title": "ツールが同じ子セッションを処理中と返したら（接続の定義の exit_codes.busy）、判定を記録せずに busy で断る",
 "why": "同じ子セッションへ同時に送ると、1つの会話に2つの依頼が混ざる。SAS の中で同時に送ることは子セッションごとの OS の鍵で防ぎ（アダプターの試験）、SAS の外で使われている子セッションはツールの答えで知る。",
 "traces": [
  "SF1:拡張:同じ子セッションが処理中"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-ok.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/r1.json",
     "--agent",
     "agent/test-agent.json"
    ]
   },
   {
    "write": {
     "path": "agent/reply-2.exit",
     "content": "75"
    }
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json",
   "--continue",
   "child-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "busy"
  },
  {
   "of": "when",
   "file": "agent/call-2.txt",
   "exists": true
  }
 ]
}
