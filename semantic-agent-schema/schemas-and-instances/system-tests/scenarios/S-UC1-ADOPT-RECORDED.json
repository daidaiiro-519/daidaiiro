{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-ADOPT-RECORDED",
 "name": "記録があるものを作成で取り込む",
 "title": "Semantic Agent Schema の記録がすでにあるファイルを create --adopt すると、取り込まずに recorded と、更新として取り込む案内を返す",
 "why": "記録の途中に2つ目の作成が入ると、事前と事後のハッシュのつながりが切れる。",
 "traces": [
  "UC1:変形:既存のファイルを取り込む"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt",
     "--schemas",
     "schemas",
     "--human"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "create",
   "usecases/u1.json",
   "--adopt",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "recorded"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "--adopt --reason"
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
