{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-ADOPT-WORKTREE",
 "name": "別のワークツリーで取り込む",
 "title": "もう一方のワークツリーでエディターで直したファイルは、そのワークツリーの検証で外の変更として知らせ、update --adopt で、そのワークツリーの HEAD（記録の事後と同じ中身）との差分を取り込める",
 "why": "記録を1つにしても、ワークツリーごとの外の変更を見つけて取り込めないと、そのワークツリーの更新が止まったままになる。",
 "traces": [
  "UC2:変形:SAS を通らない変更を取り込む",
  "UC4:変形:SAS を通らない変更を見つける"
 ],
 "given": {
  "repo": true,
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "git": [
     "add",
     "schemas",
     "usecases"
    ]
   },
   {
    "git": [
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "commit",
     "-q",
     "-m",
     "1"
    ]
   },
   {
    "git": [
     "worktree",
     "add",
     "-q",
     "wt2",
     "-b",
     "b2"
    ]
   },
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"本のワークツリーで直した目的\"}]",
     "--reason",
     "本のワークツリーで目的を直す"
    ]
   },
   {
    "write": {
     "path": "wt2/usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:example:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"別のワークツリーのエディターで直した目的\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "usecases/u1.json"
  ],
  "cwd": "wt2"
 },
 "after": [
  {
   "args": [
    "update",
    "usecases/u1.json",
    "--adopt",
    "--reason",
    "別のワークツリーで目的を言い直した"
   ],
   "cwd": "wt2"
  },
  {
   "args": [
    "validate",
    "usecases/u1.json"
   ],
   "cwd": "wt2"
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/unrecorded",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/hint",
   "contains": "--adopt"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/result",
   "equals": "adopted"
  },
  {
   "of": "after[0]",
   "pointer": "/diff/before/commit",
   "exists": true
  },
  {
   "of": "after[0]",
   "pointer": "/diff/changes/0/before",
   "equals": "検証の結果を受け取る"
  },
  {
   "of": "after[0]",
   "pointer": "/operation",
   "equals": "o-0004"
  },
  {
   "of": "after[1]",
   "pointer": "/unrecorded",
   "count": 0
  }
 ]
}
