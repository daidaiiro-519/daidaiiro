{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-HINT",
 "name": "新しい子セッションを勧める",
 "title": "最後に使ってから接続の定義の cache_ttl_s を過ぎた子セッションを続けると、判定はそのまま行い、新しい子セッションを勧める案内を返す",
 "why": "キャッシュが切れた子セッションを続けても安くならない。続けるかは呼び出し元が決める。",
 "traces": [
  "SF1:変形:検証用の子セッションを続ける"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent-ttl0.json",
   "agent/reply-1.json": "@fixtures/reply-ok.json",
   "agent/reply-2.json": "@fixtures/reply-ok.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/r1.json",
     "--agent",
     "agent/test-agent.json"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json",
   "--continue",
   "child-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/child_session/hint",
   "contains": "--continue を外して"
  }
 ]
}
