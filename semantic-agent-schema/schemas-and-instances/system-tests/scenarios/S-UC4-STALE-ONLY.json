{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-STALE-ONLY",
 "name": "入力が変わった rule だけ",
 "title": "検証したあとに calls だけを直して --stale で検証すると、読んだ所が変わった rule だけを判定し、goal の rule と Concrete は判定し直さない",
 "why": "変わっていない所まで毎回判定し直すと、意味の判定の時間と費用が変更の大きさに比例しない。",
 "traces": [
  "UC4:変形:入力が変わった rule だけ"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "schemas/usecase.schema.json",
     "usecases/u1.json",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"add\",\"path\":\"/calls/-\",\"value\":\"U1\"}]",
     "--schemas",
     "schemas",
     "--human"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "schemas/usecase.schema.json",
   "usecases/u1.json",
   "--stale",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "schemas/usecase.schema.json",
    "usecases/u1.json",
    "--stale",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/stale_only",
   "equals": true
  },
  {
   "of": "when",
   "pointer": "/targets",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/path",
   "equals": "usecases/u1.json"
  },
  {
   "of": "when",
   "pointer": "/targets/0/unchanged_rules",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/unchanged_rules/0",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/unchanged_targets/0",
   "equals": "schemas/usecase.schema.json"
  },
  {
   "of": "after[0]",
   "pointer": "/targets",
   "count": 0
  },
  {
   "of": "after[0]",
   "pointer": "/unchanged_targets",
   "count": 2
  }
 ]
}
