{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-STALE-AGENT",
 "name": "判定できなかった rule をあとで判定させる",
 "title": "--agent なしで判定できなかった（unsupported）rule は、中身が同じでも --stale --agent で子セッションに判定させる",
 "why": "子セッションをつながずに検証したあと、つないで --stale を打つと、まだ誰も判定していない rule が残らない。",
 "traces": [
  "UC4:変形:入力が変わった rule だけ",
  "SF1:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-summary.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/s1.json"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/s1.json",
   "--stale",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "lines": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/verified",
   "equals": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/unsupported",
   "equals": 0
  }
 ]
}
