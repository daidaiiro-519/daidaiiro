{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-DERIVED",
 "name": "導出値と食い違う",
 "title": "根の if ・ then ・ else で導く値と違う値で作ろうとすると、書かずに invalid_value と期待した値を返す",
 "why": "導ける値を手で違えて書けると、同じ答えから別の結論が残る。導く決まりは JSON Schema の if ・ then ・ else で書く。",
 "traces": [
  "UC1:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "decisions/d2.json",
   "--concrete",
   "urn:example:sample:decision:v1",
   "--value",
   "{\"id\":\"D2\",\"summary\":\"差分は前後の中身から求める\",\"status\":\"draft\",\"risk\":\"high\",\"review\":\"by-one\"}",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "by-two"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  }
 ]
}
