{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-ADOPT-HUMAN-FIELD",
 "name": "外で人の欄が変わった",
 "title": "外で人の欄（x-decided-by: human）が変わったファイルをツールが取り込もうとすると、取り込まずに human_field と、人が取り込む案内を返す",
 "why": "ツールの取り込みで人の欄の変更を通すと、人が決めていない値が人の決定として記録に残る。",
 "traces": [
  "UC2:変形:SAS を通らない変更を取り込む",
  "UC2:最低保証",
  "約束:abstract:x-decided-by"
 ],
 "given": {
  "repo": true,
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "decisions/d1.json",
     "--adopt",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "git": [
     "add",
     "schemas",
     "decisions"
    ]
   },
   {
    "git": [
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "commit",
     "-q",
     "-m",
     "1"
    ]
   },
   {
    "write": {
     "path": "decisions/d1.json",
     "content": "{\n \"$schema\": \"urn:example:sample:decision:v1\",\n \"id\": \"D1\",\n \"summary\": \"記録は追記だけにする\",\n \"status\": \"approved\",\n \"risk\": \"low\",\n \"review\": \"by-one\"\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "decisions/d1.json",
   "--adopt",
   "--base",
   "HEAD",
   "--reason",
   "承認した",
   "--session",
   "agent-1",
   "--schemas",
   "schemas"
  ]
 },
 "after": [
  {
   "args": [
    "update",
    "decisions/d1.json",
    "--adopt",
    "--base",
    "HEAD",
    "--reason",
    "承認した",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "human_field"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/hint",
   "contains": "--human"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/result",
   "equals": "adopted"
  },
  {
   "of": "after[0]",
   "pointer": "/diff/changes/0/pointer",
   "equals": "/status"
  }
 ],
 "unchanged": [
  "decisions/d1.json"
 ]
}
