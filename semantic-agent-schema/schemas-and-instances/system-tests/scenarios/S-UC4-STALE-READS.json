{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-STALE-READS",
 "name": "読む欄だけが変わった",
 "title": "rule の related_fields が指す欄（goal）だけを直して --stale で検証すると、当たる所（summary）の値が同じでも、その rule を判定し直す",
 "why": "要約は目的を読んで判定している。目的が変わったのに前の判定を使い回すと、食い違いを見逃す。",
 "traces": [
  "UC4:変形:入力が変わった rule だけ",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "--all"
    ]
   },
   {
    "args": [
     "update",
     "items/s1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を人が読める形で受け取る\"}]"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "--stale"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/path",
   "equals": "items/s1.json"
  },
  {
   "of": "when",
   "pointer": "/targets/0/unchanged_rules",
   "count": 0
  }
 ]
}
