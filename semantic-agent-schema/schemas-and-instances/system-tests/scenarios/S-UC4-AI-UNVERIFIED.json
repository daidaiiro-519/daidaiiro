{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-AI-UNVERIFIED",
 "name": "子セッションが判定できないと答える",
 "title": "検証用の子セッションが rule を判定できない（人が決める）と答えると、unverified として返し、verified に数えない",
 "why": "AI が決めきれないことを verified にすると、誰も決めていないものが決まったことになる。人が決める点として返す。",
 "traces": [
  "UC4:最低保証",
  "UC4:拡張:6b",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-unverified.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/unverified",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/results",
   "contains": "利用者に聞かないと決められない"
  }
 ]
}
