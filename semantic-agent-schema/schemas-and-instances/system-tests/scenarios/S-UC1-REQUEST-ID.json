{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-REQUEST-ID",
 "name": "同じ依頼をやり直す",
 "title": "同じ --request-id で作成を2回呼ぶと、2回目は書かずに1回目の操作を返す",
 "why": "やり直しのたびに操作が増えると、記録から何回作ったかを読み違える。",
 "traces": [
  "UC1:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u2.json",
     "--concrete",
     "urn:example:sample:usecase:v1",
     "--value",
     "{\"id\":\"U2\",\"goal\":\"成果物が型に従って在る\",\"calls\":[]}",
     "--request-id",
     "r-1"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "create",
   "usecases/u2.json",
   "--concrete",
   "urn:example:sample:usecase:v1",
   "--value",
   "{\"id\":\"U2\",\"goal\":\"成果物が型に従って在る\",\"calls\":[]}",
   "--request-id",
   "r-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/replayed",
   "equals": true
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "created"
  }
 ]
}
