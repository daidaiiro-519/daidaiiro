{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-STALE-RULE-CHANGED",
 "name": "rule の文が変わった",
 "title": "検証したあとに Concrete の rule の文だけを書き換えると、インスタンスが同じでも、その rule は入力が変わったものとして判定し直す",
 "why": "rule の文が変わったのに前の判定が効いたままだと、いまの決まりで確かめていない値が確かめ済みに見える。",
 "traces": [
  "UC4:変形:入力が変わった rule だけ",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "usecases/u1.json"
    ]
   },
   {
    "args": [
     "update",
     "schemas/usecase.schema.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/properties/goal/x-prompt/write/0/rule\",\"value\":\"目的を、利用者が得る結果として1文で書く。\"}]"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "--stale",
   "usecases/u1.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/results",
   "contains": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/targets/0/unchanged_rules",
   "contains": "json-schema"
  }
 ]
}
