{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SEMANTIC-READS",
 "name": "読む欄を手順に入れる",
 "title": "rule に reads があると、判定の手順のそのステップに、読む欄の所と値が入る",
 "why": "判定するセッションは手順だけで判定できるようにする。読む欄の値が無いと、要約が目的に食い違わないかを判定できない。",
 "traces": [
  "UC4:変形:意味の判定",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/s1.json",
   "--semantic"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/steps/1/rules/0",
   "equals": "summary-matches"
  },
  {
   "of": "when",
   "pointer": "/steps/1/reads/0",
   "equals": {
    "pointer": "/goal",
    "value": "検証の結果を受け取る"
   }
  }
 ]
}
