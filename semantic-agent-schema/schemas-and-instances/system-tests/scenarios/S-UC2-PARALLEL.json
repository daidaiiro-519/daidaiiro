{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-PARALLEL",
 "name": "並行するセッションの変更",
 "title": "2つのセッションが同じハッシュを読み、先のセッションが書いたあとに後のセッションが古いハッシュで直そうとすると、先の操作の理由と変えた欄が返る",
 "why": "間に入った変更の理由が分からないと、後の書き手は上書きしてよいかを決められない。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
     "--if-match",
     "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
     "--session",
     "ai-1",
     "--reason",
     "目標に、直す所が分かることを足す"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果から、直す欄と理由が分かる\"}]",
   "--if-match",
   "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
   "--session",
   "ai-2"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "conflict"
  },
  {
   "of": "when",
   "pointer": "/interleaved/expected",
   "equals": "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4"
  },
  {
   "of": "when",
   "pointer": "/interleaved/unrecorded",
   "equals": false
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations/0/operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations/0/session",
   "equals": "ai-1"
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations/0/reason",
   "equals": "目標に、直す所が分かることを足す"
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations/0/changes/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/interleaved/operations/0/changes/0/after",
   "equals": "検証の結果を受け取り、直す所が分かる"
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
