{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-RELATION-MISSING",
 "name": "参照の先が無い",
 "title": "x-relationship の欄が、在らないインスタンスを指すと relationship-target が violated になる",
 "why": "在らない先を指せると、たどった先で読む側が止まる。",
 "traces": [
  "UC4:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "usecases/u2.json": "@fixtures/u2-calls-missing.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "usecases/u2.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/violated",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/3/pointer",
   "equals": "/calls/1"
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/3/result",
   "equals": "violated"
  }
 ]
}
