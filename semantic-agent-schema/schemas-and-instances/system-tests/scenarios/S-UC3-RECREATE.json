{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-RECREATE",
 "name": "消したあとに同じ経路へ置く",
 "title": "U1 を消したあと、外で同じ経路に置き直したファイルは、作成として取り込める",
 "why": "消すと記録のつながりが切れる。消す前の記録が残っていると、置き直したものを取り込めなくなる。",
 "traces": [
  "UC3:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す\"}]",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "args": [
     "delete",
     "usecases/u1.json",
     "--reason",
     "いったん消す",
     "--human"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:example:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"検証の結果を読む\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "create",
   "usecases/u1.json",
   "--adopt",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "adopted"
  },
  {
   "of": "when",
   "pointer": "/diff/before",
   "exists": false
  }
 ]
}
