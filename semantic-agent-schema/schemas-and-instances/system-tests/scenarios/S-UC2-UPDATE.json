{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-UPDATE",
 "name": "差分を当てて直す",
 "title": "JSON Patch と直す前のハッシュを渡して直すと、変えた欄だけの差分と、事前と事後のハッシュが返る",
 "why": "何をどう変えたかが残らないと、あとから変更を確かめられない。",
 "traces": [
  "UC2:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
   "--if-match",
   "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u1.json",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "updated"
  },
  {
   "of": "when",
   "pointer": "/diff/before/hash",
   "equals": "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4"
  },
  {
   "of": "when",
   "pointer": "/diff/changes",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/change",
   "equals": "replace"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/before",
   "equals": "検証の結果を受け取る"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/after",
   "equals": "検証の結果を受け取り、直す所が分かる"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets/0/counts/violated",
   "equals": 0
  }
 ]
}
