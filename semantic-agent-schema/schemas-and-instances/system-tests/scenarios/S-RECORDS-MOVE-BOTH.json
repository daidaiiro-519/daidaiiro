{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-RECORDS-MOVE-BOTH",
 "name": "両方に記録があれば断る",
 "title": "古い置き場所と新しい置き場所の両方に記録があると、どちらも触らずに断り、2つの経路を示す",
 "why": "どちらかを上書きするか混ぜると、記録の片方が消える。どちらを残すかは利用者が決める。",
 "traces": [
  "約束:command-result:records"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ],
    "env": {
     "SEMANTIC_AGENT_SCHEMA_DATABASE_FILE": ".git/sas/sas.db"
    }
   },
   {
    "args": [
     "validate",
     "usecases/u1.json"
    ],
    "env": {
     "SEMANTIC_AGENT_SCHEMA_DATABASE_FILE": ".git/semantic-agent-schema/records.sqlite"
    }
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "usecases/u1.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "log"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "sas/sas.db"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "semantic-agent-schema/records.sqlite"
  }
 ],
 "unchanged": [
  ".git/sas/sas.db",
  ".git/semantic-agent-schema/records.sqlite"
 ]
}
