{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-READS",
 "name": "読む欄を手順に入れる",
 "title": "rule に reads があると、子セッションへの手順のそのステップに、読む欄の所と値が入る",
 "why": "子セッションは渡されたものしか読めない。読む欄の値が無いと、要約が目的に食い違わないかを判定できない。",
 "traces": [
  "SF1:成功時保証",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-summary.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/s1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "line": 0,
   "pointer": "/steps/1/rules/0/id",
   "equals": "summary-matches"
  },
  {
   "of": "when",
   "line": 0,
   "pointer": "/steps/1/reads/0",
   "equals": {
    "pointer": "/goal",
    "value": "検証の結果を受け取る"
   }
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/verified",
   "equals": 3
  }
 ]
}
