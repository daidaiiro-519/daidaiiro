{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-SEMANTIC-CONCRETE",
 "name": "Concrete を意味で書く",
 "title": "--concrete に Abstract の版を渡して --semantic で作ると、Abstract の rule（根 ・ 欄 ・ 入れ子）から手順を組み、Concrete を書くコマンドと一緒に出す",
 "why": "Concrete を書くときも、インスタンスと同じく、作法（Abstract の rule）が書く AI への指示とレビューの観点になる。",
 "traces": [
  "UC1:変形:意味で書く"
 ],
 "when": {
  "args": [
   "create",
   "schemas/flow.schema.json",
   "--concrete",
   "urn:semantic-agent-schema:published-language:abstract:v1",
   "--semantic",
   "--schemas",
   ".",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "lines": 1
  },
  {
   "of": "when",
   "pointer": "/rules/0/id",
   "equals": "read-perspectives"
  },
  {
   "of": "when",
   "pointer": "/steps/5/pointer",
   "equals": "/properties"
  },
  {
   "of": "when",
   "pointer": "/target/schema",
   "equals": "urn:semantic-agent-schema:published-language:abstract:v1"
  },
  {
   "of": "when",
   "pointer": "/command",
   "contains": "semantic-agent-schema create schemas/flow.schema.json --concrete urn:semantic-agent-schema:published-language:abstract:v1 --value"
  },
  {
   "of": "when",
   "file": "schemas/flow.schema.json",
   "exists": false
  }
 ]
}
