{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-RECORDS-OLD-ENV",
 "name": "古い環境変数の名前で断る",
 "title": "古い名前の環境変数 SAS_DB_PATH が設定されていると、黙って無視せず、記録を作らずに新しい名前 SEMANTIC_AGENT_SCHEMA_DATABASE_FILE を示して断る",
 "why": "古い名前を黙って無視すると、利用者が指したつもりの記録とは別の所に書き続ける。",
 "traces": [
  "約束:command-result:records"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "create",
   "usecases/u1.json",
   "--adopt"
  ],
  "env": {
   "SAS_DB_PATH": "old.db"
  }
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "renamed_env"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "SEMANTIC_AGENT_SCHEMA_DATABASE_FILE"
  },
  {
   "of": "when",
   "file": "old.db",
   "exists": false
  },
  {
   "of": "when",
   "file": ".git/semantic-agent-schema/records.sqlite",
   "exists": false
  }
 ]
}
