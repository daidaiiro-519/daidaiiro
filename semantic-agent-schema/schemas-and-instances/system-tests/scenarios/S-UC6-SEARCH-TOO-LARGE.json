{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC6-SEARCH-TOO-LARGE",
 "name": "範囲が上限を超える",
 "title": "意味で探す範囲の中身の合計が上限（64KB）を超えたら、切り詰めずに range_too_large で断り、手順を出さない",
 "why": "切り詰めた中身で答えると、読んでいない所を探したことにしてしまう。",
 "traces": [
  "UC6:拡張:範囲の中身が上限を超える"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "items/r2.json": "{\"$schema\": \"urn:example:sample:review:v1\", \"id\": \"R2\", \"goal\": \"運用担当が記録を読む\", \"calls\": [\"R1\"]}",
   "items/r9.json": "@fixtures/r-big.json"
  }
 },
 "when": {
  "args": [
   "search",
   "items/r1.json",
   "items/r2.json",
   "items/r9.json",
   "--semantic",
   "--question",
   "運用担当が出てくるのは？",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "lines": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "range_too_large"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/kind",
   "equals": "procedure"
  }
 ],
 "after": [
  {
   "args": [
    "search",
    "items/r1.json",
    "items/r2.json",
    "--semantic",
    "--question",
    "運用担当が出てくるのは？",
    "--schemas",
    "schemas"
   ]
  }
 ]
}
