{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-WORKTREE",
 "name": "ワークツリーで記録は1つ",
 "title": "ワークツリーを2つ作ると記録の置き場所は1つで、もう一方のワークツリーが後から書いても、こちらの中身が記録のどれかの事後なら SAS を通らない変更として知らせない",
 "why": "ワークツリーごとに記録が分かれると、同じリポジトリの操作をたどれない。逆に記録が1つでも最後の事後だけと比べると、ほかのワークツリーで書くたびに外の変更に見える。",
 "traces": [
  "UC4:変形:SAS を通らない変更を見つける"
 ],
 "given": {
  "repo": true,
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "git": [
     "add",
     "schemas",
     "usecases"
    ]
   },
   {
    "git": [
     "-c",
     "user.name=t",
     "-c",
     "user.email=t@example.com",
     "commit",
     "-q",
     "-m",
     "1"
    ]
   },
   {
    "git": [
     "worktree",
     "add",
     "-q",
     "wt2",
     "-b",
     "b2"
    ]
   },
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"本のワークツリーで直した目的\"}]",
     "--reason",
     "本のワークツリーで目的を直す"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "usecases/u1.json"
  ],
  "cwd": "wt2"
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u1.json"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/untracked",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/operations/0",
   "equals": "o-0003"
  },
  {
   "of": "after[0]",
   "pointer": "/untracked",
   "count": 0
  },
  {
   "of": "after[0]",
   "pointer": "/operations/0",
   "equals": "o-0004"
  }
 ],
 "unchanged": [
  "wt2/usecases/u1.json"
 ]
}
