{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-CONFLICT",
 "name": "答えを待つ間に対象が変わった",
 "title": "検証用の子セッションが判定している間に対象の中身が変わると、判定を記録に入れずに conflict で断る",
 "why": "判定した中身と記録の中身を食い違わせない。",
 "traces": [
  "UC4:拡張:6c"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.json": "@fixtures/reply-ok.json",
   "agent/touch-1": "{\n \"$schema\": \"urn:example:sample:review:v1\",\n \"id\": \"R1\",\n \"goal\": \"外で直した\",\n \"calls\": []\n}\n",
   "agent/touch-1.path": "items/r1.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "conflict"
  },
  {
   "of": "when",
   "pointer": "/path",
   "equals": "items/r1.json"
  }
 ]
}
