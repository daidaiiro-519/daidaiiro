{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-CONCRETE-FOLLOWED",
 "name": "インスタンスが従う Concrete を消す",
 "title": "U1 が従っている Concrete を消そうとすると、何も消さずに has_dependents を返し、従うインスタンスと、先に消すコマンドを返す",
 "why": "Concrete だけ消すとインスタンスを検証できなくなり、インスタンスごと消すと書いた人の中身が1つの操作で失われる。どちらにするかは機械では決められない。",
 "traces": [
  "UC3:拡張:2a",
  "UC3:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "schemas/usecase.schema.json",
   "--if-match",
   "sha256:111982133f713e643f5748f0dc072d2401027292d5b2712e5714aa44d9ecaa80",
   "--reason",
   "ユースケースの型を使わなくなった",
   "--range",
   "usecases/u1.json",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "has_dependents"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/blocked",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/blocked/0/path",
   "equals": "usecases/u1.json"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/code",
   "equals": "follows"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/hint",
   "equals": "消す：semantic-agent-schema delete usecases/u1.json --if-match sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4 --reason <理由> --human"
  },
  {
   "of": "when",
   "pointer": "/hint",
   "contains": "--reason <理由> --range usecases/u1.json --human"
  }
 ],
 "unchanged": [
  "schemas/usecase.schema.json",
  "usecases/u1.json"
 ]
}
