{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-DEFAULT",
 "name": "ハッシュを省いて直す",
 "title": "--if-match を省くと、SAS が最後に書いたハッシュといまの中身のハッシュを比べ、同じなら直す",
 "why": "呼ぶたびにハッシュを読み直して渡すと、手順が増えるのに守れる変更は同じである。",
 "traces": [
  "UC2:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "update",
     "usecases/u1.json",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
     "--if-match",
     "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
     "--schemas",
     "schemas"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果から、直す欄と理由が分かる\"}]",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "updated"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0002"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/after",
   "equals": "検証の結果から、直す欄と理由が分かる"
  }
 ]
}
