{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SESSION",
 "name": "打ったセッション",
 "title": "打ったセッションの ID は --session → ツールの環境変数の順で決まり、--session が環境変数より先に効く。人は --human で明示し、記録の session は null になる",
 "why": "どのセッションの検証かを残せないと、記録から誰の操作かを読めない。AI のツールの中では --session を渡し忘れても、環境変数からセッションが分かる。",
 "traces": [
  "UC4:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "--session",
   "tool-a",
   "schemas/usecase.schema.json",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/session",
   "equals": "tool-a"
  },
  {
   "of": "after[0]",
   "pointer": "/session",
   "equals": "c5c5ab7a-4041-4920-8749-7d2a36030744"
  },
  {
   "of": "after[0]",
   "pointer": "/operations/0",
   "equals": "o-0002"
  },
  {
   "of": "after[1]",
   "pointer": "/session",
   "equals": null
  },
  {
   "of": "after[2]",
   "pointer": "/session",
   "equals": "tool-a"
  }
 ],
 "after": [
  {
   "args": [
    "validate",
    "schemas/usecase.schema.json",
    "--schemas",
    "schemas"
   ],
   "env": {
    "CLAUDE_CODE_SESSION_ID": "c5c5ab7a-4041-4920-8749-7d2a36030744"
   }
  },
  {
   "args": [
    "validate",
    "schemas/usecase.schema.json",
    "--schemas",
    "schemas",
    "--human"
   ]
  },
  {
   "args": [
    "validate",
    "--session",
    "tool-a",
    "schemas/usecase.schema.json",
    "--schemas",
    "schemas"
   ],
   "env": {
    "CLAUDE_CODE_SESSION_ID": "c5c5ab7a-4041-4920-8749-7d2a36030744"
   }
  }
 ]
}
