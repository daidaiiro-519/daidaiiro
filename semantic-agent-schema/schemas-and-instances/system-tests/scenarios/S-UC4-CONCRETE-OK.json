{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-CONCRETE-OK",
 "name": "Concrete が従う",
 "title": "Abstract に従う Concrete を検証すると、形の検査と組み込みの検査が verified になり、判定の4つの区分ごとに数える",
 "why": "Concrete が契約に従うかを確かめられないと、インスタンスを書く前に契約の誤りに気付けない。",
 "traces": [
  "UC4:成功時保証",
  "約束:abstract:root",
  "約束:abstract:field",
  "約束:abstract:instance-schema-name",
  "約束:abstract:unique-id"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "schemas/usecase.schema.json",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "validation"
  },
  {
   "of": "when",
   "pointer": "/targets/0/kind",
   "equals": "concrete"
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/violated",
   "equals": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/hash",
   "contains": "sha256:"
  },
  {
   "of": "when",
   "pointer": "/operations",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/counts/verified",
   "exists": true
  }
 ],
 "unchanged": [
  "schemas/usecase.schema.json"
 ]
}
