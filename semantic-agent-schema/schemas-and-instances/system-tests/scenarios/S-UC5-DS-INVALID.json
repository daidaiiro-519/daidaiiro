{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC5-DS-INVALID",
 "name": "デザインシステムが型に合わない",
 "title": "templates の無いデザインシステムは、受け取りの型に合わないので何も書かずに断る",
 "why": "テンプレートの一覧が無いと、どの種類で描くかが決まらない。",
 "traces": [
  "UC5:拡張:2a",
  "約束:design-system"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "design/ds.json": "@fixtures/ds.json",
   "design/page.html": "@fixtures/page.html",
   "design/ds-invalid.json": "@fixtures/ds-invalid.json",
   "design/card.html": "@fixtures/card.html",
   "design/styles.css": "@fixtures/styles.css"
  }
 },
 "when": {
  "args": [
   "render",
   "usecases/u1.json",
   "--design-system",
   "design/ds-invalid.json",
   "--out",
   "site"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_design_system"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "templates"
  },
  {
   "of": "when",
   "file": "site/usecases/u1.html",
   "exists": false
  }
 ]
}
