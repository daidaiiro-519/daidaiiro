{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-STALE",
 "name": "前の判定が効かなくなる",
 "title": "検証したあとに x-prompt のある欄を直すと、その欄の前の判定が stale_judgments に出る",
 "why": "変えた欄の前の判定が効いたままだと、確かめていない値が確かめ済みに見える。",
 "traces": [
  "UC2:成功時保証",
  "約束:abstract:x-prompt"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "usecases/u1.json",
     "--schemas",
     "schemas"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
   "--if-match",
   "sha256:4d840c6444ef6c2cf25cec1e297e7a11eb09202d5a9ccb41df2de3be795f9fe4",
   "--schemas",
   "schemas"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0002"
  },
  {
   "of": "when",
   "pointer": "/stale_judgments",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/stale_judgments/0/rule",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/stale_judgments/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/stale_judgments/0/operation",
   "equals": "o-0001"
  }
 ]
}
