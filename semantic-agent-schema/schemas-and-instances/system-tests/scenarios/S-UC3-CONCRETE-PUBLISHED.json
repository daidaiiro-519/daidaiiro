{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC3-CONCRETE-PUBLISHED",
 "name": "変えない欄を持つ Concrete を消す",
 "title": "x-published: true の欄を持つ Concrete でも、従うインスタンスが無ければ消せる",
 "why": "x-published は同じ版のあいだ欄の定義を変えない約束で、消すことは止めない。従うインスタンスがあれば has_dependents が止める。",
 "traces": [
  "UC3:成功時保証",
  "約束:abstract:x-published"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "schemas/decision.schema.json",
   "--intent",
   "決定の型を使わなくなった"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "deleted"
  },
  {
   "of": "when",
   "file": "schemas/decision.schema.json",
   "exists": false
  }
 ]
}
