{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-SF1-TIMEOUT",
 "name": "時間切れ",
 "title": "子セッションが時間内に答えないと、新しい子セッションを起動してやり直す",
 "why": "止まった子セッションを待ち続けない。",
 "traces": [
  "SF1:拡張:時間切れ",
  "UC4:拡張:5a"
 ],
 "given": {
  "files": {
   "schemas/review.schema.json": "@fixtures/review.schema.json",
   "items/r1.json": "@fixtures/r1.json",
   "agent/test-agent.sh": "@fixtures/test-agent.sh",
   "agent/test-agent.json": "@fixtures/test-agent.json",
   "agent/reply-1.exit": "124\n",
   "agent/reply-2.json": "@fixtures/reply-ok-2.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "items/r1.json",
   "--agent",
   "agent/test-agent.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/child_session/restarts",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/child_session/id",
   "equals": "child-2"
  },
  {
   "of": "when",
   "file": "agent/call-2.txt",
   "contains": "start"
  }
 ]
}
