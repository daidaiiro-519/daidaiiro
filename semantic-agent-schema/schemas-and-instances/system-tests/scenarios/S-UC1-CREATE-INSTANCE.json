{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-CREATE-INSTANCE",
 "name": "インスタンスを作る",
 "title": "Concrete に従う値でインスタンスを作ると、型に従うファイルができ、操作の ID と欄ごとの差分が返る",
 "why": "作ったものが型に従うかをその場で確かめないと、壊れたインスタンスが後の検証まで残る。",
 "traces": [
  "UC1:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "usecases/u2.json",
   "--concrete",
   "urn:example:sample:usecase:v1",
   "--value",
   "{\"id\":\"U2\",\"goal\":\"成果物が型に従って在る\",\"calls\":[]}",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u2.json",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "change"
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "created"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/target/kind",
   "equals": "instance"
  },
  {
   "of": "when",
   "pointer": "/target/schema",
   "equals": "urn:example:sample:usecase:v1"
  },
  {
   "of": "when",
   "pointer": "/diff/before",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/diff/after/hash",
   "contains": "sha256:"
  },
  {
   "of": "when",
   "pointer": "/diff/changes",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/pointer",
   "equals": "/$schema"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/change",
   "equals": "add"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets/0/counts/violated",
   "equals": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets/0/hash",
   "exists": true
  }
 ]
}
