{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-STALE-READS",
 "name": "読む欄を直したあとの判定",
 "title": "rule の reads が指す欄（goal）だけを直す更新では、当たる所（summary）が同じでも、その rule の前の判定が stale_judgments に出る",
 "why": "要約の判定は目的を読んでいる。目的を直したのに知らせないと、呼ぶ側が判定し直しを忘れる。",
 "traces": [
  "UC2:成功時保証",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/s1.json"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "items/s1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を人が読める形で受け取る\"}]"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/stale_judgments",
   "contains": "summary-matches"
  },
  {
   "of": "when",
   "pointer": "/stale_judgments",
   "contains": "goal-is-outcome"
  }
 ]
}
