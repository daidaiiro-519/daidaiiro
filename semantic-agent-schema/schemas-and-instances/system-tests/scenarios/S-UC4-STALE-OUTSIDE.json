{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-STALE-OUTSIDE",
 "name": "外の変更も入力の変化",
 "title": "検証したあとにエディターで goal を直して --stale で検証すると、goal を読む rule を判定し直し、SAS を通らない変更も知らせる",
 "why": "外の変更で読んだ所が変わっても判定し直さないと、前の判定が効いたまま見える。",
 "traces": [
  "UC4:変形:入力が変わった rule だけ",
  "UC4:変形:SAS を通らない変更を見つける"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "args": [
     "validate",
     "usecases/u1.json"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:semantic-agent-schema:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"外で直した目的\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "--stale",
   "usecases/u1.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/results",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/1/rule",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/untracked",
   "count": 1
  }
 ]
}
