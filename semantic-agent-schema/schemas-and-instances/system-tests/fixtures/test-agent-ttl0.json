{
 "$schema": "urn:semantic-agent-schema:published-language:agent-connector:v1",
 "name": "test-agent",
 "version": "1",
 "model": "fixed",
 "commands": {
  "start": {
   "argv": [
    "sh",
    "agent/test-agent.sh",
    "start"
   ],
   "stdin": "{prompt.text}"
  },
  "continue": {
   "argv": [
    "sh",
    "agent/test-agent.sh",
    "continue",
    "{tool_ref}"
   ],
   "stdin": "{prompt.text}"
  }
 },
 "answer": {
  "from": "stdout",
  "json_pointer": "/result"
 },
 "tool_ref": {
  "from": "stdout",
  "json_pointer": "/session_id"
 },
 "exit_codes": {
  "timeout": [
   124
  ],
  "busy": [
   75
  ]
 },
 "time_limit_s": 20,
 "capabilities": {
  "resume": true,
  "cache_ttl_s": 0
 }
}
