{
 "$schema": "urn:semantic-agent-schema:published-language:design-system:v1",
 "name": "ユースケースのデザイン",
 "version": "1.0.0",
 "template_language": "urn:semantic-agent-schema:published-language:template-language:v1",
 "templates": {
  "card": "card.html",
  "styles": "styles.css"
 },
 "tokens": {
  "color": {
   "$type": "color",
   "light": {
    "surface": {
     "$value": "#f4f1ea"
    },
    "card": {
     "$value": "#fffdf8"
    },
    "text": {
     "$value": "#2a2622"
    },
    "muted": {
     "$value": "#6b635a"
    },
    "accent": {
     "$value": "#b4532a"
    },
    "accent-soft": {
     "$value": "#f6e4d8"
    },
    "line": {
     "$value": "#e4ddd0"
    }
   },
   "dark": {
    "surface": {
     "$value": "#191715"
    },
    "card": {
     "$value": "#23201d"
    },
    "text": {
     "$value": "#ece6dc"
    },
    "muted": {
     "$value": "#a59c90"
    },
    "accent": {
     "$value": "#e58a5c"
    },
    "accent-soft": {
     "$value": "#3b2a20"
    },
    "line": {
     "$value": "#3a3530"
    }
   }
  },
  "font": {
   "family": {
    "base": {
     "$value": "\"Noto Sans JP\", \"Hiragino Sans\", system-ui, sans-serif"
    },
    "mono": {
     "$value": "ui-monospace, SFMono-Regular, Menlo, monospace"
    }
   },
   "size": {
    "body": {
     "$value": "16px"
    },
    "goal": {
     "$value": "28px"
    },
    "label": {
     "$value": "12px"
    }
   }
  },
  "space": {
   "sm": {
    "$value": "8px"
   },
   "md": {
    "$value": "16px"
   },
   "lg": {
    "$value": "28px"
   },
   "xl": {
    "$value": "48px"
   }
  },
  "radius": {
   "card": {
    "$value": "14px"
   },
   "chip": {
    "$value": "999px"
   }
  },
  "size": {
   "content": {
    "$value": "720px"
   }
  }
 }
}
