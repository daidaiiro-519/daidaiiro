{
 "$schema": "urn:semantic-agent-schema:published-language:abstract:v1",
 "$id": "urn:example:sample:checked-decision:v1",
 "title": "確かめ付きの決定",
 "description": "決めたことと、その状態である。",
 "type": "object",
 "required": [
  "$schema",
  "id",
  "summary"
 ],
 "properties": {
  "$schema": {
   "const": "urn:example:sample:checked-decision:v1"
  },
  "id": {
   "title": "ID",
   "description": "決定を区別する名前である。",
   "x-prompt": {
    "write": []
   },
   "type": "string",
   "pattern": "^D[0-9]+$"
  },
  "summary": {
   "title": "要約",
   "description": "決めたことを1文で言ったものである。同じ版のあいだ定義を変えない欄である。",
   "x-prompt": {
    "write": []
   },
   "x-published": true,
   "type": "string"
  },
  "status": {
   "title": "状態",
   "description": "決定が承認されたかである。人が決める。",
   "x-prompt": {
    "write": []
   },
   "x-decided-by": "human",
   "type": "string",
   "enum": [
    "draft",
    "approved"
   ],
   "default": "draft"
  },
  "risk": {
   "title": "影響",
   "description": "決定が外れたときの影響の大きさである。",
   "x-prompt": {
    "write": []
   },
   "type": "string",
   "enum": [
    "low",
    "high"
   ]
  },
  "review": {
   "title": "確かめ方",
   "description": "影響から導く、確かめ方である。影響が high なら by-two、それ以外は by-one（根の if ・ then ・ else）。",
   "x-prompt": {
    "write": []
   },
   "type": "string",
   "enum": [
    "by-one",
    "by-two"
   ]
  },
  "checks": {
   "title": "確かめ",
   "description": "決定を確かめた項目の並びである。",
   "x-prompt": {
    "write": []
   },
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "title": "項目",
      "description": "確かめた項目の名前である。同じ版のあいだ定義を変えない欄である。",
      "x-published": true,
      "type": "string",
      "x-prompt": {
       "write": []
      }
     },
     "signed": {
      "title": "署名",
      "description": "人がこの項目を確かめたかである。人が決める。",
      "x-decided-by": "human",
      "type": "boolean",
      "default": false,
      "x-prompt": {
       "write": []
      }
     }
    }
   }
  }
 },
 "if": {
  "properties": {
   "risk": {
    "const": "high"
   }
  },
  "required": [
   "risk"
  ]
 },
 "then": {
  "properties": {
   "review": {
    "const": "by-two"
   }
  }
 },
 "else": {
  "properties": {
   "review": {
    "const": "by-one"
   }
  }
 }
}
