{
 "$schema": "urn:semantic-agent-schema:published-language:abstract:v1",
 "$id": "urn:example:sample:clash:v1",
 "title": "ユースケース",
 "description": "利用者が目的を果たすまでの手順である。",
 "type": "object",
 "required": [
  "$schema",
  "id",
  "goal"
 ],
 "properties": {
  "$schema": {
   "const": "urn:example:sample:clash:v1"
  },
  "id": {
   "title": "ID",
   "description": "ユースケースを区別する名前である。",
   "x-prompt": {
    "write": []
   },
   "type": "string",
   "pattern": "^U[0-9]+$"
  },
  "goal": {
   "title": "目的",
   "description": "利用者が果たしたいことである。",
   "x-prompt": {
    "write": [
     {
      "id": "goal-is-outcome",
      "rule": "利用者が得る結果を書く。",
      "why": "手段を書くと、目的が果たせたかを決められない。",
      "test": "結果を表す名詞句かを見る。",
      "by": "human"
     }
    ]
   },
   "type": "string"
  },
  "calls": {
   "title": "呼ぶユースケース",
   "description": "途中で呼ぶほかのユースケースの並びである。",
   "x-prompt": {
    "write": []
   },
   "type": "array",
   "items": {
    "type": "string",
    "x-relationship": {
     "to": "urn:example:sample:clash:v1"
    }
   }
  }
 },
 "x-extensions": {
  "x-prompt": {
   "schema": {
    "type": "object"
   },
   "title": "案内",
   "description": "本体と同じ名前を足した x- である。",
   "prompt": {
    "write": []
   }
  }
 }
}
