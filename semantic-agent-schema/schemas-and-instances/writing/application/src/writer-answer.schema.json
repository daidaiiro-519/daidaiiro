{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:writing:agent-answer-values:v1",
 "title": "書き込み用の子セッションの答え（欄の値）",
 "description": "手順のプロンプトの steps ごとに、その欄に書く値を1件ずつ返す。答えはこの JSON だけで、ほかの文を付けない",
 "type": "object",
 "required": ["values"],
 "additionalProperties": false,
 "properties": {
  "values": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["step", "pointer", "value"],
    "additionalProperties": false,
    "properties": {
     "step": { "type": "integer", "minimum": 1, "description": "手順の steps の no" },
     "pointer": { "type": "string", "description": "書く欄（JSON Pointer）" },
     "value": { "description": "その欄に書く値。欄の型（Concrete の JSON Schema）に従う" }
    }
   }
  }
 }
}
