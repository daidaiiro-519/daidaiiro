{
 "$schema": "urn:semantic-agent-schema:published-language:agent-connector:v1",
 "name": "claude-code",
 "version": "1",
 "commands": {
  "start": { "argv": ["claude", "-p", "--output-format", "json", "--tools", "", "--disallowedTools", "mcp__*"], "stdin": "{prompt.text}" },
  "continue": { "argv": ["claude", "-p", "--output-format", "json", "--tools", "", "--disallowedTools", "mcp__*", "--resume", "{tool_ref}"], "stdin": "{prompt.text}" }
 },
 "answer": { "from": "stdout", "json_pointer": "/result" },
 "tool_ref": { "from": "stdout", "json_pointer": "/session_id" },
 "time_limit_s": 600,
 "capabilities": { "resume": true, "cache_ttl_s": 3600 }
}
