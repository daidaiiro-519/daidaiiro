{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-ADOPT-USAGE",
 "name": "取り込みの使い方の誤り",
 "title": "意図を付けずに更新を取り込もうとすると、使い方の誤り（終了コード 2）を返す",
 "why": "意図の無い取り込みは、あとで読む人がなぜ外で直したかを追えない。",
 "traces": [
  "UC2:変形:SAS を通らない変更を取り込む"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:semantic-agent-schema:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": \"エディターで直した目的\",\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--adopt"
  ]
 },
 "after": [
  {
   "args": [
    "update",
    "usecases/u1.json",
    "--adopt",
    "--intent",
    "直した",
    "--patch",
    "[]"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 2
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "usage"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "--intent"
  },
  {
   "of": "after[0]",
   "exit": 2
  },
  {
   "of": "after[0]",
   "pointer": "/message",
   "contains": "--patch"
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
