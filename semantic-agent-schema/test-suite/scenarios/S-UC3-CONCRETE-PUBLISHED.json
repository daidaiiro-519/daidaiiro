{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC3-CONCRETE-PUBLISHED",
 "name": "公開した Concrete を消す",
 "title": "x-published: true の欄を持つ Concrete を消そうとすると、published_changed で止まる",
 "why": "公開した欄はほかの文脈が読むので、黙って消えると読む側が壊れる。",
 "traces": [
  "UC3:拡張:2a",
  "UC3:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "schemas/decision.schema.json",
   "--intent",
   "決定の型を使わなくなった"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "published_changed"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  }
 ],
 "unchanged": [
  "schemas/decision.schema.json"
 ]
}
