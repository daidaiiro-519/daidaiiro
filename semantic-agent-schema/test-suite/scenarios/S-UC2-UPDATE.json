{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-UPDATE",
 "name": "差分を当てて直す",
 "title": "JSON Patch と直す前の指紋を渡して直すと、変えた欄だけの差分と、事前と事後の指紋が返る",
 "why": "何をどう変えたかが残らないと、あとから変更を確かめられない。",
 "traces": [
  "UC2:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/goal\",\"value\":\"検証の結果を受け取り、直す所が分かる\"}]",
   "--if-match",
   "sha256:a309b0b6bfea46263676ac21351805f1bd90f6e223123cb153ee4a9f86dd9d2b"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u1.json"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "updated"
  },
  {
   "of": "when",
   "pointer": "/diff/before/fingerprint",
   "equals": "sha256:a309b0b6bfea46263676ac21351805f1bd90f6e223123cb153ee4a9f86dd9d2b"
  },
  {
   "of": "when",
   "pointer": "/diff/changes",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/change",
   "equals": "replace"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/before",
   "equals": "検証の結果を受け取る"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/after",
   "equals": "検証の結果を受け取り、直す所が分かる"
  },
  {
   "of": "when",
   "pointer": "/stale_rules",
   "count": 0
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets/0/counts/violated",
   "equals": 0
  }
 ]
}
