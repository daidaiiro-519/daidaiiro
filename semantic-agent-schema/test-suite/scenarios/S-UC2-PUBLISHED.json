{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-PUBLISHED",
 "name": "公開した欄を変える",
 "title": "x-published の欄の定義を、$id の版を上げずに変えようとすると、直さずに published_changed を返す",
 "why": "ほかの文脈が読む欄が同じ版のまま変わると、読む側が黙って壊れる。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "update",
   "schemas/decision.schema.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/properties/summary/type\",\"value\":\"array\"}]",
   "--if-match",
   "sha256:deb50d287d444e1899f183eb7709189985e5b4db7b6c8f9fa881e0499ce87d0b"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "published_changed"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/properties/summary"
  }
 ],
 "unchanged": [
  "schemas/decision.schema.json"
 ]
}
