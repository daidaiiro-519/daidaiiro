{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC4-ALL",
 "name": "全件",
 "title": "--all は、リポジトリの Concrete とインスタンスをすべて検証し、検証の操作を対象ごとに1件ずつ記録する",
 "why": "1件ずつ指定しないと全体を確かめられないと、確かめ漏れが出る。",
 "traces": [
  "UC4:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "notes/other.json": "@fixtures/../scenario.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "--all"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/operations",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/path",
   "equals": "schemas/usecase.schema.json"
  },
  {
   "of": "when",
   "pointer": "/targets/1/path",
   "equals": "usecases/u1.json"
  }
 ]
}
