{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-DERIVED",
 "name": "導出値が古いまま",
 "title": "導く元の欄だけを変えて導出値を変えないと、直さずに derived_mismatch を返す",
 "why": "元の答えだけが変わると、導いた値が前の答えのまま残る。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "decisions/d1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/risk\",\"value\":\"high\"}]",
   "--if-match",
   "sha256:d7ef0cf6166d824a6113c9e9ae9fd123fcfbf9b7163043e558e7850b96123003"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "derived_mismatch"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/review"
  }
 ],
 "unchanged": [
  "decisions/d1.json"
 ]
}
