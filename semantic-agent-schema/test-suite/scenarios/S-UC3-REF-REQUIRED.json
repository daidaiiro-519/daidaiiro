{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC3-REF-REQUIRED",
 "name": "記載を消すと型に外れる参照元",
 "title": "メモ N1 の必須の欄 about が U1 を指しているとき、U1 を消そうとすると、何も変えずに references_blocked を返す",
 "why": "必須の欄を外すと N1 が型に従わなくなる。代わりに何を入れるかは機械では決められない。",
 "traces": [
  "UC3:拡張:3a",
  "UC3:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "schemas/note.schema.json": "@fixtures/note.schema.json",
   "notes/n1.json": "@fixtures/n1.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "usecases/u1.json",
   "--intent",
   "U1 は要らなくなった"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "references_blocked"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/blocked/0/path",
   "equals": "notes/n1.json"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/blocked/0/hint",
   "contains": "sas update notes/n1.json"
  }
 ],
 "unchanged": [
  "usecases/u1.json",
  "notes/n1.json"
 ]
}
