{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC1-ADOPT-INVALID",
 "name": "型に従わないファイルを取り込む",
 "title": "型に従わない既存のファイルを取り込もうとすると、取り込まずに invalid_value を記録して返す",
 "why": "型に従わない中身を記録の事後にすると、以後の差分と判定が壊れた中身を前提にする。",
 "traces": [
  "UC1:最低保証",
  "UC1:変形:既存のファイルを取り込む"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "{\n \"$schema\": \"urn:semantic-agent-schema:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": 5,\n \"calls\": []\n}\n"
  }
 },
 "when": {
  "args": [
   "create",
   "usecases/u1.json",
   "--adopt"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
