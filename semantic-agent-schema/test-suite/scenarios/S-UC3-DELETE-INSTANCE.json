{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC3-DELETE-INSTANCE",
 "name": "インスタンスを消し、参照の記載も消す",
 "title": "U2 が calls で U1 を指しているとき、U1 を消すと U2 の記載も消え、削除と書き換えが同じセッションの操作として返る",
 "why": "参照が残ると、消したものを指す記載が陳腐化する。書き換えも記録に残らないと、なぜ U2 が変わったかを追えない。",
 "traces": [
  "UC3:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "usecases/u2.json": "@fixtures/u2-calls-u1.json"
  }
 },
 "when": {
  "args": [
   "delete",
   "usecases/u1.json",
   "--intent",
   "U1 は U2 に統合した"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "--all"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "deleted"
  },
  {
   "of": "when",
   "pointer": "/target/path",
   "equals": "usecases/u1.json"
  },
  {
   "of": "when",
   "pointer": "/diff/after",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/diff/changes",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/diff/changes/2",
   "equals": {
    "pointer": "/goal",
    "change": "remove",
    "before": "検証の結果を受け取る"
   }
  },
  {
   "of": "when",
   "pointer": "/references",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/references/0/target/path",
   "equals": "usecases/u2.json"
  },
  {
   "of": "when",
   "pointer": "/references/0/cause",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/references/0/operation",
   "equals": "o-0002"
  },
  {
   "of": "when",
   "pointer": "/references/0/diff/changes/0",
   "equals": {
    "pointer": "/calls/0",
    "change": "remove",
    "before": "U1"
   }
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/counts/violated",
   "equals": 0
  },
  {
   "of": "after[0]",
   "pointer": "/targets",
   "count": 2
  }
 ]
}
