{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-ADOPT-INVALID",
 "name": "外で型に外れた",
 "title": "外で型に外れる中身に直されたファイルを取り込もうとすると、取り込まずに invalid_value を記録し、次の検証でも untracked のまま",
 "why": "型に外れた中身を記録の事後にすると、以後の比べる指紋が壊れた中身を指す。",
 "traces": [
  "UC2:変形:SAS を通らない変更を取り込む",
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  },
  "steps": [
   {
    "args": [
     "create",
     "usecases/u1.json",
     "--adopt"
    ]
   },
   {
    "write": {
     "path": "usecases/u1.json",
     "content": "{\n \"$schema\": \"urn:semantic-agent-schema:sample:usecase:v1\",\n \"id\": \"U1\",\n \"goal\": 5,\n \"calls\": []\n}\n"
    }
   }
  ]
 },
 "when": {
  "args": [
   "update",
   "usecases/u1.json",
   "--adopt",
   "--intent",
   "目的を数にした"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u1.json"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  },
  {
   "of": "after[0]",
   "exit": 1
  },
  {
   "of": "after[0]",
   "pointer": "/untracked",
   "count": 1
  }
 ],
 "unchanged": [
  "usecases/u1.json"
 ]
}
