{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC1-INVALID",
 "name": "型に従わない値",
 "title": "Concrete の形に従わない値で作ろうとすると、ファイルを作らず、理由と操作の記録の ID を返す",
 "why": "形に外れた値を書いてから直させると、壊れたファイルを読む人とツールが出る。",
 "traces": [
  "UC1:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "usecases/u2.json",
   "--concrete",
   "urn:semantic-agent-schema:sample:usecase:v1",
   "--value",
   "{\"id\":\"X2\",\"goal\":\"g\",\"calls\":[]}"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "usecases/u2.json"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "error"
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "invalid_value"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/id"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "equals": "o-0001"
  },
  {
   "of": "when",
   "pointer": "/session",
   "equals": "s-0001"
  },
  {
   "of": "after[0]",
   "exit": 1
  },
  {
   "of": "after[0]",
   "pointer": "/code",
   "equals": "not_found"
  }
 ]
}
