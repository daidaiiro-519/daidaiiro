{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC2-HUMAN-FIELD",
 "name": "ツールが人の欄を変える",
 "title": "名乗ったツールが人の欄を変えようとすると、直さずに human_field を返す",
 "why": "人が決める欄をツールが変えられると、承認していない値が承認済みに見える。",
 "traces": [
  "UC2:最低保証"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "decisions/d1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/status\",\"value\":\"approved\"}]",
   "--if-match",
   "sha256:d7ef0cf6166d824a6113c9e9ae9fd123fcfbf9b7163043e558e7850b96123003",
   "--session",
   "agent-1"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "human_field"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  }
 ],
 "unchanged": [
  "decisions/d1.json"
 ]
}
