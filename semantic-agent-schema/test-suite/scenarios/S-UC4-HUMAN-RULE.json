{
 "$schema": "urn:semantic-agent-schema:test-suite:scenario:v1",
 "id": "S-UC4-HUMAN-RULE",
 "name": "人の rule",
 "title": "by: human の rule は unverified になり、verified に数えない",
 "why": "機械や AI が人の決めることを verified にすると、人が決めていないものが決まったことになる。",
 "traces": [
  "UC4:最低保証",
  "UC4:拡張:3a",
  "UC4:拡張:6b"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "usecases/u1.json"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/unverified",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/1/rule",
   "equals": "goal-is-outcome"
  },
  {
   "of": "when",
   "pointer": "/targets/0/results/1/result",
   "equals": "unverified"
  }
 ]
}
