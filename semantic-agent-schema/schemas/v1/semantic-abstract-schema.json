{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
 "title": "Semantic Abstract Schema",
 "description": "Semantic Concrete Schema が $schema に書くメタスキーマ。JSON Schema 2020-12 の形に、Abstract の9つの x- を足す。根に x-instance-path ・ x-instance-label ・ x-delegates ・ x-extensions、根と欄に x-prompt、欄に x-relationship ・ x-derived-from ・ x-decided-by ・ x-published を書く",
 "allOf": [
  {"$ref": "https://json-schema.org/draft/2020-12/schema"},
  {"$ref": "#/$defs/field"}
 ],
 "type": "object",
 "required": ["$schema", "$id", "title", "description"],
 "properties": {
  "$schema": {"const": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1", "description": "従う Abstract の版"},
  "$id": {"$ref": "#/$defs/urn", "description": "この Concrete の名前（URN）"},
  "x-instance-path": {"type": "string", "pattern": "\\{id\\}", "description": "インスタンスを置く場所。名前の入る所は {id} と書く（RFC 6570 のレベル1）"},
  "x-instance-label": {"type": "string", "minLength": 1, "description": "他から指されたときと、変更を見せるときのインスタンスの名前の型"},
  "x-delegates": {
   "type": "object",
   "description": "任せる先。名前 → 定義。ほかの Concrete の URN を書かない",
   "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
   "additionalProperties": {"$ref": "#/$defs/delegate"}
  },
  "x-extensions": {
   "type": "object",
   "description": "Concrete が足す x- の定義。名前 → 定義。名前は x- で始め、Abstract の9つとぶつからない",
   "propertyNames": {"pattern": "^x-[a-z][a-z0-9-]*$", "not": {"enum": ["x-prompt", "x-instance-path", "x-instance-label", "x-delegates", "x-extensions", "x-relationship", "x-derived-from", "x-decided-by", "x-published"]}},
   "additionalProperties": {"$ref": "#/$defs/extension"}
  }
 },
 "$defs": {
  "urn": {"type": "string", "pattern": "^urn:semantic-agent-schema:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:v[1-9][0-9]*$", "description": "urn:semantic-agent-schema:<持ち主>:<種類>:v<版>"},
  "field": {
   "description": "書く単位（欄）に付ける x-。入れ子の欄にも同じ形を掛ける",
   "type": ["object", "boolean"],
   "properties": {
    "x-prompt": {"$ref": "#/$defs/prompt"},
    "x-relationship": {"type": "object", "required": ["to"], "additionalProperties": false, "properties": {"to": {"$ref": "#/$defs/urn"}}, "description": "この欄が指すインスタンスの種類"},
    "x-derived-from": {"type": "object", "additionalProperties": false, "properties": {"rules": {"type": "array"}, "otherwise": {}, "declared": {"type": "boolean"}}, "description": "この欄の値を何からどう導くか"},
    "x-decided-by": {"const": "human", "description": "この欄の値を決めるのは人である（決定権）"},
    "x-published": {"type": "boolean", "description": "この欄を他の文脈へ見せる"},
    "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field"}},
    "items": {"$ref": "#/$defs/field"},
    "prefixItems": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "$defs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/field"}},
    "additionalProperties": {"$ref": "#/$defs/field"}
   }
  },
  "prompt": {
   "type": "object",
   "description": "セマンティックプロンプト。read は読み方、write は書くときに守る rule の並び",
   "additionalProperties": false,
   "properties": {
    "read": {"type": "object", "additionalProperties": false, "properties": {"means": {"type": "string"}, "parse": {"type": "string"}, "shown": {"type": "string"}, "when": {"type": "string"}}},
    "write": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
   }
  },
  "rule": {
   "type": "object",
   "description": "rule の1件（エンティティ。Concrete の中で id は一意）",
   "required": ["id", "rule", "why", "test", "by"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "rule": {"type": "string", "minLength": 1, "description": "状態で書いた決まり"},
    "why": {"type": "string", "minLength": 1},
    "test": {"type": "string", "minLength": 1, "description": "どう確かめるか"},
    "by": {"enum": ["machine", "ai", "human"]},
    "reads": {"type": "array", "items": {"type": "string", "pattern": "^(/.*)?$"}, "description": "読む欄の JSON Pointer。書かなければインスタンスの全体"},
    "agent": {"type": "string", "description": "by が ai のとき、x-delegates の名前"},
    "bad": {"type": "string"},
    "good": {"type": "string"}
   },
   "if": {"required": ["by"], "properties": {"by": {"const": "ai"}}},
   "then": {"required": ["agent"]},
   "dependentRequired": {"bad": ["good"], "good": ["bad"]}
  },
  "delegate": {
   "type": "object",
   "description": "任せる先の定義（エンティティ。名前で引く）。run に argv があれば CLI のプロセスとして動かす",
   "required": ["kind", "role"],
   "additionalProperties": false,
   "properties": {
    "kind": {"enum": ["judging", "working"]},
    "role": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "description": "答えの形（スキーマの $ref）"},
    "run": {"type": "object", "required": ["argv"], "additionalProperties": false, "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
   }
  },
  "extension": {
   "type": "object",
   "description": "Concrete が足す x- の定義",
   "required": ["schema", "description"],
   "additionalProperties": false,
   "properties": {
    "schema": {"type": ["object", "boolean"], "description": "値の形（JSON Schema）"},
    "description": {"type": "string", "minLength": 1},
    "prompt": {"$ref": "#/$defs/prompt"},
    "published": {"type": "boolean"}
   }
  }
 }
}
