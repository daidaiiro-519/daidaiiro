{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-NAME-OVERLAP",
 "name": "名前が重なる",
 "title": "同じ親フォルダに、name が同じ fact-check の Skill がもう1つ（フォルダ name-mismatch）あると、fact-check を確かめたときに creator の name-unique が violated になり、重なった相手のフォルダを path に返す",
 "why": "名前が重なる Skill を同じ所に置くと、AI ツールはどちらを使うかを決められない。複数の Skill をまたぐので、SAS の文書1つの検証では見つからない。",
 "traces": [
  "UC4:成功時保証",
  "約束:check-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json",
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json",
   "skills/name-mismatch/skill.json": "@fixtures/fact-check/skill.json"
  }
 },
 "when": {
  "args": [
   "check",
   "skills/fact-check"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/0/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/1/check",
   "equals": "name-unique"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/1/result",
   "equals": "violated"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/1/path",
   "equals": "skills/name-mismatch"
  }
 ]
}
