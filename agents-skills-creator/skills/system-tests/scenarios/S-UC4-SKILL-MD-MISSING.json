{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-SKILL-MD-MISSING",
 "name": "SKILL.md が無い",
 "title": "SKILL.md が無いと、creator の skill-md-built が violated になり、build で作るよう理由に書く",
 "why": "SKILL.md が無い Skill は、AI ツールから読めず、配っても使われない。",
 "traces": [
  "UC4:成功時保証",
  "約束:check-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json",
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json"
  }
 },
 "when": {
  "args": [
   "check",
   "skills/fact-check"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/result",
   "equals": "violated"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/reason",
   "contains": "build"
  }
 ]
}
