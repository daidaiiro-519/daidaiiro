{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC1-LIKE-PROCEDURE",
 "name": "同じ形で作る手順",
 "title": "new --like に既にある Skill（skills/ddd-advisor）を渡すと、同じ形かを確かめる問い（q0）・ 場面の問い（q1）・ 資料の問い（q4）だけを返し、目的の who と gets ・ 役割 ・ 手順 ・ 決まりなどは元の値をそのまま既定にする（like.keep）。聞く所と作り直す所は domain の表から決まり、書く値に same_shape_as を入れる。元の Skill は変わらない",
 "why": "同じ形の Skill を作るたびに3問から答え直すと、役割や手順が元と少しずつずれ、同じ形の Skill をまとめて直せなくなる。",
 "traces": [
  "UC1:拡張:2a",
  "UC1:拡張:2a1a",
  "UC1:拡張:2a2a",
  "UC1:最低保証",
  "約束:new-procedure"
 ],
 "given": {
  "files": {
   "skills/ddd-advisor/skill.json": "@fixtures/ddd-advisor/skill.json"
  }
 },
 "when": {
  "args": [
   "new",
   "--like",
   "skills/ddd-advisor"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/like/name",
   "equals": "ddd-advisor"
  },
  {
   "of": "when",
   "pointer": "/like/folder",
   "equals": "skills/ddd-advisor"
  },
  {
   "of": "when",
   "pointer": "/questions",
   "count": 3
  },
  {
   "of": "when",
   "pointer": "/questions/0/id",
   "equals": "q0"
  },
  {
   "of": "when",
   "pointer": "/questions/0/fills/0",
   "equals": "/same_shape_as"
  },
  {
   "of": "when",
   "pointer": "/questions/0/how",
   "contains": "2a1a"
  },
  {
   "of": "when",
   "pointer": "/questions/0/how",
   "contains": "agents-skills-creator new skills"
  },
  {
   "of": "when",
   "pointer": "/questions/1/id",
   "equals": "q1"
  },
  {
   "of": "when",
   "pointer": "/questions/1/fills",
   "equals": [
    "/purpose/when"
   ]
  },
  {
   "of": "when",
   "pointer": "/questions/2/id",
   "equals": "q4"
  },
  {
   "of": "when",
   "pointer": "/questions/2/ask",
   "contains": "判断基準"
  },
  {
   "of": "when",
   "pointer": "/questions/2/how",
   "contains": "2a2a"
  },
  {
   "of": "when",
   "pointer": "/like/ask",
   "equals": [
    "/purpose/when",
    "/references"
   ]
  },
  {
   "of": "when",
   "pointer": "/like/derive",
   "equals": [
    "/name",
    "/description",
    "/examples"
   ]
  },
  {
   "of": "when",
   "pointer": "/like/keep/0/field",
   "equals": "/purpose/who"
  },
  {
   "of": "when",
   "pointer": "/like/keep/0/value",
   "equals": "設計を決める人か、その人から頼まれた AI"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "contains": "/steps"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "contains": "/role"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "contains": "/completion_criteria"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "lacks": "/examples"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "lacks": "/references"
  },
  {
   "of": "when",
   "pointer": "/like/keep",
   "lacks": "/same_shape_as"
  },
  {
   "of": "when",
   "pointer": "/compose",
   "contains": "\"source\":\"keep\""
  },
  {
   "of": "when",
   "pointer": "/write/command",
   "equals": "sas create skills/<name>/skill.json --concrete urn:agents-skills-creator:skill:v1 --value <JSON>"
  },
  {
   "of": "when",
   "pointer": "/constraints",
   "contains": "same_shape_as に「ddd-advisor」"
  },
  {
   "of": "when",
   "pointer": "/then/2",
   "equals": "agents-skills-creator confirm skills/<name>"
  }
 ],
 "unchanged": [
  "skills/ddd-advisor/skill.json"
 ]
}
