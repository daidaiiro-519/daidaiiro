{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC1-CREATE-PROCEDURE",
 "name": "Skill を作る手順",
 "title": "create に置き場所と Skill の Concrete（skill.schema）と --semantic を渡すと、sas create --semantic の結果を書き換えずに sas に入れ、先頭に作る流れ（最初の返事で見せる4つ ・ 構造の像の4つ ・ 聞く所の見分け方 ・ 問いの形 ・ 2往復目から ・ 仕上げ ・ 守ること ・ 見せ方）を添え、何も書かない",
 "why": "作る人は欄の言葉の問いに答えても意味を感じられない。打ったセッションが、目的の仮説と完成の像と構造の像を先に見せ、結果を左右する所だけを推奨付きで聞けないと、作る人は見て直すことができない。",
 "traces": [
  "UC1:成功時保証",
  "約束:create-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "skills",
   "--concrete",
   "urn:agents-skills-creator:skill:v1",
   "--semantic"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "create"
  },
  {
   "of": "when",
   "pointer": "/questions",
   "exists": false
  },
  {
   "of": "when",
   "pointer": "/flow/guess_mark",
   "equals": "【推測】"
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply/0/id",
   "equals": "purpose"
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply/1/id",
   "equals": "completion"
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply/2/id",
   "equals": "structure"
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply/3/id",
   "equals": "questions"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/0/id",
   "equals": "scope"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/1/id",
   "equals": "materials"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/2/id",
   "equals": "steps"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/3/id",
   "equals": "common"
  },
  {
   "of": "when",
   "pointer": "/flow/box_names",
   "contains": "動詞"
  },
  {
   "of": "when",
   "pointer": "/flow/ask_only_when",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/flow/ask_only_when/0",
   "contains": "完成の像"
  },
  {
   "of": "when",
   "pointer": "/flow/otherwise",
   "contains": "【推測】"
  },
  {
   "of": "when",
   "pointer": "/flow/question",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/flow/question/1/id",
   "equals": "recommended"
  },
  {
   "of": "when",
   "pointer": "/flow/later_rounds",
   "contains": "前 → 後"
  },
  {
   "of": "when",
   "pointer": "/flow/later_rounds",
   "contains": "残りの問いの数"
  },
  {
   "of": "when",
   "pointer": "/flow/finish",
   "contains": "別の会話"
  },
  {
   "of": "when",
   "pointer": "/flow/finish",
   "contains": "承認の前と後"
  },
  {
   "of": "when",
   "pointer": "/flow/rules",
   "contains": "仮説"
  },
  {
   "of": "when",
   "pointer": "/flow/presentation",
   "contains": "木構造"
  },
  {
   "of": "when",
   "pointer": "/sas/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/sas/target/path",
   "equals": "skills/<name>/skill.json"
  },
  {
   "of": "when",
   "pointer": "/sas_exit",
   "equals": 0
  }
 ],
 "unchanged": [
  "published-language/v1/skill.schema.json"
 ]
}
