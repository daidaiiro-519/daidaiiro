{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC1-NEW-SAME-SHAPE",
 "name": "同じ形に気づく",
 "title": "new に Skill の置き場所を渡すと、そこにある Skill（name ・ description ・ フォルダ）を existing に並べ、同じ形の Skill に気づいたら示して選ばせ、選んだら new --like へ移ることを constraints に書く",
 "why": "同じ形の Skill があるのに3問から作ると、同じ形の Skill が別々に育ち、まとめて直せなくなる。",
 "traces": [
  "UC1:拡張:4a",
  "約束:new-procedure"
 ],
 "given": {
  "files": {
   "skills/ddd-advisor/skill.json": "@fixtures/ddd-advisor/skill.json",
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json"
  }
 },
 "when": {
  "args": [
   "new",
   "skills"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/existing",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/existing/0/name",
   "equals": "ddd-advisor"
  },
  {
   "of": "when",
   "pointer": "/existing/0/folder",
   "equals": "skills/ddd-advisor"
  },
  {
   "of": "when",
   "pointer": "/existing/1/description",
   "contains": "真偽は判定しない"
  },
  {
   "of": "when",
   "pointer": "/constraints",
   "contains": "4a"
  },
  {
   "of": "when",
   "pointer": "/constraints",
   "contains": "new --like"
  }
 ]
}
