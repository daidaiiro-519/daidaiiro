{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-USAGE",
 "name": "使い方の誤り",
 "title": "validate にフォルダを渡さないと、使い方の誤り（kind = error、code usage）で終了コード 2 を返す",
 "why": "何を確かめたかが分からない結果を返すと、何も確かめていないのに使えると読まれる。",
 "traces": [
  "UC4:最低保証",
  "約束:validate-result"
 ],
 "given": {
  "files": {}
 },
 "when": {
  "args": [
   "validate"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 2
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "error"
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "usage"
  }
 ]
}
