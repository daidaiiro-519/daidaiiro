{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-CHECK-OK",
 "name": "使える Skill を確かめる",
 "title": "名前がフォルダ名と同じで、ほかと重ならず、リンクの先がそろう Skill（fact-check）を確かめると、SAS の検証の結果をそのまま入れ、creator の11の検査（出力の schema があるか ・ SKILL.md が write-skill-md の出力と同じか ・ 参照する資料があるかを含む。資料を持たない Skill では資料の検査と資料の根拠の検査は verified）がどれも verified になり、終了コード 0 で返す。確かめても Skill のファイルは変わらない（SAS の記録には検証の操作が1件足される）",
 "why": "使えるかどうかが分からないと、作る人は配布してよいかを決められない。",
 "traces": [
  "UC4:成功時保証",
  "UC4:最低保証",
  "約束:validate-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json",
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json",
   "skills/fact-check/SKILL.md": "@fixtures/fact-check/SKILL.md",
   "skills/fact-check/references/verify-result.schema.json": "@fixtures/fact-check/references/verify-result.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "skills/fact-check"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "validate"
  },
  {
   "of": "when",
   "pointer": "/detected",
   "equals": false
  },
  {
   "of": "when",
   "pointer": "/skills",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/folder",
   "equals": "skills/fact-check"
  },
  {
   "of": "when",
   "pointer": "/skills/0/sas/$schema",
   "equals": "urn:semantic-agent-schema:published-language:command-result:v1"
  },
  {
   "of": "when",
   "pointer": "/skills/0/sas/kind",
   "equals": "validation"
  },
  {
   "of": "when",
   "pointer": "/skills/0/sas/targets/0/path",
   "equals": "skills/fact-check/skill.json"
  },
  {
   "of": "when",
   "pointer": "/skills/0/sas_exit",
   "equals": 0
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator",
   "count": 11
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/0/check",
   "equals": "name-is-folder"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/0/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/1/check",
   "equals": "name-unique"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/1/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/2/check",
   "equals": "links-resolve"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/2/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/check",
   "equals": "skill-md-built"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/4/check",
   "equals": "references-exist"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/4/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/4/reason",
   "contains": "references が無い"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/5/check",
   "equals": "json-schema-conforms"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/5/result",
   "equals": "verified"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/6/check",
   "equals": "grounds-are-outputs"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/6/result",
   "equals": "verified"
  }
 ],
 "unchanged": [
  "skills/fact-check/skill.json",
  "skills/fact-check/SKILL.md",
  "skills/fact-check/references/verify-result.schema.json"
 ]
}
