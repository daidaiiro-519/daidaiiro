{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC1-NEW-PROCEDURE",
 "name": "作る手順を受け取る",
 "title": "new に Skill の置き場所を渡すと、問1〜問3（1往復に1問）・ 別の場面2つの出し方 ・ 答えから skill.json の値を組む決まり（Concrete の rule を含む）・ 書く sas create のコマンド ・ そのあとの build → check → confirm を返し、何も書かない",
 "why": "creator は AI を起動しないので、打ったセッションが手順だけで作る人に聞き、SAS に書かせられないと、Skill を作れない。",
 "traces": [
  "UC1:成功時保証",
  "約束:new-procedure"
 ],
 "given": {
  "files": {}
 },
 "when": {
  "args": [
   "new",
   "skills"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/questions",
   "count": 3
  },
  {
   "of": "when",
   "pointer": "/questions/0/id",
   "equals": "q1"
  },
  {
   "of": "when",
   "pointer": "/questions/2/id",
   "equals": "q3"
  },
  {
   "of": "when",
   "pointer": "/questions/0/fills",
   "contains": "/purpose/who"
  },
  {
   "of": "when",
   "pointer": "/questions/1/fills/0",
   "equals": "/purpose/gets"
  },
  {
   "of": "when",
   "pointer": "/questions/2/fills/0",
   "equals": "/role/does_not"
  },
  {
   "of": "when",
   "pointer": "/scenes/count",
   "equals": 2
  },
  {
   "of": "when",
   "pointer": "/compose",
   "contains": "purpose-standalone"
  },
  {
   "of": "when",
   "pointer": "/compose",
   "contains": "criterion-not-content"
  },
  {
   "of": "when",
   "pointer": "/write/command",
   "equals": "sas create skills/<name>/skill.json --concrete urn:agents-skills-creator:skill:v1 --value <JSON>"
  },
  {
   "of": "when",
   "pointer": "/then",
   "count": 3
  },
  {
   "of": "when",
   "pointer": "/then/0",
   "equals": "agents-skills-creator build skills/<name>"
  },
  {
   "of": "when",
   "pointer": "/then/1",
   "equals": "agents-skills-creator check skills/<name>"
  },
  {
   "of": "when",
   "pointer": "/then/2",
   "equals": "agents-skills-creator confirm skills/<name>"
  }
 ]
}
