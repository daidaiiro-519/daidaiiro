   "skills/ddd-advisor/SKILL.md": "@fixtures/skills/ddd-advisor/SKILL.md",
   "skills/usecase-advisor/skill.json": "@fixtures/skills/usecase-advisor/skill.json",
   "skills/usecase-advisor/SKILL.md": "@fixtures/skills/usecase-advisor/SKILL.md",
   "skills/qa-advisor/skill.json": "@fixtures/skills/qa-advisor/skill.json",
   "skills/qa-advisor/SKILL.md": "@fixtures/skills/qa-advisor/SKILL.md",
   "skills/ux-advisor/skill.json": "@fixtures/skills/ux-advisor/skill.json",
   "skills/ux-advisor/SKILL.md": "@fixtures/skills/ux-advisor/SKILL.md",
   "skills/platform-advisor/skill.json": "@fixtures/skills/platform-advisor/skill.json",
   "skills/platform-advisor/SKILL.md": "@fixtures/skills/platform-advisor/SKILL.md",
   "skills/meta-thinking-advisor/skill.json": "@fixtures/skills/meta-thinking-advisor/skill.json",
   "skills/meta-thinking-advisor/SKILL.md": "@fixtures/skills/meta-thinking-advisor/SKILL.md"
  },
  "links": {
   "agents/consult-advisors/skills/ddd-advisor": "../../../skills/ddd-advisor",
   "agents/consult-advisors/skills/usecase-advisor": "../../../skills/usecase-advisor",
   "agents/consult-advisors/skills/qa-advisor": "../../../skills/qa-advisor",
   "agents/consult-advisors/skills/ux-advisor": "../../../skills/ux-advisor",
   "agents/consult-advisors/skills/platform-advisor": "../../../skills/platform-advisor",
   "agents/consult-advisors/skills/meta-thinking-advisor": "../../../skills/meta-thinking-advisor"
  }
 },
 "when": {
  "args": [
   "create",
   "agents/<name>",
   "--semantic"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "create"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/1/id",
   "equals": "calls"
  },
  {
   "of": "when",
   "pointer": "/flow/rules",
   "contains": "人が承認するステップだけ"
  },
  {
   "of": "when",
   "pointer": "/sas/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/sas/target/path",
   "equals": "agents/<name>/agent.json"
  },
  {
   "of": "when",
   "pointer": "/sas/steps",
   "contains": "\"pointer\":\"/skills\""
  },
  {
   "of": "when",
   "pointer": "/sas/steps",
   "contains": "\"pointer\":\"/steps\""
  },
  {
   "of": "when",
   "pointer": "/sas/command",
   "equals": "agents-skills-creator agents create agents/<name> --concrete urn:agents-skills-creator:agent:v1 --value <JSON か @<ファイル>>"
  },
  {
   "of": "when",
   "pointer": "/sas/constraints",
   "lacks": "command の sas"
  }
 ]
