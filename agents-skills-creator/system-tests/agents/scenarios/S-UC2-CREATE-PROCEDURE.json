{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC2-CREATE-PROCEDURE",
 "name": "Agent を作る手順",
 "title": "agents create に Agent のフォルダ（名前の決まっていない agents/<name> でもよい）と Agent の Concrete と --semantic を渡すと、semantic-agent-schema create --semantic の結果を書き換えずに semantic_agent_schema に入れ、作る流れ（目的の仮説 ・ 完成の像 ・ 構造の像：受け持つ範囲 ・ 呼ぶ Skill と受け渡し ・ 手順と分かれ道 ・ まとめ方）を添え、何も書かない。--concrete を省くと、Agent の Concrete を使う。既定の Concrete なら command に --concrete を付けない。constraints は返す手順に無い欄（inner_rules）を指さず、手順にある rules（文書全体に当たる rule。current-shape-only）を指す。目的の仮説は「進めてよいと答える」で決まり、「承認」の語を使わない（承認は approve だけ）",
 "why": "Agent は配下の Skill をどう呼んでまとめるかを持つので、作る人に呼ぶ Skill と受け渡しの像を見せずに書くと、Agent が作業の中身を持ち始める。",
 "traces": [
  "UC2:成功時保証",
  "約束:create-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json",
   "agents-published/agent.schema.json": "@published/agent.schema.json",
   "skills/ddd-advisor/skill.json": "@fixtures/skills/ddd-advisor/skill.json",
   "skills/ddd-advisor/SKILL.md": "@fixtures/skills/ddd-advisor/SKILL.md",
   "skills/usecase-advisor/skill.json": "@fixtures/skills/usecase-advisor/skill.json",
   "skills/usecase-advisor/SKILL.md": "@fixtures/skills/usecase-advisor/SKILL.md",
   "skills/qa-advisor/skill.json": "@fixtures/skills/qa-advisor/skill.json",
   "skills/qa-advisor/SKILL.md": "@fixtures/skills/qa-advisor/SKILL.md",
   "skills/ux-advisor/skill.json": "@fixtures/skills/ux-advisor/skill.json",
   "skills/ux-advisor/SKILL.md": "@fixtures/skills/ux-advisor/SKILL.md",
   "skills/platform-advisor/skill.json": "@fixtures/skills/platform-advisor/skill.json",
   "skills/platform-advisor/SKILL.md": "@fixtures/skills/platform-advisor/SKILL.md",
   "skills/meta-thinking-advisor/skill.json": "@fixtures/skills/meta-thinking-advisor/skill.json",
   "skills/meta-thinking-advisor/SKILL.md": "@fixtures/skills/meta-thinking-advisor/SKILL.md"
  },
  "links": {
   "agents/consult-advisors/skills/ddd-advisor": "../../../skills/ddd-advisor",
   "agents/consult-advisors/skills/usecase-advisor": "../../../skills/usecase-advisor",
   "agents/consult-advisors/skills/qa-advisor": "../../../skills/qa-advisor",
   "agents/consult-advisors/skills/ux-advisor": "../../../skills/ux-advisor",
   "agents/consult-advisors/skills/platform-advisor": "../../../skills/platform-advisor",
   "agents/consult-advisors/skills/meta-thinking-advisor": "../../../skills/meta-thinking-advisor"
  }
 },
 "when": {
  "args": [
   "create",
   "agents/<name>",
   "--semantic"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "create"
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image",
   "count": 4
  },
  {
   "of": "when",
   "pointer": "/flow/structure_image/1/id",
   "equals": "calls"
  },
  {
   "of": "when",
   "pointer": "/flow/rules",
   "contains": "人に結果を確かめてもらうステップ（kind approve）だけ"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/target/path",
   "equals": "agents/<name>/agent.json"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/steps",
   "contains": "\"pointer\":\"/skills\""
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/steps",
   "contains": "\"pointer\":\"/steps\""
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/command",
   "equals": "agents-skills-creator agents create agents/<name> --value <JSON か @<ファイル>>"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/constraints",
   "lacks": "command の semantic-agent-schema"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/constraints",
   "lacks": "inner_rules"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema/constraints",
   "contains": "手順の rules（文書全体に当たる rule）"
  },
  {
   "of": "when",
   "pointer": "/flow",
   "lacks": "作る人の承認で"
  },
  {
   "of": "when",
   "pointer": "/flow",
   "lacks": "承認して決める"
  },
  {
   "of": "when",
   "pointer": "/flow/first_reply/0/how",
   "contains": "進めてよい"
  },
  {
   "of": "when",
   "pointer": "/flow/rules",
   "contains": "承認の前に自分で気づいた直しも"
  },
  {
   "of": "when",
   "pointer": "/semantic_agent_schema_exit",
   "equals": 0
  }
 ]
}
