{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-SAS-OUTSIDE",
 "name": "Concrete がリポジトリに無い",
 "title": "Skill の Concrete（skill.schema）が打った場所の中に無いと、SAS の検証は unknown_schema で断り、creator はその出力を書き換えずに入れる（分かっている制約。creator の検査はそのまま行う）",
 "why": "SAS は打った場所の中から Concrete を探す。その制約が creator の出力から隠れると、作る人は Skill が悪いのか置き場所が悪いのかを見分けられない。",
 "traces": [
  "UC4:成功時保証",
  "約束:validate-result"
 ],
 "given": {
  "files": {
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "skills/fact-check"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/semantic_agent_schema/kind",
   "equals": "error"
  },
  {
   "of": "when",
   "pointer": "/skills/0/semantic_agent_schema/code",
   "equals": "unknown_schema"
  },
  {
   "of": "when",
   "pointer": "/skills/0/semantic_agent_schema_exit",
   "equals": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/0/result",
   "equals": "verified"
  }
 ]
}
