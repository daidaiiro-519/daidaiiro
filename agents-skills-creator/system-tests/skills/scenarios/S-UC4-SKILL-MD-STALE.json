{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC4-SKILL-MD-STALE",
 "name": "SKILL.md が古い",
 "title": "SKILL.md が、skill.json から write-skill-md で作るものと違う（直したあとに write-skill-md し直していない）と、creator の skill-md-built が violated になる",
 "why": "AI ツールが読むのは SKILL.md なので、skill.json だけを直しても、使われる Skill は直らない。",
 "traces": [
  "UC4:成功時保証",
  "約束:validate-result"
 ],
 "given": {
  "files": {
   "published-language/v1/skill.schema.json": "@published/skill.schema.json",
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json",
   "skills/fact-check/SKILL.md": "---\nname: fact-check\ndescription: 古い説明\n---\n"
  }
 },
 "when": {
  "args": [
   "validate",
   "skills/fact-check"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/check",
   "equals": "skill-md-built"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/result",
   "equals": "violated"
  },
  {
   "of": "when",
   "pointer": "/skills/0/creator/3/path",
   "equals": "skills/fact-check/SKILL.md"
  }
 ]
}
