{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC6-WITHDRAW",
 "name": "配布を取り下げる",
 "title": "AI のセッションから withdraw を打つと、外さずに影響（配布されている置き場所の4か所のうち在るもの：creator が置いたリンクか、ほかのものか）と、人が打つコマンドを返す。人が打つと、Skill のフォルダを指すリンクだけを外し、実体のフォルダ ・ ほかのもの ・ Skill の実体は残す。もう一度打つと外すものが無い",
 "why": "作る人が承認する前に使わなくなると、その Skill を使っている人やツールが黙って使えなくなる。creator が置いていないものまで外すと、ほかの Skill が消える。",
 "traces": [
  "UC6:成功時保証",
  "UC6:最低保証",
  "約束:withdraw-result"
 ],
 "given": {
  "files": {
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json",
   "skills/fact-check/SKILL.md": "@fixtures/fact-check/SKILL.md",
   ".agents/skills/fact-check/SKILL.md": "---\nname: fact-check\ndescription: 別の Skill\n---\n"
  },
  "links": {
   ".claude/skills/fact-check": "../../skills/fact-check",
   "home/.agents/skills/fact-check": "../../../skills/fact-check"
  }
 },
 "when": {
  "args": [
   "withdraw",
   "skills/fact-check",
   "--reason",
   "照合は SAS の search に任せることにした"
  ],
  "env": {
   "HOME": "@workdir/home",
   "CLAUDE_CODE_SESSION_ID": "agent-1"
  }
 },
 "after": [
  {
   "args": [
    "withdraw",
    "skills/fact-check",
    "--reason",
    "照合は SAS の search に任せることにした"
   ],
   "env": {
    "HOME": "@workdir/home"
   }
  },
  {
   "args": [
    "withdraw",
    "skills/fact-check",
    "--reason",
    "照合は SAS の search に任せることにした"
   ],
   "env": {
    "HOME": "@workdir/home"
   }
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "withdraw"
  },
  {
   "of": "when",
   "pointer": "/withdrawn",
   "equals": false
  },
  {
   "of": "when",
   "pointer": "/reason",
   "equals": "照合は SAS の search に任せることにした"
  },
  {
   "of": "when",
   "pointer": "/places",
   "count": 3
  },
  {
   "of": "when",
   "pointer": "/places",
   "contains": "\"path\":\".claude/skills/fact-check\",\"tool\":\"claude-code\",\"scope\":\"repository\",\"state\":\"linked\""
  },
  {
   "of": "when",
   "pointer": "/places",
   "contains": "\"path\":\".agents/skills/fact-check\",\"tool\":\"codex\",\"scope\":\"repository\",\"state\":\"other\""
  },
  {
   "of": "when",
   "pointer": "/places",
   "contains": "home/.agents/skills/fact-check"
  },
  {
   "of": "when",
   "pointer": "/removed",
   "count": 0
  },
  {
   "of": "when",
   "pointer": "/next",
   "contains": "agents-skills-creator skills withdraw skills/fact-check"
  },
  {
   "of": "when",
   "pointer": "/next",
   "contains": "人"
  },
  {
   "of": "after[0]",
   "exit": 0
  },
  {
   "of": "after[0]",
   "pointer": "/withdrawn",
   "equals": true
  },
  {
   "of": "after[0]",
   "pointer": "/removed",
   "count": 2
  },
  {
   "of": "after[0]",
   "pointer": "/after",
   "contains": "\"check\":\"unlinked\",\"result\":\"verified\""
  },
  {
   "of": "after[1]",
   "exit": 0
  },
  {
   "of": "after[1]",
   "pointer": "/removed",
   "count": 0
  },
  {
   "of": "after[1]",
   "pointer": "/places",
   "count": 1
  },
  {
   "of": "when",
   "file": ".claude/skills/fact-check/SKILL.md",
   "exists": false
  },
  {
   "of": "when",
   "file": "home/.agents/skills/fact-check/SKILL.md",
   "exists": false
  },
  {
   "of": "when",
   "file": ".agents/skills/fact-check/SKILL.md",
   "contains": "別の Skill"
  },
  {
   "of": "when",
   "file": "skills/fact-check/skill.json",
   "same_as": "@fixtures/fact-check/skill.json"
  }
 ]
}
