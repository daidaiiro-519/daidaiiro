{
 "$schema": "urn:agents-skills-creator:system-tests:scenario:v1",
 "id": "S-UC1-BUILD",
 "name": "SKILL.md を作る",
 "title": "write-skill-md は skill.json から決まった形の SKILL.md（frontmatter の name ・ description と、目的 ・ 役割 ・ 事前条件 ・ 手順 ・ 守ること ・ 最低保証 ・ 完了条件 ・ 例）を同じフォルダに書き、同じ入力からは同じ出力になる（2回目は changed が false）。参照する資料を持たない fact-validate では、参照する資料の節を出さない。守ることの各行に、その決まりに結ばれた例の id を添える",
 "why": "AI ツールが読むのは SKILL.md なので、skill.json から決まった形で作れないと、同じ項目から違う Skill が配られる。",
 "traces": [
  "UC1:成功時保証",
  "約束:write-skill-md-result"
 ],
 "given": {
  "files": {
   "skills/fact-check/skill.json": "@fixtures/fact-check/skill.json"
  }
 },
 "when": {
  "args": [
   "write-skill-md",
   "skills/fact-check"
  ]
 },
 "after": [
  {
   "args": [
    "write-skill-md",
    "skills/fact-check"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "write-skill-md"
  },
  {
   "of": "when",
   "pointer": "/path",
   "equals": "skills/fact-check/SKILL.md"
  },
  {
   "of": "when",
   "pointer": "/changed",
   "equals": true
  },
  {
   "of": "after[0]",
   "pointer": "/changed",
   "equals": false
  },
  {
   "of": "when",
   "file": "skills/fact-check/SKILL.md",
   "same_as": "@fixtures/fact-check/SKILL.md"
  },
  {
   "of": "when",
   "file": "skills/fact-check/SKILL.md",
   "lacks": "参照する資料"
  },
  {
   "of": "when",
   "file": "skills/fact-check/SKILL.md",
   "contains": "何も返さない）（例：E1 ・ E2）"
  }
 ],
 "unchanged": [
  "skills/fact-check/skill.json"
 ]
}
