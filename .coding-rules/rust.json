{
  "$schema": "../.claude/skills/no-more-spaghetti/references/rules.schema.json",
  "order": [
    "core",
    "adapter"
  ],
  "layers": {
    "core": "core",
    "adapter": "adapter"
  },
  "rules": [
    {
      "rule": "整形されている",
      "source": {
        "meta": "rustfmt README",
        "quote": "When running with `--check`, Rustfmt will exit with `0` if Rustfmt would not make any formatting changes to the input, and `1` if Rustfmt would make changes.",
        "fetched": {
          "url": "https://raw.githubusercontent.com/rust-lang/rustfmt/master/README.md",
          "date": "2026-09-26",
          "sha256": "f064e0c8e663367ae94f343aa6c7aa55892eb0c6f80fb1d7e1fe48ff3fbaaa9e",
          "line": 104
        }
      },
      "scope": "整形の差分のみ ── 設定は rustfmt.toml が持つ",
      "check": {
        "tool": [
          "cargo",
          "fmt",
          "--all",
          "--",
          "--check"
        ]
      }
    },
    {
      "rule": "静的解析を通る",
      "source": {
        "meta": "Clippy Usage",
        "quote": "cause Clippy to exit with a code other than",
        "fetched": {
          "url": "https://doc.rust-lang.org/clippy/usage.html",
          "date": "2026-09-26",
          "sha256": "650126a0e847c10f99b4d3e64e4bff4ac77040334a5fac9d71d70bae1acbcfbc",
          "line": 214
        }
      },
      "scope": "警告を誤りへ引き上げた既定の lint のみ",
      "check": {
        "tool": [
          "cargo",
          "clippy",
          "--all-targets",
          "--",
          "-Dwarnings"
        ]
      }
    },
    {
      "rule": "試験が通る",
      "source": {
        "meta": "The Cargo Book, cargo-test",
        "quote": "Cargo failed to complete",
        "fetched": {
          "url": "https://doc.rust-lang.org/cargo/commands/cargo-test.html",
          "date": "2026-09-26",
          "sha256": "6e58ba60403affa2b62d805af716cd301ed66b551150c2c5be5d981ed53d926d",
          "line": 811
        }
      },
      "scope": "既定の実行のみ",
      "check": {
        "tool": [
          "cargo",
          "test",
          "--all-targets"
        ]
      }
    },
    {
      "rule": "既知の脆弱性が無い",
      "source": {
        "meta": "cargo-audit README",
        "quote": "Audit your dependencies for crates with security vulnerabilities reported to the",
        "fetched": {
          "url": "https://raw.githubusercontent.com/rustsec/rustsec/main/cargo-audit/README.md",
          "date": "2026-09-26",
          "sha256": "bafc27dabec7fdf2c3f1f8ce23cf7d8588445efade324abc4dc690ed38c2c9a7",
          "line": 10
        }
      },
      "scope": "RustSec の助言データベースに報告されたもののみ",
      "check": {
        "tool": [
          "cargo",
          "audit"
        ]
      }
    }
  ]
}
