{
  "$schema": "brainstorming/agents@v1",
  "kind": "agents",
  "id": "agents",
  "claude": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "Bash(${entry}:*)",
      "Bash(.claude/skills/fact-check/bin/fact-check:*)"
    ]
  },
  "codex": {
    "sandbox": "workspace-write"
  },
  "kiro": {
    "trust": [
      "fs_read"
    ]
  },
  "guide": [
    "外の原典は WebSearch で探し、.claude/skills/fact-check/bin/fact-check で原文を取得して照合する（このコマンドも実行してよい）。原文は ${board_dir}sources/ に置く。"
  ]
}
