{
  "$schema": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
  "$id": "urn:semantic-agent-schema:base:published:v1",
  "title": "公開された言葉の版",
  "description": "Concrete の公開する部分（x-published が true の欄と x- の定義）の版。出した版は変えない。インスタンスのファイルは作らず、Concrete と一緒に基盤が組む。",
  "$defs": {
    "version": {
      "type": "object",
      "required": [
        "of",
        "version",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "of": {
          "type": "string",
          "pattern": "^urn:semantic-agent-schema:",
          "description": "公開した Concrete",
          "x-prompt": {
            "read": {
              "means": "この版を出した Concrete の URN である。"
            },
            "write": []
          }
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$",
          "description": "版",
          "x-prompt": {
            "read": {
              "means": "公開された言葉の版である。"
            },
            "write": [
              {
                "id": "never-change",
                "rule": "出した版の中身は、出した時と同じである。",
                "why": "読む側が黙って壊れる（I7）。",
                "test": "同じ版の fields と extensions が前と同じかを見る。",
                "by": "machine"
              }
            ]
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1#/$defs/json-pointer"
          },
          "description": "見せる欄",
          "x-prompt": {
            "read": {
              "means": "x-published が true の欄の場所の並びである。"
            },
            "write": []
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^x-"
          },
          "description": "見せる x- の定義",
          "x-prompt": {
            "read": {
              "means": "published が true の x- の名前の並びである。"
            },
            "write": []
          }
        }
      }
    }
  }
}