{
  "$schema": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
  "$id": "urn:semantic-agent-schema:base:change-view:v1",
  "title": "変更のまとまり",
  "description": "変更を見せるときの出力の形。保存せず、同じ前後と記録からは毎回同じ形に組み立てる。Concrete はこの形を $ref で使い、見せ方を足す。",
  "$defs": {
    "view": {
      "type": "object",
      "required": [
        "range",
        "exceptions",
        "purposes",
        "unreadable"
      ],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "object",
          "required": [
            "before",
            "after"
          ],
          "properties": {
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          },
          "description": "前後の参照",
          "x-prompt": {
            "read": {
              "means": "ポートに渡した前の姿と後の姿の参照で、基盤は解釈しない。"
            },
            "write": []
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "count",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "intent-missing",
                  "intent-mismatch",
                  "unrecorded",
                  "no-change",
                  "record-rewritten",
                  "human-field-changed",
                  "state-changed",
                  "unconfirmed-outside-intent",
                  "not-in-range",
                  "unreadable"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "description": "例外",
          "x-prompt": {
            "read": {
              "means": "例外の種類ごとの件数と中身で、先頭に出る。"
            },
            "write": []
          }
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "purpose_ref",
              "intents"
            ],
            "properties": {
              "purpose_ref": {
                "type": "string"
              },
              "intents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "change_id",
                    "intent",
                    "targets"
                  ],
                  "properties": {
                    "change_id": {
                      "type": "string"
                    },
                    "intent": {
                      "type": "string"
                    },
                    "judgment": {
                      "enum": [
                        "verified",
                        "violated",
                        "unverified",
                        "unsupported",
                        "error",
                        "none"
                      ]
                    },
                    "meaning": {
                      "type": "object"
                    },
                    "targets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "target",
                          "kind"
                        ],
                        "properties": {
                          "target": {
                            "$ref": "urn:semantic-agent-schema:base:annotations:v1#/$defs/target"
                          },
                          "kind": {
                            "enum": [
                              "fields",
                              "lines"
                            ]
                          },
                          "fields": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "at"
                              ],
                              "properties": {
                                "at": {
                                  "$ref": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1#/$defs/json-pointer"
                                },
                                "before": true,
                                "after": true
                              }
                            }
                          },
                          "lines": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "mark",
                                "text"
                              ],
                              "properties": {
                                "mark": {
                                  "enum": [
                                    " ",
                                    "-",
                                    "+"
                                  ]
                                },
                                "text": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "description": "目的 → 意図",
          "x-prompt": {
            "read": {
              "means": "目的ごと、意図ごとの変更で、JSON は欄ごと、それ以外は行ごと（ファイルの全体に印）に成型したものである。"
            },
            "write": []
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "成型できなかった対象",
          "x-prompt": {
            "read": {
              "means": "文字として読めないなどで成型できなかった対象のパスである。"
            },
            "write": []
          }
        }
      }
    }
  }
}