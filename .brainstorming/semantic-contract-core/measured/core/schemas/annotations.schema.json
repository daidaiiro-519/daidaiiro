{
  "$schema": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
  "$id": "urn:semantic-agent-schema:base:annotations:v1",
  "title": "複数のスキーマで使う注釈の形",
  "description": "x-relationship の値の形など、本体とほかのファイルが共有する形。インスタンスは作らない。",
  "$defs": {
    "relationship": {
      "type": "object",
      "required": [
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^urn:semantic-agent-schema:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:v[0-9]+$",
          "description": "指す先の種類",
          "x-prompt": {
            "read": {
              "means": "指す先のインスタンスが従う Concrete の URN である。"
            },
            "write": []
          }
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$",
          "description": "公開された版",
          "x-prompt": {
            "read": {
              "means": "ほかの文脈の公開された言葉を指すときの版である。",
              "when": "ほかの文脈を指すときだけ読む。"
            },
            "write": []
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "title": "インスタンス",
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "pattern": "^urn:semantic-agent-schema:"
            }
          }
        },
        {
          "title": "それ以外のファイル",
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/]"
            }
          }
        }
      ]
    }
  }
}