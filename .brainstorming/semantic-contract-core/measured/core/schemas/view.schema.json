{
  "$schema": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
  "$id": "urn:semantic-agent-schema:base:view:v1",
  "title": "ビュー",
  "description": "ある kind（Concrete）のインスタンスをどう見せるかの定義。文脈ごと ・ kind ごとに0か1つ。見せ方だけを持ち、データの形と意味は持たない（Concrete が持つ）。",
  "x-instance-path": ".semantic-agent-schema/views/{id}.json",
  "x-instance-label": "ビュー {id}",
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "id",
    "for",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:semantic-agent-schema:base:view:v1"
    },
    "kind": {
      "const": "view",
      "description": "種類",
      "x-prompt": {
        "read": {
          "means": "ビューであること。"
        },
        "write": []
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "ビューの id",
      "x-prompt": {
        "read": {
          "means": "このビューの名前である。"
        },
        "write": []
      }
    },
    "for": {
      "type": "string",
      "pattern": "^urn:semantic-agent-schema:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:v[0-9]+$",
      "description": "描く kind",
      "x-prompt": {
        "read": {
          "means": "このビューが描く Concrete の URN である。"
        },
        "write": [
          {
            "id": "one-view-per-kind",
            "rule": "同じ文脈で、同じ kind を描くビューは1つまでである。",
            "why": "2つあると、どちらで描くかが決まらない（I26）。",
            "test": "同じ for を持つビューの数を数える。",
            "by": "machine"
          },
          {
            "id": "for-exists",
            "rule": "for の Concrete は、閉じた一覧か公開された版にある。",
            "why": "無い kind は描けない。",
            "test": "for の URN が引けるかを見る。",
            "by": "machine"
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "parts"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "part",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "part": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "value": {
                  "type": "string",
                  "pattern": "^(/([^~/]|~[01])*)+$"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "description": "節の並び",
      "x-prompt": {
        "read": {
          "means": "見出しと、部品で値を見せる並びである。",
          "parse": "部品の value は、インスタンスの中の場所（JSON Pointer）として読む。"
        },
        "write": [
          {
            "id": "value-in-concrete",
            "rule": "部品の value（JSON Pointer）は、for の Concrete の欄を指す。",
            "why": "無い欄を指すと、描けない（Q1 #23）。",
            "test": "value の先頭の欄が for の Concrete の properties にあるかを見る。",
            "by": "machine"
          },
          {
            "id": "part-in-catalog",
            "rule": "部品の part は、文脈の部品のカタログにある名前である。",
            "why": "無い部品は描けない（Q1 #23）。",
            "test": "part の名前がカタログの parts にあるかを見る。",
            "by": "machine"
          }
        ]
      }
    }
  }
}