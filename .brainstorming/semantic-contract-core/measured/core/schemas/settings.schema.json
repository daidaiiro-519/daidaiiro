{
  "$schema": "urn:semantic-agent-schema:base:semantic-abstract-schema:v1",
  "$id": "urn:semantic-agent-schema:base:settings:v1",
  "title": "基盤の設定",
  "description": "基盤の振る舞いの値。利用者（~/.semantic-agent-schema/settings.json）・ プロジェクト（.semantic-agent-schema/settings.json、確定する）・ 手元（.semantic-agent-schema/settings.local.json、確定しない）の3段を、手元 ＞ プロジェクト ＞ 利用者の順で重ねる。許可 ・ キャッシュの有効時間 ・ 料金は持たない。",
  "x-instance-path": ".semantic-agent-schema/settings.json",
  "x-instance-label": "設定",
  "type": "object",
  "required": [
    "$schema",
    "kind",
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:semantic-agent-schema:base:settings:v1"
    },
    "kind": {
      "const": "settings",
      "description": "種類",
      "x-prompt": {
        "read": {
          "means": "基盤の設定であること。"
        },
        "write": []
      }
    },
    "id": {
      "enum": [
        "user",
        "project",
        "local"
      ],
      "description": "置き場所",
      "x-prompt": {
        "read": {
          "means": "利用者 ・ プロジェクト ・ 手元のどの段かである。"
        },
        "write": []
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "newWhenHistoryAbovePercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "description": "セッションの設定",
      "x-prompt": {
        "read": {
          "means": "再開か新規かを決めるときの値である。",
          "parse": "newWhenHistoryAbovePercent：履歴がコンテキストの上限に占める割合がこれを超えたら、有効時間内でも新しく立てる。書かなければ使わない（既定は無い）。"
        },
        "write": []
      }
    }
  }
}