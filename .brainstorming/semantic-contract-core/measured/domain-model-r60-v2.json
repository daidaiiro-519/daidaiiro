   "from_u": [
    "U1",
    "U2"
   ]
  },
  {
   "id": "I3",
   "order": 2,
   "concept": "Concrete スキーマ（集約）",
   "text": "Concrete の版は、人が承認したときだけ公開になる。検証に使えるのは公開した版だけで、AI は下書きの版を書けるが承認はできない。",
   "when": "常に",
   "from_u": [
    "U1",
    "U2",
    "U9"
   ]
  },
  {
   "id": "I4",
   "order": 3,
   "concept": "Concrete スキーマ（集約）",
   "text": "承認を求める版は、前の版との rule の差分 ・ validator の割り当て ・ 変えてよい範囲 ・ 移し方と、移すと結果が変わる instance の数を持つ。",
   "when": "承認の依頼の時点",
   "from_u": [
    "U2",
    "U3",
    "U9"
   ]
  },
  {
   "id": "I5",
   "order": 4,
   "concept": "Concrete スキーマ（集約）",
   "text": "rule は id ・ rule ・ why ・ test と、読む欄の一覧と、判定する者（機械 ・ AI ・ 人）を持つ。読む欄の無い rule は instance 全体を読む。",
   "when": "承認の依頼の時点",
   "from_u": [
    "U1",
    "U8",
    "U14"
   ]
  },
  {
   "id": "I6",
   "order": 5,
   "concept": "Concrete スキーマ（集約）",
   "text": "版を引退させるのは、その版に従う instance が無いときだけである。",
   "when": "保存の時点",
   "from_u": [
    "U2",
    "U11"
   ]
  },
  {
   "id": "I7",
   "order": 6,
   "concept": "instance（集約）",
   "text": "instance は公開した Concrete の版1つに従い、従う版を変えるのは「移す」だけである。",
   "when": "保存の時点",
   "from_u": [
    "U3",
    "U7"
   ]
  },
  {
   "id": "I8",
   "order": 7,
   "concept": "instance（集約）",
   "text": "instance の保存は、読んだ時点のハッシュが保存先と一致し、変える欄がすべて変えてよい範囲の中にあるときだけ成り立つ。",
   "when": "保存の時点",
   "from_u": [
    "U5",
    "U6"
   ]
  },
  {
   "id": "I9",
   "order": 8,
   "concept": "instance（集約）",
   "text": "instance を消すのは、x-ref ・ $schema で指されていないときだけである。",
   "when": "保存の時点",
   "from_u": [
    "U11"
   ]
  },
  {
   "id": "I10",
   "order": 9,
   "concept": "検証の記録（集約）",
   "text": "検証結果は rule ごとに5つの値のどれか1つで、件数の合計は rule の総数と一致する。verified ・ violated は validator の名前と版と根拠を持つ。",
   "when": "常に",
   "from_u": [
    "U5",
    "U8",
    "U14"
   ]
  },
  {
   "id": "I11",
   "order": 10,
   "concept": "検証の記録（集約）",
   "text": "検証の記録は rule ごとに、結果を決めた入力（読んだ欄の値 ・ 3つの版 ・ validator の版 ・ 参照先のハッシュ）を持つ。",
   "when": "常に",
   "from_u": [
    "U8",
    "U10",
    "U13"
   ]
  },
  {
   "id": "I12",
   "order": 11,
   "concept": "検証の記録（集約）",
   "text": "入力のどれかがいまと違う rule の結果は、いまの結果として使わない。基盤を通らない書き換えも含め、基盤はその rule だけを検証し直す。",
