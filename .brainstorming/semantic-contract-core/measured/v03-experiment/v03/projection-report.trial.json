{
  "_note": "試案。v0.3 の examples の形にならったもので、正式な仕様ではない。",
  "target": "json-schema-2020-12",
  "coverage": "partial",
  "lossless": false,
  "represented": [
    {
      "constraint": "rejected-at-least-one",
      "as": "minItems（jsonschema-trial で動いた）"
    },
    {
      "constraint": "title-40",
      "as": "maxLength（jsonschema-trial で動いた。approx は落ちる）"
    },
    {
      "constraint": "topics-3-to-5",
      "as": "minItems ・ maxItems（jsonschema-trial で動いた）"
    },
    {
      "constraint": "open-at-most-5",
      "as": "contains ・ maxContains（一時の場所で動かした）"
    },
    {
      "constraint": "open-needs-queue",
      "as": "if/then と contains（jsonschema-trial で動いた）"
    },
    {
      "constraint": "open-has-image",
      "as": "if/then（jsonschema-trial で動いた）"
    },
    {
      "constraint": "code-language-not-text",
      "as": "not と enum（jsonschema-trial で動いた。小文字にする操作は落ちる）"
    },
    {
      "constraint": "no-open-means-all-settled",
      "as": "anyOf と contains（試していない）"
    }
