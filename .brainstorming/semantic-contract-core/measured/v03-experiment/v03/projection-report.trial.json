  "notRepresented": [
    "intro-one-sentence",
    "queue-points-open",
    "open-depends-settled",
    "log-newest-first",
    "topic-id-unique",
    "topic-name-10",
    "language-known",
    "mentions-declared",
    "sentence-120",
    "open-used-somewhere",
    "tree-depth-step",
    "svg-checked",
    "html-standalone",
    "verification-hidden",
    "decisions-only",
    "not-make-user-choose",
    "flag-rare",
    "one-decision",
    "decidable",
    "image-kind-by-content",
    "assumption-one-each",
    "screen-height-fits",
    "code-is-real-file",
    "highlight-few",
    "lines-60",
    "caption-and-note-one-sentence"
