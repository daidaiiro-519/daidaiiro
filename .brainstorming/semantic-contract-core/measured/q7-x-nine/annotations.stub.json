{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:semantic-schema-core:core:annotations:v1",
 "$comment": "検査のための仮のもの。relationship は to だけを置いた",
 "$defs": {
  "relationship": {"type":"object","required":["to"],"additionalProperties":false,"properties":{"to":{"type":"string","pattern":"^urn:semantic-schema-core:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:v[0-9]+$"}}}
 }
}
