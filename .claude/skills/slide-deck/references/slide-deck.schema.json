             "claim"
            ],
            "properties": {
             "kind": {
              "const": "card",
              "description": "主張と、その直下の根拠。出典は rows の note に置く"
             },
             "label": {
              "type": "string"
             },
             "claim": {
              "type": "string"
             },
             "rows": {
              "type": "array",
              "items": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                "text"
               ],
               "properties": {
                "text": {
                 "type": "string"
                },
                "note": {
                 "type": "string"
                }
               }
              }
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "rows"
            ],
            "properties": {
             "kind": {
              "const": "flow",
              "description": "段を追う並び。mark を立てた行だけが強調になる"
             },
             "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                "title"
               ],
               "properties": {
                "title": {
                 "type": "string"
                },
                "note": {
                 "type": "string"
                },
                "mark": {
                 "type": "boolean"
                }
               }
              }
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "value",
             "caption"
            ],
            "properties": {
             "kind": {
              "const": "stat",
              "description": "大きい数値1つ。条件 → 出典の順を崩さない"
             },
             "value": {
              "type": "string"
             },
             "unit": {
              "type": "string"
             },
             "caption": {
              "type": "string"
             },
             "source": {
              "type": "string"
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "items"
            ],
            "properties": {
             "kind": {
              "const": "boxes",
              "description": "種類を分けて並べる"
             },
             "items": {
              "type": "array",
              "minItems": 1,
              "items": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                "title"
               ],
               "properties": {
                "title": {
                 "type": "string"
                },
                "note": {
                 "type": "string"
                }
               }
              }
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "left",
             "right"
            ],
            "properties": {
             "kind": {
              "const": "pair",
              "description": "2つを突き合わせる。3つ目を足さない"
             },
             "left": {
              "type": "string"
             },
             "right": {
              "type": "string"
             },
             "left_note": {
              "type": "string"
             },
             "right_note": {
              "type": "string"
             },
             "link": {
              "type": "string"
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "items"
            ],
            "properties": {
             "kind": {
              "const": "recap",
              "description": "通ってきた論点を、番号で振り返る"
             },
             "items": {
              "type": "array",
              "minItems": 1,
              "items": {
               "type": "object",
               "additionalProperties": false,
               "required": [
                "no",
                "text"
               ],
               "properties": {
                "no": {
                 "type": "string"
                },
                "text": {
                 "type": "string"
                }
               }
              }
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "body"
            ],
            "properties": {
             "kind": {
              "const": "punch",
              "description": "枚に1つだけの、言い切り"
             },
             "body": {
              "type": "string"
             },
             "sub": {
              "type": "string"
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "body"
            ],
            "properties": {
             "kind": {
              "const": "caveat",
              "description": "但し書き。要素の直下に置く"
             },
             "body": {
              "type": "string"
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "svg"
            ],
            "properties": {
             "kind": {
              "const": "figure",
              "description": "図。SVG の文字列を受け取るだけで、この Skill は描かない"
             },
             "svg": {
              "type": "string"
             },
             "caption": {
              "type": "string"
             }
            }
           },
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "kind",
             "rows"
            ],
            "properties": {
             "kind": {
              "const": "table",
              "description": "表"
             },
             "head": {
              "type": "array",
              "items": {
               "type": "string"
              }
             },
             "rows": {
              "type": "array",
              "items": {
