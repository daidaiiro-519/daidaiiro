{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-abstract": "schema-driven/abstract@v1",
  "$id": "brainstorming/agents@v1",
  "title": "AI に許すこと",
  "description": "画面の「AI に聞く」で起動する AI ごとに、使ってよいツールと、新しいセッションの最初の依頼に足す文を持つ。serve は依頼のたびに読む。リポジトリの .brainstorming/.settings/agents.json があればそれを使い、無ければ Skill の assets/defaults/agents.json を使う（混ぜない）。読むたびに基盤の check で検査し、合格しなければ AI を起動しない。",
  "x-prompt": {
    "read": {
      "means": "画面の AI に許すツールと、使い方の文である。"
    },
    "write": [
      {
        "id": "whole-file",
        "rule": "使うファイル1つに全部を書く。Skill の既定と混ぜない。",
        "why": "混ぜると、どの許可が効いているかを2つのファイルから組み立てて読むことになる。",
        "test": "serve が読むのは1つのファイルだけかを見る。"
      },
      {
        "id": "person-writes",
        "rule": "利用者が書く。AI は書き換えない。",
        "why": "AI が自分の許可を広げられることになる。",
        "test": "AI の作業の前後で変わっていないかを serve の範囲の検査で見る。"
      }
    ]
  },
  "x-generates": ".brainstorming/.settings/agents.json",
  "x-view": {
    "label": "id"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "id",
    "claude",
    "codex",
    "kiro"
  ],
  "properties": {
    "$schema": {
      "description": "従うスキーマの名前",
      "x-prompt": {
        "read": {
          "means": "このインスタンスが従う型の名前である。"
        },
        "write": [
          {
            "id": "this-name",
            "rule": "brainstorming/agents@v1 と書く。",
            "why": "エンジンは、この名前で型のスキーマを引く。",
            "test": "値がこの文字列と同じかを見る。"
          }
        ]
      },
      "const": "brainstorming/agents@v1"
    },
    "kind": {
      "description": "インスタンスの種類",
      "x-prompt": {
        "read": {
          "means": "このインスタンスの種類である。"
        },
        "write": [
          {
            "id": "const",
            "rule": "agents と書く。",
            "why": "ページテンプレートと参照は kind で選ぶ。",
            "test": "値が同じかを見る。"
          }
        ]
      },
      "const": "agents"
    },
    "id": {
      "description": "名前",
      "x-prompt": {
        "read": {
          "means": "agents である。"
        },
        "write": [
          {
            "id": "one",
            "rule": "agents と書く。",
            "why": "1つの置き場所に1つだけ置く。",
            "test": "値が同じかを見る。"
          }
        ]
      },
      "const": "agents"
    },
    "claude": {
      "description": "Claude Code に許すこと",
      "x-prompt": {
        "read": {
          "means": "Claude Code を --permission-mode dontAsk で起動し、ここに並べたツールだけを --allowedTools で許す。"
        },
        "write": [
          {
            "id": "listed-only",
            "rule": "allow に並べたものだけが使える。並べていないツールは確認なしで断られる。",
            "why": "dontAsk は許可の一覧に無いものを聞かずに断る。",
            "test": "allow の値をそのまま --allowedTools に渡しているかを見る。"
          }
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow"
      ],
      "properties": {
        "allow": {
          "description": "許すツール",
          "x-prompt": {
            "read": {
              "means": "--allowedTools に渡すツールの名前である。${entry} は brainstorming の実行ファイル（リポジトリの根から）に置き換わる。"
            },
            "write": [
              {
                "id": "entry-kept",
                "rule": "Bash(${entry}:*) を必ず入れる。",
                "why": "無いと、AI がボードを update で直せない。",
                "test": "値の中に Bash(${entry}:*) があるかを見る。"
              },
              {
                "id": "paths-from-root",
                "rule": "Bash で許すコマンドは、リポジトリの根からの経路で書く。",
                "why": "AI はリポジトリの根で動く。",
                "test": "経路のファイルがあるかを見る。"
              }
            ]
          },
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "Bash(${entry}:*)"
          },
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(dangerously|bypass)).*$"
          }
        }
      }
    },
    "codex": {
      "description": "Codex に許すこと",
      "x-prompt": {
        "read": {
          "means": "Codex を起動するときの sandbox である。"
        },
        "write": [
          {
            "id": "no-full-access",
            "rule": "read-only か workspace-write のどちらかを書く。",
            "why": "danger-full-access は sandbox を外す。",
            "test": "値を見る。"
          }
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sandbox"
      ],
      "properties": {
        "sandbox": {
          "description": "sandbox",
          "x-prompt": {
            "read": {
              "means": "Codex の --sandbox に渡す値である（続きでは -c sandbox_mode に渡す）。"
            },
            "write": [
              {
                "id": "two",
                "rule": "read-only か workspace-write を書く。",
                "why": "ボードを直すには workspace-write が要る。",
                "test": "値を見る。"
              }
            ]
          },
          "enum": [
            "read-only",
            "workspace-write"
          ]
        }
      }
    },
    "kiro": {
      "description": "Kiro に許すこと",
      "x-prompt": {
        "read": {
          "means": "Kiro を起動するときに信頼するツールである。"
        },
        "write": [
          {
            "id": "read-only",
            "rule": "読むツールだけを書く。",
            "why": "手元の Kiro はシェルのコマンドを絞れないので、画面の Kiro は読むだけにする。",
            "test": "値を見る。"
          }
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust"
      ],
      "properties": {
        "trust": {
          "description": "信頼するツール",
          "x-prompt": {
            "read": {
              "means": "--trust-tools に , でつないで渡すツールの名前である。"
            },
            "write": [
              {
                "id": "verified",
                "rule": "fs_read だけを書く。",
                "why": "help の出力で確かめた読むツールは fs_read だけである。",
                "test": "値を見る。"
              }
            ]
          },
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fs_read"
            ]
          }
        }
      }
    },
    "guide": {
      "description": "使い方の文",
      "x-prompt": {
        "read": {
          "means": "新しいセッションの最初の依頼に、ボードを直してよい AI へだけ足す文である。${entry} と ${board_dir} は置き換わる。"
        },
        "write": [
          {
            "id": "matches-allow",
            "rule": "許したツールの使い方だけを書く。",
            "why": "許していないツールの使い方を書くと、AI が試して断られる。",
            "test": "文に出てくるツールが allow にあるかを見る。"
          }
        ]
      },
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
