{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-abstract": "schema-driven/abstract@v1",
  "$id": "brainstorming/round@v1",
  "title": "回の記録",
  "description": "advance が回を進めたときのボードの写し。.brainstorming/<ボード>/rounds/<回>.json に置き、書き換えない。",
  "x-prompt": {
    "read": {
      "means": "ある回のボードの姿である。"
    },
    "write": [
      {
        "id": "frozen",
        "rule": "advance だけが書き、書いたあとは書き換えない。",
        "why": "次の回の「変わったところ」は、この写しと比べて決まる。",
        "test": "書いたあとにハッシュ値が変わっていないかを見る。"
      }
    ]
  },
  "x-generates": ".brainstorming/<ボード>/rounds/<回>.json",
  "x-view": {
    "label": "join('', [board, ' 第', to_string(round), '回'])"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "id",
    "board",
    "round",
    "at",
    "snapshot"
  ],
  "properties": {
    "$schema": {
      "description": "従うスキーマの名前",
      "x-prompt": {
        "read": {
          "means": "このインスタンスが従う型の名前である。"
        },
        "write": [
          {
            "id": "this-name",
            "rule": "brainstorming/round@v1 と書く。",
            "why": "エンジンは、この名前で型のスキーマを引く。",
            "test": "値がこの文字列と同じかを見る。"
          }
        ]
      },
      "const": "brainstorming/round@v1"
    },
    "kind": {
      "description": "インスタンスの種類",
      "x-prompt": {
        "read": {
          "means": "このインスタンスの種類である。"
        },
        "write": [
          {
            "id": "const",
            "rule": "round と書く。",
            "why": "ページテンプレートと参照は kind で選ぶ。",
            "test": "値が同じかを見る。"
          }
        ]
      },
      "const": "round"
    },
    "id": {
      "description": "回の記録の名前",
      "x-prompt": {
        "read": {
          "means": "回の番号の文字である。"
        },
        "write": [
          {
            "id": "file-name",
            "rule": "回の番号を書く。",
            "why": "ファイル名と同じにする。",
            "test": "ファイル名と同じかを見る。"
          }
        ]
      },
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "board": {
      "description": "ボードの id",
      "x-prompt": {
        "read": {
          "means": "どのボードの回かである。"
        },
        "write": [
          {
            "id": "by-id",
            "rule": "ボードの id を書く。",
            "why": "ボードと回を結ぶ。",
            "test": "ボードがあるかを見る。"
          }
        ]
      },
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "round": {
      "description": "回の番号",
      "x-prompt": {
        "read": {
          "means": "記録した回である。"
        },
        "write": [
          {
            "id": "same",
            "rule": "id と同じ数を書く。",
            "why": "番号を2つの形で持つ。",
            "test": "id と同じかを見る。"
          }
        ]
      },
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "description": "記録した時刻",
      "x-prompt": {
        "read": {
          "means": "回を進めた時刻である。"
        },
        "write": [
          {
            "id": "by-advance",
            "rule": "advance が書く。",
            "why": "記録の順を決める。",
            "test": "時刻の形かを見る。"
          }
        ]
      },
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "snapshot": {
      "description": "その回のボード",
      "x-prompt": {
        "read": {
          "means": "その回のボードの本体の写しである。"
        },
        "write": [
          {
            "id": "whole",
            "rule": "ボードの本体をそのまま入れる。",
            "why": "欄ごとに比べるので、一部だけでは比べられない。",
            "test": "brainstorming/board@v1 の形かを見る。"
          }
        ]
      },
      "type": "object"
    }
  }
}
