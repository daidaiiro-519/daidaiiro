 "color": {
  "$type": "color",
  "$description": "意味の層（明）。値は基礎の層を指す",
  "surface": {
   "page": {
    "$value": "{base.paper.100}",
    "$description": "ページの背景"
   },
   "block": {
    "$value": "{base.paper.000}",
    "$description": "節の枠の面"
   },
   "literal": {
    "$value": "{base.paper.100}",
    "$description": "コード ・ 差分 ・ フォルダ構成 ・ 実行例の面（字面をそのまま見せる所）"
   },
   "head": {
    "$value": "{base.paper.300}",
    "$description": "表の見出しの行の面。吹き出し（page）とも欄（block）とも違う値にする"
   },
   "control": {
    "$value": "{base.paper.100}",
    "$description": "選んでいないタブなど、押せる部品の地。置いた枠（block）と違う値にする"
   },
   "done": {
    "$value": "{base.green.100}",
    "$description": "決着の札の地。完了を明るい緑で伝える"
   },
   "answer": {
    "$value": "{base.teal.100}",
    "$description": "答えの面"
   },
   "notice": {
    "$value": "{base.sand.100}",
    "$description": "この回で変わったところの帯の面"
   },
   "added": {
    "$value": "{base.teal.100}",
    "$description": "差分の足した行の面"
   },
   "removed": {
    "$value": "{base.rose.100}",
    "$description": "差分の消した行の面"
   }
  },
  "text": {
   "body": {
    "$value": "{base.ink.900}",
    "$description": "本文"
   },
   "sub": {
    "$value": "{base.ink.800}",
    "$description": "補足の文字"
   },
   "key": {
    "$value": "{base.teal.700}",
    "$description": "リンク ・ 答えのラベル"
   },
   "done": {
    "$value": "{base.green.800}",
    "$description": "決着の札の文字"
   },
   "on-key": {
    "$value": "{base.paper.000}",
    "$description": "主役の色の上の文字"
   },
   "warn": {
    "$value": "{base.amber.700}",
    "$description": "変わった印 ・ エラー出力のラベル"
   },
   "source": {
    "$value": "{base.plum.700}",
    "$description": "原典のバッジ"
   },
   "added": {
    "$value": "{base.teal.700}",
    "$description": "差分の + の記号"
   },
   "removed": {
    "$value": "{base.rose.700}",
    "$description": "差分の − の記号 ・ 0 以外の終了コード"
   }
  },
  "syntax": {
   "keyword": {
    "$value": "{base.teal.700}",
    "$description": "コードのキーワード"
   },
   "string": {
    "$value": "{base.amber.700}",
    "$description": "コードの文字列"
   },
   "literal": {
    "$value": "{base.plum.700}",
    "$description": "コードの数 ・ 真偽値"
   },
   "comment": {
    "$value": "{base.ink.700}",
    "$description": "コードの注釈 ・ 行番号"
   }
  },
  "key": {
   "$value": "{base.teal.700}",
   "$description": "主役の色（押した状態 ・ いまの論点）"
  },
  "line": {
   "control": {
    "$value": "{base.ink.700}",
    "$description": "ボタン ・ 入力欄 ・ タブの枠"
   },
   "block": {
    "$value": "{base.paper.400}",
    "$description": "節の枠（装飾）"
   },
   "notice": {
    "$value": "{base.sand.400}",
    "$description": "帯の枠（装飾）"
   },
   "done": {
    "$value": "{base.green.700}",
    "$description": "決着の札の線"
   }
  },
  "mark": {
   "added": {
    "$value": "{base.teal.700}",
    "$description": "フォルダ構成の「足す」の印の面"
   },
   "removed": {
