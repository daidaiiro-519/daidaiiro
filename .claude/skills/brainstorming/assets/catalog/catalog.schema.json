        "id": {
          "description": "id"
        },
        "title": {
          "description": "title"
        },
        "intro": {
          "description": "intro"
        },
        "opened": {
          "description": "opened"
        },
        "status": {
          "description": "status"
        },
        "status_label": {
          "description": "status_label"
        },
        "held": {
          "description": "held"
        },
        "held_since": {
          "description": "held_since"
        },
