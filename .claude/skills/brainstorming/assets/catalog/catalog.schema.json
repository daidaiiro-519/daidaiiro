        "answer_count": {
          "description": "answer_count"
        },
        "answer": {
          "description": "answer"
        },
        "hold_count": {
          "description": "hold_count"
        },
        "hold": {
          "description": "hold"
        },
        "done_count": {
          "description": "done_count"
        },
        "done": {
          "description": "done"
        }
      },
      "required": [],
      "x-states": {
        "default": "状態ごとにボードを並べる。決着は閉じている",
        "selected": "幅が狭いときは、ボードの一覧ボタンで開く"
      }
    },
    "board-link": {
      "type": "object",
      "description": "サイドバーのボード1枚",
