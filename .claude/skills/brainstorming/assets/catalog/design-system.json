    "color-surface-block": "{base-paper-000}",
    "color-surface-literal": "{base-paper-100}",
    "color-surface-head": "{base-paper-300}",
    "color-surface-answer": "{base-teal-100}",
    "color-surface-notice": "{base-sand-100}",
    "color-surface-added": "{base-teal-100}",
    "color-surface-removed": "{base-rose-100}",
    "color-text-body": "{base-ink-900}",
    "color-text-sub": "{base-ink-800}",
    "color-text-key": "{base-teal-700}",
    "color-text-on-key": "{base-paper-000}",
    "color-text-warn": "{base-amber-700}",
    "color-text-source": "{base-plum-700}",
    "color-text-added": "{base-teal-700}",
    "color-text-removed": "{base-rose-700}",
    "color-syntax-keyword": "{base-teal-700}",
    "color-syntax-string": "{base-amber-700}",
    "color-syntax-literal": "{base-plum-700}",
    "color-syntax-comment": "{base-ink-700}",
    "color-key": "{base-teal-700}",
    "color-line-control": "{base-ink-700}",
    "color-line-block": "{base-paper-400}",
    "color-line-notice": "{base-sand-400}",
    "color-mark-added": "{base-teal-700}",
    "color-mark-removed": "{base-rose-700}",
    "color-mark-changed": "{base-amber-700}",
    "color-state-focus": "{base-teal-700}",
    "color-state-target": "{base-amber-700}",
    "color-editor-surface": "{base-editor-paper}",
    "color-editor-text": "{base-editor-ink}",
    "color-editor-gutter": "{base-editor-gutter}",
    "color-editor-line": "{base-editor-line}",
    "color-editor-keyword": "{base-editor-red}",
    "color-editor-string": "{base-editor-navy}",
    "color-editor-comment": "{base-editor-gutter}",
    "color-editor-highlight": "{base-editor-hl}",
    "color-editor-mark": "{base-editor-gold}",
