    "color-terminal-bar": "{base-night-700}",
    "color-terminal-text": "{base-snow-100}",
    "color-terminal-sub": "{base-snow-200}",
    "color-terminal-prompt": "{base-teal-300}",
    "color-terminal-dot": "{base-ink-600}",
    "font-body": "\"Zen Kaku Gothic New\", system-ui, sans-serif",
    "font-heading": "\"Shippori Mincho\", serif",
    "font-literal": "\"JetBrains Mono\", \"Zen Kaku Gothic New\", monospace",
    "size-body": "15px",
    "size-literal": "13px",
    "size-space-3": "0.45rem",
    "size-space-5": "0.7rem",
    "size-space-7": "1.2rem",
    "size-radius": "0.6rem",
    "size-radius-pill": "999px",
    "size-line-hair": "1px",
    "size-line-solid": "2px",
    "size-line-accent": "3px",
    "type-body-font-family": "{font-body}",
    "type-body-font-size": "{size-body}",
    "type-body-font-weight": "400",
    "type-body-letter-spacing": "0px",
    "type-body-line-height": "1.85",
    "type-literal-font-family": "{font-literal}",
    "type-literal-font-size": "{size-literal}",
    "type-literal-font-weight": "400",
    "type-literal-letter-spacing": "0px",
    "type-literal-line-height": "1.6"
