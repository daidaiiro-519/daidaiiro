    "base-night-900": "#0e1614",
    "base-snow-100": "#e6eeeb",
    "base-snow-200": "#c2cec9",
    "base-snow-400": "#9dada8",
    "base-snow-500": "#93a29d",
    "base-teal-100": "#d5e6e3",
