{
 "$schema": "schema-driven/page@v1",
 "kind": "dashboard",
 "head": {
  "page": {
   "text": "dashboard"
  },
  "board": {
   "text": ""
  },
  "side": {
   "component": "sidebar",
   "answer": [
    {
     "component": "board-link",
     "each": "instances[?kind=='board' && !hold && (length(topics) == `0` || length(topics[?status!='settled']) > `0`)]",
     "id": "id",
     "title": "title",
     "sub": "join('', [join(' ・ ', topics[?status=='open'].join(' ', [id, name])), ' ・ ', to_string(length(topics[?status=='open'])), '件'])"
    }
   ],
   "hold": [
    {
     "component": "board-link",
     "each": "instances[?kind=='board' && hold]",
     "id": "id",
     "title": "title",
     "sub": "join('', [hold.date, ' に保留'])"
    }
   ],
   "done": [
    {
     "component": "board-link",
     "each": "instances[?kind=='board' && !hold && length(topics) > `0` && length(topics[?status!='settled']) == `0`]",
     "id": "id",
     "title": "title",
     "sub": "join('', [opened || '', ' に決着'])"
    }
   ],
   "answer_count": "length(instances[?kind=='board' && !hold && (length(topics) == `0` || length(topics[?status!='settled']) > `0`)])",
   "hold_count": "length(instances[?kind=='board' && hold])",
   "done_count": "length(instances[?kind=='board' && !hold && length(topics) > `0` && length(topics[?status!='settled']) == `0`])"
  },
  "chat": {
   "text": ""
  },
  "round": {
   "text": ""
  }
 },
 "sections": [
  {
   "heading": "ダッシュボード",
   "body": [
    {
     "component": "dash-head",
     "title": "this.title"
    },
    {
     "component": "summary-tiles",
     "answer": "length(instances[?kind=='board' && !hold && (length(topics) == `0` || length(topics[?status!='settled']) > `0`)])",
     "open_topics": "length(instances[?kind=='board' && !hold && (length(topics) == `0` || length(topics[?status!='settled']) > `0`)].topics[] | [?status=='open'])",
     "hold": "length(instances[?kind=='board' && hold])",
     "done": "length(instances[?kind=='board' && !hold && length(topics) > `0` && length(topics[?status!='settled']) == `0`])"
    }
   ]
  },
  {
   "heading": "先に決めるもの",
   "body": [
    {
     "component": "priority-list",
     "boards": [
      {
       "component": "priority-board",
       "each": "instances[?kind=='board' && !hold && (length(topics) == `0` || length(topics[?status!='settled']) > `0`)]",
       "id": "id",
       "title": "title",
       "flag": "flag || `false`",
       "opened": "opened || ''",
       "waits": "join(' ', waits_for || `[]`)",
       "topics": [
        {
         "component": "priority-topic",
         "each": "topics[?status=='open']",
         "id": "id",
         "name": "name",
         "question": "question"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "heading": "最近の動き",
   "body": [
    {
     "component": "activity-log",
     "boards": [
      {
       "component": "activity-board",
       "each": "instances[?kind=='board']",
       "id": "id",
       "title": "title",
       "items": [
        {
         "component": "activity-item",
         "each": "log || `[]`",
         "date": "date",
         "text": "text"
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
