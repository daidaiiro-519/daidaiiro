{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-abstract": "schema-driven/abstract@v1",
  "$id": "brainstorming/chat@v1",
  "title": "チャットの記録",
  "description": "画面の「AI に聞く」のやりとり。serve だけが .brainstorming/.chat/<ボード>/<AI>.json に書く。AI が書き換えたら serve の検査が見つける。",
  "x-prompt": {
    "read": {
      "means": "1つのボードと1つの AI のやりとりと、続きに使うセッションの ID である。"
    },
    "write": [
      {
        "id": "serve-only",
        "rule": "serve だけが書く。",
        "why": "AI が書き換えると、何を依頼したかの記録が変わる。",
        "test": "serve の範囲の検査で、AI の作業の前後に変わっていないかを見る。"
      }
    ]
  },
  "x-generates": ".brainstorming/.chat/<ボード>/<AI>.json",
  "x-view": {
    "label": "join(' ', [board, agent])"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "id",
    "board",
    "agent",
    "messages"
  ],
  "properties": {
    "$schema": {
      "description": "従うスキーマの名前",
      "x-prompt": {
        "read": {
          "means": "このインスタンスが従う型の名前である。"
        },
        "write": [
          {
            "id": "this-name",
            "rule": "brainstorming/chat@v1 と書く。",
            "why": "エンジンは、この名前で型のスキーマを引く。",
            "test": "値がこの文字列と同じかを見る。"
          }
        ]
      },
      "const": "brainstorming/chat@v1"
    },
    "kind": {
      "description": "インスタンスの種類",
      "x-prompt": {
        "read": {
          "means": "このインスタンスの種類である。"
        },
        "write": [
          {
            "id": "const",
            "rule": "chat と書く。",
            "why": "ページテンプレートと参照は kind で選ぶ。",
            "test": "値が同じかを見る。"
          }
        ]
      },
      "const": "chat"
    },
    "id": {
      "description": "名前",
      "x-prompt": {
        "read": {
          "means": "<ボード>-<AI> である。"
        },
        "write": [
          {
            "id": "file-name",
            "rule": "<ボード>-<AI> と書く。",
            "why": "ボードと AI ごとに1つにする。",
            "test": "board と agent をつないだものかを見る。"
          }
        ]
      },
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "board": {
      "description": "ボードの id",
      "x-prompt": {
        "read": {
          "means": "やりとりしたボードである。"
        },
        "write": [
          {
            "id": "by-id",
            "rule": "ボードの id を書く。",
            "why": "ボードごとに分ける。",
            "test": "ボードがあるかを見る。"
          }
        ]
      },
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "agent": {
      "description": "AI",
      "x-prompt": {
        "read": {
          "means": "使った AI の CLI である。"
        },
        "write": [
          {
            "id": "three",
            "rule": "claude ・ codex ・ kiro のどれかを書く。",
            "why": "続きの呼び方が CLI ごとに違う。",
            "test": "値を見る。"
          }
        ]
      },
      "enum": [
        "claude",
        "codex",
        "kiro"
      ]
    },
    "session": {
      "description": "セッションの ID",
      "x-prompt": {
        "read": {
          "means": "続きに使う ID である。"
        },
        "write": [
          {
            "id": "from-cli",
            "rule": "CLI が返した ID をそのまま書く（Claude Code は serve が決めた UUID）。",
            "why": "再開はこの ID で行う。",
            "test": "空でないかを見る。"
          }
        ]
      },
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "description": "やりとり",
      "x-prompt": {
        "read": {
          "means": "古い順のやりとりである。"
        },
        "write": [
          {
            "id": "append",
            "rule": "後ろに足すだけにする。",
            "why": "前のやりとりを書き換えると、続きの文脈と食い違う。",
            "test": "時刻が古い順かを見る。"
          }
        ]
      },
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "at"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "work",
              "notice"
            ],
            "description": "あなた ・ AI ・ 作業の記録 ・ serve の知らせ",
            "x-prompt": {
              "read": {
                "means": "あなた ・ AI ・ 作業の記録 ・ serve の知らせである。"
              },
              "write": [
                {
                  "id": "as-described",
                  "rule": "説明のとおりに書く。",
                  "why": "読み手とツールは説明のとおりに読む。",
                  "test": "説明と合っているかを見る。"
                }
              ]
            }
          },
          "text": {
            "type": "string",
            "description": "本文",
            "x-prompt": {
              "read": {
                "means": "本文である。"
              },
              "write": [
                {
                  "id": "only-needed",
                  "rule": "見せたい部分だけを書く。",
                  "why": "長いと強調した行が埋もれる。",
                  "test": "60行くらいまでかを見る。"
                }
              ]
            }
          },
          "items": {
            "type": "array",
            "description": "作業の記録の行",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "act",
                "target"
              ],
              "properties": {
                "act": {
                  "enum": [
                    "read",
                    "edit",
                    "run",
                    "check"
                  ],
                  "description": "読んだ ・ 直した ・ 実行した ・ 検査",
                  "x-prompt": {
                    "read": {
                      "means": "読んだ ・ 直した ・ 実行した ・ 検査である。"
                    },
                    "write": [
                      {
                        "id": "as-described",
                        "rule": "説明のとおりに書く。",
                        "why": "読み手とツールは説明のとおりに読む。",
                        "test": "説明と合っているかを見る。"
                      }
                    ]
                  }
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "x-prompt": {
                    "read": {
                      "means": "textである。"
                    },
                    "write": [
                      {
                        "id": "only-needed",
                        "rule": "見せたい部分だけを書く。",
                        "why": "長いと強調した行が埋もれる。",
                        "test": "60行くらいまでかを見る。"
                      }
                    ]
                  }
                },
                "ok": {
                  "type": "boolean",
                  "x-prompt": {
                    "read": {
                      "means": "okである。"
                    },
                    "write": [
                      {
                        "id": "as-described",
                        "rule": "説明のとおりに書く。",
                        "why": "読み手とツールは説明のとおりに読む。",
                        "test": "説明と合っているかを見る。"
                      }
                    ]
                  }
                }
              }
            },
            "x-prompt": {
              "read": {
                "means": "作業の記録の行である。"
              },
              "write": [
                {
                  "id": "as-described",
                  "rule": "説明のとおりに書く。",
                  "why": "読み手とツールは説明のとおりに読む。",
                  "test": "説明と合っているかを見る。"
                }
              ]
            }
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "x-prompt": {
              "read": {
                "means": "atである。"
              },
              "write": [
                {
                  "id": "as-described",
                  "rule": "説明のとおりに書く。",
                  "why": "読み手とツールは説明のとおりに読む。",
                  "test": "説明と合っているかを見る。"
                }
              ]
            }
          }
        }
      }
    }
  }
}
