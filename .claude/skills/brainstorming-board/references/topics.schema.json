{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ブレストボードの論点（topics.json）",
  "description": "組み上がりの形を検査する。**散文を弾くのが目的である** ── 1つの升に主張を複数入れた状態を、機械で検出する。",
  "type": "object",
  "required": [
    "theme",
    "board",
    "round",
    "topics"
  ],
  "properties": {
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "$defs": {
    "升": {
      "type": "string",
      "description": "1つの升。**主張は1つだけ入れる** ── 「主張 ── 説明」の形にし、2つ以上並べる場合は箇条書きか表に割る",
      "maxLength": 2000
    },
    "topic": {
      "type": "object",
      "required": [
        "no",
        "label",
        "question",
        "status"
      ],
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "未",
            "新規",
            "決着"
          ]
        },
        "answer": {
          "$ref": "#/$defs/升"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "example": {
          "type": "string"
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "kept": {
          "type": "array",
          "description": "反証を通過した案。**1件だけの状態は、選択ではない**",
          "items": {
            "type": "object",
            "required": [
              "name",
              "gist",
              "cost"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4
              },
              "gist": {
                "type": "string",
                "minLength": 1
              },
              "cost": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "why": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "tables": {
          "type": "array"
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "found": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/升"
          }
        },
        "pick": {
          "type": [
            "array",
            "null"
          ],
          "description": "採った案の記号と、その結論",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/升"
          }
        },
        "grounds": {
          "type": "array",
          "description": "支える先 ・ もとにしたこと ・ 出どころの種類 ・ 出どころ",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              },
              {
                "enum": [
                  "実測",
                  "原典",
                  "決まり",
                  "前提",
                  "未確認"
                ]
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/升"
          }
        },
        "weaknesses": {
          "type": "array",
          "description": "扱わない範囲。**承認を求める論点は、扱いを対で書く**",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "defects": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decision": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "extras": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
