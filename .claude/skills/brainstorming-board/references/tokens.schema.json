{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ブレストボードのデザイントークン",
  "description": "3段の階層を形として固定する。基礎は原始値だけを持ち、意味は基礎の鍵だけを参照し、部品は意味か基礎の鍵、または calc() だけを参照する。段を跨いだ直値を形の段で弾く ── 散文の規定では破れる。",
  "type": "object",
  "required": [
    "base",
    "semantic",
    "component"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "why_three_tiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "to_remove": {
      "description": "取り消す予定の段。**鍵に文を持たせない** ── 表題と理由に割る。",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "why": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "base": {
      "description": "原始値だけを持つ段。ここだけが生の値を書いてよい。",
      "type": "object",
      "required": [
        "color",
        "shadow",
        "space",
        "font_size",
        "tracking",
        "radius",
        "border"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/color_table"
        },
        "shadow": {
          "$ref": "#/$defs/value_table"
        },
        "space": {
          "$ref": "#/$defs/size_table"
        },
        "font_size": {
          "$ref": "#/$defs/size_table"
        },
        "tracking": {
          "$ref": "#/$defs/tracking_table"
        },
        "radius": {
          "$ref": "#/$defs/size_table"
        },
        "border": {
          "$ref": "#/$defs/size_table"
        }
      }
    },
    "semantic": {
      "description": "役割の名前に、基礎の鍵を割り当てる段。明と暗は同じ鍵集合を持つ ── 片方にしか在る鍵を弾く。",
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "properties": {
        "light": {
          "$ref": "#/$defs/ref_table"
        },
        "dark": {
          "$ref": "#/$defs/ref_table"
        }
      }
    },
    "component": {
      "description": "部品ごとの値。意味か基礎の鍵、または calc() だけを参照する。",
      "$ref": "#/$defs/component_table"
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "CSS のカスタムプロパティの名前になる。先頭の -- は書かない。"
    },
    "color_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(#[0-9a-f]{3}|#[0-9a-f]{6}|#[0-9a-f]{8})$",
        "description": "16進の色だけを許す。小文字に限る ── 大文字と混在すると、同じ色が2つの文字列になる。"
      }
    },
    "value_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "size_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
      }
    },
    "tracking_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?(0|\\.?\\d+(\\.\\d+)?)em$"
      }
    },
    "ref_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/key",
        "description": "基礎のどれかの鍵。直値は書けない ── 段を跨ぐためである。"
      }
    },
    "component_table": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "type": "string",
        "anyOf": [
          {
            "$ref": "#/$defs/key"
          },
          {
            "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
          },
          {
            "pattern": "^calc\\(.+\\)$"
          }
        ]
      }
    }
  }
}
