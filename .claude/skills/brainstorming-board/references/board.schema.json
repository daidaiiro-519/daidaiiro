{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ブレストボードの入力",
  "description": "JSON が正本で、HTML は生成物である。**この入力は宣言だけを保持し、組み上がった HTML 断片を保持しない** ── 断片を入れると、散文の検査が当たらなくなり（区切りが消えるため）、整形を重ねた結果が入力へ戻る。",
  "type": "object",
  "required": [
    "title",
    "board",
    "round",
    "topics"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "intro": {
      "$ref": "#/$defs/blocks"
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/panel"
      }
    },
    "queue": {
      "description": "いま見る論点と、なぜいま開いたか。",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "no",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "no": {
            "type": "integer"
          },
          "why": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "section_names": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "道筋の節の名前。{n} が件数に置き換わる。"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "$defs": {
    "cell": {
      "description": "人が読む1つの升。生の文字列を保持する ── 整形はレンダラが当てる。",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "panel": {
      "type": "object",
      "required": [
        "heading",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "$ref": "#/$defs/blocks"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "para",
            "note",
            "heading",
            "html",
            "list",
            "fold",
            "card",
            "table",
            "grid",
            "previous",
            "figure"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "para"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "text": {
                "$ref": "#/$defs/cell"
              },
              "nested": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "text": {
                "$ref": "#/$defs/cell"
              },
              "nested": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "level",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "level": {
                "enum": [
                  3,
                  4
                ]
              },
              "text": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "html"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "text": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/item"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fold"
              }
            }
          },
          "then": {
            "required": [
              "heading",
              "body"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "heading": {
                "type": "string"
              },
              "body": {
                "$ref": "#/$defs/blocks"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "card"
              }
            }
          },
          "then": {
            "required": [
              "heading"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "letter": {
                "$ref": "#/$defs/letter"
              },
              "heading": {
                "$ref": "#/$defs/cell"
              },
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/event"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "cols",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "cols": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grid"
              }
            }
          },
          "then": {
            "required": [
              "cols",
              "rows"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "cols": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "previous"
              }
            }
          },
          "then": {
            "required": [
              "letter",
              "body",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "letter": {
                "$ref": "#/$defs/letter"
              },
              "body": {
                "$ref": "#/$defs/cell"
              },
              "why": {
                "$ref": "#/$defs/cell"
              },
              "user_words": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "figure"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": true,
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "caption": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/cell"
        },
        "nested": {
          "$ref": "#/$defs/blocks"
        }
      }
    },
    "letter": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "event": {
      "description": "札は4値に限る。利用者の言葉は「内容」ではなく「差し戻し」である。",
      "type": "object",
      "required": [
        "tag",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "enum": [
            "returned",
            "obsolete",
            "finding",
            "content"
          ]
        },
        "text": {
          "$ref": "#/$defs/cell"
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "no",
        "name",
        "status",
        "question",
        "answer"
      ],
      "additionalProperties": false,
      "properties": {
        "no": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "waiting",
            "open",
            "settled"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "$ref": "#/$defs/cell"
        },
        "intro": {
          "$ref": "#/$defs/cell"
        },
        "decision": {
          "type": "object",
          "required": [
            "letter",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "letter": {
              "$ref": "#/$defs/letter"
            },
            "text": {
              "$ref": "#/$defs/blocks"
            }
          }
        },
        "example": {
          "$ref": "#/$defs/blocks"
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "passed": {
          "description": "1件だけの状態は、選択ではない ── 2件以上を要する。",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "letter",
              "body",
              "cost"
            ],
            "additionalProperties": false,
            "properties": {
              "letter": {
                "$ref": "#/$defs/letter"
              },
              "body": {
                "$ref": "#/$defs/cell"
              },
              "cost": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "body",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "body": {
                "$ref": "#/$defs/cell"
              },
              "reason": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "path": {
          "$ref": "#/$defs/blocks"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "grounds": {
          "description": "支える先・もとにしたこと・札・出どころの4欄で、欠けを許さない。",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "supports",
              "basis",
              "tag",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "supports": {
                "$ref": "#/$defs/cell"
              },
              "basis": {
                "$ref": "#/$defs/cell"
              },
              "tag": {
                "enum": [
                  "measured",
                  "primary",
                  "rule",
                  "assumption",
                  "unverified"
                ]
              },
              "source": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "$ref": "#/$defs/cell"
              },
              "treatment": {
                "enum": [
                  "out",
                  "later",
                  "resolved"
                ],
                "description": "対象外 ／ 後続で決定 ／ 解消済。**札の語は組み立て側が保持する**"
              },
              "note": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          }
        }
      }
    }
  }
}
