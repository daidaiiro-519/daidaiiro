{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "init が置く Markdown の本文",
  "description": "init がブレストボードの置き場所へ書き出す Markdown の本文を、置く先ごとに1件で持つ。本文は置く先でそのまま使う ── references に Markdown を置かないので、本文を JSON の文字列で持つ。",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "title": "置くファイル",
      "type": "array",
      "x-view": "list",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "id",
        "path",
        "purpose",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "識別子",
          "description": "init がこの値で本文を取り出す",
          "type": "string",
          "enum": [
            "index",
            "sources"
          ],
          "x-view": "hidden"
        },
        "path": {
          "title": "置く先",
          "description": "init の置き場所の親（既定は .brainstorming-board）からの経路。{name} はブレストボードの名前である",
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "title": "何を記録するファイルか",
          "type": "string",
          "minLength": 1
        },
        "text": {
          "title": "本文",
          "description": "置く先へ、この文字列をそのまま書き出す。末尾の改行も含む",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
