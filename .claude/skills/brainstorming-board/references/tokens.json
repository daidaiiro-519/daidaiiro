  "component": {
    "tl-node": "sp-7",
    "tl-rail": "bw-solid",
    "tl-inset": "calc(var(--tl-node) * 1.34)",
    "ev-label": "7.4rem",
    "nest-guide": "bw-solid",
    "card-radius": "rd-lg"
  },
  "to_remove": [
    {
      "what": "fig-bg と code-bg の段差が逆向きであること",
      "why": [
        "図の台を濃く、組み上がりを淡くしているのは、設計判断ではなく欠陥の埋め合わせである。",
        "figures/*.svg が fill=\"#f8faf9\" を焼いているため、暗配色で図が反転しない。",
        "design-svg が箱の色をトークン参照で出力するようになった時点で、この逆向きの2段を取り消す。"
      ]
    }
  ]
}
