{
  "$schema": "./tokens.schema.json",
  "why_three_tiers": [
    "基礎は原始値だけを持つ。意味は基礎だけを参照する。部品は意味と基礎だけを参照する。",
    "段を跨いで直値を書くと、外へ出した意味が消える ── 実際に --panel ・ --move ・ --line が",
    "定義の無いまま参照され、無言で初期値へ縮退していた。",
    "意味の段の名前は変えない ── build_board.py の CSS がこの名前を参照しており、そこは触らない。"
  ],
  "base": {
    "color": {
      "teal-700": "#0d5c55",
      "teal-300": "#6cc9b8",
      "teal-100": "#d5e6e3",
      "teal-900": "#173330",
      "amber-700": "#8f5410",
      "amber-400": "#d9a35f",
      "amber-100": "#f0e2cd",
      "amber-900": "#33281a",
      "plum-700": "#7a3b6d",
      "plum-300": "#d094c2",
      "sand-100": "#f8f3e8",
      "sand-400": "#d9b77e",
      "sand-900": "#241d14",
      "sand-700": "#6e5738",
      "ink-900": "#111d1a",
      "ink-700": "#5b6b66",
      "ink-500": "#7d8a86",
      "paper-000": "#f8faf9",
      "paper-100": "#eef1ef",
      "paper-200": "#e7ecea",
      "paper-300": "#dfe7e4",
      "paper-400": "#ccd8d4",
      "fig-100": "#dde6e2",
      "code-000": "#fbfcfc",
      "night-950": "#060b0a",
      "night-900": "#0e1614",
      "night-800": "#16211e",
      "night-700": "#22302d",
      "night-600": "#2a3936",
      "night-850": "#111a18",
      "code-800": "#1d2a26",
      "fog-300": "#93a29d",
      "fog-500": "#7b8985",
      "mist-100": "#e6eeeb"
    },
    "shadow": {
      "sh-light": "0 1px 0 rgba(17,29,26,.06),0 8px 22px -18px rgba(17,29,26,.5)",
      "sh-dark": "0 1px 0 rgba(0,0,0,.4),0 10px 26px -18px #000"
    },
    "space": {
      "sp-1": ".2rem",
      "sp-2": ".35rem",
      "sp-3": ".45rem",
      "sp-4": ".6rem",
      "sp-5": ".7rem",
      "sp-6": ".9rem",
      "sp-7": "1.2rem"
    },
    "font_size": {
      "fs-3xs": ".66rem",
      "fs-2xs": ".72rem",
      "fs-xs": ".8rem",
      "fs-sm": ".88rem"
    },
    "tracking": {
      "tr-wide": ".04em"
    },
    "radius": {
      "rd-sm": ".3rem",
      "rd-md": ".4rem",
      "rd-lg": ".6rem"
    },
    "border": {
      "bw-hair": "1px",
      "bw-solid": "2px"
    }
  },
  "semantic": {
    "light": {
      "paper": "paper-100",
      "card": "paper-000",
      "panel": "paper-200",
      "sunk": "paper-200",
      "fig-bg": "fig-100",
      "code-bg": "code-000",
      "ink": "ink-900",
      "muted": "ink-700",
      "dim": "ink-500",
      "rule": "paper-400",
      "rule-soft": "paper-300",
      "line": "paper-400",
