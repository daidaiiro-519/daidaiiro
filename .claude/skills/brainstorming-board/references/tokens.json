      "popline": "sand-400",
      "shadow": "sh-light"
    },
    "dark": {
      "paper": "night-900",
      "card": "night-800",
      "panel": "night-700",
      "sunk": "night-850",
      "fig-bg": "night-950",
      "code-bg": "code-800",
      "ink": "mist-100",
      "muted": "fog-300",
      "dim": "fog-500",
      "rule": "night-600",
      "rule-soft": "night-700",
