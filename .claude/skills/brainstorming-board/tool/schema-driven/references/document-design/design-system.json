{
 "$schema": "../design-system.schema.json",
 "scope": ".sd-doc",
 "tokens": {
  "base": {
   "color": {
    "bg-light": "#f7f8f7",
    "bg-dark": "#131816",
    "panel-light": "#ffffff",
    "panel-dark": "#1a201e",
    "ink-light": "#1d2321",
    "ink-dark": "#e3eae7",
    "muted-light": "#5c6763",
    "muted-dark": "#9aa8a3",
    "line-light": "#dde2df",
    "line-dark": "#2d3633",
    "accent-light": "#1f6f63",
    "accent-dark": "#6cc4b4",
    "accent-bg-light": "#e2f0ed",
    "accent-bg-dark": "#1d3531",
    "soft-light": "#eef1ef",
    "soft-dark": "#222a27",
    "done-light": "#2c7a4b",
    "done-dark": "#7dd3a0",
    "done-bg-light": "#e2f2e8",
    "done-bg-dark": "#1c3426",
    "doing-light": "#a15c07",
    "doing-dark": "#f0b45e",
