    "warn-bg-dark": "#352b17",
    "warn-line-light": "#e0b25a",
    "warn-line-dark": "#a8843d"
   }
  },
  "semantic": {
   "light": {
    "sd-bg": "bg-light",
    "sd-panel": "panel-light",
    "sd-ink": "ink-light",
    "sd-muted": "muted-light",
    "sd-line": "line-light",
    "sd-accent": "accent-light",
    "sd-accent-bg": "accent-bg-light",
    "sd-soft": "soft-light",
    "sd-done": "done-light",
    "sd-done-bg": "done-bg-light",
    "sd-doing": "doing-light",
    "sd-doing-bg": "doing-bg-light",
    "sd-todo": "todo-light",
    "sd-todo-bg": "todo-bg-light",
    "sd-blocked": "blocked-light",
    "sd-blocked-bg": "blocked-bg-light",
    "sd-warn-bg": "warn-bg-light",
    "sd-warn-line": "warn-line-light"
   },
   "dark": {
    "sd-bg": "bg-dark",
    "sd-panel": "panel-dark",
    "sd-ink": "ink-dark",
    "sd-muted": "muted-dark",
    "sd-line": "line-dark",
    "sd-accent": "accent-dark",
    "sd-accent-bg": "accent-bg-dark",
    "sd-soft": "soft-dark",
    "sd-done": "done-dark",
    "sd-done-bg": "done-bg-dark",
    "sd-doing": "doing-dark",
    "sd-doing-bg": "doing-bg-dark",
    "sd-todo": "todo-dark",
    "sd-todo-bg": "todo-bg-dark",
    "sd-blocked": "blocked-dark",
    "sd-blocked-bg": "blocked-bg-dark",
    "sd-warn-bg": "warn-bg-dark",
    "sd-warn-line": "warn-line-dark"
   }
  },
  "component": {}
 },
 "components": [
  {
   "name": "document",
   "states": {
    "default": {
     "background": "sd-bg",
     "text": "sd-ink",
     "border": "sd-line"
    }
   }
  },
  {
   "name": "badges",
   "states": {
    "default": {
     "background": "sd-accent-bg",
     "text": "sd-accent"
    }
   }
  },
  {
   "name": "inline",
   "states": {
    "default": {
     "text": "sd-ink",
     "link": "sd-accent"
    },
    "focus": {
     "outline": "sd-accent"
    }
   }
  }
 ]
}