    "todo-bg-light": "#eceeed",
    "todo-bg-dark": "#262e2b",
    "blocked-light": "#b0322a",
    "blocked-dark": "#f08a80",
    "blocked-bg-light": "#fae4e2",
    "blocked-bg-dark": "#3c1f1c",
