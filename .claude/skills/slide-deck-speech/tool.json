{
  "contract": 3,
  "cli": {
    "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/skills/slide-deck-speech/bin/slide-deck-speech",
    "args": []
  },
  "build": [
    ["cargo", "install", "--force", "--path", "tool/cli", "--root", ".", "--target-dir", "tool/target"],
    ["cargo", "install", "--force", "--path", "tool/mcp", "--root", ".", "--target-dir", "tool/target"]
  ],
  "test": [
    ["cargo", "test", "--manifest-path", "tool/Cargo.toml", "-q"]
  ],
  "format": [
    ["cargo", "fmt", "--manifest-path", "tool/Cargo.toml", "--all", "--", "--check"]
  ],
  "external": [
    {
      "name": "aws",
      "command": "aws",
      "reason": "Amazon Polly で音声を合成する。AWS の Rust の SDK は、sso-session の形の SSO 設定に対応していない"
    }
  ]
}
