{
  "$schema": "./rules.schema.json",
  "rules": [
    {
      "rule": "この Skill の試験が通る",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "test",
          "-q"
        ],
        "target": "rs"
      }
    },
    {
      "rule": "規則ファイルの形が契約を満たす",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "rs/target/release/no-more-spaghetti",
          "validate",
          "references/self-rules.json",
          ".",
          "--skill_root",
          "."
        ]
      }
    },
    {
      "rule": "概念の出典と、生成するスキーマの案内が契約を満たす",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "test",
          "-q",
          "-p",
          "nms_parts",
          "--test",
          "validate"
        ],
        "target": "rs"
      }
    },
    {
      "rule": "雛形の生成が成立する",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "test",
          "-q",
          "-p",
          "nms_parts",
          "--test",
          "init"
        ],
        "target": "rs"
      }
    },
    {
      "rule": "規則の実行と、出力の続きが成立する",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "test",
          "-q",
          "-p",
          "nms_parts",
          "--test",
          "run"
        ],
        "target": "rs"
      }
    },
    {
      "rule": "整形されている",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "fmt",
          "--all",
          "--",
          "--check"
        ],
        "target": "rs"
      }
    },
    {
      "rule": "静的解析を通る",
      "source": {
        "record": "no-more-spaghetti-self"
      },
      "scope": "この成果物に限る",
      "check": {
        "tool": [
          "cargo",
          "clippy",
          "--all-targets",
          "--all-features",
          "--",
          "-Dwarnings"
        ],
        "target": "rs"
      }
    }
  ]
}
