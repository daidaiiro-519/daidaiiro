{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "廃語の一覧",
  "description": "一度破棄した語と、その言い換え先。この一覧は doc-writing-skills の外にあり、プロジェクトが持つ。既定の置き場所は、プロジェクト直下の .doc-writing/retired-words.json である。",
  "type": "object",
  "required": ["廃語"],
  "properties": {
    "$schema": { "type": "string" },
    "廃語": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["語", "言い換え先"],
        "additionalProperties": false,
        "properties": {
          "語": { "type": "string", "minLength": 1, "description": "廃語。これが本文に現れたら検出する" },
          "言い換え先": { "type": "string", "minLength": 1, "description": "代わりに使う語" },
          "破棄した時点": { "type": "string", "description": "YYYY-MM-DD" },
          "出どころ": { "type": "string", "description": "どこで捨てたか。コミット・論点・決まりなど" }
        }
      }
    }
  },
  "additionalProperties": false
}
