{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "意思決定の記録",
  "description": "意思決定の記録。上部は4つの節（決めたこと ・ なぜ ・ どう変わるか ・ 比較した案）だけを描画し、具体の差分は面が持つ。",
  "type": "object",
  "required": [
    "title",
    "decision",
    "why",
    "status",
    "alternatives"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "x-view": "hidden"
    },
    "no": {
      "type": "string",
      "description": "連番。例 ACDR 0001",
      "x-view": "meta"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^YYYY-MM-DD$",
      "description": "決めた日。YYYY-MM-DD",
      "x-view": "meta"
    },
    "status": {
      "title": "状態",
      "x-view": "tag",
      "oneOf": [
        {
          "const": "proposed",
          "title": "提案 ── 承認前。適用してはならない"
        },
        {
          "const": "accepted",
          "title": "承認"
        },
        {
          "const": "superseded",
          "title": "差し替え済み"
        }
      ],
      "$comment": "proposed は未承認で適用してはならない。accepted は承認済み。superseded は後の記録が置き換えた"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "短い名詞句",
      "x-view": "heading"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "title": "決めたこと",
      "x-view": "card",
      "$comment": "**決めてほしいこと1件**。手段ではなく、何を採るかを1文で記述する"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "title": "なぜ決める必要があるか",
      "$comment": "なぜ、いま決めるのか。何と食い違っていて、何に一致させたか"
    },
    "figure": {
      "type": "string",
      "title": "どう変わるか",
      "x-view": "figure",
      "$comment": "隣に置いた SVG のファイル名。**この Skill は描画しない** ── 描くのは design-svg である"
    },
    "shift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string",
            "title": "何が"
          },
          "from": {
            "type": "string",
            "title": "変更前"
          },
          "to": {
            "type": "string",
            "title": "変更後"
          }
        }
      },
      "title": "変更前と変更後",
      "x-view": "table",
      "$comment": "**抽象の側の変更前と変更後**。具体の差分は面が保持する"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "option"
        ],
        "additionalProperties": false,
        "properties": {
          "option": {
            "type": "string",
            "title": "案"
          },
          "why_not": {
            "type": "string",
            "title": "採らなかった理由"
          }
        }
      },
      "title": "比較した案と、採らなかった理由",
      "x-view": "table",
      "$comment": "**どれも反証を通過しなかった案である** ── 未解決の懸念ではない",
      "minItems": 1
    },
    "supersedes": {
      "type": "string",
      "description": "この決定が置き換えた記録の番号",
      "x-view": "hidden"
    },
    "figure_caption": {
      "type": "string",
      "description": "図が示すものを1文で記述する",
      "x-view": "hidden"
    },
    "how": {
      "type": "string",
      "description": "その決定をどう実現するか（手段）。決定の文に混在させない",
      "x-view": "hidden"
    },
    "applies_to": {
      "type": "string",
      "minLength": 1,
      "description": "どの正本が変化するか",
      "x-view": "hidden"
    },
    "after_approval": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-view": "hidden"
    },
    "lede": {
      "type": "string",
      "x-view": "hidden"
    },
    "intro": {
      "type": "string",
      "x-view": "hidden"
    },
    "docs": {
      "type": "array",
      "description": "対象の文書。空なら新規の決定で、差分は出ない",
      "items": {
        "type": "object",
        "required": [
          "key",
          "tab",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "description": "面を識別する短いキー"
          },
          "tab": {
            "type": "string",
            "description": "タブに出す名前"
          },
          "file": {
            "type": "string",
            "description": "リポジトリの根からの相対パス"
          },
          "rev": {
            "type": "string",
            "description": "変更前を取得する git の版。既定は HEAD"
          },
          "before": {
            "type": "string",
            "description": "変更前の中身を直に渡す場合。既定は git から取得する"
          },
          "marks": {
            "type": "array",
            "description": "変更1件ぶんの3つ組",
            "items": {
              "type": "object",
              "required": [
                "find",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "find": {
                  "type": "string",
                  "description": "どこ ── 描画したあとの本文に現れる文字列。記法を含めない"
                },
                "before": {
                  "type": "string",
                  "description": "変更前の原文。要約しない。**平文である**"
                },
                "why": {
                  "type": "string",
                  "description": "なぜ ── 何と食い違っていて、何に一致させたか。**平文である**"
                }
              }
            }
          }
        }
      },
      "x-view": "hidden"
    },
    "seal": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "承認時点の対象の文書の sha256。**承認済みの記録は、承認時点の姿を保持する**",
      "x-view": "hidden"
    },
    "seal_note": {
      "type": "string",
      "description": "封印についての補足",
      "x-view": "hidden"
    }
  },
  "$comment": "acdr.json の形。節と、対象の文書ごとの3つ組だけを保持する ── 変更後の中身は対象の文書が保持する。x-view は描画の見せ方の指定である。how ・ applies_to ・ after_approval ・ lede ・ intro は過去の記録のために残し、描画しない"
}
