{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "意思決定の記録（ACDR）の入力",
  "description": "acdr.json の形。**節と、対象の文書ごとの3つ組だけを保持する** ── 変更後の中身は対象の文書が保持する。",
  "type": "object",
  "required": [
    "title",
    "decision",
    "why",
    "applies_to",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "no": {
      "type": "string",
      "description": "連番。例 ACDR 0001"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "短い名詞句"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^YYYY-MM-DD$",
      "description": "決めた日。YYYY-MM-DD"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ],
      "description": "proposed は未承認で適用してはならない。accepted は承認済み。superseded は後の記録が置き換えた"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "description": "**決めてほしいこと1件**。手段ではなく、何を採るかを1文で記述する"
    },
    "applies_to": {
      "type": "string",
      "minLength": 1,
      "description": "どの正本が変化するか"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "description": "なぜ、いま決めるのか。何と食い違っていて、何に一致させたか"
    },
    "shift": {
      "type": "array",
      "description": "**抽象の側の変更前と変更後**。具体の差分は面が保持する",
      "items": {
        "type": "object",
        "required": [
          "what",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "figure": {
      "type": "string",
      "description": "隣に置いた SVG のファイル名。**この Skill は描画しない** ── 描くのは design-svg である"
    },
    "figure_caption": {
      "type": "string",
      "description": "図が示すものを1文で記述する"
    },
    "how": {
      "type": "string",
      "description": "その決定をどう実現するか（手段）。決定の文に混在させない"
    },
    "alternatives": {
      "type": "array",
      "description": "**どれも反証を通過しなかった案である** ── 未解決の懸念ではない",
      "items": {
        "type": "object",
        "required": [
          "option"
        ],
        "additionalProperties": false,
        "properties": {
          "option": {
            "type": "string"
          },
          "why_not": {
            "type": "string"
          }
        }
      }
    },
    "after_approval": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "string",
      "description": "この決定が置き換えた記録の番号"
    },
    "lede": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "docs": {
      "type": "array",
      "description": "対象の文書。空なら新規の決定で、差分は出ない",
      "items": {
        "type": "object",
        "required": [
          "key",
          "tab",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "description": "面を識別する短い鍵"
          },
          "tab": {
            "type": "string",
            "description": "タブに出す名前"
          },
          "file": {
            "type": "string",
            "description": "リポジトリの根からの相対パス"
          },
          "rev": {
            "type": "string",
            "description": "変更前を取得する git の版。既定は HEAD"
          },
          "before": {
            "type": "string",
            "description": "変更前の中身を直に渡す場合。既定は git から取得する"
          },
          "marks": {
            "type": "array",
            "description": "変更1件ぶんの3つ組",
            "items": {
              "type": "object",
              "required": [
                "find",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "find": {
                  "type": "string",
                  "description": "どこ ── 描画したあとの本文に現れる文字列。記法を含めない"
                },
                "before": {
                  "type": "string",
                  "description": "変更前の原文。要約しない。**平文である**"
                },
                "why": {
                  "type": "string",
                  "description": "なぜ ── 何と食い違っていて、何に一致させたか。**平文である**"
                }
              }
            }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "承認時点の対象の文書の sha256。**承認済みの記録は、承認時点の姿を保持する**"
    },
    "seal_note": {
      "type": "string",
      "description": "封印についての補足"
    }
  }
}
