      "line": "rule-200",
      "gone": "red-700"
    },
    "dark": {
      "paper": "night-000",
      "ink": "snow-100",
      "muted": "snow-500",
      "panel": "night-100",
      "chipbg": "night-200",
      "move": "amber-300",
      "key": "teal-300",
      "line": "night-rule",
      "gone": "red-300"
    }
  },
  "component": {
    "pop-bg": "wash-move",
