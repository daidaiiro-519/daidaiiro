{
  "$schema": "./tokens.schema.json",
  "why_three_tiers": [
    "基礎は原始値だけを持つ。色の実体を書いてよいのはここだけである。",
    "意味は役割へ基礎の鍵を割り当てる。明暗の差はここだけに出る。",
    "部品は、意味か基礎の鍵を参照する。直値を書くと、配色を替えたときにそこだけ取り残される。"
  ],
  "base": {
    "color": {
      "paper-000": "#fbfaf7",
      "paper-100": "#f2efe8",
      "paper-200": "#e7e3d9",
      "ink-900": "#1c1a17",
      "ink-500": "#6b665d",
      "rule-200": "#d8d3c7",
      "amber-700": "#9a5b2c",
      "teal-700": "#2f6f5e",
      "red-700": "#8a3a3a",
      "night-000": "#16150f",
      "night-100": "#211f18",
      "night-200": "#2b281f",
      "night-rule": "#38342a",
      "snow-100": "#ece7dc",
      "snow-500": "#98918a",
      "amber-300": "#d99b62",
      "teal-300": "#6fbfa4",
      "red-300": "#d97b7b"
    },
    "alpha": {
      "wash-move": "rgba(154,91,44,.07)",
      "wash-key": "rgba(47,111,94,.10)",
      "wash-gone": "rgba(138,58,58,.10)",
      "wash-quiet": "rgba(128,128,128,.12)"
    }
  },
  "semantic": {
    "light": {
      "paper": "paper-000",
      "ink": "ink-900",
      "muted": "ink-500",
      "panel": "paper-100",
