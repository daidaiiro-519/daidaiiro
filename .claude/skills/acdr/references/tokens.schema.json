{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "意思決定の記録のデザイントークン",
 "description": "3層の構造を形として固定する。基礎は原始値だけを持ち、意味は基礎のキーだけを参照し、部品は意味か基礎のキーだけを参照する。層を跨いだ直値を、形の層で弾く ── 散文の規定では破れる。",
 "type": "object",
 "required": [
  "base",
  "semantic",
  "component"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "why_three_tiers": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "base": {
   "description": "原始値だけを持つ層。ここだけが生の値を書いてよい。",
   "type": "object",
   "required": [
    "color",
    "alpha",
    "space",
    "font_size",
    "tracking",
    "radius",
    "border",
    "width"
   ],
   "additionalProperties": false,
   "properties": {
    "color": {
     "$ref": "#/$defs/color_table"
    },
    "alpha": {
     "$ref": "#/$defs/alpha_table"
    },
    "space": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "space の層。原始値だけを持つ"
    },
    "font_size": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "font_size の層。原始値だけを持つ"
    },
    "tracking": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "tracking の層。原始値だけを持つ"
    },
    "radius": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "radius の層。原始値だけを持つ"
    },
    "border": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "border の層。原始値だけを持つ"
    },
    "width": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
     },
     "additionalProperties": {
      "type": "string",
      "pattern": "^(0|\\.?\\d+(\\.\\d+)?)(rem|em|px|%)$"
     },
     "description": "width の層。原始値だけを持つ"
    }
   }
  },
  "semantic": {
   "description": "役割の名前へ、基礎のキーを割り当てる層。明と暗は同じキー集合を持つ ── 片方にしか無いキーを弾く。",
   "type": "object",
   "required": [
    "light",
    "dark"
   ],
   "additionalProperties": false,
   "properties": {
    "light": {
     "$ref": "#/$defs/ref_table"
    },
    "dark": {
     "$ref": "#/$defs/ref_table"
    }
   }
  },
  "component": {
   "description": "部品ごとの値。意味か基礎のキーだけを参照する。",
   "$ref": "#/$defs/ref_table"
  }
 },
 "$defs": {
  "color_table": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "string",
    "pattern": "^#[0-9a-f]{3,8}$"
   },
   "propertyNames": {
    "pattern": "^[a-z0-9-]+$"
   }
  },
  "alpha_table": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "string",
    "pattern": "^rgba?\\("
   },
   "propertyNames": {
    "pattern": "^[a-z0-9-]+$"
   }
  },
  "ref_table": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "string",
    "pattern": "^[a-z0-9-]+$"
   },
   "propertyNames": {
    "pattern": "^[a-z0-9-]+$"
   }
  }
 }
}