/**
 * {{Skill名}} の道具の一覧。**能力の正本はここである。**
 *
 * CLI と MCP はこの一覧から組む ── 能力を2回書くと、片方だけが古くなる。
 */

import { found, type Given, need, type Outcome, type Tool } from './contract.ts';
import { greet } from './hello.ts';

/**
 * 見本の道具。**書き換えて、この Skill の道具にする。**
 *
 * 外部の道具を起動するなら、given.external("名前") で tool.json から読み、引数として渡す。
 */
function runHello(given: Given): Outcome {
    return found([], { greeting: greet(given.one('name', '')) });
}

function humanHello(out: Outcome): string {
    if (!out.ok) return out.findings.join(' ／ ');
    return String(out.data.greeting ?? '');
}

/** この Skill が持つ道具の一覧。 */
export function tools(): Tool[] {
    return [
        {
            name: 'hello',
            summary: '見本の道具。名前を受けて、あいさつの文を返す',
            args: [need('name', 'あいさつする相手の名前')],
            run: runHello,
            human: humanHello
        }
    ];
}
