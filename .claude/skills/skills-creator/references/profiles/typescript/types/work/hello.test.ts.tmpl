/** 見本の道具（hello）を事例で検証する。道具を書き換えたら、事例も書き換える。 */

import { strict as assert } from 'node:assert';
import { test } from 'node:test';

import { greet } from '../src/hello.ts';

test('名前を差し込んだ文を返す', () => {
    // **1つの事例が1つの判定を固定する。** まとめると、どれが壊れたか分からない
    assert.equal(greet('世界'), 'こんにちは、世界');
});
