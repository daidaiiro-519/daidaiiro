/**
 * references の実装。**どの Skill も同じファイルを複製して使う** ── contract.ts と同じ扱いである。
 *
 * references は、Skill の目的を達成するために参照する情報である（ACDR 0043）。種類ごとに、
 * JSON Schema（<種類>.schema.json）と、それに従う JSON（<種類>.json）を置く。JSON は
 * $schema でスキーマを指す。回答の形のように、スキーマだけの種類も在る。
 *
 * 持つ能力は4つである ── 取り出す（get）・ 検査する（validate）・ 描画する（view）・
 * 既存の文書を取り込む（import）。**描画は回答の形も種類の中身も参照しない** ── スキーマの
 * title を見出しに、description を説明にし、見せ方は x-view が決める。
 *
 * **出力は Rust の組の refs.rs と1バイトずつ同じにする**（ACDR 0069）── 同じ references が、
 * 言語によって違って見えてはならない。
 */

import { createHash } from 'node:crypto';
import { mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';

import { Ajv2020 } from 'ajv/dist/2020.js';

export const SCHEMA_TAIL = '.schema.json';

/**
 * 見た目の正本の複製（ボード view-design-tokens）。**描画は、Skill の references/ に置いた複製だけを読む**
 * ── コードに見た目の値を保持しない。正本は Skill を生んだ道具が持ち、Skill を生むときに複製する。
 */
const VIEW_TOKENS = 'view.tokens.json';
/** 描画の規則（.rv の囲みの中だけに適用される）。 */
const VIEW_CSS = 'view.css';
/** 頁の型。**差し込む場所は3つ** ── {{title}} ・ {{style}} ・ {{body}}。 */
const VIEW_TEMPLATE = 'view.template.html';
/** Skill 固有のトークン（必要とする Skill だけが置く）。 */
const SKILL_TOKENS = 'view.skill.tokens.json';
/** Skill 固有の規則（必要とする Skill だけが置く）。 */
const SKILL_CSS = 'view.skill.css';

/** JSON の値。 */
export type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
type Obj = { [key: string]: Json };

/** references を読めない ・ 書けない ・ 項目が無いときの誤り。道具は誤用として返す。 */
export class RefsError extends Error {}

/** 種類1つ。data はスキーマだけの種類では null である。 */
export interface Kind {
    name: string;
    schema: string;
    data: string | null;
}

/** 数の原文を保持する値（JSON.rawJSON）。**書き出すと、読んだときの書き方（4.0 など）のまま出る。** */
const RAW = JSON as unknown as { rawJSON(text: string): Json; isRawJSON(v: unknown): boolean };

function isObj(v: Json | undefined): v is Obj {
    return typeof v === 'object' && v !== null && !Array.isArray(v) && !RAW.isRawJSON(v);
}

function names(refs: string): string[] {
    try {
        return readdirSync(refs).sort(byBytes);
    } catch (e) {
        throw new RefsError(`${refs} を読めない ── ${(e as Error).message}`);
    }
}

/** 名前を UTF-8 のバイトの順に並べる。**Rust の文字列の順と同じにする。** */
function byBytes(a: string, b: string): number {
    return Buffer.compare(Buffer.from(a, 'utf8'), Buffer.from(b, 'utf8'));
}

function isFile(p: string): boolean {
    try {
        return statSync(p).isFile();
    } catch {
        return false;
    }
}

/** references の種類を並べる。**名前の順である** ── 実行ごとに順が変わると、差分が毎回出る。 */
export function kinds(refs: string): Kind[] {
    return names(refs)
        .filter(f => f.endsWith(SCHEMA_TAIL))
        // **見た目の正本の複製（view.*）は種類ではない** ── 中身ではなく見た目である。形は validate が検査する
        .filter(f => !f.startsWith('view.'))
        .map(file => {
            const name = file.slice(0, -SCHEMA_TAIL.length);
            const data = join(refs, `${name}.json`);
            return { name, schema: join(refs, file), data: isFile(data) ? data : null };
        });
}

/** 描画した頁を書き出す。 */
export function save(out: string, html: string): void {
    try {
        mkdirSync(dirname(out), { recursive: true });
        writeFileSync(out, html, 'utf8');
    } catch (e) {
        throw new RefsError(`${out} に書けない ── ${(e as Error).message}`);
    }
}

/** 取り込む文書を読む。 */
export function readText(file: string): string {
    try {
        return readFileSync(file, 'utf8');
    } catch (e) {
        throw new RefsError(`${file} を読めない ── ${(e as Error).message}`);
    }
}

/**
 * JSON を読む。`keep` を渡すと、**数を原文の書き方のまま保持する** ── JSON.parse は 4.0 を 4 にするので、
 * 取り出しと描画の出力が、原文と ・ 他の言語の道具と食い違う。**検査に使う値には渡さない**（スキーマの
 * 検査は、数を数として受け取る）。
 */
function readJson(path: string, keep = false): Json {
    let body: string;
    try {
        body = readFileSync(path, 'utf8');
    } catch (e) {
        throw new RefsError(`${path} を読めない ── ${(e as Error).message}`);
    }
    try {
        if (!keep) return JSON.parse(body) as Json;
        return JSON.parse(body, (_k, v, ctx?: { source?: string }) => (typeof v === 'number' && ctx?.source !== undefined ? RAW.rawJSON(ctx.source) : v)) as Json;
    } catch (e) {
        throw new RefsError(`${path} が JSON でない ── ${(e as Error).message}`);
    }
}

/** スキーマで検査する。**$schema の欄は、スキーマを指す印なので外してから当てる。** */
function against(schema: Json, instance: Json, head: string): string[] {
    let plain = instance;
    if (isObj(plain)) {
        const { $schema: _, ...rest } = plain;
        plain = rest;
    }
    const ajv = new Ajv2020({ strict: false, allErrors: true, validateFormats: false });
    let check;
    try {
        check = ajv.compile(schema as object);
    } catch {
        return [`${head}: スキーマとして無効である`];
    }
    if (check(plain)) return [];
    return (check.errors ?? []).map(e => `${head}: ${e.instancePath.replace(/^\//, '')} ── ${e.message ?? ''}`).sort(byBytes);
}

/** references を検査する。**スキーマに合わない JSON、スキーマを指さない JSON、Markdown を並べる。** */
export function validate(refs: string): string[] {
    const found: string[] = [];
    for (const file of names(refs)) {
        if (file.endsWith('.md')) {
            found.push(`${file}: Markdown が在る ── references は JSON Schema と JSON で持つ（Markdown は SKILL.md だけ）`);
        }
        if (!file.endsWith('.json') || file.endsWith(SCHEMA_TAIL)) continue;
        let data: Json;
        try {
            data = readJson(join(refs, file));
        } catch (why) {
            found.push((why as Error).message);
            continue;
        }
        // **$schema が指すスキーマで検査する** ── 雛形のように、種類の名前と違うスキーマを指してよい
        const own = `${file.slice(0, -'.json'.length)}${SCHEMA_TAIL}`;
        let want = isObj(data) && typeof data.$schema === 'string' ? data.$schema : null;
        if (want === null) {
            found.push(`${file}: $schema が無い ── ${own} を指す`);
            want = own;
        }
        let schema: Json;
        try {
            schema = readJson(join(refs, want));
        } catch {
            found.push(`${file}: スキーマ ${want} が無い`);
            continue;
        }
        found.push(...against(schema, data, file));
    }
    return found;
}

/** 1つの JSON を、種類のスキーマで検査する。**回答のように、references の外の JSON に使う。** */
export function validateFile(refs: string, kind: string, file: string): string[] {
    const schema = readJson(join(refs, `${kind}${SCHEMA_TAIL}`));
    const data = readJson(file);
    const found = against(schema, data, file);
    // **形に合っても、指す先が無ければ通さない** ── 無い基準や無い文を根拠に書いても、形の検査は通る
    const merged = mergeRefs(schema, schema, 0);
    const cited: string[] = [];
    cite(refs, merged, merged, data, '', file, cited);
    cited.sort(byBytes);
    found.push(...cited);
    return found;
}

/**
 * 指す先の種類の項目を返す。**項目が0件なら null** ── 生成した直後の Skill は、見本の id を指す
 * 回答の例を持つので、書き入れるまでは照らさない。
 */
function itemsOf(refs: string, kind: string): Json[] | null {
    let data: Json;
    try {
        data = readJson(join(refs, `${kind}.json`));
    } catch {
        return null;
    }
    const items = isObj(data) && Object.hasOwn(data, 'items') ? data.items : data;
    return Array.isArray(items) && items.length > 0 ? items : null;
}

/** 項目の中の文字列をすべてつなぐ。**空白は外す** ── 引用と照らすための平文である。 */
function plainOf(v: Json | undefined): string {
    if (typeof v === 'string') return v.replace(new RegExp(WS, 'gu'), '');
    if (Array.isArray(v)) return v.map(plainOf).join('');
    if (isObj(v)) return Object.values(v).map(plainOf).join('');
    return '';
}

/**
 * 引用を、照らす断片に分ける。**省略（…）と並び（ ・ ）で切り、「欄の題：」を外す** ── 表 ・ 規則の
 * 行は「欄の題：値」の形で引く。2文字に満たない断片は照らさない。
 */
function fragments(quote: string): string[] {
    return quote
        .split('…')
        .flatMap(x => x.split(' ・ '))
        .map(x => {
            const c = x.indexOf('：');
            return c >= 0 ? x.slice(c + 1) : x;
        })
        .map(x => x.replace(new RegExp(WS, 'gu'), '').replace(/。+$/u, ''))
        .filter(x => [...x].length >= 2);
}

/**
 * 参照の注記（`x-refers` ・ `x-quotes`）に従って、指す先を照らす。**`x-refers: 種類` の欄は、その種類の
 * id を指す。`x-quotes: 隣の欄` の欄は、隣の欄が指す項目の記述を引く。**
 */
function cite(refs: string, schema: Json | undefined, root: Json, value: Json, path: string, head: string, out: string[]): void {
    const node = resolve(schema, root);
    if (isObj(value)) {
        const props = at(node, 'properties');
        for (const [k, v] of Object.entries(value)) {
            const raw = at(props, k);
            if (raw === undefined) continue;
            const ps = resolve(raw, root);
            const here = `${path}/${k}`;
            const kind = str(ps, 'x-refers');
            if (kind !== null && typeof v === 'string') {
                const items = itemsOf(refs, kind);
                if (items !== null && !items.some(x => str(x, 'id') === v)) out.push(`${head}: ${here} ── ${kind} に id ${v} が無い`);
            }
            const sib = str(ps, 'x-quotes');
            if (sib !== null && typeof v === 'string') {
                const sp = at(props, sib);
                const kindOf = sp === undefined ? null : str(resolve(sp, root), 'x-refers');
                const id = str(value, sib);
                if (kindOf !== null && id !== null) {
                    const item = itemsOf(refs, kindOf)?.find(x => str(x, 'id') === id);
                    if (item !== undefined) {
                        const whole = plainOf(item);
                        for (const f of fragments(v)) {
                            if (!whole.includes(f)) out.push(`${head}: ${here} ── ${kindOf} の ${id} の記述に無い ──「${f}」`);
                        }
                    }
                }
            }
            cite(refs, ps, root, v, here, head, out);
        }
    } else if (Array.isArray(value)) {
        const items = at(node, 'items');
        if (items !== undefined) value.forEach((x, i) => cite(refs, items, root, x, `${path}/${i}`, head, out));
    }
}

/** 指定した欄を、入れ子のすべてから除く。**取り出す量を減らす** ── 要素ごとの出典（source）は、判断基準 1件の大半を占める。 */
export function omit(v: Json, keys: string[]): Json {
    if (Array.isArray(v)) return v.map(x => omit(x, keys));
    if (!isObj(v)) return v;
    return Object.fromEntries(Object.entries(v).filter(([k]) => !keys.includes(k)).map(([k, x]) => [k, omit(x, keys)]));
}

/** 除く欄の指定（, で区切る）を、欄の名前の並びにする。**空白の規則は Rust の str::trim と同じである。** */
export function omitKeys(spec: string | undefined): string[] {
    return spec === undefined ? [] : spec.split(',').map(trim).filter(k => k !== '');
}

/** 種類の JSON を取り出す。**id を渡すと、その1件だけを返す** ── モデルは全体を読まずに済む。 */
export function get(refs: string, kind: string, id?: string): Json {
    const data = readJson(join(refs, `${kind}.json`), true);
    if (isObj(data)) delete data.$schema;
    if (id === undefined) return data;
    const items = isObj(data) && 'items' in data ? data.items : data;
    if (!Array.isArray(items)) throw new RefsError(`${kind} は項目の並びではない ── id で取り出せない`);
    const hit = items.find(x => isObj(x) && x.id === id);
    if (hit === undefined) throw new RefsError(`${kind} に id ${id} の項目が無い`);
    return hit;
}

/** 行に分ける。**Rust の str::lines と同じ規則である** ── 末尾の改行は空の行を作らず、行末の CR を外す。 */
function lines(text: string): string[] {
    const parts = text.split('\n');
    if (parts.length > 0 && parts[parts.length - 1] === '') parts.pop();
    return parts.map(p => (p.endsWith('\r') ? p.slice(0, -1) : p));
}

function numbered(t: string): string | null {
    const at = t.indexOf('. ');
    if (at < 0) return null;
    const n = t.slice(0, at);
    return n.length > 0 && /^[0-9]+$/.test(n) ? t.slice(at + 2) : null;
}

/**
 * 空白の集合。**Rust の char::is_whitespace（Unicode の White_Space）と同じにする** ──
 * JS の \\s は BOM（U+FEFF）を含み、U+0085 を含まないので、結果が Rust と食い違う。
 */
const WS = '[\\t\\n\\v\\f\\r \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]';
const trimStart = (s: string) => s.replace(new RegExp(`^${WS}+`, 'u'), '');
const trimEnd = (s: string) => s.replace(new RegExp(`${WS}+$`, 'u'), '');
const trim = (s: string) => trimEnd(trimStart(s));
const trimChars = (s: string, c: string) => {
    let a = 0;
    let b = s.length;
    while (a < b && s[a] === c) a++;
    while (b > a && s[b - 1] === c) b--;
    return s.slice(a, b);
};

/** 本文を塊に分ける ── 段落 ・ 箇条書き ・ 表 ・ コード。**記号のまま残さない。** 区切りの線（---）は捨てる。 */
export function blocksOf(src: string[]): Obj[] {
    const plain = (t: string) => t.replaceAll('**', '').replaceAll('`', '');
    const cells = (line: string) => trimChars(trim(line), '|').split('|').map(c => plain(trim(c)));
    const out: Obj[] = [];
    const para: string[] = [];
    const flush = () => {
        if (para.length > 0) {
            out.push({ kind: 'para', text: para.join('') });
            para.length = 0;
        }
    };
    let i = 0;
    while (i < src.length) {
        const line = trimEnd(src[i]);
        const t = trimStart(line);
        if (t.startsWith('```')) {
            flush();
            const code: string[] = [];
            i++;
            while (i < src.length && !trimStart(src[i]).startsWith('```')) {
                code.push(src[i]);
                i++;
            }
            out.push({ kind: 'code', text: code.join('\n') });
        } else if (t.startsWith('|')) {
            flush();
            const head = cells(t);
            const rows: Json[] = [];
            i++;
            while (i < src.length && trimStart(src[i]).startsWith('|')) {
                const r = cells(src[i]);
                if (!r.every(c => [...c].every(ch => ch === '-' || ch === ':' || ch === ' '))) rows.push(r);
                i++;
            }
            out.push({ kind: 'table', head, rows });
            continue;
        } else if (t.startsWith('- ') || t.startsWith('* ') || numbered(t) !== null) {
            flush();
            const ordered = !t.startsWith('-') && !t.startsWith('*');
            const items: Json[] = [];
            while (i < src.length) {
                const l = trimStart(src[i]);
                let item: string;
                if (l.startsWith('- ') || l.startsWith('* ')) item = l.slice(2);
                else {
                    const rest = numbered(l);
                    if (rest === null) break;
                    item = rest;
                }
                items.push(plain(item));
                i++;
            }
            out.push({ kind: 'list', ordered, items });
            continue;
        } else if (t === '' || [...t].every(c => c === '-')) {
            flush();
        } else {
            para.push(plain(trim(t.replace(/^>+/, ''))));
        }
        i++;
    }
    flush();
    return out;
}

interface Node {
    title: string;
    level: number;
    body: string[];
    children: Node[];
}

/** Markdown の文書を、document の1件へ取り込む。**見出しを節の入れ子に分ける。** */
export function importMarkdown(id: string, location: string, fetched: string, text: string): Obj {
    const toJson = (n: Node): Obj => {
        const m: Obj = { title: n.title };
        const blocks = blocksOf(n.body);
        if (blocks.length > 0) m.blocks = blocks;
        if (n.children.length > 0) m.sections = n.children.map(toJson);
        return m;
    };
    const stack: Node[] = [{ title: '', level: 0, body: [], children: [] }];
    let fence = false;
    // **frontmatter は取り込まない** ── 原典の管理のための欄であって、本文ではない
    let body = text;
    if (text.startsWith('---\n')) {
        const rest = text.slice(4);
        const at = rest.indexOf('\n---\n');
        if (at >= 0) body = rest.slice(at + 5);
    }
    for (const line of lines(body)) {
        if (trimStart(line).startsWith('```')) fence = !fence;
        let hashes = 0;
        while (hashes < line.length && line[hashes] === '#') hashes++;
        const heading = !fence && hashes >= 1 && hashes <= 6 && line.slice(hashes).startsWith(' ');
        if (!heading) {
            stack[stack.length - 1].body.push(line);
            continue;
        }
        while (stack.length > 1 && stack[stack.length - 1].level >= hashes) {
            const done = stack.pop()!;
            stack[stack.length - 1].children.push(done);
        }
        stack.push({ title: trim(line.slice(hashes)), level: hashes, body: [], children: [] });
    }
    while (stack.length > 1) {
        const done = stack.pop()!;
        stack[stack.length - 1].children.push(done);
    }
    const root = stack.pop()!;
    const title = root.children.length > 0 ? root.children[0].title : id;
    const doc: Obj = {
        id,
        title,
        source: { location, sha256: sha256Hex(Buffer.from(text, 'utf8')), fetched }
    };
    doc.sections = root.children.map(toJson);
    const lead = blocksOf(root.body);
    if (lead.length > 0) doc.blocks = lead;
    return doc;
}

/** document の並びへ1件を置く。**同じ id が在れば置き換える。** */
export function putDocument(refs: string, doc: Obj): string {
    const path = join(refs, 'document.json');
    const all = isFile(path) ? readJson(path, true) : ({ $schema: 'document.schema.json', items: [] } as Json);
    const items = isObj(all) ? all.items : undefined;
    if (!Array.isArray(items)) throw new RefsError('document.json に items が無い');
    const id = doc.id ?? null;
    const kept = items.filter(x => !(isObj(x) && 'id' in x && same(x.id, id)));
    kept.push(doc);
    (all as Obj).items = kept;
    try {
        writeFileSync(path, JSON.stringify(all, null, 2) + '\n', 'utf8');
    } catch (e) {
        throw new RefsError(`${path} に書けない ── ${(e as Error).message}`);
    }
    return path;
}

/** SHA-256 を16進で返す。 */
export function sha256Hex(data: Uint8Array): string {
    return createHash('sha256').update(data).digest('hex');
}

// ── 描画 ────────────────────────────────────────────────────────────────

/** JSON の値として等しいか。 */
function same(a: Json | undefined, b: Json | undefined): boolean {
    if (a === undefined || b === undefined) return a === b;
    // **原文を保持した数は、数として比べる** ── スキーマの const は数で読んでいる
    if (RAW.isRawJSON(a)) a = JSON.parse(JSON.stringify(a)) as Json;
    if (RAW.isRawJSON(b)) b = JSON.parse(JSON.stringify(b)) as Json;
    if (Array.isArray(a) || Array.isArray(b)) {
        return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((x, i) => same(x, b[i]));
    }
    if (isObj(a) || isObj(b)) {
        if (!isObj(a) || !isObj(b)) return false;
        const ka = Object.keys(a);
        return ka.length === Object.keys(b).length && ka.every(k => k in b && same(a[k], b[k]));
    }
    return a === b;
}

const esc = (s: string) => s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

/** 値を文字列にする。**文字列はそのまま、null は空、それ以外は1行の JSON である。** */
function text(v: Json | undefined): string {
    if (typeof v === 'string') return v;
    if (v === null || v === undefined) return '';
    return JSON.stringify(v);
}

const at = (v: Json | undefined, key: string): Json | undefined => (isObj(v) && Object.hasOwn(v, key) ? v[key] : undefined);
const str = (v: Json | undefined, key: string): string | null => {
    const x = at(v, key);
    return typeof x === 'string' ? x : null;
};
const strOr = (v: Json | undefined, key: string, fallback: string) => str(v, key) ?? fallback;

/** JSON Pointer を解く。**無ければ undefined を返す。** */
function walk(root: Json | undefined, pointer: string): Json | undefined {
    if (pointer === '') return root;
    if (!pointer.startsWith('/')) return undefined;
    let cur = root;
    for (const raw of pointer.slice(1).split('/')) {
        const token = raw.replaceAll('~1', '/').replaceAll('~0', '~');
        if (isObj(cur)) {
            if (!Object.hasOwn(cur, token)) return undefined;
            cur = cur[token];
        } else if (Array.isArray(cur)) {
            if (!/^(0|[1-9][0-9]*)$/.test(token) || Number(token) >= cur.length) return undefined;
            cur = cur[Number(token)];
        } else return undefined;
    }
    return cur;
}

/** $ref（#/$defs/…）を解く。**スキーマの中だけを指す** ── 外を指す参照は解かない。 */
function resolve(schema: Json | undefined, root: Json): Json | undefined {
    const r = str(schema, '$ref');
    if (r === null || !r.startsWith('#')) return schema;
    const hit = walk(root, r.slice(1));
    return hit === undefined ? schema : hit;
}

/**
 * $ref の隣の語（title ・ x-view ・ description など）を、参照先に重ねる。**隣の語が参照先より優先する**
 * （JSON Schema 2020-12 では隣の語も効く）。隣の語の無い $ref は、そのまま残す。**深さで止める** ──
 * 自分を参照する定義でも、展開が終わる。
 */
function mergeRefs(v: Json, root: Json, depth: number): Json {
    if (Array.isArray(v)) return v.map(x => mergeRefs(x, root, depth));
    if (!isObj(v)) return v;
    const r = str(v, '$ref');
    if (r !== null && Object.keys(v).length > 1 && r.startsWith('#')) {
        const target = walk(root, r.slice(1));
        if (isObj(target) && depth < 8) {
            const merged = new Map(Object.entries(mergeRefs(target, root, depth + 1) as Obj));
            for (const [k, x] of Object.entries(v)) {
                if (k !== '$ref') merged.set(k, mergeRefs(x, root, depth));
            }
            return Object.fromEntries(merged);
        }
    }
    return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, mergeRefs(x, root, depth)]));
}

/** 節点と辺だけの図を、つながりの並びにする。**SVG の無い図でも、読み手が構造を確認できる。** */
function graphHtml(value: Json): string {
    const ns = at(value, 'nodes');
    const nodes = Array.isArray(ns) ? ns : [];
    const es = at(value, 'edges');
    const edges = Array.isArray(es) ? es : [];
    if (nodes.length === 0 && edges.length === 0) return '';
    const labelOf = (id: string) => str(nodes.find(n => str(n, 'id') === id), 'label') ?? id;
    let lis = '';
    for (const e of edges) {
        const notes: string[] = [];
        const l = str(e, 'label');
        if (l !== null && l !== '') notes.push(l);
        if (at(e, 'dashed') === true) notes.push('破線');
        const arrow = notes.length > 0 ? `→（${notes.join(' ・ ')}）→` : '→';
        // **辺の名前は矢印の上に置く** ── 節点名の後ろに置くと、節点名の括弧と区別できない
        lis += `<li>${esc(labelOf(str(e, 'from') ?? ''))} ${esc(arrow)} ${esc(labelOf(str(e, 'to') ?? ''))}</li>`;
    }
    for (const n of nodes) {
        const id = str(n, 'id') ?? '';
        if (!edges.some(e => str(e, 'from') === id || str(e, 'to') === id)) lis += `<li>${esc(strOr(n, 'label', id))}</li>`;
    }
    return `<ol class="graph">${lis}</ol>`;
}

function label(schema: Json | undefined, value: Json | undefined): string {
    const options = at(schema, 'oneOf');
    if (Array.isArray(options)) {
        const hit = options.find(o => isObj(o) && Object.hasOwn(o, 'const') && same(o.const, value));
        if (hit !== undefined) {
            const t = str(hit, 'title');
            if (t !== null) return t;
        }
    }
    return text(value);
}

function tag(schema: Json | undefined, value: Json | undefined): string {
    const neg = value === false || value === 'reject';
    return `<span class="${neg ? 'tag neg' : 'tag'}">${esc(label(schema, value))}</span>`;
}

function scalar(schema: Json | undefined): boolean {
    const t = str(schema, 'type');
    // **画面に出さない欄は、表にするかの判定を妨げない**（ACDR 0073）
    return str(schema, 'x-view') === 'hidden' || at(schema, 'oneOf') !== undefined || t === 'string' || t === 'number' || t === 'integer' || t === 'boolean';
}

function head(key: string, schema: Json | undefined, level: number): string {
    const h = Math.min(Math.max(level, 2), 3);
    const d = str(schema, 'description');
    const desc = d !== null ? `<p class="desc">${esc(d)}</p>` : '';
    return `<h${h}>${esc(strOr(schema, 'title', key))}</h${h}>${desc}`;
}

interface Ctx {
    root: Json;
    base: string;
}

const viewOf = (schema: Json | undefined) => str(schema, 'x-view') ?? '';

function props(schema: Json | undefined): Obj | null {
    const p = at(schema, 'properties');
    return isObj(p) ? p : null;
}

function cell(schema: Json | undefined, value: Json | undefined, ctx: Ctx): string {
    const s = resolve(schema, ctx.root);
    if (viewOf(s) === 'tag' || at(s, 'oneOf') !== undefined) return tag(s, value);
    return esc(text(value));
}

function inner(value: Json, schemaIn: Json | undefined, level: number, ctx: Ctx): string {
    const schema = resolve(schemaIn, ctx.root);
    if (isObj(value)) {
        const p = props(schema);
        let out = '';
        for (const key of p !== null ? Object.keys(p) : Object.keys(value)) {
            if (!Object.hasOwn(value, key)) continue;
            const sub = p !== null ? p[key] : undefined;
            if (viewOf(resolve(sub, ctx.root)) === 'hidden') continue;
            out += `<div class="nest">${head(key, resolve(sub, ctx.root), level)}${inner(value[key], sub, level + 1, ctx)}</div>`;
        }
        return out;
    }
    if (Array.isArray(value)) {
        const item = resolve(at(schema, 'items'), ctx.root);
        const p = props(item);
        if (p !== null && Object.values(p).every(s => scalar(resolve(s, ctx.root)))) {
            // **どの行も値を保持しない列は描かない** ── 空の列は、欠けがあるように読める
            const cols = Object.entries(p).filter(([k, s]) => value.some(v => at(v, k) !== undefined) && str(resolve(s, ctx.root), 'x-view') !== 'hidden');
            // **列が1つなら箇条書きにする** ── 1列の表は、見出しの升が中身を説明しない
            if (cols.length === 1) {
                const [k, s] = cols[0];
                const lis = value
                    .filter(v => at(v, k) !== undefined)
                    .map(v => `<li>${cell(s, at(v, k), ctx)}</li>`)
                    .join('');
                return `<ul>${lis}</ul>`;
            }
            const th = cols.map(([k, s]) => `<th>${esc(strOr(s, 'title', k))}</th>`).join('');
            const rows = value
                .map(v => `<tr>${cols.map(([k, s]) => `<td>${cell(s, at(v, k) ?? null, ctx)}</td>`).join('')}</tr>`)
                .join('');
            return `<div class="scroll"><table><thead><tr>${th}</tr></thead><tbody>${rows}</tbody></table></div>`;
        }
        if (p !== null) return value.map(v => `<div class="item">${inner(v, item, level + 1, ctx)}</div>`).join('');
        return `<ul>${value.map(v => `<li>${esc(text(v))}</li>`).join('')}</ul>`;
    }
    if (at(schema, 'oneOf') !== undefined || viewOf(schema) === 'tag') return tag(schema, value);
    const t = text(value);
    return t.includes('\n') ? `<pre>${esc(t)}</pre>` : `<p>${esc(t)}</p>`;
}

function readOrEmpty(path: string): string {
    try {
        return readFileSync(path, 'utf8');
    } catch {
        return '';
    }
}

/** SVG を埋め込む。**svg はファイル名（references からの経路）か、SVG そのもの。** */
const svgOf = (p: string, base: string) => (trimStart(p).startsWith('<svg') ? p : readOrEmpty(join(base, p)));

/** 論点の並びを描く ── **1件を1枚にし、heading の欄を題、lead の欄を主張にする。** */
function sections(schema: Json | undefined, value: Json, ctx: Ctx): string {
    const item = resolve(at(schema, 'items'), ctx.root);
    return (Array.isArray(value) ? value : []).map(v => `<section class="block topic">${fields(item, v, ctx)}</section>`).join('');
}

/** 欄を順に描く。**heading は題、lead は主張、hidden は描かない。** */
function fields(schema: Json | undefined, value: Json, ctx: Ctx): string {
    const p = props(schema);
    if (p === null) return inner(value, schema, 3, ctx);
    let out = '';
    for (const [k, s] of Object.entries(p)) {
        if (k === 'kind') continue;
        const v = at(value, k);
        if (v !== undefined) out += field(resolve(s, ctx.root), v, ctx);
    }
    return out;
}

/** 欄1つを描く。見出しを付けない ── 論点と単位の中では、形そのものが役割を示す。 */
function field(schema: Json | undefined, value: Json, ctx: Ctx): string {
    switch (viewOf(schema)) {
        case 'hidden':
            return '';
        case 'heading':
            return `<h2>${esc(text(value))}</h2>`;
        case 'lead':
            return `<p class="claim">${esc(text(value))}</p>`;
        case 'subhead':
            return `<h3>${esc(text(value))}</h3>`;
        case 'paras':
            // **段落の並びは、段落ごとに描く** ── 1つの文字列へ連結すると、原文の段落の切れ目が消える
            return (Array.isArray(value) ? value : []).map(p => `<p>${esc(text(p))}</p>`).join('');
        case 'svg':
            return `<figure>${svgOf(typeof value === 'string' ? value : '', ctx.base)}</figure>`;
        case 'code':
            return `<pre class="code">${esc(text(value))}</pre>`;
        case 'units':
            return units(schema, value, ctx);
        case 'blocks':
            return blocks(value, ctx.base);
        case 'steps':
            return steps(schema, value, ctx);
        case 'table': {
            const t: Obj = isObj(value) ? { ...value } : {};
            t.kind = 'table';
            return blocks([t], ctx.base);
        }
        default:
            return inner(value, schema, 4, ctx);
    }
}

/** 単位の並びを描く。**形は kind の値で、items.oneOf から選ぶ** ── 形の title を札にする。 */
function units(schema: Json | undefined, value: Json, ctx: Ctx): string {
    const options = at(resolve(at(schema, 'items'), ctx.root), 'oneOf');
    const forms = Array.isArray(options) ? options.map(f => resolve(f, ctx.root)) : [];
    return (Array.isArray(value) ? value : [])
        .map(u => {
            const want = at(u, 'kind');
            const form = forms.find(f => {
                const have = walk(f, '/properties/kind/const');
                return have === undefined || want === undefined ? have === want : same(have, want);
            });
            const t = str(form, 'title');
            const lab = t !== null ? `<span class="ulabel">${esc(t)}</span>` : '';
            return `<div class="unit">${lab}${fields(form ?? null, u, ctx)}</div>`;
        })
        .join('');
}

/** 手順を番号付きで描く。**各段の1つ目の欄を太字にし、残りを添える。** */
function steps(schema: Json | undefined, value: Json, ctx: Ctx): string {
    const p = props(resolve(at(schema, 'items'), ctx.root));
    const keys = p !== null ? Object.keys(p) : [];
    const lis = (Array.isArray(value) ? value : [])
        .map(v => {
            const parts = keys.map(k => at(v, k)).filter(x => x !== undefined);
            const lead = parts.length > 0 ? `<p class="lead">${esc(text(parts[0]))}</p>` : '';
            const rest = parts
                .slice(1)
                .map(x => `<p class="sub">${esc(text(x))}</p>`)
                .join('');
            return `<li>${lead}${rest}</li>`;
        })
        .join('');
    return `<ol class="steps">${lis}</ol>`;
}

/** 本文の塊を描く ── 段落 ・ 一覧 ・ 表 ・ コード ・ 図。**図は SVG をそのまま埋め込む。** */
function blocks(list: Json | undefined, base: string): string {
    return (Array.isArray(list) ? list : [])
        .map(b => {
            switch (str(b, 'kind')) {
                case 'list': {
                    const t = at(b, 'ordered') === true ? 'ol' : 'ul';
                    const items = at(b, 'items');
                    const lis = (Array.isArray(items) ? items : []).map(x => `<li>${esc(text(x))}</li>`).join('');
                    return `<${t}>${lis}</${t}>`;
                }
                case 'table': {
                    const row = (r: Json | undefined, t: string) => (Array.isArray(r) ? r : []).map(c => `<${t}>${esc(text(c))}</${t}>`).join('');
                    const h = at(b, 'head');
                    const th = h !== undefined ? row(h, 'th') : '';
                    const rows = at(b, 'rows');
                    const trs = (Array.isArray(rows) ? rows : []).map(r => `<tr>${row(r, 'td')}</tr>`).join('');
                    return `<div class="scroll"><table><thead><tr>${th}</tr></thead><tbody>${trs}</tbody></table></div>`;
                }
                case 'figure': {
                    const p = str(b, 'svg');
                    const svg = p !== null ? svgOf(p, base) : '';
                    const c = str(b, 'caption');
                    return `<figure>${svg}${c !== null ? `<figcaption>${esc(c)}</figcaption>` : ''}</figure>`;
                }
                case 'code':
                    return `<pre class="code">${esc(str(b, 'text') ?? '')}</pre>`;
                default:
                    return `<p>${esc(str(b, 'text') ?? '')}</p>`;
            }
        })
        .join('');
}

/** 節の入れ子を、見出しと本文の字下げで組む。**欄の名前（見出し ・ 本文）は表示しない。** */
function outline(items: Json | undefined, level: number, base: string): string {
    const h = Math.min(Math.max(level + 1, 3), 6);
    return (Array.isArray(items) ? items : [])
        .map(n => {
            const b = at(n, 'blocks');
            const k = at(n, 'sections');
            const body = b !== undefined ? blocks(b, base) : '';
            const kids = k !== undefined ? outline(k, level + 1, base) : '';
            return `<div class="nest"><h${h}>${esc(str(n, 'title') ?? '')}</h${h}>${body}${kids}</div>`;
        })
        .join('');
}

function block(key: string, schemaIn: Json | undefined, value: Json, ctx: Ctx): string {
    const schema = resolve(schemaIn, ctx.root);
    const hd = head(key, schema, 2);
    switch (viewOf(schema)) {
        case 'hidden':
            return '';
        case 'outline':
            return `<section class="block">${hd}${outline(value, 2, ctx.base)}</section>`;
        case 'blocks':
            return `<section class="block">${hd}${blocks(value, ctx.base)}</section>`;
        case 'sections':
            return sections(schema, value, ctx);
        case 'group':
            // **導入の文と表を1枚にまとめる** ── 分けると、導入の文が別の論点に属すように読める
            return `<section class="block">${hd}${fields(schema, value, ctx)}</section>`;
        case 'card': {
            const title = esc(strOr(schema, 'title', key));
            if (typeof value === 'string') {
                return `<section class="card"><div class="cardhead"><h2>${title}</h2></div><p class="lead">${esc(text(value))}</p></section>`;
            }
            let tags = '';
            const ls: string[] = [];
            for (const [k, p] of Object.entries(props(schema) ?? {})) {
                const v = at(value, k);
                if (v === undefined) continue;
                if (viewOf(p) === 'tag') tags += tag(p, v);
                else ls.push(esc(text(v)));
            }
            const body = ls.map((l, i) => `<p class="${i === 0 ? 'lead' : 'sub'}">${l}</p>`).join('');
            return `<section class="card"><div class="cardhead"><h2>${title}</h2>${tags}</div>${body}</section>`;
        }
        case 'figure': {
            // **svg は、ファイル名か、SVG そのもの** ── 呼ぶ側が読み込み済みなら、そのまま埋め込む
            const p = str(value, 'svg');
            const file = p !== null ? svgOf(p, ctx.base) : '';
            // **SVG が無ければ、節点と辺の宣言を描く**
            const svg = file !== '' ? file : graphHtml(value);
            return `<section class="block">${hd}<figure><figcaption>${esc(str(value, 'caption') ?? '')}</figcaption>${svg}</figure></section>`;
        }
        case 'steps':
            return `<section class="block">${hd}${steps(schema, value, ctx)}</section>`;
        default:
            return `<section class="block">${hd}${inner(value, schema, 3, ctx)}</section>`;
    }
}

/** 1件を描画する。**x-view が heading の欄を h1、トップの tag の欄を見出しの上の札にする。** */
function pageBody(schemaIn: Json | undefined, value: Json, ctx: Ctx): string {
    const schema = resolve(schemaIn, ctx.root);
    const p = props(schema);
    if (p === null) return inner(value, schema, 2, ctx);
    const eyebrow = [esc(str(ctx.root, 'title') ?? '')];
    let h1 = '';
    let body = '';
    for (const [k, raw] of Object.entries(p)) {
        const s = resolve(raw, ctx.root);
        const v = at(value, k);
        if (v === undefined) continue;
        switch (viewOf(s)) {
            case 'tag':
                eyebrow.push(tag(s, v));
                break;
            case 'meta': {
                const t = text(v);
                if (t !== '') eyebrow.push(esc(t));
                break;
            }
            case 'heading':
                h1 = esc(text(v));
                break;
            default:
                body += block(k, s, v, ctx);
        }
    }
    const lead = h1 !== '' ? h1 : esc(str(value, 'title') ?? '');
    return `<header><p class="eyebrow">${eyebrow.join(' ・ ')}</p><h1>${lead}</h1></header>${body}`;
}

/** 見た目の正本の複製が無いときの理由。 */
function missing(name: string): string {
    return `references/${name} が無い ── 見た目の正本の複製である。Skill を生んだ道具が置く（その道具の check が正本との差を報告する）`;
}

/** 明と暗の色の変数を組む。**共通のパレットの後ろに Skill 固有のトークンを足し、鍵の順に並べる。** */
function paletteVars(refs: string): [string, string] {
    let tokens: Json;
    try {
        tokens = readJson(join(refs, VIEW_TOKENS));
    } catch {
        throw new RefsError(missing(VIEW_TOKENS));
    }
    const name = at(tokens, 'palette');
    if (typeof name !== 'string') throw new RefsError(`${VIEW_TOKENS}: palette が無い`);
    const chosen = at(at(tokens, 'palettes'), name);
    if (chosen === undefined) throw new RefsError(`${VIEW_TOKENS}: palettes に ${name} が無い`);
    let skill: Json | undefined;
    try {
        skill = readJson(join(refs, SKILL_TOKENS));
    } catch {
        skill = undefined;
    }
    const out: string[] = [];
    for (const scheme of ['light', 'dark']) {
        const decl = new Map<string, string>();
        for (const source of [chosen, skill]) {
            const part = at(source, scheme);
            if (!isObj(part)) continue;
            for (const [k, v] of Object.entries(part)) {
                if (typeof v === 'string') decl.set(k, v);
            }
        }
        const keys = [...decl.keys()].sort(byBytes);
        out.push(keys.map(k => `--${k}:${decl.get(k)};`).join(''));
    }
    return [out[0], out[1]];
}

/** 色の変数を selector に定め、共通と Skill 固有の規則を続ける。 */
function styleFor(refs: string, selector: string): string {
    const [light, dark] = paletteVars(refs);
    let css: string;
    try {
        css = readFileSync(join(refs, VIEW_CSS), 'utf8');
    } catch {
        throw new RefsError(missing(VIEW_CSS));
    }
    let own: string;
    try {
        own = readFileSync(join(refs, SKILL_CSS), 'utf8');
    } catch {
        own = '';
    }
    return `${selector}{${light}}@media (prefers-color-scheme:dark){${selector}{${dark}}}${css}${own}`;
}

/**
 * .rv の囲みの中だけに適用される規則と色。**他の型の頁に埋め込むときに使う** ── 色の変数も .rv に定めるので、
 * 埋め込む側の :root の変数を上書きしない。複製が無いか読めないときは RefsError を投げる。
 */
export const scopedStyle = (refs: string): string => styleFor(refs, '.rv');

/** 1件の本文を組む（.rv の囲みを含む）。**他の型の頁に埋め込むときに使う。** */
export function renderBody(schemaIn: Json, value: Json, base: string): string {
    const schema = mergeRefs(schemaIn, schemaIn, 0);
    return `<div class="rv">${pageBody(schema, value, { root: schema, base })}</div>`;
}

/** 種類の JSON（か、その id の1件か、渡された JSON）を HTML にする。 */
export function view(refs: string, kind: string, id?: string, file?: string): string {
    const read = readJson(join(refs, `${kind}${SCHEMA_TAIL}`));
    // **$ref の隣の語を、参照先に重ねてから描く**
    const root = mergeRefs(read, read, 0);
    const value = file !== undefined ? readJson(file, true) : get(refs, kind);
    const ctx: Ctx = { root, base: file !== undefined ? dirname(file) : refs };
    let body: string;
    if (id !== undefined) {
        let one: Json | undefined;
        if (file !== undefined) {
            const items = at(value, 'items') ?? value;
            one = Array.isArray(items) ? items.find(x => str(x, 'id') === id) : undefined;
            if (one === undefined) throw new RefsError(`id ${id} の項目が無い`);
        } else {
            one = get(refs, kind, id);
        }
        const top = resolve(root, root);
        const itemSchema = walk(top, '/properties/items/items') ?? at(top, 'items') ?? null;
        body = pageBody(itemSchema, one, ctx);
    } else {
        let plain = value;
        if (isObj(plain)) {
            const { $schema: _, ...rest } = plain;
            plain = rest;
        }
        // **項目の並びだけを持つ種類は、1件ずつの頁を並べる** ── 全体を1つの値として描くと、
        // 項目の中の欄（units など）が見せ方を失い、JSON の文字列のまま並ぶ
        const itemSchema = walk(resolve(root, root), '/properties/items/items');
        const list = at(plain, 'items');
        if (isObj(plain) && Object.keys(plain).length === 1 && Array.isArray(list) && itemSchema !== undefined) {
            body = list.map(it => `<section class="entry">${pageBody(itemSchema, it, ctx)}</section>`).join('');
        } else {
            body = pageBody(root, plain, ctx);
        }
    }
    let tpl: string;
    try {
        tpl = readFileSync(join(refs, VIEW_TEMPLATE), 'utf8');
    } catch {
        throw new RefsError(missing(VIEW_TEMPLATE));
    }
    const title = esc(strOr(root, 'title', kind));
    const style = styleFor(refs, ':root');
    // **置き換えは関数で渡す** ── 文字列で渡すと、$& などが置換の記法として解釈される
    return tpl.replaceAll('{{title}}', () => title).replaceAll('{{style}}', () => style).replaceAll('{{body}}', () => body);
}
