/**
 * {{Skill名}} のプレゼンテーション層（CLI）。シェルから呼ぶ唯一の経路である。
 *
 * **道具ごとに実行ファイルを作らない** ── 実行ファイルが増えると、呼ぶ側が形を推測することになる。
 */

import { catalog, exitCode, Given, type Outcome, type Tool } from './contract.ts';
import { tools } from './tools.ts';

function readArgs(tool: Tool, rest: string[]): Given {
    const given = new Given();
    const positional: string[] = [];
    for (let i = 0; i < rest.length; i++) {
        const a = rest[i];
        if (!a.startsWith('--')) {
            positional.push(a);
            continue;
        }
        const body = a.slice(2);
        let key: string;
        let value: string;
        const eq = body.indexOf('=');
        if (eq >= 0) {
            key = body.slice(0, eq);
            value = body.slice(eq + 1);
        } else if (i + 1 < rest.length && !rest[i + 1].startsWith('--')) {
            key = body;
            value = rest[++i];
        } else {
            key = body;
            value = '1';
        }
        key = key.replaceAll('-', '_');
        // **道具の一覧に無い旗は断る。** 黙って無視すると、打ち間違いが検出されない
        if (!tool.args.some(x => x.name === key)) {
            const known = tool.args.map(x => x.name).join(' ・ ');
            throw new Error(`その旗は無い: --${key}（${tool.name} は ${known} を受ける）`);
        }
        given.push(key, value);
    }
    let next = 0;
    for (const arg of tool.args) {
        if (given.has(arg.name)) continue;
        if (arg.many) {
            for (; next < positional.length; next++) given.push(arg.name, positional[next]);
            continue;
        }
        if (next < positional.length) given.push(arg.name, positional[next++]);
        else if (arg.default !== undefined) given.push(arg.name, arg.default);
    }
    return given;
}

function usage(all: Tool[]): void {
    const lines = ['道具の一覧'];
    for (const t of all) {
        const need = t.args
            .map(a => (a.many ? `<${a.name}…>` : a.required ? `<${a.name}>` : `[${a.name}]`))
            .join(' ');
        lines.push(`  ${t.name} ${need}`, `      ${t.summary}`);
    }
    lines.push('', '  どれも --json を付けると、機械が読む形で出る');
    process.stdout.write(lines.join('\n') + '\n');
}

function emit(out: Outcome, asJson: boolean, human: (out: Outcome) => string): number {
    process.stdout.write((asJson ? JSON.stringify(out, null, 2) : human(out)) + '\n');
    return exitCode(out);
}

/**
 * 動詞の前に置いた旗（`--名前 値`）を、引数の末尾へ移す。**旗の位置で失敗させない** ──
 * `--skill_root <場所> get …` の順でも、`get … --skill_root <場所>` と同じに読む。
 */
function verbFirst(argv: string[]): string[] {
    const lead: string[] = [];
    let i = 0;
    while (i < argv.length && argv[i].startsWith('--')) {
        lead.push(argv[i++]);
        if (i < argv.length && !argv[i].startsWith('--')) lead.push(argv[i++]);
    }
    return [...argv.slice(i), ...lead];
}

function main(): number {
    const all = tools();
    const asJson = process.argv.includes('--json');
    const argv = verbFirst(process.argv.slice(2).filter(a => a !== '--json'));
    if (argv.length === 0) {
        if (asJson) return emit(catalog(all, new Given()), true, () => '');
        usage(all);
        return 2;
    }
    const [verb, ...rest] = argv;
    if (verb === '-h' || verb === '--help' || verb === 'help') {
        usage(all);
        return 0;
    }
    const tool = all.find(t => t.name === verb);
    if (!tool) {
        process.stderr.write(`その動詞は無い: ${verb} ── 一覧は help である\n`);
        return 2;
    }
    let given: Given;
    try {
        given = readArgs(tool, rest);
    } catch (why) {
        process.stderr.write(`${(why as Error).message}\n`);
        return 2;
    }
    const missing = tool.args.find(a => a.required && !given.has(a.name));
    if (missing) {
        process.stderr.write(`引数が足りない: ${tool.name} は ${missing.name} を要する\n`);
        return 2;
    }
    return emit(tool.run(given), asJson, tool.human);
}

process.exitCode = main();
