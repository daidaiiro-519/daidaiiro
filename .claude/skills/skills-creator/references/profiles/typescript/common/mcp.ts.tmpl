/**
 * {{Skill名}} の MCP の面（プレゼンテーション層）。**同じ道具の一覧から組む** ── 能力は1行も複製しない。
 *
 * MCP の公式 TypeScript SDK（v2）の低水準の Server を使い、道具をその場で宣言する registerTool を使わない。
 * **標準出力へ書かない** ── 標準出力は JSON-RPC の通信路である。
 *
 * **`ok` が偽なら `isError` を立てる。** 道具の実行の誤りは結果で返し、呼び方の誤り（無い道具 ・
 * 足りない引数）は、引数が不正（InvalidParams）として返す ── Rust の組と同じ分け方である。
 */

import { ProtocolError, ProtocolErrorCode, Server } from '@modelcontextprotocol/server';
import { serveStdio } from '@modelcontextprotocol/server/stdio';

import { Given, type Tool } from './contract.ts';
import { tools } from './tools.ts';

/** 引数1つの入力の形。**interface にしない** ── SDK の型は JSON の値の索引を要し、interface はそれを満たさない。 */
type Property = {
    type: string;
    description: string;
    items?: { type: string };
};

/** 道具の一覧から、入力の形を組む。**引数を1つずつ公開する。** */
function inputSchema(tool: Tool) {
    const properties: Record<string, Property> = {};
    for (const a of tool.args) {
        properties[a.name] = a.many
            ? { type: 'array', items: { type: 'string' }, description: a.summary }
            : { type: 'string', description: a.summary };
    }
    return {
        type: 'object' as const,
        properties,
        required: tool.args.filter(a => a.required).map(a => a.name)
    };
}

function build(): Server {
    const server = new Server({ name: '{{Skill名}}', version: '0.1.0' }, { capabilities: { tools: {} } });
    server.setRequestHandler('tools/list', async () => ({
        tools: tools().map(t => ({ name: t.name, description: t.summary, inputSchema: inputSchema(t) }))
    }));
    server.setRequestHandler('tools/call', async request => {
        const tool = tools().find(t => t.name === request.params.name);
        if (!tool) {
            throw new ProtocolError(ProtocolErrorCode.InvalidParams, `その道具は無い: ${request.params.name}`);
        }
        const given = new Given();
        for (const [key, value] of Object.entries(request.params.arguments ?? {})) {
            // **型は緩く受ける** ── 数を文字列で包むことを強制しない。まとめて受ける引数は配列も受ける
            for (const item of Array.isArray(value) ? value : [value]) {
                given.push(key, typeof item === 'string' ? item : JSON.stringify(item));
            }
        }
        for (const a of tool.args) {
            if (given.has(a.name)) continue;
            if (a.default !== undefined) given.push(a.name, a.default);
            else if (a.required) {
                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `引数が足りない: ${tool.name} は ${a.name} を要する`);
            }
        }
        const out = tool.run(given);
        return {
            content: [{ type: 'text' as const, text: JSON.stringify(out) }],
            structuredContent: { ...out },
            isError: !out.ok
        };
    });
    return server;
}

serveStdio(() => build());
