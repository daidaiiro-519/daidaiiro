/**
 * references の道具を、道具の一覧に載せる。**どの Skill も同じ4つを持つ** ── 取り出す ・ 検査する ・
 * 描画する ・ 取り込む（ACDR 0043）。実体は refs.ts が持つ。**どの Skill も同じファイルを複製して使う。**
 */

import { join } from 'node:path';

import { found, type Given, misuse, need, opt, type Outcome, type Tool } from './contract.ts';
import * as refs from './refs.ts';

const refsDir = (given: Given) => join(given.skillRoot(), 'references');
const optional = (given: Given, name: string) => given.one(name, '') || undefined;

/** 読めない ・ 無いを、誤用として返す。 */
function guard(run: (given: Given) => Outcome): (given: Given) => Outcome {
    return given => {
        try {
            return run(given);
        } catch (why) {
            return misuse((why as Error).message);
        }
    };
}

const runGet = guard(given => {
    const got = refs.get(refsDir(given), given.one('kind', ''), optional(given, 'id'));
    // **除く欄を渡すと、入れ子のすべてから除いて返す**（例：omit=source）
    return found([], refs.omit(got, refs.omitKeys(optional(given, 'omit'))));
});

const runValidate = guard(given => {
    const d = refsDir(given);
    const file = optional(given, 'file');
    const hits = file !== undefined ? refs.validateFile(d, given.one('kind', ''), file) : refs.validate(d);
    // **何を検査したかを返す** ── 種類の一覧だけを返すと、合格したのか、検査が実行されなかったのかを
    // 読み手が区別できない（実測 2026-10-01、試しの相談3件とも）
    return found(hits, { kinds: refs.kinds(d).map(k => k.name), checked: file ?? 'references' });
});

const runView = guard(given => {
    const d = refsDir(given);
    const html = refs.view(d, given.one('kind', ''), optional(given, 'id'), optional(given, 'file'));
    const out = optional(given, 'out');
    if (out === undefined) return found([], { html });
    refs.save(out, html);
    return found([], { out, bytes: Buffer.byteLength(html, 'utf8') });
});

const runImport = guard(given => {
    const d = refsDir(given);
    const file = given.one('file', '');
    const doc = refs.importMarkdown(given.one('id', ''), given.one('source', file), given.one('fetched', ''), refs.readText(file));
    const path = refs.putDocument(d, doc);
    return found(refs.validate(d), { path });
});

function human(out: Outcome): string {
    if (!out.ok || out.findings.length > 0) return out.findings.map(x => `  ×  ${x}`).join('\n');
    const html = (out.data as { html?: unknown } | null)?.html;
    if (typeof html === 'string') return html;
    return JSON.stringify(out.data, null, 2);
}

function humanValidate(out: Outcome): string {
    if (!out.ok || out.findings.length > 0) return human(out);
    const checked = (out.data as { checked?: unknown } | null)?.checked;
    return `合格 ── ${typeof checked === 'string' ? checked : 'references'} に検出は無い`;
}

/** references の4つの道具。**道具の一覧（tools.ts）がこれを足す。** */
export function refsTools(): Tool[] {
    const root = () => opt('skill_root', 'この Skill の置き場所（既定は、SKILL.md の在る上のフォルダ）');
    return [
        {
            name: 'get',
            summary: 'references の種類の JSON を取り出す。id を渡すと、その1件だけを返す',
            args: [need('kind', '種類の名前'), opt('id', '項目の id'), opt('omit', '除く欄の名前（, で区切る。例：source）'), root()],
            run: runGet,
            human
        },
        {
            name: 'validate',
            summary: 'references の JSON を、指しているスキーマで検査する。file を渡すと、その JSON を種類のスキーマで検査する',
            args: [opt('kind', '種類の名前（file と一緒に渡す）'), opt('file', '検査する JSON'), root()],
            run: runValidate,
            human: humanValidate
        },
        {
            name: 'view',
            summary: 'references の種類の JSON を、スキーマの title と x-view に従って HTML に描画する',
            args: [need('kind', '種類の名前'), opt('id', '項目の id'), opt('file', '描画する JSON（回答など）'), opt('out', 'HTML の置き場所'), root()],
            run: runView,
            human
        },
        {
            name: 'import',
            summary: 'Markdown の文書を、見出しを節の入れ子に分けて document へ取り込む',
            args: [need('file', '取り込む Markdown'), need('id', 'document の id'), opt('source', '元の場所（既定は file）'), opt('fetched', '取り込んだ日'), root()],
            run: runImport,
            human
        }
    ];
}
