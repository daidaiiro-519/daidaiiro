{
  "$comment": "言語の組の定義（ACDR 0062）。Python の組は契約の版1 で、作業型だけを持つ。from は profiles/python/ からの相対。依存は uv が揃える",
  "name": "python",
  "detect": "tool/pyproject.toml",
  "contract": 1,
  "common": [
    {
      "from": "common/pyproject.toml.tmpl",
      "to": "tool/pyproject.toml"
    },
    {
      "from": "common/package.init.py.tmpl",
      "to": "tool/{{パッケージ名}}/__init__.py"
    },
    {
      "from": "common/contract.py.tmpl",
      "to": "tool/{{パッケージ名}}/contract.py"
    },
    {
      "from": "common/cli.py.tmpl",
      "to": "tool/cli.py"
    },
    {
      "from": "common/mcp_server.py.tmpl",
      "to": "tool/mcp_server.py"
    },
    {
      "from": "common/tool.json.tmpl",
      "to": "tool.json"
    },
    {
      "from": "common/mcp.json.tmpl",
      "to": "mcp.json"
    },
    {
      "from": "common/gitignore.tmpl",
      "to": ".gitignore"
    }
  ],
  "types": {
    "work": [
      {
        "from": "types/work/tools.py.tmpl",
        "to": "tool/{{パッケージ名}}/tools.py"
      },
      {
        "from": "types/work/hello.py.tmpl",
        "to": "tool/{{パッケージ名}}/hello.py"
      },
      {
        "from": "types/work/test_hello.py.tmpl",
        "to": "tool/tests/test_hello.py"
      }
    ]
  },
  "parts": {},
  "build": [
    "uv sync --quiet --project tool"
  ],
  "test": [
    "uv",
    "run",
    "--quiet",
    "--project",
    "tool",
    "python",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tool/tests"
  ],
  "sources": {
    "extensions": [
      ".py"
    ],
    "skip": [
      ".venv",
      "__pycache__",
      "tests"
    ]
  },
  "spawn": [
    "subprocess.run(",
    "subprocess.Popen(",
    "subprocess.call(",
    "subprocess.check_call(",
    "subprocess.check_output(",
    "os.system("
  ],
  "dist": false,
  "layout": false
}
