{
  "$comment": "言語の組の定義（ACDR 0064）。C# の組は契約の版1 で、作業型だけを持つ。from は profiles/csharp/ からの相対。組み立てた dll を dotnet で起動する",
  "name": "csharp",
  "detect": "tool/Directory.Build.props",
  "contract": 1,
  "common": [
    {"from": "common/Directory.Build.props.tmpl", "to": "tool/Directory.Build.props"},
    {"from": "common/Skill.csproj.tmpl", "to": "tool/Skill/Skill.csproj"},
    {"from": "common/Contract.cs.tmpl", "to": "tool/Skill/Contract.cs"},
    {"from": "common/Cli.csproj.tmpl", "to": "tool/Cli/Cli.csproj"},
    {"from": "common/Cli.Program.cs.tmpl", "to": "tool/Cli/Program.cs"},
    {"from": "common/Mcp.csproj.tmpl", "to": "tool/Mcp/Mcp.csproj"},
    {"from": "common/Mcp.Program.cs.tmpl", "to": "tool/Mcp/Program.cs"},
    {"from": "common/tool.json.tmpl", "to": "tool.json"},
    {"from": "common/mcp.json.tmpl", "to": "mcp.json"},
    {"from": "common/gitignore.tmpl", "to": ".gitignore"}
  ],
  "types": {
    "work": [
      {"from": "types/work/Tools.cs.tmpl", "to": "tool/Skill/Tools.cs"},
      {"from": "types/work/Hello.cs.tmpl", "to": "tool/Skill/Hello.cs"},
      {"from": "types/work/Tests.csproj.tmpl", "to": "tool/Tests/Tests.csproj"},
      {"from": "types/work/HelloTests.cs.tmpl", "to": "tool/Tests/HelloTests.cs"}
    ]
  },
  "parts": {},
  "build": [
    "dotnet build tool/Cli -c Release -o tool/bin/cli",
    "dotnet build tool/Mcp -c Release -o tool/bin/mcp"
  ],
  "test": [
    "dotnet",
    "test",
    "tool/Tests"
  ],
  "sources": {
    "extensions": [".cs"],
    "skip": ["bin", "obj", "Tests"]
  },
  "spawn": [
    "Process.Start(",
    "new ProcessStartInfo(",
    "FileName = "
  ],
  "dist": false,
  "layout": false
}
