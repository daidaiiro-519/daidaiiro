[project]
name = "{{パッケージ名}}"
version = "0.1.0"
description = "{{Skill名}} の道具"
requires-python = ">=3.10"
# **MCP の公式 SDK は v2 である**（2.x の低水準の Server を使う）。v3 が出たら、移行を確かめてから上げる
dependencies = ["mcp>=2.2,<3"]

# 組み立ての仕組み（build-system）を置かない ── uv はプロジェクト自身を入れず、依存だけを揃える。
# 入口（cli.py ・ mcp_server.py）は tool/ に在り、同じフォルダのパッケージを読み込む
