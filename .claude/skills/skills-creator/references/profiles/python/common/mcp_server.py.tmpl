"""{{Skill名}} の MCP の面（プレゼンテーション層）。**同じ道具の一覧から組む** ── 能力は1行も複製しない。

MCP の公式 Python SDK（v2）の低水準の Server を使い、道具をその場で宣言するデコレータを使わない。
stdio で配るあいだ、SDK が標準出力を標準エラーへ向け直す ── 道具の印字が通信へ混ざらない。

**`ok` が偽なら `is_error` を立てる。** 道具の実行の誤りは結果で返し、呼び方の誤り（無い道具 ・
足りない引数）は、引数が不正（INVALID_PARAMS）として返す ── Rust の組と同じ分け方である。
"""

from __future__ import annotations

import asyncio
import json

import mcp.server.stdio
from mcp.server import Server, ServerRequestContext
from mcp.shared.exceptions import MCPError
from mcp.types import (
    INVALID_PARAMS,
    CallToolRequestParams,
    CallToolResult,
    ListToolsResult,
    PaginatedRequestParams,
    TextContent,
)
from mcp.types import Tool as McpTool

from {{パッケージ名}}.contract import Given, Tool
from {{パッケージ名}}.tools import tools


def input_schema(tool: Tool) -> dict:
    """道具の一覧から、入力の形を組む。**引数を1つずつ公開する。**"""
    properties = {}
    for a in tool.args:
        if a.many:
            properties[a.name] = {"type": "array", "items": {"type": "string"}, "description": a.summary}
        else:
            properties[a.name] = {"type": "string", "description": a.summary}
    return {
        "type": "object",
        "properties": properties,
        "required": [a.name for a in tool.args if a.required],
    }


async def list_tools(ctx: ServerRequestContext, params: PaginatedRequestParams | None) -> ListToolsResult:
    return ListToolsResult(
        tools=[McpTool(name=t.name, description=t.summary, input_schema=input_schema(t)) for t in tools()]
    )


async def call_tool(ctx: ServerRequestContext, params: CallToolRequestParams) -> CallToolResult:
    tool = next((t for t in tools() if t.name == params.name), None)
    if tool is None:
        raise MCPError(INVALID_PARAMS, f"その道具は無い: {params.name}")
    given = Given()
    for key, value in (params.arguments or {}).items():
        # **型は緩く受ける** ── 数を文字列で包むことを強制しない。まとめて受ける引数は配列も受ける
        items = value if isinstance(value, list) else [value]
        for item in items:
            given.push(key, item if isinstance(item, str) else json.dumps(item, ensure_ascii=False))
    for a in tool.args:
        if not given.has(a.name):
            if a.default is not None:
                given.push(a.name, a.default)
            elif a.required:
                raise MCPError(INVALID_PARAMS, f"引数が足りない: {tool.name} は {a.name} を要する")
    out = tool.run(given)
    body = out.to_json()
    # **予期した失敗は、道具の結果として返す** ── ok が偽なら is_error を立てる
    return CallToolResult(
        content=[TextContent(type="text", text=json.dumps(body, ensure_ascii=False))],
        structured_content=body,
        is_error=not out.ok,
    )


async def main() -> None:
    server = Server("{{Skill名}}", on_list_tools=list_tools, on_call_tool=call_tool)
    async with mcp.server.stdio.stdio_server() as (read_stream, write_stream):
        await server.run(read_stream, write_stream, server.create_initialization_options())


if __name__ == "__main__":
    asyncio.run(main())
