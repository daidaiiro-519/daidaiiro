"""{{Skill名}} の references を事例で検証する。**助言型の雛形の事例5件である**（ACDR 0061）。
判断基準の件数や題に依存しない ── 全件に同じ性質を確かめる。
"""

import json
import sys
import tempfile
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from {{パッケージ名}} import refs  # noqa: E402

REFERENCES = Path(__file__).resolve().parents[2] / "references"
FIXTURES = Path(__file__).resolve().parent / "fixtures"


def _answer(body: dict) -> Path:
    fd = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8")
    with fd:
        json.dump(body, fd, ensure_ascii=False)
    return Path(fd.name)


class ReferencesTest(unittest.TestCase):
    def test_the_references_match_their_schemas(self) -> None:
        self.assertEqual(refs.validate(REFERENCES), [])

    def test_every_criterion_is_taken_by_its_id(self) -> None:
        # **判断基準は1件ずつ取り出せる** ── 回答の前に読む手順が、この取り出しに頼る
        for item in refs.get(REFERENCES, "criteria")["items"]:
            self.assertEqual(refs.get(REFERENCES, "criteria", item["id"])["id"], item["id"])

    def test_the_answer_example_passes_the_answer_schema(self) -> None:
        self.assertEqual(refs.validate_file(REFERENCES, "answer", FIXTURES / "answer.example.json"), [])

    def test_a_concept_answer_needs_its_definition(self) -> None:
        # **概念相談は、定義と具体例を欠くと合格しない**
        fx = _answer({"kind": "concept", "question": "それは何か",
                      "conclusion": {"stance": "adopt", "headline": "こうである"},
                      "grounds": [{"criterion": "x", "quote": "x"}], "next": ["読む"]})
        found = refs.validate_file(REFERENCES, "answer", fx)
        self.assertTrue(any("definition" in f for f in found), found)

    def test_a_design_answer_needs_its_steps(self) -> None:
        # **設計相談は、設計の手順を欠くと合格しない**
        fx = _answer({"kind": "design", "question": "どう組み立てるか",
                      "conclusion": {"stance": "adopt", "headline": "こう組む"},
                      "grounds": [{"criterion": "x", "quote": "x"}], "next": ["組む"]})
        found = refs.validate_file(REFERENCES, "answer", fx)
        self.assertTrue(any("steps" in f for f in found), found)


if __name__ == "__main__":
    unittest.main()
