"""見本の道具（hello）を事例で検証する。道具を書き換えたら、事例も書き換える。"""

import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from {{パッケージ名}}.hello import greet  # noqa: E402


class HelloTest(unittest.TestCase):
    def test_greets_by_name(self) -> None:
        # **1つの事例が1つの判定を固定する。** まとめると、どれが壊れたか分からない
        self.assertEqual(greet("世界"), "こんにちは、世界", "名前を差し込んだ文を返す")


if __name__ == "__main__":
    unittest.main()
