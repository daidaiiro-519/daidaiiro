{
  "$comment": "言語の組の定義（ACDR 0065 ・ 0069）。Go の組は契約の版2 で、作業型と助言型を持つ。from は profiles/go/ からの相対。組み立てた実行ファイルを bin/ に置く",
  "name": "go",
  "detect": "tool/go.mod",
  "contract": 2,
  "common": [
    {
      "from": "common/go.mod.tmpl",
      "to": "tool/go.mod"
    },
    {
      "from": "common/contract.go.tmpl",
      "to": "tool/contract/contract.go"
    },
    {
      "from": "common/refs.go.tmpl",
      "to": "tool/refs/refs.go"
    },
    {
      "from": "common/refs.tools.go.tmpl",
      "to": "tool/refs/tools.go"
    },
    {
      "from": "common/cli.main.go.tmpl",
      "to": "tool/cmd/cli/main.go"
    },
    {
      "from": "common/mcp.main.go.tmpl",
      "to": "tool/cmd/mcp/main.go"
    },
    {
      "from": "common/tool.json.tmpl",
      "to": "tool.json"
    },
    {
      "from": "common/mcp.json.tmpl",
      "to": "mcp.json"
    },
    {
      "from": "common/gitignore.tmpl",
      "to": ".gitignore"
    },
    {
      "from": "../shared/document.schema.json.tmpl",
      "to": "references/document.schema.json"
    }
  ],
  "types": {
    "work": [
      {
        "from": "types/work/tools.go.tmpl",
        "to": "tool/tools/tools.go"
      },
      {
        "from": "types/work/hello.go.tmpl",
        "to": "tool/tools/hello.go"
      },
      {
        "from": "types/work/hello_test.go.tmpl",
        "to": "tool/tools/hello_test.go"
      }
    ],
    "advisor": [
      {
        "from": "types/advisor/tools.go.tmpl",
        "to": "tool/tools/tools.go"
      },
      {
        "from": "types/advisor/references_test.go.tmpl",
        "to": "tool/tools/references_test.go"
      },
      {
        "from": "../rust/types/advisor/answer.example.json.tmpl",
        "to": "tool/tools/testdata/answer.example.json"
      }
    ]
  },
  "parts": {},
  "build": [
    "go mod tidy -C tool",
    "go build -C tool -o ../bin/{{Skill名}} ./cmd/cli",
    "go build -C tool -o ../bin/{{Skill名}}-mcp ./cmd/mcp"
  ],
  "test": [
    "go",
    "test",
    "-C",
    "tool",
    "./..."
  ],
  "sources": {
    "extensions": [
      ".go"
    ],
    "skip": [
      "bin"
    ]
  },
  "spawn": [
    "exec.Command("
  ],
  "dist": false,
  "layout": false,
  "fixtures": "tool/tools/testdata"
}
