//! {{Skill名}} の道具の宣言。**能力の正本はここである。**
//!
//! 入口（CLI ・ MCP）はこの宣言から組む ── 能力を2回書くと、片方だけが古くなる。
//! 許可辺は `Cargo.toml` が宣言する ── この crate は部品だけを参照する。

pub mod contract;
mod refs;

use serde_json::json;

pub use contract::{catalog, Arg, Given, Outcome, Tool};

/// {{道具の名前}} を実行する。
fn run_{{道具の名前}}(given: &Given) -> Outcome {
    let _ = given;
    // **ここに実体を書かない。** 部品（{{接頭辞}}_parts）を呼び、結果を組むだけである。
    // 部品が外部の道具を起動するなら、`given.external("名前")` で tool.json から読み、
    // 引数として渡す ── 部品は外部の道具の名前を直書きしない
    Outcome::found(Vec::new(), json!({}))
}

/// 人向けの文を組む。**印字はしない** ── 印字と終了コードは入口が持つ。
fn human_{{道具の名前}}(out: &Outcome) -> String {
    if !out.ok {
        return out.findings.join(" ／ ");
    }
    out.findings.join("\n")
}

/// この Skill が持つ道具の一覧。**能力の正本である。** references の4つの道具（get ・ validate ・
/// view ・ import）は、どの Skill も同じものを足す（ACDR 0043）。
#[must_use]
pub fn tools() -> Vec<Tool> {
    let mut all = vec![Tool {
        name: "{{道具の名前}}",
        summary: "{{その道具が何をするか}}",
        args: vec![Arg::need("{{引数の名前}}", "{{何を渡すか}}")],
        run: run_{{道具の名前}},
        human: human_{{道具の名前}},
    }];
    all.extend(refs::tools());
    all
}
