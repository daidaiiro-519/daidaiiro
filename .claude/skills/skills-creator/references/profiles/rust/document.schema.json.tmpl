{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "原典の複製",
  "description": "外部の原典を、出典と sha256 を付けて構造化した複製。原典が正本である",
  "$comment": "import が Markdown の見出しを節の入れ子に、本文を段落 ・ 箇条書き ・ 表 ・ コードの塊に分けて作る。見出しを機械で読めない文書（PDF など）は、書く側が同じ形で書き、validate で検査する",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "source",
          "sections"
        ],
        "properties": {
          "id": {
            "title": "識別子",
            "x-view": "hidden",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "title": "題",
            "x-view": "heading",
            "type": "string"
          },
          "source": {
            "title": "出典",
            "description": "取り直して sha256 が変われば、原典が変わった",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "sha256",
              "fetched"
            ],
            "properties": {
              "location": {
                "title": "元の場所",
                "type": "string"
              },
              "sha256": {
                "title": "sha256",
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "fetched": {
                "title": "取り込んだ日",
                "type": "string"
              }
            }
          },
          "sections": {
            "title": "節",
            "x-view": "outline",
            "type": "array",
            "items": {
              "$ref": "#/$defs/section"
            }
          },
          "blocks": {
            "title": "前文",
            "x-view": "blocks",
            "$ref": "#/$defs/blocks"
          }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "title": "見出し",
          "type": "string"
        },
        "sections": {
          "title": "下位の節",
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "blocks": {
          "title": "本文",
          "$ref": "#/$defs/blocks"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "para"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "kind": {
                "const": "list"
              },
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "kind": {
                "const": "table"
              },
              "head": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "kind",
              "head",
              "rows"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "kind": {
                "const": "code"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}