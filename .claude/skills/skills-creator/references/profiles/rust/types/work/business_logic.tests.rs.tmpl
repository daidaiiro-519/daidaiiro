use {{接頭辞}}_business_logic::hello::greet;

#[test]
fn greets_by_name() {
    // **1つの事例が1つの判定を固定する。** まとめると、どれが壊れたか分からない
    assert_eq!(greet("世界"), "こんにちは、世界", "名前を差し込んだ文を返す");
}
