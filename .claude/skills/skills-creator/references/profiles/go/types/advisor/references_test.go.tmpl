package tools

// {{Skill名}} の references を事例で検証する。**助言型の雛形の事例5件である**（ACDR 0061）。
// 判断基準の件数や題に依存しない ── 全件に同じ性質を確かめる。

import (
	"os"
	"path/filepath"
	"strings"
	"testing"

	"{{パッケージ名}}/refs"
)

const references = "../../references"

func answer(t *testing.T, body string) string {
	t.Helper()
	path := filepath.Join(t.TempDir(), "answer.json")
	if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
		t.Fatal(err)
	}
	return path
}

func mentions(found []string, word string) bool {
	for _, f := range found {
		if strings.Contains(f, word) {
			return true
		}
	}
	return false
}

func TestTheReferencesMatchTheirSchemas(t *testing.T) {
	found, err := refs.Validate(references)
	if err != nil || len(found) > 0 {
		t.Fatalf("%v %v", err, found)
	}
}

func TestEveryCriterionIsTakenByItsID(t *testing.T) {
	// **判断基準は1件ずつ取り出せる** ── 回答の前に読む手順が、この取り出しに頼る
	all, err := refs.Get(references, "criteria", "")
	if err != nil {
		t.Fatal(err)
	}
	items, _ := all.(*refs.Object).Vals["items"].([]any)
	for _, item := range items {
		id, _ := item.(*refs.Object).Vals["id"].(string)
		one, err := refs.Get(references, "criteria", id)
		if err != nil || one.(*refs.Object).Vals["id"] != id {
			t.Fatalf("%s: %v", id, err)
		}
	}
}

func TestTheAnswerExamplePassesTheAnswerSchema(t *testing.T) {
	found, err := refs.ValidateFile(references, "answer", "testdata/answer.example.json")
	if err != nil || len(found) > 0 {
		t.Fatalf("%v %v", err, found)
	}
}

func TestAConceptAnswerNeedsItsDefinition(t *testing.T) {
	// **概念相談は、定義と具体例を欠くと合格しない**
	fx := answer(t, `{"kind": "concept", "question": "それは何か", "conclusion": {"stance": "adopt", "headline": "こうである"}, "grounds": [{"criterion": "x", "quote": "x"}], "next": ["読む"]}`)
	found, _ := refs.ValidateFile(references, "answer", fx)
	if !mentions(found, "definition") {
		t.Fatal(found)
	}
}

func TestADesignAnswerNeedsItsSteps(t *testing.T) {
	// **設計相談は、設計の手順を欠くと合格しない**
	fx := answer(t, `{"kind": "design", "question": "どう組み立てるか", "conclusion": {"stance": "adopt", "headline": "こう組む"}, "grounds": [{"criterion": "x", "quote": "x"}], "next": ["組む"]}`)
	found, _ := refs.ValidateFile(references, "answer", fx)
	if !mentions(found, "steps") {
		t.Fatal(found)
	}
}
