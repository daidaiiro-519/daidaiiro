// {{Skill名}} の MCP の面（プレゼンテーション層）。**同じ道具の一覧から組む** ── 能力は1行も複製しない。
//
// MCP の公式 Go SDK の低水準の登録（Server.AddTool）を使い、引数の型から入力の形を導く
// 汎用の AddTool を使わない。**標準出力へ書かない** ── 標準出力は通信路である。
//
// **ok が偽なら IsError を立てる。** 道具の実行の誤りは結果で返し、呼び方の誤り（足りない引数）は、
// 引数が不正（CodeInvalidParams）として返す ── Rust の組と同じ分け方である。
package main

import (
	"context"
	"encoding/json"
	"fmt"
	"log"

	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
	"github.com/modelcontextprotocol/go-sdk/mcp"

	"{{パッケージ名}}/contract"
	"{{パッケージ名}}/tools"
)

func main() {
	server := mcp.NewServer(&mcp.Implementation{Name: "{{Skill名}}", Version: "0.1.0"}, nil)
	for _, t := range tools.All() {
		server.AddTool(&mcp.Tool{Name: t.Name, Description: t.Summary, InputSchema: inputSchema(t)}, handler(t))
	}
	if err := server.Run(context.Background(), &mcp.StdioTransport{}); err != nil {
		log.Fatal(err)
	}
}

// inputSchema は道具の一覧から入力の形を組む。**引数を1つずつ公開する。**
func inputSchema(t contract.Tool) map[string]any {
	properties := map[string]any{}
	required := []string{}
	for _, a := range t.Args {
		if a.Many {
			properties[a.Name] = map[string]any{"type": "array", "items": map[string]any{"type": "string"}, "description": a.Summary}
		} else {
			properties[a.Name] = map[string]any{"type": "string", "description": a.Summary}
		}
		if a.Required {
			required = append(required, a.Name)
		}
	}
	return map[string]any{"type": "object", "properties": properties, "required": required}
}

func handler(t contract.Tool) mcp.ToolHandler {
	return func(ctx context.Context, req *mcp.CallToolRequest) (*mcp.CallToolResult, error) {
		var raw map[string]any
		if len(req.Params.Arguments) > 0 {
			if err := json.Unmarshal(req.Params.Arguments, &raw); err != nil {
				return nil, &jsonrpc.Error{Code: jsonrpc.CodeInvalidParams, Message: err.Error()}
			}
		}
		given := &contract.Given{}
		for key, value := range raw {
			// **型は緩く受ける** ── 数を文字列で包むことを強制しない。まとめて受ける引数は配列も受ける
			items, ok := value.([]any)
			if !ok {
				items = []any{value}
			}
			for _, item := range items {
				if s, ok := item.(string); ok {
					given.Push(key, s)
				} else {
					b, _ := json.Marshal(item)
					given.Push(key, string(b))
				}
			}
		}
		for _, a := range t.Args {
			if given.Has(a.Name) {
				continue
			}
			if a.Default != nil {
				given.Push(a.Name, *a.Default)
			} else if a.Required {
				msg := fmt.Sprintf("引数が足りない: %s は %s を要する", t.Name, a.Name)
				return nil, &jsonrpc.Error{Code: jsonrpc.CodeInvalidParams, Message: msg}
			}
		}
		out := t.Run(given)
		body, _ := json.Marshal(out)
		return &mcp.CallToolResult{
			Content:           []mcp.Content{&mcp.TextContent{Text: string(body)}},
			StructuredContent: out,
			IsError:           !out.Ok,
		}, nil
	}
}
