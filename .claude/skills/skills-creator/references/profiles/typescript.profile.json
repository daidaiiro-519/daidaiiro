{
  "$comment": "言語の組の定義（ACDR 0063）。TypeScript の組は契約の版1 で、作業型だけを持つ。from は profiles/typescript/ からの相対。node が型の注記を外して .ts を直接実行する",
  "name": "typescript",
  "detect": "tool/package.json",
  "contract": 1,
  "common": [
    {"from": "common/package.json.tmpl", "to": "tool/package.json"},
    {"from": "common/tsconfig.json.tmpl", "to": "tool/tsconfig.json"},
    {"from": "common/contract.ts.tmpl", "to": "tool/src/contract.ts"},
    {"from": "common/cli.ts.tmpl", "to": "tool/src/cli.ts"},
    {"from": "common/mcp.ts.tmpl", "to": "tool/src/mcp.ts"},
    {"from": "common/tool.json.tmpl", "to": "tool.json"},
    {"from": "common/mcp.json.tmpl", "to": "mcp.json"},
    {"from": "common/gitignore.tmpl", "to": ".gitignore"}
  ],
  "types": {
    "work": [
      {"from": "types/work/tools.ts.tmpl", "to": "tool/src/tools.ts"},
      {"from": "types/work/hello.ts.tmpl", "to": "tool/src/hello.ts"},
      {"from": "types/work/hello.test.ts.tmpl", "to": "tool/tests/hello.test.ts"}
    ]
  },
  "parts": {},
  "build": [
    "npm install --silent --prefix tool"
  ],
  "test": [
    "node",
    "--test",
    "tool/tests/**/*.test.ts"
  ],
  "sources": {
    "extensions": [".ts", ".mts", ".js", ".mjs"],
    "skip": ["node_modules", "tests"]
  },
  "spawn": [
    "spawn(",
    "spawnSync(",
    "execSync(",
    "execFile(",
    "execFileSync("
  ],
  "dist": false,
  "layout": false
}
