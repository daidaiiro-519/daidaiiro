// {{Skill名}} の道具の一覧。**能力の正本はここである。**
//
// CLI と MCP はこの一覧から組む ── 能力を2回書くと、片方だけが古くなる。

using System.Text.Json.Nodes;

namespace SkillTool;

public static class Tools
{
    /// <summary>この Skill が持つ道具の一覧。</summary>
    public static IReadOnlyList<Tool> All() =>
    [
        new Tool(
            "hello",
            "見本の道具。名前を受けて、あいさつの文を返す",
            [Arg.Need("name", "あいさつする相手の名前")],
            RunHello,
            HumanHello),
    ];

    /// <summary>
    /// 見本の道具。**書き換えて、この Skill の道具にする。**
    /// 外部の道具を起動するなら、given.External("名前") で tool.json から読み、引数として渡す。
    /// </summary>
    static Outcome RunHello(Given given) =>
        Outcome.Found([], new JsonObject { ["greeting"] = Hello.Greet(given.One("name", "")) });

    static string HumanHello(Outcome out_) =>
        !out_.Ok ? string.Join(" ／ ", out_.Findings) : out_.Data["greeting"]?.GetValue<string>() ?? "";
}
