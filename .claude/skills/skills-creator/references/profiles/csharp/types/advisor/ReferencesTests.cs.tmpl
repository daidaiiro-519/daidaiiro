// {{Skill名}} の references を事例で検証する。**助言型の雛形の事例5件である**（ACDR 0061）。
// 判断基準の件数や題に依存しない ── 全件に同じ性質を確かめる。

using System.Text.Json.Nodes;
using SkillTool;
using Xunit;

public class ReferencesTests
{
    static readonly string Here = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "../../../"));
    static readonly string References = Path.GetFullPath(Path.Combine(Here, "../../references"));

    static string Answer(string json)
    {
        var path = Path.Combine(Path.GetTempPath(), $"{{Skill名}}-{Guid.NewGuid():N}.json");
        File.WriteAllText(path, json);
        return path;
    }

    [Fact]
    public void TheReferencesMatchTheirSchemas() => Assert.Empty(Refs.Validate(References));

    [Fact]
    public void EveryCriterionIsTakenByItsId()
    {
        // **判断基準は1件ずつ取り出せる** ── 回答の前に読む手順が、この取り出しに頼る
        foreach (var item in Refs.Get(References, "criteria")!["items"]!.AsArray())
        {
            var id = item!["id"]!.GetValue<string>();
            Assert.Equal(id, Refs.Get(References, "criteria", id)!["id"]!.GetValue<string>());
        }
    }

    [Fact]
    public void TheAnswerExamplePassesTheAnswerSchema() =>
        Assert.Empty(Refs.ValidateFile(References, "answer", Path.Combine(Here, "fixtures", "answer.example.json")));

    [Fact]
    public void AConceptAnswerNeedsItsDefinition()
    {
        // **概念相談は、定義と具体例を欠くと合格しない**
        var fx = Answer("""{"kind": "concept", "question": "それは何か", "conclusion": {"stance": "adopt", "headline": "こうである"}, "grounds": [{"criterion": "x", "quote": "x"}], "next": ["読む"]}""");
        Assert.Contains(Refs.ValidateFile(References, "answer", fx), f => f.Contains("definition"));
    }

    [Fact]
    public void ADesignAnswerNeedsItsSteps()
    {
        // **設計相談は、設計の手順を欠くと合格しない**
        var fx = Answer("""{"kind": "design", "question": "どう組み立てるか", "conclusion": {"stance": "adopt", "headline": "こう組む"}, "grounds": [{"criterion": "x", "quote": "x"}], "next": ["組む"]}""");
        Assert.Contains(Refs.ValidateFile(References, "answer", fx), f => f.Contains("steps"));
    }
}
