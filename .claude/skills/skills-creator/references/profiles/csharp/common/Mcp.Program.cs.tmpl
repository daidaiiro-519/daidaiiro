// {{Skill名}} の MCP の面（プレゼンテーション層）。**同じ道具の一覧から組む** ── 能力は1行も複製しない。
//
// MCP の公式 C# SDK（v2）の低水準の API（McpServer.Create と McpServerHandlers）を使い、
// 道具をその場で宣言する属性（McpServerTool）を使わない。**標準出力へ書かない** ── 標準出力は通信路である。
//
// **`ok` が偽なら `IsError` を立てる。** 道具の実行の誤りは結果で返し、呼び方の誤り（無い道具 ・
// 足りない引数）は、引数が不正（InvalidParams）として返す ── Rust の組と同じ分け方である。

using System.Text.Json;
using System.Text.Json.Nodes;
using ModelContextProtocol;
using ModelContextProtocol.Protocol;
using ModelContextProtocol.Server;
using SkillTool;

var options = new McpServerOptions
{
    ServerInfo = new Implementation { Name = "{{Skill名}}", Version = "0.1.0" },
    Capabilities = new ServerCapabilities { Tools = new ToolsCapability() },
    Handlers = new McpServerHandlers
    {
        ListToolsHandler = (context, cancellationToken) =>
            ValueTask.FromResult(new ListToolsResult { Tools = [.. Tools.All().Select(Mcp.Describe)] }),
        CallToolHandler = (context, cancellationToken) => ValueTask.FromResult(Mcp.Call(context.Params)),
    },
};

await using var server = McpServer.Create(new StdioServerTransport(options), options);
await server.RunAsync();

static class Mcp
{
    /// <summary>道具の一覧から、入力の形を組む。**引数を1つずつ公開する。**</summary>
    public static ModelContextProtocol.Protocol.Tool Describe(SkillTool.Tool tool)
    {
        var properties = new JsonObject();
        foreach (var a in tool.Args)
        {
            properties[a.Name] = a.Many
                ? new JsonObject { ["type"] = "array", ["items"] = new JsonObject { ["type"] = "string" }, ["description"] = a.Summary }
                : new JsonObject { ["type"] = "string", ["description"] = a.Summary };
        }
        var schema = new JsonObject
        {
            ["type"] = "object",
            ["properties"] = properties,
            ["required"] = new JsonArray([.. tool.Args.Where(a => a.Required).Select(a => (JsonNode?)JsonValue.Create(a.Name))]),
        };
        return new ModelContextProtocol.Protocol.Tool
        {
            Name = tool.Name,
            Description = tool.Summary,
            InputSchema = JsonSerializer.SerializeToElement(schema),
        };
    }

    public static CallToolResult Call(CallToolRequestParams? request)
    {
        var name = request?.Name ?? "";
        var tool = Tools.All().FirstOrDefault(t => t.Name == name)
            ?? throw new McpProtocolException($"その道具は無い: {name}", McpErrorCode.InvalidParams);
        var given = new Given();
        foreach (var (key, value) in request?.Arguments ?? new Dictionary<string, JsonElement>())
        {
            // **型は緩く受ける** ── 数を文字列で包むことを強制しない。まとめて受ける引数は配列も受ける
            var items = value.ValueKind == JsonValueKind.Array ? value.EnumerateArray().ToList() : [value];
            foreach (var item in items)
            {
                given.Push(key, item.ValueKind == JsonValueKind.String ? item.GetString()! : item.GetRawText());
            }
        }
        foreach (var a in tool.Args)
        {
            if (given.Has(a.Name)) continue;
            if (a.Default is not null) given.Push(a.Name, a.Default);
            else if (a.Required)
            {
                throw new McpProtocolException($"引数が足りない: {tool.Name} は {a.Name} を要する", McpErrorCode.InvalidParams);
            }
        }
        var out_ = tool.Run(given);
        var body = out_.ToJson();
        return new CallToolResult
        {
            Content = [new TextContentBlock { Text = Contract.Text(body, false) }],
            StructuredContent = JsonSerializer.SerializeToElement(body),
            IsError = !out_.Ok,
        };
    }
}
