// {{Skill名}} のプレゼンテーション層（CLI）。シェルから呼ぶ唯一の経路である。
//
// **道具ごとに実行ファイルを作らない** ── 実行ファイルが増えると、呼ぶ側が形を推測することになる。

using SkillTool;

Console.OutputEncoding = System.Text.Encoding.UTF8;
return Cli.Run(args);

static class Cli
{
    public static int Run(string[] argv)
    {
        var all = Tools.All();
        var asJson = argv.Contains("--json");
        var rest = argv.Where(a => a != "--json").ToList();
        if (rest.Count == 0)
        {
            if (asJson) return Emit(Contract.Catalog(all, new Given()), true, _ => "");
            Usage(all);
            return 2;
        }
        var verb = rest[0];
        if (verb is "-h" or "--help" or "help")
        {
            Usage(all);
            return 0;
        }
        var tool = all.FirstOrDefault(t => t.Name == verb);
        if (tool is null)
        {
            Console.Error.WriteLine($"その動詞は無い: {verb} ── 一覧は help である");
            return 2;
        }
        Given given;
        try
        {
            given = ReadArgs(tool, rest.Skip(1).ToList());
        }
        catch (ArgumentException why)
        {
            Console.Error.WriteLine(why.Message);
            return 2;
        }
        var missing = tool.Args.FirstOrDefault(a => a.Required && !given.Has(a.Name));
        if (missing is not null)
        {
            Console.Error.WriteLine($"引数が足りない: {tool.Name} は {missing.Name} を要する");
            return 2;
        }
        return Emit(tool.Run(given), asJson, tool.Human);
    }

    static Given ReadArgs(Tool tool, List<string> rest)
    {
        var given = new Given();
        var positional = new List<string>();
        for (var i = 0; i < rest.Count; i++)
        {
            var a = rest[i];
            if (!a.StartsWith("--", StringComparison.Ordinal))
            {
                positional.Add(a);
                continue;
            }
            var body = a[2..];
            string key, value;
            var eq = body.IndexOf('=');
            if (eq >= 0)
            {
                key = body[..eq];
                value = body[(eq + 1)..];
            }
            else if (i + 1 < rest.Count && !rest[i + 1].StartsWith("--", StringComparison.Ordinal))
            {
                key = body;
                value = rest[++i];
            }
            else
            {
                key = body;
                value = "1";
            }
            key = key.Replace('-', '_');
            // **道具の一覧に無い旗は断る。** 黙って無視すると、打ち間違いが検出されない
            if (!tool.Args.Any(x => x.Name == key))
            {
                var known = string.Join(" ・ ", tool.Args.Select(x => x.Name));
                throw new ArgumentException($"その旗は無い: --{key}（{tool.Name} は {known} を受ける）");
            }
            given.Push(key, value);
        }
        var next = 0;
        foreach (var arg in tool.Args)
        {
            if (given.Has(arg.Name)) continue;
            if (arg.Many)
            {
                for (; next < positional.Count; next++) given.Push(arg.Name, positional[next]);
                continue;
            }
            if (next < positional.Count) given.Push(arg.Name, positional[next++]);
            else if (arg.Default is not null) given.Push(arg.Name, arg.Default);
        }
        return given;
    }

    static void Usage(IReadOnlyList<Tool> all)
    {
        Console.WriteLine("道具の一覧");
        foreach (var t in all)
        {
            var need = string.Join(" ", t.Args.Select(a => a.Many ? $"<{a.Name}…>" : a.Required ? $"<{a.Name}>" : $"[{a.Name}]"));
            Console.WriteLine($"  {t.Name} {need}");
            Console.WriteLine($"      {t.Summary}");
        }
        Console.WriteLine();
        Console.WriteLine("  どれも --json を付けると、機械が読む形で出る");
    }

    static int Emit(Outcome out_, bool asJson, Func<Outcome, string> human)
    {
        Console.WriteLine(asJson ? out_.ToJson().ToJsonString(Contract.Pretty) : human(out_));
        return out_.ExitCode;
    }
}
