// references の道具を、道具の一覧に載せる。**どの Skill も同じ4つを持つ** ── 取り出す ・ 検査する ・
// 描画する ・ 取り込む（ACDR 0043）。実体は Refs.cs が持つ。**どの Skill も同じファイルを複製して使う。**

using System.Text;
using System.Text.Json.Nodes;

namespace SkillTool;

public static class RefsTools
{
    static string RefsDir(Given given) => Path.Combine(given.SkillRoot(), "references");

    static string? Optional(Given given, string name) => given.One(name, "") is { Length: > 0 } v ? v : null;

    /// <summary>読めない ・ 無いを、誤用として返す。</summary>
    static Func<Given, Outcome> Guard(Func<Given, Outcome> run) => given =>
    {
        try
        {
            return run(given);
        }
        catch (Exception why) when (why is RefsException or InvalidOperationException)
        {
            return Outcome.Misuse(why.Message);
        }
    };

    static Outcome RunGet(Given given) =>
        Outcome.Found([], Refs.Get(RefsDir(given), given.One("kind", ""), Optional(given, "id")));

    static Outcome RunValidate(Given given)
    {
        var d = RefsDir(given);
        var file = Optional(given, "file");
        var found = file is not null ? Refs.ValidateFile(d, given.One("kind", ""), file) : Refs.Validate(d);
        var kinds = new JsonArray([.. Refs.Kinds(d).Select(k => (JsonNode?)JsonValue.Create(k.Name))]);
        return Outcome.Found(found, new JsonObject { ["kinds"] = kinds });
    }

    static Outcome RunView(Given given)
    {
        var d = RefsDir(given);
        var html = Refs.View(d, given.One("kind", ""), Optional(given, "id"), Optional(given, "file"));
        var out_ = Optional(given, "out");
        if (out_ is null) return Outcome.Found([], new JsonObject { ["html"] = html });
        Refs.Save(out_, html);
        return Outcome.Found([], new JsonObject { ["out"] = out_, ["bytes"] = Encoding.UTF8.GetByteCount(html) });
    }

    static Outcome RunImport(Given given)
    {
        var d = RefsDir(given);
        var file = given.One("file", "");
        var doc = Refs.ImportMarkdown(given.One("id", ""), given.One("source", file), given.One("fetched", ""), Refs.ReadText(file));
        var path = Refs.PutDocument(d, doc);
        return Outcome.Found(Refs.Validate(d), new JsonObject { ["path"] = path });
    }

    static string Human(Outcome out_)
    {
        if (!out_.Ok || out_.Findings.Count > 0) return string.Join("\n", out_.Findings.Select(x => $"  ×  {x}"));
        if (out_.Data is JsonObject o && o["html"] is JsonValue h && h.TryGetValue<string>(out var html)) return html;
        return out_.Data?.ToJsonString(Contract.Pretty) ?? "null";
    }

    /// <summary>references の4つの道具。**道具の一覧（Tools.cs）がこれを足す。**</summary>
    public static IReadOnlyList<Tool> All()
    {
        static Arg Root() => Arg.Opt("skill_root", "この Skill の置き場所（既定は、SKILL.md の在る上のフォルダ）");
        return
        [
            new Tool("get", "references の種類の JSON を取り出す。id を渡すと、その1件だけを返す",
                [Arg.Need("kind", "種類の名前"), Arg.Opt("id", "項目の id"), Root()], Guard(RunGet), Human),
            new Tool("validate", "references の JSON を、指しているスキーマで検査する。file を渡すと、その JSON を種類のスキーマで検査する",
                [Arg.Opt("kind", "種類の名前（file と一緒に渡す）"), Arg.Opt("file", "検査する JSON"), Root()], Guard(RunValidate), Human),
            new Tool("view", "references の種類の JSON を、スキーマの title と x-view に従って HTML に描画する",
                [Arg.Need("kind", "種類の名前"), Arg.Opt("id", "項目の id"), Arg.Opt("file", "描画する JSON（回答など）"), Arg.Opt("out", "HTML の置き場所"), Root()],
                Guard(RunView), Human),
            new Tool("import", "Markdown の文書を、見出しを節の入れ子に分けて document へ取り込む",
                [Arg.Need("file", "取り込む Markdown"), Arg.Need("id", "document の id"), Arg.Opt("source", "元の場所（既定は file）"), Arg.Opt("fetched", "取り込んだ日"), Root()],
                Guard(RunImport), Human),
        ];
    }
}
