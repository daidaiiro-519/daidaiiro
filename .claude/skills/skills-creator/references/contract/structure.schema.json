{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structure.schema.json",
  "title": "Skill のディレクトリ構成",
  "description": "どの言語で書いた Skill も満たす、置くファイルとフォルダ",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "need",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "title": "置き場所",
            "type": "string"
          },
          "need": {
            "title": "要否",
            "enum": [
              "always",
              "optional",
              "never"
            ]
          },
          "purpose": {
            "title": "中身",
            "type": "string"
          },
          "note": {
            "title": "補足",
            "type": "string"
          }
        }
      }
    }
  }
}
