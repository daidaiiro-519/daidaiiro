{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools.schema.json",
  "title": "CLI のインターフェース",
  "description": "どの言語で書いた Skill も満たす、呼び出しの形 ・ 出力形式 ・ 終了コード ・ tool.json の欄",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cli",
    "output",
    "exit",
    "subcommands",
    "tool_json"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cli": {
      "title": "呼び出しの形",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "title": "出力形式",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit": {
      "title": "終了コード",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "meaning"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "subcommands": {
      "title": "共通ツールのサブコマンド",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "args"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "need",
                "meaning"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "need": {
                  "type": "boolean"
                },
                "meaning": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "tool_json": {
      "title": "tool.json の欄",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "need",
          "meaning"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "need": {
            "type": "boolean"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    }
  }
}
