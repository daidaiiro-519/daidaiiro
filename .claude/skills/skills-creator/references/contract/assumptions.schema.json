{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assumptions.schema.json",
  "title": "実装上の前提",
  "description": "リファレンス実装から読み取りにくい前提。どの言語で実装するときも守る",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "why",
          "cases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "rule": {
            "title": "ルール",
            "type": "string"
          },
          "why": {
            "title": "理由",
            "type": "string"
          },
          "cases": {
            "title": "確認するテストケース",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
