{
 "case": "CRLF の改行と末尾の改行を持つ Markdown も、LF と同じに取り込む",
 "test": "markdown_is_imported_as_nested_sections",
 "setup": [
  [
   "import",
   "--file",
   "fixtures/markdown/crlf.md",
   "--id",
   "crlf",
   "--source",
   "crlf.md",
   "--fetched",
   "2026-10-03",
   "--skill_root",
   "fixtures/document"
  ]
 ],
 "call": [
  "get",
  "--kind",
  "document",
  "--id",
  "crlf",
  "--skill_root",
  "fixtures/document"
 ],
 "expect": {
  "exit": 0,
  "json": {
   "ok": true,
   "findings": [],
   "data": {
    "id": "crlf",
    "title": "題",
    "source": {
     "location": "crlf.md",
     "sha256": "4697135acba5a2135b960568794ec57ad3e0d7549506b6d268e9fd0b5ce2bd53",
     "fetched": "2026-10-03"
    },
    "sections": [
     {
      "title": "題",
      "blocks": [
       {
        "kind": "para",
        "text": "本文の1行目本文の2行目"
       }
      ],
      "sections": [
       {
        "title": "節",
        "blocks": [
         {
          "kind": "list",
          "ordered": false,
          "items": [
           "項目"
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  }
 }
}