{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "view.tokens.schema.json",
  "title": "描画のトークン",
  "description": "共通のトークン（view.tokens.json）と、Skill 固有のトークン（view.skill.tokens.json）の形",
  "oneOf": [
    {
      "$ref": "#/$defs/common"
    },
    {
      "$ref": "#/$defs/skill"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "palettes"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "$comment": {
          "type": "string"
        },
        "palette": {
          "type": "string",
          "title": "使うパレット",
          "description": "palettes の鍵のどれか1つ"
        },
        "palettes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "light",
              "dark"
            ],
            "properties": {
              "light": {
                "$ref": "#/$defs/scheme"
              },
              "dark": {
                "$ref": "#/$defs/scheme"
              }
            }
          }
        }
      }
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "surface",
        "band",
        "ink",
        "muted",
        "line",
        "accent",
        "accent-soft",
        "warn",
        "warn-soft"
      ],
      "properties": {
        "paper": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "paper"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "surface"
        },
        "band": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "band"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "ink"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "muted"
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "line"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "accent"
        },
        "accent-soft": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "accent-soft"
        },
        "warn": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "warn"
        },
        "warn-soft": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "warn-soft"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "$comment": {
          "type": "string"
        },
        "light": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "色の値（#rrggbb）か、共通の役割の参照（var(--role)）"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "色の値（#rrggbb）か、共通の役割の参照（var(--role)）"
          }
        }
      },
      "description": "Skill 固有のトークン。必要とする Skill だけが置く。鍵は共通の役割と重ならない名前にする"
    }
  }
}
