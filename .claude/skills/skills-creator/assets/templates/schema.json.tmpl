{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "x-abstract": "schema-driven/abstract@v1",
 "$id": "{{name}}/{{kind}}@v1",
 "title": "{{インスタンスが何であるかを名詞で}}",
 "description": "{{何を持つインスタンスか}}",
 "x-prompt": {
  "read": {"means": "{{このインスタンスが何であるか}}"},
  "write": [{"id": "first-rule", "rule": "{{書くときの決まり}}", "why": "{{なぜ}}", "test": "{{確かめ方}}"}]
 },
 "x-generates": "{{インスタンスを置く場所}}",
 "type": "object",
 "required": ["$schema", "kind"],
 "properties": {
  "$schema": {
   "const": "{{name}}/{{kind}}@v1",
   "description": "従うスキーマの名前",
   "x-prompt": {"read": {"means": "このインスタンスが従うスキーマの名前である。"},
                "write": [{"id": "this-name", "rule": "{{name}}/{{kind}}@v1 と書く。", "why": "エンジンは、この名前でスキーマを引く。", "test": "値がこの文字列と同じかを見る。"}]}
  },
  "kind": {
   "const": "{{kind}}",
   "description": "種類",
   "x-prompt": {"read": {"means": "インスタンスの種類である。"},
                "write": [{"id": "const", "rule": "{{kind}} と書く。", "why": "基盤は kind で種類を判定する。", "test": "値が {{kind}} かを見る。"}]}
  }
 }
}
