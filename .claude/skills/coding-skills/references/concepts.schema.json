{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "概念の出典",
  "description": "この Skill が手順の中で依拠する概念と、その原典。**原文は同梱しない** ── 持つのは引用と、取り直すための4つの値だけである。",
  "type": "object",
  "required": [
    "concepts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": [
        "concept",
        "applies",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1,
          "description": "手順の中で使う呼び名"
        },
        "applies": {
          "type": "string",
          "minLength": 1,
          "description": "この Skill の手順のどこで、どう使うか"
        },
        "source": {
          "type": "object",
          "required": [
            "meta",
            "quote",
            "fetched"
          ],
          "additionalProperties": false,
          "properties": {
            "meta": {
              "type": "string",
              "minLength": 1,
              "description": "原典の識別子"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "description": "原文の文字列。**要約しない**"
            },
            "fetched": {
              "description": "あとから取り直して、同じ版かを判定するための4つの値。",
              "type": "object",
              "required": [
                "url",
                "date",
                "sha256",
                "line"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
