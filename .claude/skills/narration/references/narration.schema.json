{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "narration.json ── 呼ぶ側が作る入力",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "voice": {"type": "string", "default": "Takumi", "description": "日本語のニューラルの声。Takumi ・ Kazuha ・ Tomoko"},
    "engine": {"type": "string", "default": "neural"},
    "format": {"type": "string", "const": "mp3"},
    "cache": {"type": "string", "default": "cache", "description": "鍵の名前で音声を置くフォルダ"},
    "lexicons": {"type": "array", "items": {"type": "string"}, "description": "合成の前に適用する辞書の名前"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "枚の識別子。スライドを保持する側が出したものをそのまま使う"},
          "text": {"type": "string", "description": "読み上げる文。読み仮名は書かない ── 読みの補正は辞書が持つ"}
        }
      }
    }
  }
}
