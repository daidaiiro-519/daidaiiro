{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "narration.out.json ── このSkillが返す出力",
  "type": "object",
  "required": ["items"],
  "properties": {
    "voice": {"type": "string"},
    "engine": {"type": "string"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "audio", "marks", "format", "durationMs"],
        "properties": {
          "id": {"type": "string", "description": "入力と同じ枚の識別子"},
          "key": {"type": "string", "description": "文・声・エンジンから作った鍵。音声の名前でもある"},
          "audio": {"type": "string"},
          "marks": {"type": "string", "description": "語と文の時刻。字幕や強調に使う"},
          "format": {"type": "string", "const": "mp3"},
          "durationMs": {"type": "integer", "description": "音声の長さ。speech marks の最後の印の時刻ではない"}
        }
      }
    }
  }
}
