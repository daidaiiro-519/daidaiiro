{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "licenses.schema.json",
  "title": "references のファイルの使用条件",
  "description": "原典を翻案したファイルごとの使用条件。Skill のほかの部分は、Skill の根の LICENSE（MIT）に従う",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "x-view": "hidden"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "target",
          "license",
          "notice",
          "origin",
          "terms"
        ],
        "properties": {
          "id": {
            "title": "識別子",
            "x-view": "hidden",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "title": {
            "title": "題",
            "x-view": "heading",
            "type": "string",
            "minLength": 1
          },
          "target": {
            "title": "対象のファイル",
            "type": "string",
            "minLength": 1,
            "description": "references からの相対パス"
          },
          "license": {
            "title": "使用条件",
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "title": "著作権の表示",
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "title": "原典",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "location",
              "fetched"
            ],
            "properties": {
              "name": {
                "title": "書誌",
                "type": "string",
                "minLength": 1
              },
              "location": {
                "title": "所在",
                "type": "string",
                "minLength": 1
              },
              "fetched": {
                "title": "取得した日",
                "type": "string",
                "minLength": 1
              }
            }
          },
          "changes": {
            "title": "変更したこと",
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "title": "原典の使用条件（原文のまま）",
            "x-view": "list",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}