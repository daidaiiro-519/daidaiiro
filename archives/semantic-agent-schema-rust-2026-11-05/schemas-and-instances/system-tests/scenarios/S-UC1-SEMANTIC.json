{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-SEMANTIC",
 "name": "意味で作る手順",
 "title": "--semantic で作ると、Concrete の rule から書く手順を組み（related_fields で読まれる欄を先に、資料は中身ごと）、書くコマンド（semantic-agent-schema create … --value）と一緒に出して終わる。ファイルも記録も作らない",
 "why": "作り手が書いたのは Concrete だけで、手順は Semantic Agent Schema が組む。値を決めるのは打ったセッションで、書くのは機械の作成なので、形に外れた値は書かれない。",
 "traces": [
  "UC1:変形:意味で書く",
  "約束:procedure"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "docs/withdraw.md": "@fixtures/withdraw.md"
  }
 },
 "when": {
  "args": [
   "create",
   "items/s2.json",
   "--concrete",
   "urn:example:sample:summary:v1",
   "--semantic",
   "--reason",
   "退会を足す",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "lines": 1
  },
  {
   "of": "when",
   "pointer": "/operation_kind",
   "equals": "write"
  },
  {
   "of": "when",
   "pointer": "/steps/1/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/steps/2/pointer",
   "equals": "/summary"
  },
  {
   "of": "when",
   "pointer": "/steps/2/related_fields/0/pointer",
   "equals": "/goal"
  },
  {
   "of": "when",
   "pointer": "/answer/format",
   "equals": "document"
  },
  {
   "of": "when",
   "pointer": "/command",
   "equals": "semantic-agent-schema create items/s2.json --concrete urn:example:sample:summary:v1 --value <値の JSON> --reason '退会を足す' --schemas schemas --human"
  },
  {
   "of": "when",
   "file": "items/s2.json",
   "exists": false
  },
  {
   "of": "after[0]",
   "pointer": "/operations/0",
   "equals": "o-0001"
  }
 ],
 "after": [
  {
   "args": [
    "validate",
    "schemas/summary.schema.json",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ]
}
