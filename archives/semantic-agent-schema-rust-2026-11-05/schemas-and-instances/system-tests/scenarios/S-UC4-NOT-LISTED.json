{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-NOT-LISTED",
 "name": "版が一覧に無い",
 "title": "閉じた一覧に無い Abstract の版を申告した Concrete は schema_not_listed で断り、取りに行かない",
 "why": "知らない版を取りに行くと、ネットワークと外の中身に結果が左右される。",
 "traces": [
  "UC4:最低保証",
  "約束:abstract:root"
 ],
 "given": {
  "files": {
   "schemas/future.schema.json": "@fixtures/future.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "schemas/future.schema.json",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "error"
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "schema_not_listed"
  }
 ],
 "unchanged": [
  "schemas/future.schema.json"
 ]
}
