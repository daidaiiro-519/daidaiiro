{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC1-HUMAN-FIELD",
 "name": "ツールが人の欄を決めた",
 "title": "名乗ったツールが人の欄を default 以外の値で作ろうとすると、書かず記録もせずに human_field と理由を返す",
 "why": "人が決める欄をツールが決められると、承認したことになっていない値が承認済みに見える。",
 "traces": [
  "UC1:最低保証",
  "約束:abstract:x-decided-by"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json"
  }
 },
 "when": {
  "args": [
   "create",
   "decisions/d2.json",
   "--concrete",
   "urn:example:sample:decision:v1",
   "--value",
   "{\"id\":\"D2\",\"summary\":\"差分は前後の中身から求める\",\"status\":\"approved\",\"risk\":\"low\",\"review\":\"by-one\"}",
   "--session",
   "agent-1",
   "--schemas",
   "schemas"
  ]
 },
 "after": [
  {
   "args": [
    "validate",
    "decisions/d2.json",
    "--schemas",
    "schemas",
    "--human"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "human_field"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "/status"
  },
  {
   "of": "when",
   "pointer": "/operation",
   "exists": false
  },
  {
   "of": "after[0]",
   "exit": 1
  },
  {
   "of": "after[0]",
   "pointer": "/code",
   "equals": "not_found"
  }
 ]
}
