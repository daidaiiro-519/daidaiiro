{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-PATHS",
 "name": "渡した経路だけを検証する",
 "title": "渡した経路の Concrete とインスタンスだけを検証し、検証の操作を対象ごとに1件ずつ記録する。経路の外の文書は見ない",
 "why": "範囲を推し量ると、渡していない文書で結果が変わる。",
 "traces": [
  "UC4:成功時保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "notes/other.json": "@fixtures/../scenario.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "schemas/usecase.schema.json",
   "usecases/u1.json",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/targets",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/operations",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/targets/0/path",
   "equals": "schemas/usecase.schema.json"
  },
  {
   "of": "when",
   "pointer": "/targets/1/path",
   "equals": "usecases/u1.json"
  }
 ]
}
