{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC5-PATH-OUTSIDE-ROOT",
 "name": "根の外を指す経路",
 "title": "Git の根の外を指す経路（../ ・ 絶対の経路）を描く対象に渡すと、読まずに断り、1ページも書かない",
 "why": "根の外を読むと、渡された経路が Git の根からの相対という約束が崩れる。",
 "traces": [
  "UC5:最低保証"
 ],
 "given": {
  "files": {
   "schemas/usecase.schema.json": "@fixtures/usecase.schema.json",
   "usecases/u1.json": "@fixtures/u1.json",
   "design/ds.json": "@fixtures/ds.json",
   "design/page.html": "@fixtures/page.html",
   "design/card.html": "@fixtures/card.html",
   "design/styles.css": "@fixtures/styles.css"
  }
 },
 "when": {
  "args": [
   "render",
   "../u1.json",
   "--design-system",
   "design/ds.json",
   "--out",
   "site",
   "--schemas",
   "schemas"
  ]
 },
 "after": [
  {
   "args": [
    "render",
    "/etc/hostname",
    "--design-system",
    "design/ds.json",
    "--out",
    "site",
    "--schemas",
    "schemas"
   ]
  }
 ],
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/code",
   "equals": "not_found"
  },
  {
   "of": "when",
   "pointer": "/message",
   "contains": "根"
  },
  {
   "of": "after[0]",
   "exit": 1
  },
  {
   "of": "when",
   "file": "site/usecases/u1.html",
   "exists": false
  }
 ]
}
