{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-RULE-ID-RESERVED",
 "name": "予約した名前の rule",
 "title": "Concrete の rule の id に json-schema を使うと、形の検査（json-schema）が violated になる",
 "why": "json-schema は Semantic Agent Schema が形の検査の結果に使う名前で、同じ名前の rule があると判定の記録でどちらを指すか決まらない。",
 "traces": [
  "UC4:成功時保証",
  "約束:abstract:rule"
 ],
 "given": {
  "files": {
   "schemas/reserved.schema.json": "@fixtures/reserved-rule-id.schema.json"
  }
 },
 "when": {
  "args": [
   "validate",
   "schemas/reserved.schema.json",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 1
  },
  {
   "of": "when",
   "pointer": "/targets/0/counts/violated",
   "equals": 1
  }
 ]
}
