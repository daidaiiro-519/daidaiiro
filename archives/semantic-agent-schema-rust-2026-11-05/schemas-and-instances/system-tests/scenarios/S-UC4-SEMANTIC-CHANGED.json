{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC4-SEMANTIC-CHANGED",
 "name": "変わった所だけを判定する",
 "title": "判定済みの対象で要約（summary）だけを直して validate --semantic を打つと、直した所のまとまり（前の判定のときの値 ・ いまの値 ・ 直した操作つき）と文書全体のまとまり（変わった所の一覧）だけが出て、直していない目的（goal）は出ない。rule の全文は rules に1回だけ書かれる",
 "why": "書いて直すたびに検証するので、1か所直すたびにすべての所を判定し直すと、欄が増えるほど待つ時間が延びる。",
 "traces": [
  "UC4:変形:意味の判定",
  "約束:procedure"
 ],
 "given": {
  "files": {
   "schemas/summary.schema.json": "@fixtures/summary.schema.json",
   "items/s1.json": "@fixtures/s1.json",
   "answers/summary.json": "{\"hash\": \"sha256:cd024bdab47826bd4bbb3483df31b544cd88d9ca89879d18a0cc34616f4ddcaa\", \"results\": [{\"step\": 1, \"rule\": \"goal-is-outcome\", \"pointer\": \"/goal\", \"result\": \"verified\", \"reason\": \"結果を書いている\"}, {\"step\": 2, \"rule\": \"summary-matches\", \"pointer\": \"/summary\", \"result\": \"verified\", \"reason\": \"目的に食い違わない\"}]}"
  },
  "steps": [
   {
    "args": [
     "validate",
     "items/s1.json",
     "--answer",
     "answers/summary.json",
     "--schemas",
     "schemas",
     "--human"
    ]
   },
   {
    "args": [
     "update",
     "items/s1.json",
     "--if-match",
     "sha256:cd024bdab47826bd4bbb3483df31b544cd88d9ca89879d18a0cc34616f4ddcaa",
     "--patch",
     "[{\"op\":\"replace\",\"path\":\"/summary\",\"value\":\"検証の結果を受け取るための約束\"}]",
     "--schemas",
     "schemas",
     "--human"
    ]
   }
  ]
 },
 "when": {
  "args": [
   "validate",
   "items/s1.json",
   "--semantic",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/kind",
   "equals": "procedure"
  },
  {
   "of": "when",
   "pointer": "/steps",
   "count": 2
  },
  {
   "of": "when",
   "pointer": "/steps/0/action",
   "equals": "review-place"
  },
  {
   "of": "when",
   "pointer": "/steps/0/pointer",
   "equals": "/summary"
  },
  {
   "of": "when",
   "pointer": "/steps/0/before",
   "equals": "検証の結果を受け取るための決めごと"
  },
  {
   "of": "when",
   "pointer": "/steps/0/rules",
   "equals": [
    "summary-matches"
   ]
  },
  {
   "of": "when",
   "pointer": "/steps/1/action",
   "equals": "review-document"
  },
  {
   "of": "when",
   "pointer": "/steps/1/changed",
   "equals": [
    "/summary"
   ]
  },
  {
   "of": "when",
   "pointer": "/rules",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/command",
   "equals": "semantic-agent-schema validate items/s1.json --answer <判定の JSON のファイル | -> --schemas schemas --human"
  },
  {
   "of": "when",
   "pointer": "/steps/0/current",
   "equals": "検証の結果を受け取るための約束"
  },
  {
   "of": "when",
   "pointer": "/steps/0/changes/0/operation",
   "equals": "o-0002"
  },
  {
   "of": "when",
   "pointer": "/steps/0/changes/0/target",
   "equals": "items/s1.json"
  },
  {
   "of": "when",
   "pointer": "/steps/0/changes/0/session",
   "equals": null
  },
  {
   "of": "when",
   "pointer": "/steps/1/changes",
   "count": 1
  },
  {
   "of": "when",
   "pointer": "/review/scope",
   "equals": "changed"
  },
  {
   "of": "when",
   "pointer": "/review/since",
   "equals": "o-0001"
  }
 ],
 "unchanged": [
  "items/s1.json"
 ]
}
