{
 "$schema": "urn:semantic-agent-schema:system-tests:scenario:v1",
 "id": "S-UC2-HUMAN-UPDATE",
 "name": "人が人の欄を直す",
 "title": "--human を付けた呼び出し（人）が人の欄を直すと、直せる",
 "why": "人の入口からも直せないと、人の欄を誰も変えられない。",
 "traces": [
  "UC2:成功時保証",
  "約束:abstract:x-decided-by"
 ],
 "given": {
  "files": {
   "schemas/decision.schema.json": "@fixtures/decision.schema.json",
   "decisions/d1.json": "@fixtures/d1.json"
  }
 },
 "when": {
  "args": [
   "update",
   "decisions/d1.json",
   "--patch",
   "[{\"op\":\"replace\",\"path\":\"/status\",\"value\":\"approved\"}]",
   "--if-match",
   "sha256:da5cc215c456a669443fc2f07aa7b7817e7c1f39812490c6f6c1fec7a8ac743a",
   "--schemas",
   "schemas",
   "--human"
  ]
 },
 "then": [
  {
   "of": "when",
   "exit": 0
  },
  {
   "of": "when",
   "pointer": "/result",
   "equals": "updated"
  },
  {
   "of": "when",
   "pointer": "/diff/changes/0/pointer",
   "equals": "/status"
  }
 ]
}
