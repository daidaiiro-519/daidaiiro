{
 "$schema": "urn:semantic-agent-schema:published-language:abstract:v1",
 "$id": "urn:example:sample:steps:v1",
 "title": "手順の並び",
 "description": "利用者と仕組みのやりとりの並びである。",
 "type": "object",
 "required": [
  "$schema",
  "steps"
 ],
 "$defs": {
  "step": {
   "type": "object",
   "required": [
    "action"
   ],
   "properties": {
    "action": {
     "type": "string",
     "x-prompt": {
      "rules": [
       {
        "id": "one-action",
        "rule": "誰が何をするかを1つだけ書く。",
        "why": "2つ混ぜると、どこで失敗したかが分からない。",
        "check": "主語と動作が1組だけかを見る。",
        "bad": [
         {
          "value": "利用者が注文を送り、仕組みが在庫を確かめる",
          "note": "主語と動作が2組ある。"
         }
        ],
        "good": [
         {
          "value": "利用者が注文を送る"
         }
        ]
       }
      ]
     },
     "title": "動作",
     "description": "誰が何をするかの1文である。"
    }
   }
  }
 },
 "properties": {
  "$schema": {
   "const": "urn:example:sample:steps:v1"
  },
  "steps": {
   "title": "手順",
   "description": "やりとりの並びである。",
   "x-prompt": {
    "rules": []
   },
   "type": "array",
   "items": {
    "$ref": "#/$defs/step"
   }
  }
 }
}
