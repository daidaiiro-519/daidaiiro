{
 "$schema": "urn:semantic-agent-schema:published-language:design-system:v1",
 "name": "ユースケースのデザイン",
 "version": "1.0.0",
 "template_language": "urn:semantic-agent-schema:published-language:template-language:v1",
 "templates": {
  "page": "nothing.html",
  "styles": "styles.css"
 },
 "tokens": {
  "color": {
   "$type": "color",
   "light": {
    "surface": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.957,
       0.945,
       0.918
      ],
      "hex": "#f4f1ea"
     }
    },
    "card": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       1.0,
       0.992,
       0.973
      ],
      "hex": "#fffdf8"
     }
    },
    "text": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.165,
       0.149,
       0.133
      ],
      "hex": "#2a2622"
     }
    },
    "muted": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.42,
       0.388,
       0.353
      ],
      "hex": "#6b635a"
     }
    },
    "accent": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.706,
       0.325,
       0.165
      ],
      "hex": "#b4532a"
     }
    },
    "accent-soft": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.965,
       0.894,
       0.847
      ],
      "hex": "#f6e4d8"
     }
    },
    "line": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.894,
       0.867,
       0.816
      ],
      "hex": "#e4ddd0"
     }
    }
   },
   "dark": {
    "surface": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.098,
       0.09,
       0.082
      ],
      "hex": "#191715"
     }
    },
    "card": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.137,
       0.125,
       0.114
      ],
      "hex": "#23201d"
     }
    },
    "text": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.925,
       0.902,
       0.863
      ],
      "hex": "#ece6dc"
     }
    },
    "muted": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.647,
       0.612,
       0.565
      ],
      "hex": "#a59c90"
     }
    },
    "accent": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.898,
       0.541,
       0.361
      ],
      "hex": "#e58a5c"
     }
    },
    "accent-soft": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.231,
       0.165,
       0.125
      ],
      "hex": "#3b2a20"
     }
    },
    "line": {
     "$value": {
      "colorSpace": "srgb",
      "components": [
       0.227,
       0.208,
       0.188
      ],
      "hex": "#3a3530"
     }
    }
   }
  },
  "font": {
   "family": {
    "$type": "fontFamily",
    "base": {
     "$value": [
      "Noto Sans JP",
      "Hiragino Sans",
      "system-ui",
      "sans-serif"
     ]
    },
    "mono": {
     "$value": [
      "ui-monospace",
      "SFMono-Regular",
      "Menlo",
      "monospace"
     ]
    }
   },
   "size": {
    "$type": "dimension",
    "body": {
     "$value": {
      "value": 16,
      "unit": "px"
     }
    },
    "goal": {
     "$value": {
      "value": 28,
      "unit": "px"
     }
    },
    "label": {
     "$value": {
      "value": 12,
      "unit": "px"
     }
    }
   },
   "weight": {
    "$type": "fontWeight",
    "label": {
     "$value": "semi-bold"
    }
   }
  },
  "space": {
   "$type": "dimension",
   "sm": {
    "$value": {
     "value": 8,
     "unit": "px"
    }
   },
   "md": {
    "$value": {
     "value": 16,
     "unit": "px"
    }
   },
   "lg": {
    "$value": {
     "value": 28,
     "unit": "px"
    }
   },
   "xl": {
    "$value": {
     "value": 48,
     "unit": "px"
    }
   }
  },
  "radius": {
   "$type": "dimension",
   "card": {
    "$value": {
     "value": 14,
     "unit": "px"
    }
   },
   "chip": {
    "$value": {
     "value": 999,
     "unit": "px"
    }
   }
  },
  "size": {
   "$type": "dimension",
   "content": {
    "$value": {
     "value": 720,
     "unit": "px"
    }
   }
  }
 }
}
