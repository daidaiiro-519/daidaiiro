    "html": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>判断基準</title>\n<style>*{box-sizing:border-box}body{margin:0;background:var(--band);color:var(--ink);font:15px/1.8 'Noto Sans JP',sans-serif}main{max-width:880px;margin:0 auto;padding:24px 16px}@media (max-width:480px){main{padding:16px 12px}}:root{--accent:#3949ab;--accent-soft:#e7e9f7;--band:#eef0f7;--ink:#1f2330;--line:#d5d9e8;--muted:#565c70;--paper:#ffffff;--surface:#f3f4fa;--warn:#9a3412;--warn-soft:#fdeee6;}@media (prefers-color-scheme:dark){:root{--accent:#8c9eff;--accent-soft:#232a4d;--band:#11131a;--ink:#e6e8f0;--line:#353a52;--muted:#9ea3b8;--paper:#15171f;--surface:#1d2030;--warn:#f0a07a;--warn-soft:#3a241c;}}/* 描画の規則（ボード view-design-tokens）。.rv の囲みの中だけに適用される ── 他の頁に埋め込んでも混ざらない。\n   色は var(--役割) だけで参照し、色の直値を書かない。字の大きさと余白は固定の値で持つ */\n.rv header{margin:0 0 16px}.rv .eyebrow{color:var(--muted);font-size:12px;margin:0}\n.rv h1{font-size:22px;line-height:1.5;margin:4px 0 0}\n.rv h2{font-size:14px;color:var(--accent);margin:0 0 4px;letter-spacing:.02em}\n.rv h3,.rv h4,.rv h5,.rv h6{font-size:17px;margin:10px 0 4px;line-height:1.55}\n.rv .block,.rv .card{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px;margin:0 0 14px}\n.rv .card{border:2px solid var(--accent)}.rv .cardhead{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.rv .lead{font-size:16px;font-weight:500;margin:6px 0 2px}.rv .claim{margin:2px 0 8px;color:var(--ink)}\n.rv p{margin:0;overflow-wrap:anywhere}.rv .unit p+p{margin-top:6px}\n.rv .unit{border-top:1px dashed var(--line);margin-top:14px;padding-top:12px}\n.rv .ulabel{display:inline-block;font-size:11px;font-weight:600;color:var(--accent);background:var(--accent-soft);border-radius:4px;padding:1px 8px;margin:0 0 4px}\n/* 表 */\n.rv .scroll{overflow-x:auto;margin-top:8px;border:1px solid var(--line);border-radius:8px}\n.rv table{border-collapse:collapse;width:100%;font-size:14px;line-height:1.7}\n.rv th{background:var(--surface);color:var(--ink);font-weight:700;font-size:13px;text-align:left;padding:10px 12px;border-bottom:2px solid var(--line);white-space:nowrap}\n.rv td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere;min-width:6em}\n.rv tbody tr:last-child td{border-bottom:none}\n.rv tbody tr:nth-child(even) td{background:var(--surface)}\n.rv td:first-child{min-width:7.5em}\n/* コードブロック */\n.rv pre{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}\n.rv pre.code{margin-top:8px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:8px;padding:12px 16px;font:13px/1.8 ui-monospace,SFMono-Regular,Menlo,Consolas,'BIZ UDGothic',monospace;color:var(--ink)}\n/* そのほか */\n.rv ul{margin:0;padding-left:1.3em}.rv li{overflow-wrap:anywhere}\n.rv ol.steps{list-style:none;counter-reset:s;margin:8px 0 0;padding:0}.rv ol.steps li{counter-increment:s;position:relative;padding:4px 0 10px 40px}\n.rv ol.steps li::before{content:counter(s);position:absolute;left:0;top:6px;width:26px;height:26px;border-radius:50%;background:var(--accent);color:var(--paper);font-size:13px;display:flex;align-items:center;justify-content:center}\n.rv figure{margin:8px 0 0;border:1px solid var(--line);border-radius:10px;padding:12px;text-align:center;background:var(--paper);overflow-x:auto}.rv figure svg{max-width:100%;height:auto}\n.rv .item{border-top:1px dashed var(--line);padding-top:6px;margin-top:6px}\n/* 旧い型から引き継ぐ部品 */\n.rv .desc{color:var(--muted);font-size:12px;margin:0 0 8px}\n.rv .tag{display:inline-block;background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:1px 10px;font-size:12px;font-weight:700;white-space:nowrap}\n.rv .tag.neg{background:var(--warn-soft);color:var(--warn)}\n.rv .sub{margin:0}\n.rv .nest{border-left:3px solid var(--accent-soft);padding-left:12px;margin:6px 0}\n.rv .nest p,.rv .nest ul,.rv .nest ol,.rv .nest .scroll{margin:4px 0}\n.rv .topic>h2{font-size:17px;color:var(--ink);margin:0}\n.rv .unit .scroll,.rv .unit figure,.rv .unit pre{margin-top:8px}\n.rv figcaption{color:var(--muted);font-size:12px}\n.rv ol.steps .lead{font-size:15px;margin:0}\n.rv th:first-child{min-width:7.5em}\n@media (max-width:480px){.rv h1{font-size:19px}.rv th,.rv td{padding:8px 10px}}\n</style>\n</head>\n<body><main class=\"rv\"><section class=\"entry\"><header><p class=\"eyebrow\">判断基準</p><h1>集約</h1></header><section class=\"block\"><h2>id</h2><p>aggregate</p></section><section class=\"block\"><h2>判断の基準</h2><p class=\"desc\">判定に使う記述</p><p>集約は1つのトランザクションの単位である</p></section></section><section class=\"entry\"><header><p class=\"eyebrow\">判断基準</p><h1>区切られた文脈</h1></header><section class=\"block\"><h2>id</h2><p>context</p></section><section class=\"block\"><h2>判断の基準</h2><p class=\"desc\">判定に使う記述</p><p>語の意味は文脈の内側で1つに決まる</p></section></section></main></body>\n</html>\n"
