{
 "case": "スキーマに合わない JSON を検出する",
 "test": "json_that_breaks_its_schema_is_reported",
 "call": [
  "validate",
  "--skill_root",
  "fixtures/broken-criteria"
 ],
 "expect": {
  "exit": 1,
  "json": {
   "ok": true,
   "findings": [
    "criteria.json: items/0 ── \"rule\" is a required property"
   ],
   "data": {
    "kinds": [
     "criteria"
    ],
    "checked": "references"
   }
  }
 },
 "ignore": [
  "/findings/0"
 ]
}