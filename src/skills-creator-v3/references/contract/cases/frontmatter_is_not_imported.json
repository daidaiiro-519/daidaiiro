{
 "case": "frontmatter を本文として取り込まない",
 "test": "frontmatter_is_not_imported",
 "setup": [
  [
   "import",
   "--file",
   "fixtures/markdown/frontmatter.md",
   "--id",
   "x",
   "--source",
   "a.md",
   "--fetched",
   "2026-09-29",
   "--skill_root",
   "fixtures/document"
  ]
 ],
 "call": [
  "get",
  "--kind",
  "document",
  "--id",
  "x",
  "--skill_root",
  "fixtures/document"
 ],
 "expect": {
  "exit": 0,
  "json": {
   "ok": true,
   "findings": [],
   "data": {
    "id": "x",
    "title": "題",
    "source": {
     "location": "a.md",
     "sha256": "126e0df848a3e36095cdb21b81196ddfa6563ad37b87a22a969654f35738c7c0",
     "fetched": "2026-09-29"
    },
    "sections": [
     {
      "title": "題",
      "blocks": [
       {
        "kind": "para",
        "text": "本文"
       }
      ]
     }
    ]
   }
  }
 }
}