{
 "case": "判断基準が0件のあいだは、指す先を照らさない",
 "test": "references_are_not_checked_while_the_criteria_are_empty",
 "call": [
  "validate",
  "--kind",
  "answer",
  "--file",
  "fixtures/answers/grounds-example.json",
  "--skill_root",
  "fixtures/grounds-empty"
 ],
 "expect": {
  "exit": 0,
  "json": {
   "ok": true,
   "findings": [],
   "data": {
    "kinds": [
     "answer",
     "criteria"
    ],
    "checked": "fixtures/answers/grounds-example.json"
   }
  }
 }
}