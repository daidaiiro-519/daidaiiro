{
 "case": "本文を段落 ・ 箇条書き ・ 表 ・ コードの塊に分ける",
 "test": "the_body_is_split_into_blocks",
 "setup": [
  [
   "import",
   "--file",
   "fixtures/markdown/blocks.md",
   "--id",
   "blocks",
   "--source",
   "a.md",
   "--fetched",
   "2026-09-29",
   "--skill_root",
   "fixtures/document"
  ]
 ],
 "call": [
  "get",
  "--kind",
  "document",
  "--id",
  "blocks",
  "--skill_root",
  "fixtures/document"
 ],
 "expect": {
  "exit": 0,
  "json": {
   "ok": true,
   "findings": [],
   "data": {
    "id": "blocks",
    "title": "blocks",
    "source": {
     "location": "a.md",
     "sha256": "094b943c20b8a95882f02b9ac4853642a3af13a7e7aac85c4dc6c0a7f840e33e",
     "fetched": "2026-09-29"
    },
    "sections": [],
    "blocks": [
     {
      "kind": "para",
      "text": "一文目の続き。"
     },
     {
      "kind": "list",
      "ordered": false,
      "items": [
       "甲",
       "乙"
      ]
     },
     {
      "kind": "table",
      "head": [
       "列A",
       "列B"
      ],
      "rows": [
       [
        "1",
        "2"
       ]
      ]
     },
     {
      "kind": "code",
      "text": "fn x() {}"
     }
    ]
   }
  }
 }
}