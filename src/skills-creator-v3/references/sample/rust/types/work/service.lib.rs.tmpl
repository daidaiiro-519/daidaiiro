//! {{Skill名}} のサービス層。道具の一覧を持ち、**能力の正本はここである。**
//!
//! プレゼンテーション層（CLI ・ MCP）はこの一覧から組む ── 能力を2回書くと、片方だけが古くなる。
//! 依存の向きは `Cargo.toml` が宣言する ── この crate は業務ロジック層だけを参照する。

pub mod contract;
mod refs;

use serde_json::json;

pub use contract::{catalog, Arg, Given, Outcome, Tool};

/// 見本の道具。**書き換えて、この Skill の道具にする。**
fn run_hello(given: &Given) -> Outcome {
    // **ここに実体を書かない。** 業務ロジック層（{{接頭辞}}_business_logic）を呼び、結果を組むだけである。
    // 外部の道具を起動するなら、`given.external("名前")` で tool.json から読み、業務ロジック層へ
    // 引数として渡す。起動するのはデータアクセス層の `process` である ── どの層も名前を直書きしない
    let greeting = {{接頭辞}}_business_logic::hello::greet(given.one("name", ""));
    Outcome::found(Vec::new(), json!({ "greeting": greeting }))
}

/// 人向けの文を組む。**印字はしない** ── 印字と終了コードはプレゼンテーション層が持つ。
fn human_hello(out: &Outcome) -> String {
    if !out.ok {
        return out.findings.join(" ／ ");
    }
    out.data
        .get("greeting")
        .and_then(serde_json::Value::as_str)
        .unwrap_or_default()
        .to_owned()
}

/// この Skill が持つ道具の一覧。**能力の正本である。** references の4つの道具（get ・ validate ・
/// view ・ import）は、どの Skill も同じものを足す（ACDR 0043）。
#[must_use]
pub fn tools() -> Vec<Tool> {
    let mut all = vec![Tool {
        name: "hello",
        summary: "見本の道具。名前を受けて、あいさつの文を返す",
        args: vec![Arg::need("name", "あいさつする相手の名前")],
        run: run_hello,
        human: human_hello,
    }];
    all.extend(refs::tools());
    all
}
